version: v1
kind: Spicepod
name: nasa-earth-events

# NASA Earth Observatory Natural Event Tracker (EONET) via the HTTP connector.
#
# This spicepod surfaces live NASA natural event data — wildfires, storms,
# volcanoes, sea ice, floods, and more — as queryable SQL tables.
#
# No API key required; EONET is a public NASA API.
#
# Example queries:
#
#   -- All open events right now
#   SELECT * FROM eonet_events ORDER BY geometry_date DESC LIMIT 20;
#
#   -- Active wildfires larger than 1000 acres
#   SELECT title, geometry_date, magnitude_value, longitude, latitude
#   FROM eonet_events
#   WHERE category_id = 'wildfires'
#     AND magnitude_value > 1000
#   ORDER BY magnitude_value DESC;
#
#   -- Events by category in the last 30 days
#   SELECT category_title, COUNT(*) AS event_count
#   FROM eonet_events
#   GROUP BY category_title
#   ORDER BY event_count DESC;
#
#   -- Browse available event categories
#   SELECT * FROM eonet_categories;
#
#   -- Browse available data sources
#   SELECT * FROM eonet_sources;

views:
  # Parses the raw JSON content column from eonet_events_raw into typed columns.
  # This is where the json_get_* expressions live — refresh_sql only allows
  # plain column references, so transformations must go in a view instead.
  - name: eonet_events
    sql: |
      SELECT
        content ->> 'id'                                                  AS event_id,
        content ->> 'title'                                               AS title,
        content ->> 'description'                                         AS description,
        content ->> 'link'                                                AS link,
        content ->> 'closed'                                              AS closed_at,
        content -> 'categories' -> 0 ->> 'id'                            AS category_id,
        content -> 'categories' -> 0 ->> 'title'                         AS category_title,
        CAST(content -> 'geometry' -> 0 ->> 'magnitudeValue' AS DOUBLE)  AS magnitude_value,
        content -> 'geometry' -> 0 ->> 'magnitudeUnit'                   AS magnitude_unit,
        content -> 'geometry' -> 0 ->> 'date'                            AS geometry_date,
        content -> 'geometry' -> 0 ->> 'type'                            AS geometry_type,
        CAST(content -> 'geometry' -> 0 -> 'coordinates' ->> 0 AS DOUBLE) AS longitude,
        CAST(content -> 'geometry' -> 0 -> 'coordinates' ->> 1 AS DOUBLE) AS latitude
      FROM eonet_events_raw

  # Active wildfires — uses request_query to scope the HTTP request to the
  # EONET API to wildfires from the last 30 days, rather than fetching all
  # open events and filtering client-side.
  #
  # GET https://eonet.gsfc.nasa.gov/api/v3/events?category=wildfires&days=30&status=open
  #
  # e.g. SELECT * FROM active_wildfires ORDER BY magnitude_value DESC;
  - name: active_wildfires
    sql: |
      SELECT
        content ->> 'id'                                                   AS event_id,
        content ->> 'title'                                                AS title,
        CAST(content -> 'geometry' -> 0 ->> 'magnitudeValue' AS DOUBLE)   AS magnitude_value,
        content -> 'geometry' -> 0 ->> 'magnitudeUnit'                    AS magnitude_unit,
        content -> 'geometry' -> 0 ->> 'date'                             AS geometry_date,
        CAST(content -> 'geometry' -> 0 -> 'coordinates' ->> 0 AS DOUBLE) AS longitude,
        CAST(content -> 'geometry' -> 0 -> 'coordinates' ->> 1 AS DOUBLE) AS latitude,
        content ->> 'link'                                                 AS link
      FROM eonet_events_raw
      WHERE request_query = 'category=wildfires&days=30&status=open'
      ORDER BY magnitude_value DESC

datasets:
  # Raw JSON event data from EONET. Each row is one event with a `content`
  # column containing the full JSON object. The eonet_events view parses this
  # into typed columns.
  - from: https://eonet.gsfc.nasa.gov/api/v3/events
    name: eonet_events_raw
    params:
      file_format: json
      pagination: enabled
      health_probe: /api/v3/events
      pagination_data_pointer: /events
      request_query_filters: enabled
    acceleration:
      enabled: true
      refresh_mode: caching
      refresh_check_interval: 15m
      # Workaround for spiceai/spiceai#10590 (refresh_on_startup: always ignored in
      # caching mode) and spiceai/spiceai#10591 (default caching_ttl of 30s evicts
      # data immediately). Setting caching_ttl to match refresh_check_interval keeps
      # data fresh between refreshes. on_zero_results: use_source ensures a cold cache
      # falls through to the live API rather than returning empty results.
      on_zero_results: use_source
      params:
        caching_ttl: 15m

  # All EONET event categories (wildfires, storms, volcanoes, floods, …)
  - from: https://eonet.gsfc.nasa.gov/api/v3/categories
    name: eonet_categories
    params:
      file_format: json
      pagination: enabled
      health_probe: /api/v3/categories
      pagination_data_pointer: /categories
    acceleration:
      enabled: true
      refresh_mode: caching
      refresh_check_interval: 24h
      on_zero_results: use_source
      params:
        caching_ttl: 24h

  # Data source registry — who contributes event data to EONET
  - from: https://eonet.gsfc.nasa.gov/api/v3/sources
    name: eonet_sources
    params:
      file_format: json
      pagination: enabled
      health_probe: /api/v3/sources
      pagination_data_pointer: /sources
    acceleration:
      enabled: true
      refresh_mode: caching
      refresh_check_interval: 24h
      on_zero_results: use_source
      params:
        caching_ttl: 24h
