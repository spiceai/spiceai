#!/usr/bin/env python3
# Copyright 2024-2026 The Spice.ai OSS Authors
#
# scripts/batch-make — merge several PRs onto trunk and run one command (usually
# a make target) on the result. Use it to build one spiced that has all of them.
#
#   1. Pin trunk to one commit (T) and merge it into each PR head, locally.
#   2. Merge those heads onto T, in the order given: the batch commit.
#   3. Run the command in a worktree that is reused across runs, so its build
#      cache stays warm.
#
#   trunk T ──┬── #a + T ──┐
#             ├── #b + T ──┼──▶ batch = T + #a' + #b' + #c' ──▶ <command>
#             └── #c + T ──┘
#
# Steps 1-2 are the same as scripts/signoff-batch. This script does not push or
# attest: the merges stay local, on branch `batch-make`.
#
# Usage:
#   scripts/batch-make 15040 15041 -- make install SPICED_NON_DEFAULT_FEATURES='metal,models'
#   scripts/batch-make --base release/2.4 15040 -- make install
#   scripts/batch-make --plan 15040 15041   # do steps 1-2, check out, stop
#
# Environment:
#   BATCH_MAKE_WORKTREE  Worktree for the build (default: a sibling of the main
#                        checkout, <checkout>-batch-make)
#   SIGNOFF_REMOTE       Git remote (default: origin)
#   SIGNOFF_BRANCH       Base branch (default: trunk); --base overrides it

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path


def load_signoff_batch():
    path = Path(__file__).resolve().parent / "signoff-batch"
    loader = importlib.machinery.SourceFileLoader("signoff_batch", str(path))
    spec = importlib.util.spec_from_loader("signoff_batch", loader)
    module = importlib.util.module_from_spec(spec)
    # dataclasses resolves annotations through sys.modules.
    sys.modules["signoff_batch"] = module
    loader.exec_module(module)
    return module


sb = load_signoff_batch()
# A separate branch from signoff-batch, so both can be checked out at once.
sb.BATCH_BRANCH = "batch-make"


def default_worktree(repo: Path) -> Path:
    if env := os.environ.get("BATCH_MAKE_WORKTREE"):
        return Path(env)
    main = Path(sb.git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")).parent
    return main.parent / f"{main.name}-batch-make"


def run_command(command: Sequence[str], worktree: Path, log_path: Path) -> int:
    # One argument is a shell string ('make install X=y'); more are an argv.
    args = ["sh", "-c", command[0]] if len(command) == 1 else list(command)
    if sys.platform == "darwin":
        # Builds take a long time; keep the Mac from idle-sleeping.
        args = ["caffeinate", "-i", *args]
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("w") as log, subprocess.Popen(
        args, cwd=worktree, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1
    ) as proc:
        assert proc.stdout is not None
        for line in proc.stdout:
            sys.stdout.write(line)
            log.write(line)
    return proc.returncode


def main(argv: Sequence[str]) -> int:
    sys.stdout.reconfigure(line_buffering=True)
    argv = list(argv)
    command: list[str] = []
    if "--" in argv:
        split = argv.index("--")
        argv, command = argv[:split], argv[split + 1 :]

    parser = argparse.ArgumentParser(
        prog="scripts/batch-make",
        usage="%(prog)s [options] PR [PR ...] -- COMMAND [ARG ...]",
        description="Merge several PRs onto trunk and run one command on the result. Nothing is pushed.",
    )
    parser.add_argument("prs", nargs="+", metavar="PR", help="PR number, #number, or URL; merged in this order")
    parser.add_argument("--base", help="branch to merge the PRs onto (default: $SIGNOFF_BRANCH or trunk)")
    parser.add_argument("--plan", action="store_true", help="build and check out the batch, then stop")
    parser.add_argument("--worktree", type=Path, help="build worktree (default: $BATCH_MAKE_WORKTREE or <checkout>-batch-make)")
    args = parser.parse_args(argv)
    if not command and not args.plan:
        parser.error("give the command after `--`, or pass --plan")
    if args.base:
        sb.TRUNK = args.base

    try:
        repo = Path(sb.git(Path.cwd(), "rev-parse", "--show-toplevel"))
        repo_slug = sb.remote_repo_slug(repo)
        if repo_slug:
            # Look PRs up in the repository the batch fetches from, not gh's default.
            os.environ["GH_HOST"] = "github.com"
            os.environ["GH_REPO"] = f"github.com/{repo_slug}"
        numbers = list(dict.fromkeys(sb.parse_pr_arg(a, repo_slug) for a in args.prs))
        worktree = (args.worktree or default_worktree(repo)).resolve()

        trunk, prs = sb.fetch(repo, numbers)
        heads = [sb.update_head(repo, trunk, pr) for pr in prs]
        batch = sb.build_batch(repo, trunk, heads)
        sb.print_plan(batch)
        sb.prepare_worktree(repo, worktree, batch.sha)
        print(f"\nChecked out in {worktree} (branch {sb.BATCH_BRANCH}).")
        if args.plan:
            return 0

        common = Path(sb.git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir"))
        log_path = common / "batch-make" / f"{batch.sha[:12]}.log"
        print(f"Running: {' '.join(command)}\n  Log: {log_path}\n")
        code = run_command(command, worktree, log_path)
        if code != 0:
            print(f"\n✗ Command failed (exit {code}) on batch {batch.sha[:12]}.\n  Log: {log_path}", file=sys.stderr)
            return code
        included = " ".join(f"#{h.pr.number}" for h in batch.heads)
        print(f"\n✓ Command passed on batch {batch.sha[:12]} ({sb.TRUNK} {trunk[:12]} + {included}).")
        return 0
    except sb.BatchError as err:
        print(f"✗ {err}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n✗ Interrupted.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
