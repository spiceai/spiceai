#!/usr/bin/env bash
# Copyright 2024-2026 The Spice.ai OSS Authors
#
# scripts/signoff — Local CI attestation ("developer sign-off").
#
# Run the fast quality checks on your own machine, then attest to the exact
# commit you pushed. On the pull request a single `Attestation` check validates
# your sign-off and lets the PR into the merge queue, where the *full* suite of
# tests and checks runs as the real gate.
#
# Pure reverts skip this entirely: a PR that only reverts commits already on the
# base branch passes the Attestation check automatically (validated in pr.yml),
# since the merge queue still re-runs the full suite on the merged result. See
# docs/dev/ci_signoff.md ("Reverts are fast-tracked").
#
# This is Spice's take on 37signals' approach of moving CI back to developer
# machines (https://world.hey.com/dhh/we-re-moving-continuous-integration-back-to-developer-machines-3ac6c611),
# modeled on their open-source tool basecamp/gh-signoff. The twist: local
# sign-off only gates *entry* to the merge queue — the queue still runs the
# whole suite on the merged result, so a bad attestation can never reach trunk.
#
# Usage:
#   scripts/signoff                 Run checks, then sign off on HEAD  (or: make signoff)
#   scripts/signoff -f              Sign off even with a dirty/unpushed tree
#   scripts/signoff --no-verify     Sign off without running the checks (honor system)
#   scripts/signoff status          Show the sign-off status of HEAD
#   scripts/signoff mine            Show attestation status for all your open PRs
#   scripts/signoff clear-pending   Turn a left-behind pending status into a failure
#   scripts/signoff preflight-disk  Check the work volume's free space (CI: run
#                                   before the toolchain setup steps)
#   scripts/signoff check           Show whether trunk requires sign-off
#   scripts/signoff install         Configure the trunk ruleset (maintainers)
#   scripts/signoff install --yes   Apply the ruleset change (default is a dry-run)
#
# Environment:
#   SIGNOFF_BRANCH    Branch/ruleset to target for install/check (default: trunk)
#   SIGNOFF_REMOTE    Git remote to use in a JJ workspace (default: origin)
#   SIGNOFF_ACTOR     Attribution login (remote workflow sets this to the
#                     human who dispatched the run; defaults to gh/git user)
#   SIGNOFF_REMOTE_RUN  Set by .github/workflows/signoff.yml — pending/failure
#                     statuses, "via remote" description, GitHub step summary
#   SIGNOFF_DEBUG     Set to any value for verbose debug logging
#   SIGNOFF_SKIP_TARGETED_LINT  Set to any value to skip the branch-scoped pre-lint
#   SIGNOFF_SKIP_TARGETED_TESTS Set to any value to skip the branch-scoped unit
#                     tests that run after the pre-lint
#   SIGNOFF_MIN_FREE_GIB  Free space (GiB) the work volume must have before a
#                     remote run starts its Rust checks (default: 25). Checked
#                     twice: by the `preflight-disk` step before the toolchain
#                     setup, and again inside the run. Below it a remote run
#                     stops immediately as an infrastructure failure; a local
#                     run only warns.
#
# Targeted pre-lint always diffs against trunk (not configurable).
# When the branch has no Rust-affecting changes vs trunk (.rs, Cargo.toml,
# Cargo.lock, rust-toolchain*, .cargo/*, clippy/rustfmt/nextest/layers config,
# the lint guards, the root Makefile), Rust lint/build/tests are skipped
# (both local and remote); the sign-off status is still posted.
#
# Remote alternative to local `make signoff` (both dispatch GitHub Actions):
#   make signoff-remote
#   gh workflow run signoff.yml -f branch=<branch>

set -euo pipefail

readonly VERSION="1.5.0"
# Fixed, not configurable: it must match the hardcoded context the Attestation
# workflow (pr.yml) looks for, so an env override would silently break the gate.
readonly STATUS_CONTEXT="signoff"
readonly TARGET_BRANCH="${SIGNOFF_BRANCH:-trunk}"
readonly TARGET_REMOTE="${SIGNOFF_REMOTE:-origin}"
DEBUG="${SIGNOFF_DEBUG:-}"
VCS=""
JJ_REMOTE_URL=""
# Packages excluded from workspace lint (must match Makefile lint-rust excludes).
readonly LINT_EXCLUDED_PACKAGES="libnfs lopdf ttf-parser pdf-extract"

# True when running under the Remote Sign-off workflow. Drives pending/failure
# statuses, "via remote" descriptions, and the GitHub Actions step summary.
# GITHUB_ACTIONS alone is not enough — other workflows must not inherit this.
is_remote_run() { [[ -n "${SIGNOFF_REMOTE_RUN:-}" ]]; }

# The single source of truth for the checks required to merge. `install` writes
# exactly this list into the trunk ruleset's required status checks. Every name
# here must be produced under the same name on both the PR head (to allow
# queue entry) and `merge_group` (to gate the merged result).
readonly REQUIRED_CHECKS=(
  "Attestation"              # sign-off gate (pr.yml) — the PR's only quality check
  "enforce-pull-with-spice"  # PR hygiene (enforce-pulls-with-spice.yml)
  "Rust Lint"                # pr.yml
  "Build and Test"           # pr.yml
  "Build (release profile)"  # pr.yml
  "Integration Tests (part 1)"
  "Integration Tests (part 2)"
  "Integration Tests (part 3)"
  "ADBC Integration Tests"   # integration_adbc.yml
  "Features Check"           # features.yml
  "Check Rust Licenses"      # license_check.yml
  "E2E Test CI"              # e2e_test_ci.yml (gate job)
)
# GitHub Actions app id — pins each required check to Actions so a hand-POSTed
# commit status can't satisfy a required check (only `signoff` is a raw status).
readonly ACTIONS_INTEGRATION_ID=15368

# --- output helpers ----------------------------------------------------------

readonly OK="✓"
readonly NO="✗"

# Colors for `mine`'s human-facing report only — every other command's output
# stays plain text (docs/scripts may grep it). Respects NO_COLOR and piping.
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
  readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' \
    C_DIM=$'\033[2m' C_BOLD=$'\033[1m' C_RESET=$'\033[0m'
else
  readonly C_RED='' C_GREEN='' C_YELLOW='' C_DIM='' C_BOLD='' C_RESET=''
fi

debug() { [[ -n "$DEBUG" ]] && echo "debug: $*" >&2 || true; }
info()  { echo "$*" >&2; }
fail()  { echo "${NO} $*" >&2; exit 1; }

# Prefix each non-empty line of stdin with "$1" (for indented list output).
bullet() { local prefix="$1" line; while IFS= read -r line; do [[ -n "$line" ]] && echo "${prefix}${line}"; done; }

# True when "$1" holds at least one character that is not a tab, newline, CR, or
# space — i.e. the string carries content rather than only separators.
#
# This replaces `[[ -n "${var//[$'\t\n\r ']/}" ]]`. That expansion is quadratic
# or worse in bash 3.2 (still /bin/bash on macOS, which `#!/usr/bin/env bash`
# resolves to), so applying it to a branch's changed-file list — ~107 KB for a
# 900-file diff — takes hours: measured 1.8s at 3 KB, 14s at 6 KB, 91s at 12 KB,
# extrapolating to ~11h at 107 KB. A glob match short-circuits on the first
# content character instead, and stays fast (~20ms at 107 KB) even in the
# all-whitespace worst case, where it has to scan the whole string.
readonly SIGNOFF_SEPARATORS=$'\t\n\r '
has_content() { [[ "$1" == *[!$SIGNOFF_SEPARATORS]* ]]; }

# --- preconditions -----------------------------------------------------------

# Detect Git first so colocated JJ repositories retain the existing Git behavior.
# Fall back to JJ for non-colocated workspaces, which intentionally have no .git
# directory for Git or gh to discover.
detect_vcs() {
  if command -v git >/dev/null 2>&1 && git rev-parse --show-toplevel >/dev/null 2>&1; then
    VCS="git"
    return
  fi

  if command -v jj >/dev/null 2>&1 && jj root >/dev/null 2>&1; then
    VCS="jj"
    [[ "$TARGET_REMOTE" =~ ^[[:alnum:]_.:/-]+$ ]] \
      || fail "invalid JJ remote name: '${TARGET_REMOTE}'"

    local name url remotes
    remotes=$(jj --color=never git remote list) \
      || fail "could not list JJ remotes"
    while read -r name url; do
      if [[ "$name" == "$TARGET_REMOTE" ]]; then
        JJ_REMOTE_URL="$url"
        break
      fi
    done <<<"$remotes"
    [[ -n "$JJ_REMOTE_URL" ]] \
      || fail "JJ remote '${TARGET_REMOTE}' not found — add it with 'jj git remote add', or set SIGNOFF_REMOTE"
    [[ "$JJ_REMOTE_URL" != -* ]] \
      || fail "invalid URL for JJ remote '${TARGET_REMOTE}'"
    return
  fi

  fail "not inside a Git checkout or JJ workspace"
}

# gh covers every path; Git is used in a Git checkout and JJ in a non-colocated
# workspace. The default signoff flow parses JSON via `gh --jq`, not jq itself.
require_tools() {
  command -v gh >/dev/null 2>&1 || fail "GitHub CLI (gh) not found — install from https://cli.github.com"
  detect_vcs
  gh auth status >/dev/null 2>&1 || fail "not logged in to GitHub — run 'gh auth login'"
}

# Only the subcommands that parse JSON with the jq binary (status/check/install).
require_jq() {
  command -v jq >/dev/null 2>&1 || fail "jq not found — install from https://jqlang.github.io/jq"
}

# owner/repo of the current checkout, from the gh context. gh cannot infer a
# repository from a non-colocated JJ workspace, so give it that workspace's
# configured remote URL explicitly.
repo_slug() {
  if [[ "$VCS" == "jj" ]]; then
    gh repo view "$JJ_REMOTE_URL" --json nameWithOwner --jq .nameWithOwner 2>/dev/null \
      || fail "could not determine the GitHub repository from JJ remote '${TARGET_REMOTE}'"
  else
    gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null \
      || fail "could not determine the GitHub repository — run this inside a clone of the repo"
  fi
}

jj_revision_is_remote() {
  local revision="$1" sha
  sha=$(jj --color=never --no-pager log \
    -r "${revision} & remote_bookmarks(remote=exact:\"${TARGET_REMOTE}\")" \
    --no-graph -T 'commit_id') \
    || fail "could not inspect JJ bookmarks on '${TARGET_REMOTE}'"
  [[ -n "$sha" ]]
}

# A normal `jj commit` leaves an empty working-copy commit on top of the commit
# that was bookmarked and pushed. Treat that parent as HEAD. If @ itself has a
# bookmark, contains changes, or is already a remote bookmark, it is the commit
# the developer is trying to attest instead.
current_revision() {
  local force="${1:-false}"
  if [[ "$VCS" == "git" ]]; then
    echo "HEAD"
    return
  fi

  local at_bookmark at_empty
  at_bookmark=$(jj --color=never --no-pager log -r '@ & bookmarks()' --no-graph -T 'commit_id') \
    || fail "could not inspect JJ bookmarks"
  at_empty=$(jj --color=never --no-pager log -r '@ & empty()' --no-graph -T 'commit_id') \
    || fail "could not inspect the JJ working-copy commit"
  if jj_revision_is_remote "@" || [[ -n "$at_bookmark" ]] || [[ -z "$at_empty" ]]; then
    echo "@"
    return
  fi

  local parent_count
  parent_count=$(jj --color=never --no-pager log -r '@' --no-graph -T 'parents.len()') \
    || fail "could not inspect the JJ working-copy parent"
  if [[ "$parent_count" == "1" ]]; then
    echo "@-"
  elif $force; then
    echo "@"
  else
    fail "empty JJ working-copy commit has ${parent_count} parents — select the commit to sign off, or pass -f"
  fi
}

revision_sha() {
  local revision="$1"
  if [[ "$VCS" == "jj" ]]; then
    jj --color=never --no-pager log -r "$revision" --no-graph -T 'commit_id'
  else
    git rev-parse "$revision"
  fi
}

local_user_name() {
  if [[ "$VCS" == "jj" ]]; then
    jj config get user.name 2>/dev/null
  else
    git config user.name 2>/dev/null
  fi
}

# Refuse to sign off on a tree that isn't exactly what's pushed: the attestation
# is bound to a single commit SHA, so it must match the commit under review.
ensure_clean_and_pushed() {
  local revision="$1"
  if [[ "$VCS" == "jj" ]]; then
    jj_revision_is_remote "$revision" \
      || fail "JJ revision ${revision} is not a bookmark tip on '${TARGET_REMOTE}' — bookmark and push it with 'jj git push', or pass -f"
    return
  fi

  if [[ -n "$(git status --porcelain)" ]]; then
    fail "working tree has uncommitted changes — commit or stash them, or pass -f"
  fi
  if ! git rev-parse --abbrev-ref '@{push}' >/dev/null 2>&1; then
    fail "current branch has no upstream — push it first (git push -u origin HEAD), or pass -f"
  fi
  if [[ -n "$(git log '@{push}..' --oneline)" ]]; then
    fail "branch has commits that aren't pushed — push them first, or pass -f"
  fi
  # ...and not behind either, so HEAD is exactly the pushed tip under review.
  if [[ -n "$(git log 'HEAD..@{push}' --oneline)" ]]; then
    fail "branch is behind its remote — pull the latest, then sign off (or pass -f)"
  fi
}

# --- branch → package mapping (targeted pre-lint) ----------------------------

# Targeted pre-lint always diffs against trunk (fixed, not configurable).
readonly LINT_BASE_BRANCH="trunk"

# Resolve trunk to a local git/jj ref usable with merge-base / jj diff.
# Fails if the ref isn't present locally (caller may fall back to API).
resolve_local_trunk_ref() {
  if [[ "$VCS" == "jj" ]]; then
    if jj --color=never --no-pager log \
      -r "remote_bookmarks(exact:\"${LINT_BASE_BRANCH}\", remote=exact:\"${TARGET_REMOTE}\")" \
      --no-graph -T 'commit_id' -n 1 >/dev/null 2>&1; then
      echo "${LINT_BASE_BRANCH}@${TARGET_REMOTE}"
      return 0
    fi
    if jj --color=never --no-pager log -r "bookmarks(exact:\"${LINT_BASE_BRANCH}\")" \
      --no-graph -T 'commit_id' -n 1 >/dev/null 2>&1; then
      echo "$LINT_BASE_BRANCH"
      return 0
    fi
    return 1
  fi

  if git rev-parse --verify "refs/remotes/${TARGET_REMOTE}/${LINT_BASE_BRANCH}" >/dev/null 2>&1; then
    echo "${TARGET_REMOTE}/${LINT_BASE_BRANCH}"
    return 0
  fi
  if git rev-parse --verify "refs/heads/${LINT_BASE_BRANCH}" >/dev/null 2>&1; then
    echo "$LINT_BASE_BRANCH"
    return 0
  fi
  return 1
}

# GitHub compare API — works on shallow clones where merge-base is unavailable.
# Prints one filename per line. Returns non-zero if the API call fails or the
# compare is truncated beyond usefulness (caller skips targeted lint).
github_compare_files() {
  local head_sha="$1"
  local repo payload

  repo=$(repo_slug) || return 1

  # three-dot compare: merge-base of trunk...head → head (same as a PR diff).
  # GitHub caps the files list at 300; when truncated, skip targeted pre-lint
  # rather than linting an incomplete package set.
  # Emit: first line "true"/"false" (truncated), then one filename per line.
  # Keep stderr so auth/rate-limit/network errors from `gh` are visible when
  # the compare fallback fails (caller still degrades to full workspace lint).
  payload=$(gh api "repos/${repo}/compare/${LINT_BASE_BRANCH}...${head_sha}" \
    --jq '(.truncated // false | tostring), (.files[]?.filename // empty)') \
    || return 1

  local truncated rest
  truncated="${payload%%$'\n'*}"
  if [[ "$truncated" == "true" ]]; then
    debug "GitHub compare is truncated (300+ files) — skipping targeted pre-lint"
    return 1
  fi
  rest="${payload#*$'\n'}"
  # When there are no files, payload is a single line ("false") and rest==payload.
  if [[ "$rest" == "$payload" ]]; then
    return 0
  fi
  printf '%s\n' "$rest"
}

# List paths changed on this branch relative to the merge-base with trunk.
# With a dirty tree (signoff -f), includes uncommitted working-tree changes when
# using local git. Falls back to the GitHub compare API on shallow clones
# (remote sign-off).
changed_files_vs_trunk() {
  local revision="$1"
  local base_ref base_sha head_sha files

  if [[ "$VCS" == "jj" ]]; then
    if base_ref=$(resolve_local_trunk_ref); then
      # `jj diff --from A --to B` is the branch delta; working-copy edits on an
      # empty @ parent are already in `revision` when current_revision selected @.
      jj --color=never --no-pager diff --from "$base_ref" --to "$revision" --name-only
      return 0
    fi
    debug "JJ trunk not local — trying GitHub compare API"
    head_sha=$(revision_sha "$revision") || return 1
    github_compare_files "$head_sha"
    return
  fi

  if base_ref=$(resolve_local_trunk_ref) \
    && base_sha=$(git merge-base HEAD "$base_ref" 2>/dev/null); then
    # No second revision → working tree vs trunk (covers committed + dirty -f).
    # Untracked files are invisible to `git diff` but still need package mapping
    # under `scripts/signoff -f` (dirty tree).
    {
      git diff --name-only --diff-filter=ACDMRT "$base_sha"
      git ls-files --others --exclude-standard
    } | sort -u
    return 0
  fi

  debug "merge-base with trunk unavailable (shallow clone?) — trying GitHub compare API"
  head_sha=$(git rev-parse HEAD) || return 1
  files=$(github_compare_files "$head_sha") || return 1
  printf '%s\n' "$files"
}

# Map changed file paths (stdin, one per line) to workspace package names.
# Uses `cargo metadata` so package names match what `-p` expects (including
# nested members under crates/data-connectors/*).
packages_for_changed_files() {
  command -v cargo >/dev/null 2>&1 || fail "cargo not found — required for sign-off checks"
  # Targeted pre-lint is an optional fail-fast step: without python3, skip it
  # (return non-zero, caller tolerates) — the full workspace lint still runs.
  if ! command -v python3 >/dev/null 2>&1; then
    info "python3 not found — skipping targeted pre-lint (full workspace lint still runs)"
    return 1
  fi

  local files
  # Read paths first — the program below reads metadata from stdin.
  files=$(cat)
  has_content "$files" || return 0

  # Metadata streams over stdin rather than the environment: it is ~700 KB
  # against a 1 MiB ARG_MAX covering argv plus the whole environment of exec(),
  # and once the workspace outgrows that headroom python3 would stop starting
  # and the targeted pre-lint would silently vanish. The changed-file list is a
  # branch diff, small enough to stay in the environment. Keep cargo's stderr so
  # its own error (missing rustc, bad manifest, …) stays visible.
  cargo metadata --no-deps --format-version 1 \
    | CHANGED_FILES="$files" SIGNOFF_LINT_EXCLUDED="$LINT_EXCLUDED_PACKAGES" python3 -c '
import json, os, sys
from pathlib import Path

try:
    meta = json.load(sys.stdin)
except ValueError:
    raise SystemExit("cargo metadata failed — is this a Cargo workspace?")
excluded = set(os.environ.get("SIGNOFF_LINT_EXCLUDED", "").split())
workspace_root = Path(meta["workspace_root"]).resolve()

# Longest package root first so nested members (connector-postgres) win over
# a parent path if both ever appeared (they should not for exclusive members).
packages = []
for p in meta["packages"]:
    name = p["name"]
    if name in excluded:
        continue
    root = Path(p["manifest_path"]).resolve().parent
    try:
        root.relative_to(workspace_root)
    except ValueError:
        continue
    packages.append((str(root) + os.sep, name))
packages.sort(key=lambda x: len(x[0]), reverse=True)

found = set()
for raw in os.environ["CHANGED_FILES"].splitlines():
    path = raw.strip()
    if not path:
        continue
    # Normalize under the workspace for prefix matching. Trailing-sep roots
    # avoid matching sibling packages that share a prefix (runtime vs
    # runtime-auth).
    abs_path = str((workspace_root / path).resolve())
    for root, name in packages:
        if abs_path == root.rstrip(os.sep) or abs_path.startswith(root):
            found.add(name)
            break

for name in sorted(found):
    print(name)
'
}

# Resolve workspace packages touched by the current branch vs trunk. Prints a
# space-separated list, or nothing if there are no package changes.
changed_workspace_packages() {
  local revision="$1"
  local files packages

  info "Diff base for targeted pre-lint: ${LINT_BASE_BRANCH}"

  if ! files=$(changed_files_vs_trunk "$revision"); then
    info "Could not list changed files vs ${LINT_BASE_BRANCH} — skipping targeted pre-lint"
    return 0
  fi
  if ! has_content "$files"; then
    debug "no changed files vs ${LINT_BASE_BRANCH}"
    return 0
  fi
  debug "changed files:"$'\n'"$files"

  packages=$(printf '%s\n' "$files" | packages_for_changed_files) || true
  if ! has_content "$packages"; then
    debug "no workspace packages in the changed files"
    return 0
  fi

  # Collapse newlines → spaces for `make PACKAGES=…`.
  echo "$packages" | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

# Feature set each named package carries in a full workspace resolve, formatted
# for `--features` and package-qualified so multi-package selections stay
# unambiguous.
#
# Without this a scoped `-p <crate>` run gets that crate's *own* defaults, which
# is not what the workspace build produces: `runtime` declares 54 features and no
# `default`, so `cargo clippy -p runtime` compiles it with zero features — a
# configuration no real build ever produces, because `spiced`'s defaults unify 35
# features into `runtime` across the workspace. The targeted steps would lint and
# test different code than the gate, which is both the false-failure class that
# SIGNOFF_SKIP_TARGETED_LINT exists to dodge and a guaranteed cache miss.
# Deriving the set from the resolve keeps the two in step with no hand-maintained
# list to drift.
workspace_features_for_packages() {
  local packages="$1"
  has_content "$packages" || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  # A resolve carrying dependencies is ~10 MB here, an order of magnitude past
  # ARG_MAX, so it can only reach python over stdin.
  cargo metadata --format-version 1 2>/dev/null | python3 -c '
import json, sys

try:
    meta = json.load(sys.stdin)
except ValueError:
    raise SystemExit(0)

wanted = set(sys.argv[1].split())
# Match on workspace members only: a dependency can share a name with a member.
members = set(meta.get("workspace_members", []))
names = {p["id"]: p["name"] for p in meta["packages"]}

features = []
for node in meta.get("resolve", {}).get("nodes", []):
    if node["id"] not in members or names.get(node["id"]) not in wanted:
        continue
    name = names[node["id"]]
    # `default` is already on -- nothing here passes --no-default-features.
    features.extend(
        f"{name}/{feat}" for feat in sorted(node["features"]) if feat != "default"
    )
print(",".join(features))
' "$packages" || return 0
}

# Narrow a package-qualified feature list (`pkg/feat,…`) to the given packages.
# Cargo rejects a feature naming a package outside the `-p` selection outright
# ("the package 'x' does not contain this feature: y/z"), so any caller that
# builds a subset of the packages the features were resolved for has to filter
# first. Prints the kept features, or nothing when none survive.
features_for_packages() {
  local features="$1" packages="$2"
  has_content "$features" || return 0
  has_content "$packages" || return 0

  awk -v feats="$features" -v pkgs="$packages" 'BEGIN {
    n = split(pkgs, selected, /[ \t\n]+/)
    for (i = 1; i <= n; i++) if (selected[i] != "") keep[selected[i]] = 1

    m = split(feats, entries, /,/)
    out = ""
    for (i = 1; i <= m; i++) {
      slash = index(entries[i], "/")
      if (slash == 0) continue
      if (substr(entries[i], 1, slash - 1) in keep) {
        out = (out == "" ? entries[i] : out "," entries[i])
      }
    }
    print out
  }'
}

# Filter a space-separated package list to those with a library target. The
# unit-test gate is lib-only, and `--lib` is a fatal `no library targets found`
# on bin-only crates (spice, testoperator, …). Prints the filtered list, or
# nothing when none qualify or the metadata is unavailable (caller then skips
# the targeted tests; the full run still covers them).
packages_with_lib_targets() {
  local packages="$1"
  has_content "$packages" || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  # Metadata streams in over stdin rather than an environment variable: this
  # workspace's `cargo metadata` output is ~700 KB against a 1 MiB ARG_MAX on
  # macOS, and that cap covers argv plus the whole environment of exec(). Once
  # the workspace outgrows the remaining headroom, python3 would stop starting
  # at all and the targeted tests would silently disappear. That forces
  # `python3 -c` over the heredoc used elsewhere here, since stdin is now data.
  # The package list stays in argv — it is a handful of crate names.
  cargo metadata --no-deps --format-version 1 2>/dev/null | python3 -c '
import json, sys

try:
    meta = json.load(sys.stdin)
except ValueError:
    # cargo metadata failed or produced nothing: print no packages, so the
    # caller skips the targeted tests instead of showing a decode traceback.
    raise SystemExit(0)

candidates = set(sys.argv[1].split())
# A proc-macro crate lib target is what `--lib` selects for it, so it counts.
LIB_KINDS = {"lib", "rlib", "proc-macro"}

with_lib = sorted(
    p["name"]
    for p in meta["packages"]
    if p["name"] in candidates
    and any(LIB_KINDS & set(t["kind"]) for t in p["targets"])
)
print(" ".join(with_lib))
' "$packages" || return 0
}

# Append a short markdown section to the GitHub Actions job summary (no-op
# outside Actions, or when the summary file isn't writable).
append_step_summary() {
  local text="$1"
  [[ -n "${GITHUB_STEP_SUMMARY:-}" ]] || return 0
  printf '%s\n' "$text" >>"$GITHUB_STEP_SUMMARY" 2>/dev/null || true
}

# Post a commit status for STATUS_CONTEXT. Used for pending/failure on remote
# runs and the final success attestation.
post_commit_status() {
  local repo="$1" sha="$2" state="$3" description="$4"
  description="${description:0:140}"
  debug "posting ${STATUS_CONTEXT}=${state} on ${repo}@${sha}: ${description}"
  gh api --method POST "repos/${repo}/statuses/${sha}" \
    -f state="$state" \
    -f context="${STATUS_CONTEXT}" \
    -f "description=${description}" >/dev/null
}

# The STATUS_CONTEXT state currently on a commit: success/pending/failure/error,
# or "none" when it has none. Asks gh's own jq rather than the jq binary — the
# remote sign-off path is otherwise free of that dependency (see require_jq).
signoff_state() {
  local repo="$1" sha="$2"
  gh api "repos/${repo}/commits/${sha}/status" \
    --jq ".statuses // [] | map(select(.context == \"${STATUS_CONTEXT}\")) | .[0].state // \"none\""
}

# Post the in-progress status for a remote run — unless the commit is already
# signed off. A re-dispatch against an attested commit is routine
# (`cancel-in-progress` makes it the normal way to recover from an evicted run),
# and posting `pending` over the success discards an attestation a multi-hour run
# earned — leaving the commit worse off than before if this run never reaches a
# verdict of its own. Suppressing the post costs no
# progress reporting: `mine` takes its ⟳ from the in-flight run list, not from
# this status. A `failure` from the checks still overwrites, because that one is
# this run's own verdict; a stale `failure` or `error` is likewise overwritten,
# because a run that is retrying it has nothing to preserve.
#
# Read-then-write with no compare-and-set, same as cmd_clear_pending: a success
# posted by another run on this SHA in the gap between the two calls is still
# overwritten. Nothing closes that gap, so it stays narrow — one API round trip —
# rather than the whole length of a run, which is what it was before.
post_pending_status() {
  local repo="$1" sha="$2" user="$3"
  # Declared before it is assigned on purpose: `local state=$(…)` reports
  # `local`'s own exit status, so the read's failure would go unnoticed.
  local state

  if ! state=$(signoff_state "$repo" "$sha"); then
    info "warning: could not read the current sign-off status — not posting pending"
    return 0
  fi
  if [[ "$state" == "success" ]]; then
    info "${sha:0:12} is already signed off — leaving that status in place while this run re-verifies it"
    return 0
  fi

  post_commit_status "$repo" "$sha" pending \
    "Remote sign-off in progress (triggered by ${user})…" \
    || info "warning: could not post pending sign-off status"
}

# --- commands ----------------------------------------------------------------

# Paths that can change what cargo/clippy/fmt/nextest do — Rust sources, the
# Cargo/toolchain config, and the config files the gate itself reads. Keep in
# sync with `rustAffecting` in .github/workflows/pr.yml and covered by the
# check-code-changes filter; `scripts/check_rust_gate_paths.py` enforces both,
# and docs/dev/ci_signoff.md explains why each path is here.
RUST_AFFECTING_PATH_PATTERN='(\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)rust-toolchain(\.toml)?$|(^|/)\.cargo/|(^|/)\.?(clippy|rustfmt)\.toml$|(^|/)nextest\.toml$|(^|/)layers\.toml$|^scripts/check_(crate_layers|rust_gate_paths)\.py$|^Makefile$)'

# True when the branch delta vs trunk can affect Rust lint/build/tests.
# Prints nothing. Exit 0 = has Rust-affecting changes (or unknown — run checks).
# Exit 1 = no such paths in the changed set → safe to skip.
# Unknown (diff unavailable) returns 0 so we never skip when we can't tell.
branch_has_rust_changes() {
  local revision="$1"
  local files

  if ! files=$(changed_files_vs_trunk "$revision"); then
    debug "could not list changed files — assuming Rust changes (will run checks)"
    return 0
  fi
  if ! has_content "$files"; then
    debug "no changed files vs ${LINT_BASE_BRANCH} — no Rust changes"
    return 1
  fi
  # Feed grep a here-string rather than a pipe: `grep -q` exits at the first
  # match, and once "$files" exceeds the 64 KB pipe buffer that closes the pipe
  # while the writer still has data, so the writer dies of SIGPIPE and
  # `set -o pipefail` reports the whole pipeline as failed (status 141). This
  # function would then answer "no Rust changes" for a branch that does change
  # .rs files, and sign-off would skip lint/build/tests and still post success —
  # it needs a large diff whose first matching path lands early, which is why it
  # survived on smaller branches. Same hazard as the `| head -n1` note below.
  if grep -qE "$RUST_AFFECTING_PATH_PATTERN" <<<"$files"; then
    debug "Rust-affecting files present — will run Rust checks"
    return 0
  fi
  debug "no Rust-affecting files in changed set — can skip Rust lint/build/tests"
  return 1
}

# --- disk guard ---------------------------------------------------------------
#
# A sign-off links every test binary in the workspace into a `target/` that the
# self-hosted pool shares across branches. When that volume fills, the run does
# not fail where the space ran out: nextest reports the whole suite green, and
# then the *linker* dies with `errno=28` thousands of lines later, on a crate
# the branch never touched. That failure has none of the tells of a real one —
# no `-->` source pointers, no clippy diagnostic, a passing test summary — so
# it reads as a defect in the branch, and the reader either hunts a
# nonexistent bug or re-dispatches onto the same full disk. What follows makes
# the run say which one it was: a floor it refuses to start below, a recorder
# that catches the build saying it ran out, and a free-space backstop.

# Refuse to *start* a run the volume cannot hold, rather than discovering it
# three hours in. This is headroom for linking, not an estimate of a cold
# build: `target/` is warm on the pool, so what a run actually needs is room
# for the binaries it relinks.
readonly DEFAULT_MIN_FREE_GIB=25
# At failure time, this little free space means the volume is what broke, not
# the branch. Deliberately far below the preflight floor: a genuine compile
# error on a tight-but-workable disk must not be relabelled "infrastructure",
# while the `errno=28` death this exists to catch leaves the volume at ~0.
readonly DISK_CRITICAL_GIB=2
# run_checks returns this when the preflight refuses to start.
readonly EXIT_DISK_EXHAUSTED=70
# Bash reports a foreground child killed by signal N as 128+N, and run_make_step
# returns make's own status untouched. So a status at or above this means `make`
# never reached a verdict of its own — the process tree was signalled. That is
# how a `Sign off` step reads when its `timeout-minutes` budget expires (#12518)
# and how a cancelled job reads (#12424); a recipe that genuinely fails exits 2.
readonly EXIT_SIGNAL_BASE=128
# How the linker's out-of-disk death actually reads in the run log:
# `ld: write() failed, errno=28 (No space left on device)`. Either spelling is
# enough; matching both survives a toolchain that words one of them differently.
readonly DISK_FULL_PATTERN='No space left on device|errno=28'

# Set to 1 on remote runs, where run_make_step watches build output for the
# out-of-disk signature. Separates "watched, and it was not disk" from "nothing
# watched at all", which failure_kind answers differently.
SIGNOFF_DISK_WATCH="${SIGNOFF_DISK_WATCH:-}"

# Set to 1 by run_make_step when the step it ran reported running out of disk.
#
# A shell variable rather than a file, because the signal has to survive the
# condition it reports. Recording the line by appending to a marker file needed
# an allocation at exactly the moment allocation is failing — and on macOS
# $TMPDIR and the workspace are usually the same APFS container, so there was
# nowhere to put that file that was reliably writable. An empty marker read as
# "not a disk failure", so the branch was blamed for the volume (#12427). The
# watcher's exit status needs no disk at all.
#
# Seeded from the environment so the unit tests can set up a classification
# without running a build; run_make_step resets it per step, so an inherited
# value cannot outlive a run that watched anything.
SIGNOFF_DISK_HIT="${SIGNOFF_DISK_HIT:-}"

# The status the watcher exits with to report an out-of-disk line. Deliberately
# not 1 or 2: awk uses those for its own errors, and a watcher that itself died
# must not be read as a volume that filled. Reserving a distinct status is also
# what lets run_make_step tell "ran, saw nothing" (0) from "never reached a
# verdict" (anything else), which it must not conflate — see run_make_step.
readonly DISK_WATCH_HIT_STATUS=3

# Run one `make` step, recording whether it died for want of disk. Returns
# make's own status, never the watcher's. With the watch off — every local run —
# make is invoked exactly as before, so local output is untouched.
run_make_step() {
  if [[ -z "$SIGNOFF_DISK_WATCH" ]]; then
    make "$@"
    return $?
  fi
  local status watch_status
  local -a pipe_status
  # Reset per step, so the verdict describes the step that actually failed. Left
  # to accumulate, a step that merely *mentioned* running out of disk and then
  # succeeded would still be blaming the volume for a genuine test failure two
  # steps later.
  SIGNOFF_DISK_HIT=""
  # awk rather than a captured log: it passes every line straight through and
  # keeps one bit of state, so watching costs nothing on a volume that is
  # already short of space. fflush keeps the output streaming to the Actions log
  # line by line, as it does unwatched.
  make "$@" 2>&1 | awk -v pat="$DISK_FULL_PATTERN" -v hit_status="$DISK_WATCH_HIT_STATUS" '
    $0 ~ pat { hit = 1 }
    { print; fflush() }
    END { if (hit) exit (hit_status + 0) }
  '
  # Copy the whole array in one statement: reading PIPESTATUS is itself a command,
  # so a second `x="${PIPESTATUS[1]}"` would be reading the *assignment's* status
  # and, under `set -u`, abort on the now-absent index.
  pipe_status=("${PIPESTATUS[@]}")
  status="${pipe_status[0]:-0}"
  watch_status="${pipe_status[1]:-0}"
  if [[ "$watch_status" -eq "$DISK_WATCH_HIT_STATUS" ]]; then
    SIGNOFF_DISK_HIT=1
  elif [[ "$watch_status" -ne 0 ]]; then
    # The watcher died instead of reaching a verdict: no awk on the runner, a
    # syntax error, a signal. Its silence is then not "no out-of-disk line went
    # past" — nothing reliably read the output at all — so leaving the watch
    # armed would let failure_kind assert "not disk" on the authority of a
    # watcher that never ran, which is the same mislabelling in the other
    # direction from #12427. Disarm it so classification falls back to the
    # free-space backstop, exactly as on an unwatched local run.
    info "warning: the out-of-disk watcher exited ${watch_status} rather than reporting a verdict — falling back to free-space classification"
    SIGNOFF_DISK_WATCH=""
  fi
  return "$status"
}

# True when this run watched its build output at all, i.e. the watch's verdict —
# including its "no ENOSPC line went past" — is worth something. run_make_step
# clears the flag if the watcher itself failed, so this stays false for a run
# whose watch was requested but never actually delivered a reading.
disk_watch_armed() {
  [[ -n "$SIGNOFF_DISK_WATCH" ]]
}

# True when this run's build actually reported running out of disk. This is the
# authoritative signal — unlike a free-space reading taken after the fact, it
# cannot be washed out by the partial artifacts cargo unlinks on its way out,
# and unlike a marker file it costs no allocation at the moment allocation is
# what is failing.
build_hit_disk_full() {
  [[ -n "$SIGNOFF_DISK_HIT" ]]
}

# Free space in GiB on the volume holding "$1" (default: the working tree).
# Prints an integer. Returns non-zero when df is absent or its output does not
# parse — every caller reads that as "unknown" and never as "full", so a runner
# whose df we cannot read still gets to run its sign-off.
free_disk_gib() {
  # The volume that actually holds the build output: `target/` is what fills,
  # and CARGO_TARGET_DIR can put it on a different filesystem than the checkout.
  local path="${1:-${CARGO_TARGET_DIR:-.}}" free
  command -v df >/dev/null 2>&1 || return 1
  # -P: POSIX one-line-per-filesystem output, so Available is reliably field 4
  # even when a long device name would wrap in df's default format.
  # -k: 1024-byte blocks on both macOS (whose df defaults to 512) and Linux.
  free=$(df -Pk "$path" 2>/dev/null | awk 'NR==2 { print int($4 / 1048576) }') || return 1
  [[ "$free" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$free"
}

# True when the work volume is so empty that a failure is the volume's fault
# rather than the branch's. Unknown free space answers false: without a reading
# we cannot claim infrastructure, and mislabelling a real failure is worse.
disk_is_critical() {
  local free
  free=$(free_disk_gib) || return 1
  (( free < DISK_CRITICAL_GIB ))
}

# Names what broke in a check run that did not pass, given run_checks' exit
# status: "signalled" when nothing judged the branch at all, "disk" when the work
# volume is the cause, "checks" for everything else, which is the branch. Three
# ways to reach "disk", in falling order of authority: the preflight refused to
# start, the build said so itself, or the volume is at ~0 now. The last is a
# backstop for a build whose output we did not record — a local run, or a remote
# one whose watcher died before it could read anything — which is why it is not
# the only signal.
failure_kind() {
  local check_status="$1"

  # First, because it is the one kind that says the checks reached no verdict
  # rather than which verdict they reached. The two disk signals below both
  # describe a `make` that *returned*: the preflight refusing to start (70) and
  # a build that printed ENOSPC and died. Neither can coexist with a status that
  # says make itself was killed.
  if [[ "$check_status" -ge "$EXIT_SIGNAL_BASE" ]]; then
    echo "signalled"
    return
  fi

  # The preflight's own refusal needs no corroboration.
  if [[ "$check_status" -eq "$EXIT_DISK_EXHAUSTED" ]]; then
    echo "disk"
    return
  fi

  # If we watched the build, the watch decides — both ways. No ENOSPC line means
  # the build ran out of many things but not disk, and a free-space reading must
  # not overrule that: on a shared pool another run can drag the volume under any
  # threshold while *this* branch fails for its own reasons, and calling that
  # "infrastructure" tells the author to re-dispatch a branch that will fail
  # again. Free space is consulted only when nothing watched.
  if disk_watch_armed; then
    if build_hit_disk_full; then echo "disk"; else echo "checks"; fi
    return
  fi

  if disk_is_critical; then echo "disk"; else echo "checks"; fi
}

# What to publish about a check run that did not pass, given run_checks' exit
# status, how long it ran, and who dispatched it. Sets three globals rather than
# returning a packed string, the way run_make_step reports through
# SIGNOFF_DISK_HIT:
#
#   SIGNOFF_FAILURE_STATUS_DESC  the commit-status description, or "" to publish
#                                no verdict at all
#   SIGNOFF_FAILURE_SUMMARY      the step summary
#   SIGNOFF_FAILURE_MESSAGE      what `fail` says on the way out
#
# An empty description is the whole point of the "signalled" case and is not an
# error path: see below.
SIGNOFF_FAILURE_STATUS_DESC=""
SIGNOFF_FAILURE_SUMMARY=""
SIGNOFF_FAILURE_MESSAGE=""
describe_check_failure() {
  local check_status="$1" elapsed="$2" user="$3"

  case "$(failure_kind "$check_status")" in
    signalled)
      # Publish nothing. Nothing judged this branch — the process tree was
      # signalled — so the status this run left on its way in is still the most
      # this run can honestly claim: the `pending` it posted before starting, or
      # an earlier `success` post_pending_status declined to overwrite. A leftover
      # `pending` is already what the workflow's "Resolve an incomplete sign-off"
      # step is there to describe.
      #
      # Any verdict written here would assert something nothing established:
      # "checks failed" about a suite the log shows still passing when the
      # 353-minute budget expired (#12518), on a commit that may already carry a
      # `signoff=success` an earlier run earned (#12520). Neither correction
      # handler can take it back — both are gated on `cancelled()`, and a budget
      # expiry is a *failed* step by #12343's design — so the only safe moment to
      # decline is here.
      SIGNOFF_FAILURE_STATUS_DESC=""
      SIGNOFF_FAILURE_SUMMARY="### Sign-off"$'\n'"**Did not complete** after ${elapsed}s — the run was signalled (its step budget expired, or the job was stopped), so **the checks reached no verdict** and no failure status is published. Nothing reported a failure; equally, nothing cleared the branch. The \`${STATUS_CONTEXT}\` status stands as this run left it — the \`pending\` posted at the start, or an earlier \`success\` this run declined to overwrite. Sign off again: a branch that repeatedly exhausts the budget is either contending for the pool or has lengthened the build itself."$'\n'
      SIGNOFF_FAILURE_MESSAGE="sign-off did not complete: the run was signalled after ${elapsed}s, so the checks reached no verdict — sign off again"
      ;;
    disk)
      # An out-of-disk run says nothing useful by default — the commit status is
      # all most readers see, so it has to carry the distinction itself.
      SIGNOFF_FAILURE_STATUS_DESC="Runner out of disk after ${elapsed}s — checks did not complete, re-dispatch (triggered by ${user})"
      SIGNOFF_FAILURE_SUMMARY="### Sign-off"$'\n'"**Infrastructure failure** after ${elapsed}s — the build ran out of disk on the runner work volume, so **the checks did not complete**. Re-dispatch once the runner has space. Only if this recurs for one branch alone is the diff worth suspecting: a build script or dependency change can consume the volume by itself."$'\n'
      SIGNOFF_FAILURE_MESSAGE="sign-off aborted: the runner ran out of disk (the checks did not complete)"
      ;;
    *)
      SIGNOFF_FAILURE_STATUS_DESC="Sign-off checks failed after ${elapsed}s (triggered by ${user})"
      SIGNOFF_FAILURE_SUMMARY="### Sign-off"$'\n'"**Failed** after ${elapsed}s."$'\n'
      SIGNOFF_FAILURE_MESSAGE="sign-off checks failed"
      ;;
  esac
}

# Stop before the Rust checks when the work volume cannot hold them. Fatal only
# on a remote run — that shared pool is where this happens, and it is where a
# wasted run costs hours. A local run just warns: a developer's own disk is
# theirs to manage, and blocking their sign-off on a floor tuned for the pool
# would be wrong.
preflight_disk() {
  local free min="${SIGNOFF_MIN_FREE_GIB:-$DEFAULT_MIN_FREE_GIB}"

  if [[ ! "$min" =~ ^[0-9]+$ ]]; then
    info "warning: SIGNOFF_MIN_FREE_GIB='${min}' is not an integer — using ${DEFAULT_MIN_FREE_GIB}"
    min="$DEFAULT_MIN_FREE_GIB"
  fi
  # Force base 10: bash arithmetic reads a leading zero as octal, so a
  # well-meaning `SIGNOFF_MIN_FREE_GIB=08` is an arithmetic error, not 8.
  min=$((10#$min))

  if ! free=$(free_disk_gib); then
    debug "could not measure free disk space — skipping the preflight check"
    return 0
  fi

  debug "free space on the work volume: ${free} GiB (floor ${min} GiB)"
  if (( free >= min )); then
    return 0
  fi

  if ! is_remote_run; then
    info "warning: only ${free} GiB free here and sign-off wants ${min} GiB — the build may die at the linker"
    return 0
  fi

  info "${NO} Only ${free} GiB free on the work volume; a sign-off needs ${min} GiB."
  info "  The branch was not evaluated. Reclaim space on this runner and re-dispatch."
  # An Actions annotation as well as the step summary. Reached from the standalone
  # `preflight-disk` step there is no commit status yet to carry the distinction —
  # the pending status is posted later, inside the sign-off run — so the run page
  # is the only place an operator can learn this was the volume and not the diff.
  echo "::error title=Runner out of disk::Only ${free} GiB free on the work volume, below the ${min} GiB floor. The branch was not evaluated: reclaim space on this runner and re-dispatch."
  append_step_summary "### Preflight: not enough disk"$'\n'"Only **${free} GiB** free on the runner work volume, below the **${min} GiB** floor, so the Rust checks did not run and **the branch was not evaluated**. This is an infrastructure failure, not a code failure: reclaim space on this runner (\`target/\` is shared across branches) and re-dispatch. Adjust the floor with \`SIGNOFF_MIN_FREE_GIB\`."$'\n'
  return "$EXIT_DISK_EXHAUSTED"
}

# Unit tests for the packages a branch touched, run before the full workspace
# lint. A broken test in the crate you just edited is the likeliest failure, and
# it would otherwise surface only after the longest step in the gate.
# Bin-only packages are dropped (see packages_with_lib_targets); everything the
# targeted run skips is still covered by the full `nextest` run later.
run_targeted_tests() {
  local packages="$1"
  local features="${2:-}"
  local test_packages

  if [[ -n "${SIGNOFF_SKIP_TARGETED_TESTS:-}" ]]; then
    info "SIGNOFF_SKIP_TARGETED_TESTS set — skipping targeted unit tests"
    return 0
  fi

  test_packages=$(packages_with_lib_targets "$packages" || true)
  if ! has_content "$test_packages"; then
    debug "no changed packages with a library target — skipping targeted unit tests"
    append_step_summary "### Targeted unit tests"$'\n'"Skipped (no changed packages with a library target)."$'\n'
    return 0
  fi

  # The features were resolved for the full changed set, which can name crates
  # dropped just above. Naming a feature for a package outside the `-p`
  # selection is a hard cargo error ("the package 'x' does not contain this
  # feature: y/z"), so a branch touching a library crate and a bin-only one
  # (runtime + testoperator) would fail the run outright.
  features=$(features_for_packages "$features" "$test_packages")

  info "Targeted unit tests for changed packages: ${test_packages}"
  info "  (make nextest-packages PACKAGES=\"${test_packages}\")"
  append_step_summary "### Targeted unit tests"$'\n'"Packages: \`${test_packages}\`"$'\n'
  # Explicit `|| return` so failures short-circuit even when the caller has
  # temporarily disabled `set -e` (see cmd_signoff).
  run_make_step nextest-packages PACKAGES="$test_packages" FEATURES="$features" || return $?
  info "Targeted unit tests passed."
}

# Run the same fast checks the old PR build ran: lint + build + unit tests.
# The heavier suite (release build, integration, e2e, ...) runs in the merge
# queue, so it deliberately isn't part of the local sign-off.
#
# Fail-fast order:
#   0. Skip all Rust work when the branch has no Rust-affecting files vs trunk
#   1. Targeted lint on packages touched by the branch (fast feedback)
#   2. Targeted unit tests for those packages (fast feedback)
#   3. Full workspace lint (the real gate)
#   4. CLI build + unit tests
#
# Steps 1-2 cover the crate you actually edited before step 3, the longest step,
# so its likeliest failures surface in minutes instead of at the end. They build
# it with the features the workspace resolves for it, so they exercise the same
# code the gate will rather than a scoped-only configuration;
# SIGNOFF_SKIP_TARGETED_LINT and SIGNOFF_SKIP_TARGETED_TESTS opt out.
#
# Sets SIGNOFF_CHECK_SUMMARY (short phrase for the commit-status description).
# Output streams straight to the terminal — call this bare, never `$(run_checks)`,
# which would capture make's stdout.
run_checks() {
  local revision="${1:-}"
  local packages=""
  local features=""

  # Non-Rust-only changes (docs, YAML, scripts, …): still attest, but skip the
  # expensive lint/build/test gate. Unknown diffs fall through and run checks.
  if [[ -n "$revision" ]] && ! branch_has_rust_changes "$revision"; then
    info "No Rust-affecting files changed vs ${LINT_BASE_BRANCH} — skipping Rust lint, build, and unit tests"
    # Name the pattern rather than a subset of what it matches: the two drift apart
    # every time a path is added to the gate.
    append_step_summary "### Rust checks"$'\n'"Skipped (nothing in the branch diff vs \`${LINT_BASE_BRANCH}\` matches \`RUST_AFFECTING_PATH_PATTERN\` in \`scripts/signoff\`)."$'\n'
    SIGNOFF_CHECK_SUMMARY="no Rust changes (lint/test skipped)"
    return 0
  fi

  # Deliberately after the Rust-changes skip: a docs-only sign-off compiles
  # nothing, so a full volume is no reason to refuse it.
  preflight_disk || return $?

  if [[ -z "${SIGNOFF_SKIP_TARGETED_LINT:-}" && -n "$revision" ]]; then
    packages=$(changed_workspace_packages "$revision" || true)
  fi

  if [[ -n "$packages" ]]; then
    # Build these crates the way the workspace builds them, not the way they
    # build alone — see workspace_features_for_packages. An empty result (no
    # python3, cargo metadata unavailable) falls back to package defaults, which
    # is the old behavior rather than a hard failure.
    features=$(workspace_features_for_packages "$packages" || true)
    info "Targeted pre-lint for changed packages: ${packages}"
    if [[ -n "$features" ]]; then
      info "  (workspace-resolved features: $(printf '%s' "$features" | tr ',' '\n' | wc -l | tr -d ' '))"
      debug "targeted features: ${features}"
    else
      info "  (no resolved features available — falling back to package defaults)"
    fi
    append_step_summary "### Targeted pre-lint"$'\n'"Packages: \`${packages}\`"$'\n'
    # FEATURES is set explicitly so a user-exported value cannot reintroduce a
    # workspace-only set. Explicit `|| return` so failures short-circuit even
    # when the caller has temporarily disabled `set -e` (see cmd_signoff).
    run_make_step lint-rust PACKAGES="$packages" FEATURES="$features" || return $?
    info "Targeted pre-lint passed."
    run_targeted_tests "$packages" "$features" || return $?
    info "Running full workspace lint…"
  else
    info "No changed workspace packages detected (or targeted lint skipped) — running full workspace lint…"
    append_step_summary "### Targeted pre-lint"$'\n'"Skipped (no changed workspace packages, or unavailable base/diff)."$'\n'
  fi

  info "Running Rust lint (make lint-rust)…"
  # Clear PACKAGES/FEATURES so a user-exported env cannot scope or re-feature
  # the full gate; empty values leave the Makefile on its workspace defaults.
  run_make_step lint-rust PACKAGES= FEATURES= || return $?

  # build-cli-dev, not build-cli: the release CLI build shares no artifacts with
  # the profile the lint and test passes just warmed, so it recompiles its whole
  # graph (~590 crates, DataFusion and Arrow among them) to prove the binary
  # links. The merge queue's required `Build (release profile)` job builds the
  # CLI, spiced, and the release install for real, so release-only breakage is
  # still caught before trunk.
  info "Building the CLI and running unit tests (make build-cli-dev nextest)…"
  run_make_step build-cli-dev nextest || return $?

  SIGNOFF_CHECK_SUMMARY="lint+test passed"
}

# The PR's `Attestation` job (pr.yml) only re-reads the `signoff` commit status
# when its workflow run executes: pr.yml triggers on `pull_request`,
# `merge_group` and `workflow_dispatch`, never on a status change. So a run that
# already completed keeps whatever verdict it reached, however the status has
# moved since. Re-run that job instead of making the developer open or refresh
# the PR by hand. `gh` is already required by require_tools() before cmd_signoff
# can reach this point, but the check stays here so this function remains
# correct if it's ever called on its own.
#
# A run that concluded `success` needs no refresh when this sign-off also
# succeeded — but it needs one precisely when the sign-off failed, or the gate
# keeps reporting an attestation this run just overturned. Pass a non-empty
# third argument to force the re-run past that short-circuit.
refresh_attestation_check() {
  local sha="$1" repo="$2" force="${3:-}"
  # pr.yml runs on `pull_request`/`merge_group`/`workflow_dispatch`, so viewing
  # the PR page does not start one — say what actually re-reads the status.
  local fallback="Re-run the PR's 'Attestation' check from the Checks tab once it has reported — reloading the PR page does not re-read the sign-off status."
  local run run_id run_status run_conclusion pr_heads head heads_short=""
  local -a head_list=()

  if ! command -v gh >/dev/null 2>&1; then
    info "  Install the GitHub CLI (https://cli.github.com) so signoff can auto-refresh the 'Attestation' check."
    info "  ${fallback}"
    return 0
  fi

  # Only refresh while $sha is still a PR head. A remote sign-off can run for
  # hours (the job budget is 358 minutes), so the branch may have advanced
  # underneath it — and re-running the *stale* commit's pr.yml run then cancels
  # the current head's in-flight one: pr.yml's concurrency group is
  # `pr-<ref_name>-<ref_name == 'trunk' && sha || 'any-sha'>`, and on a
  # pull_request event ref_name is `<number>/merge` while the SHA term collapses
  # to the literal `any-sha`, so every attempt for a PR shares one group whatever
  # its commit. The re-run also keeps its original event payload, so the verdict
  # it publishes is computed for the stale commit.
  #
  # Fixing it here rather than by making that group SHA-specific: the shared group
  # is deliberate — it is what lets a new push cancel the run for the commit it
  # superseded. A stale sign-off has nothing to propagate anyway (its status sits
  # on a commit no longer under review), so skipping is the whole fix. See #12360.
  #
  # `gh --jq` (gh's built-in filter), not the jq binary: this path runs from
  # cmd_signoff, which requires gh but not jq.
  pr_heads=$(gh api "repos/${repo}/commits/${sha}/pulls" \
    --jq '[.[] | select(.state == "open") | .head.sha] | join(" ")' 2>/dev/null) || pr_heads=""
  # Empty means "no open PR yet" or "the lookup failed"; both fall through to the
  # original behaviour, since signing off before the PR exists is ordinary and a
  # blipped lookup is no reason to skip a refresh that would have worked. The
  # membership test is space-delimited so a short SHA cannot partially match.
  if [[ -n "$pr_heads" && " ${pr_heads} " != *" ${sha} "* ]]; then
    # "not the head of any open PR", not "no longer the head of its PR": a commit
    # can belong to several open PRs, so name every current head rather than
    # implying there is one. `read -ra` rather than an unquoted `for` so the split
    # cannot glob, regardless of what the API returned.
    read -ra head_list <<<"$pr_heads"
    for head in "${head_list[@]}"; do
      heads_short="${heads_short:+${heads_short}, }${head:0:12}"
    done
    info "  ${sha:0:12} is not the head of any open PR that contains it (PR heads: ${heads_short}) — not refreshing 'Attestation'."
    info "  Re-running this commit's check would cancel the current head's, and would report a verdict for the wrong commit."
    info "  Sign off on the current head instead."
    return 0
  fi

  run=$(gh run list --repo "$repo" --commit "$sha" --workflow pr.yml --event pull_request \
    --json databaseId,status,conclusion --jq 'first(.[]) | "\(.databaseId) \(.status) \(.conclusion)"' 2>/dev/null) \
    || { debug "could not list 'pr' workflow runs for ${sha} on ${repo}"; info "  ${fallback}"; return 0; }

  read -r run_id run_status run_conclusion <<<"$run"
  # A missing run renders as an empty string, but an empty `--jq` match can
  # also render as the literal word "null" for each field — check run_id
  # looks like a real numeric database id rather than trusting non-emptiness.
  if [[ ! "$run_id" =~ ^[0-9]+$ ]]; then
    debug "no 'pr' workflow run found yet for ${sha} — nothing to refresh"
    info "  ${fallback}"
    return 0
  fi
  if [[ "$run_status" != "completed" ]]; then
    # A run that is still going may already have read the status — the read is
    # the first thing its job does, and validating an inherited sign-off keeps
    # it busy long after. So "it will evaluate the sign-off once it finishes"
    # holds only when the status it is about to report is the one we want; on
    # the failure path an in-flight run can still land green on what it read
    # before this verdict existed, and there is nothing to re-run yet.
    if [[ -n "$force" ]]; then
      info "  The 'Attestation' check (run ${run_id}) is still ${run_status} and may have read the previous sign-off already."
      info "  Re-run it once it finishes if it lands green — this sign-off failed."
    else
      info "  The 'Attestation' check (run ${run_id}) is still ${run_status} — it will evaluate the sign-off once it finishes."
    fi
    return 0
  fi
  if [[ "$run_conclusion" == "success" && -z "$force" ]]; then
    debug "run ${run_id} already succeeded — nothing to refresh"
    return 0
  fi

  # Not `--failed`: that only reruns jobs with conclusion=failure and no-ops
  # on cancelled/skipped runs. Rerunning the whole run is fine here — on a
  # `pull_request` event, pr.yml executes nothing but the Attestation job.
  local outcome="it will turn green shortly"
  [[ -z "$force" ]] || outcome="it will pick up the failed sign-off"
  if gh run rerun "$run_id" --repo "$repo" >/dev/null 2>&1; then
    echo "  Re-ran the 'Attestation' check (run ${run_id}) — ${outcome}."
  else
    info "  Could not auto-refresh the 'Attestation' check — ${fallback}"
  fi
}

# Post this run's failing verdict, then make the gate reflect it.
#
# The raw `signoff` status is not itself a required check — `Attestation` is,
# and it only re-reads the status when its pr.yml run executes. A commit that
# was already attested therefore keeps a green `Attestation` after a later run
# overturns it, and the branch can still enter the merge queue on an attestation
# this run contradicted. The merge queue re-runs the full suite, so that cannot
# put broken code on trunk; it spends a queue slot learning what the sign-off
# already knew. Hence the forced refresh — the inverse of the success path,
# which is right to skip a run that already passed.
#
# When the post itself fails the commit still carries whatever it had before, so
# there is nothing new for a re-run to read: warn and leave the check alone. The
# caller aborts either way, with the more useful message.
# `description` rather than user+elapsed: the caller already decides what the
# failure was — an out-of-disk runner reads differently from a failing branch —
# and the commit status is all most readers see, so that wording has to reach
# them intact.
post_failure_status() {
  local repo="$1" sha="$2" description="$3"

  if ! post_commit_status "$repo" "$sha" failure "$description"; then
    info "warning: could not post the failed sign-off status — the 'Attestation' check still reflects the previous sign-off"
    return 0
  fi
  refresh_attestation_check "$sha" "$repo" force
}

cmd_signoff() {
  local force=false verify=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force)     force=true;  shift ;;
      --no-verify)    verify=false; shift ;;
      -h|--help)      cmd_help; exit 0 ;;
      *)              fail "unknown option: $1 (see: scripts/signoff --help)" ;;
    esac
  done

  require_tools

  local revision sha user repo description start via elapsed
  revision=$(current_revision "$force")
  $force || ensure_clean_and_pushed "$revision"
  sha=$(revision_sha "$revision") || fail "could not resolve ${revision}"
  # Remote workflow passes the human who dispatched the run (SIGNOFF_ACTOR).
  # Otherwise: `gh api user` needs a user-scoped token; under a CI GITHUB_TOKEN
  # it 403s and can echo the error body to stdout, so accept its result only if
  # it looks like a GitHub login. Then fall back to the CI actor (set in
  # Actions) or the VCS-configured name (which may contain spaces — fine for a
  # description).
  user="${SIGNOFF_ACTOR:-}"
  if [[ -z "$user" ]]; then
    user=$(gh api user --jq .login 2>/dev/null || true)
    if [[ ! "$user" =~ ^[A-Za-z0-9-]{1,39}$ ]]; then
      user="${GITHUB_ACTOR:-$(local_user_name 2>/dev/null || true)}"
    fi
  fi
  [[ -n "$user" ]] || user="unknown"
  repo=$(repo_slug)
  via=""
  is_remote_run && via=" via remote"

  if $verify; then
    local check_status=0
    # Default summary; run_checks overwrites on success (incl. Rust-skip path).
    SIGNOFF_CHECK_SUMMARY="lint+test passed"
    start=$(date +%s)
    if is_remote_run; then
      post_pending_status "$repo" "$sha" "$user"
      # Watch for out-of-disk lines from here on, so a failure can say whether
      # the volume or the branch was at fault. Remote only: a local run's output
      # then stays byte-for-byte what it is today. Arming cannot fail — there is
      # no file to create and so nothing to clean up on exit.
      SIGNOFF_DISK_WATCH=1
    fi
    # Capture status without wrapping in `if`/`||` (those also disable set -e
    # for the LHS). run_checks uses explicit `|| return` so make failures still
    # short-circuit under the temporary `set +e` used for status capture.
    set +e
    run_checks "$revision"
    check_status=$?
    set -e
    if [[ "$check_status" -ne 0 ]]; then
      elapsed=$(( $(date +%s) - start ))
      describe_check_failure "$check_status" "$elapsed" "$user"
      if is_remote_run; then
        # An empty description means this run reached no verdict, so it has none
        # to publish — leaving the status it posted at the start untouched. The
        # summary still goes out: it is where an operator reads *why* the run
        # ended without one.
        if [[ -n "$SIGNOFF_FAILURE_STATUS_DESC" ]]; then
          post_failure_status "$repo" "$sha" "$SIGNOFF_FAILURE_STATUS_DESC"
        fi
        append_step_summary "$SIGNOFF_FAILURE_SUMMARY"
      fi
      fail "$SIGNOFF_FAILURE_MESSAGE"
    fi
    elapsed=$(( $(date +%s) - start ))
    description="Signed off by ${user}${via} — ${SIGNOFF_CHECK_SUMMARY} in ${elapsed}s"
  else
    description="Signed off by ${user}${via} (checks not verified locally)"
  fi

  post_commit_status "$repo" "$sha" success "$description" \
    || fail "failed to post the sign-off status (do you have write access to ${repo}?)"

  append_step_summary "### Sign-off"$'\n'"**Success** on \`${sha:0:12}\` — ${description}"$'\n'

  echo "${OK} Signed off on ${sha:0:12} — ${description}"
  refresh_attestation_check "$sha" "$repo"
}

# Run the disk preflight on its own, for the workflow to call *before* the
# toolchain setup steps.
#
# The guard reached through `run_checks` sits behind Rust, Nextest, sccache,
# protoc, cc and spiceio setup, so a volume that was already below the floor
# spent all of that first, and a volume that filled during those steps produced
# an ordinary red job with none of the labelling (#12427). Running the same floor
# check as the first step after checkout stops the already-full case immediately
# and says why. It cannot catch a volume that fills mid-setup — that would need
# the setup actions to report it — so this narrows the gap rather than closing it.
#
# Same floor, same `SIGNOFF_MIN_FREE_GIB` override, same remote-only fatality as
# the in-run preflight, because it is the same function.
cmd_preflight_disk() {
  preflight_disk
}

cmd_status() {
  require_tools
  require_jq
  local revision sha repo combined state desc
  revision=$(current_revision)
  sha=$(revision_sha "$revision")
  repo=$(repo_slug)
  # Fetch the combined status once, then pick the first matching entry with jq.
  # (Piping `gh --jq ... | head -n1` would SIGPIPE the writer under pipefail.)
  # Fail on a real API error rather than falling back to {} → "not signed off".
  combined=$(gh api "repos/${repo}/commits/${sha}/status") \
    || fail "failed to read commit status for ${sha} on ${repo} (auth/rate-limit/network?)"
  state=$(jq -r "first(.statuses[]? | select(.context==\"${STATUS_CONTEXT}\") | .state) // \"\"" <<<"$combined")
  if [[ "$state" == "success" ]]; then
    desc=$(jq -r "first(.statuses[]? | select(.context==\"${STATUS_CONTEXT}\") | .description) // \"\"" <<<"$combined")
    echo "${OK} ${sha:0:12} is signed off — ${desc}"
  else
    echo "${NO} ${sha:0:12} is not signed off — run: make signoff"
    exit 1
  fi
}

# Replace a `pending` sign-off status with a failure.
#
# A remote run posts `pending` before it starts the checks, so a run that never
# reaches a verdict — the job is terminated at its budget, the runner goes away —
# leaves that `pending` on the commit for good. `status` and `mine` then render
# the branch as a sign-off still in progress, which is the one thing it is not.
#
# Only `pending` is replaced. A run that finished has already posted its own
# success or failure, and overwriting that would discard the real verdict; the
# same guard makes this safe to run unconditionally at the end of a job.
#
# Read-then-write, and commit statuses have no compare-and-set, so a verdict
# posted in the gap between the two calls is overwritten. Nothing closes that
# gap — an ownership token in the status would still be read before the write —
# so keep it narrow instead: this is one API round trip, and the caller runs it
# once, at the end of a run that has already stopped working.
cmd_clear_pending() {
  local reason="${1:-Sign-off run ended before the checks completed — sign off again}"
  require_tools

  local revision sha repo state
  revision=$(current_revision true)
  sha=$(revision_sha "$revision") || fail "could not resolve ${revision}"
  repo=$(repo_slug)
  state=$(signoff_state "$repo" "$sha") \
    || fail "failed to read commit status for ${sha} on ${repo} (auth/rate-limit/network?)"

  if [[ "$state" != "pending" ]]; then
    info "${STATUS_CONTEXT} on ${sha:0:12} is '${state}' — leaving it alone"
    return 0
  fi

  post_commit_status "$repo" "$sha" failure "$reason" \
    || fail "failed to post the sign-off status (do you have write access to ${repo}?)"
  append_step_summary "### Sign-off"$'\n'"**Incomplete** on \`${sha:0:12}\` — ${reason}"$'\n'
  echo "${NO} ${sha:0:12} — ${reason}"
}

# Truncate to at most `n` display columns, adding an ellipsis when cut.
truncate_str() {
  local s="$1" n="$2"
  if (( ${#s} > n )); then
    printf '%s…' "${s:0:$((n - 1))}"
  else
    printf '%s' "$s"
  fi
}

# One line per PR: colored icon, PR number, a Remote Sign-off run id when one
# is relevant (blank-padded when there isn't one, so the title column stays
# aligned), and the title (truncated to the terminal width). `running`=1
# means a run is currently queued/in_progress on this branch (necessarily for
# its current tip, since the workflow checks out the ref live); otherwise
# `run_id`, if set, is the most recent *failed* run for a `failure`/`error`
# state, so you can jump straight to its logs instead of re-triggering blind.
print_pr_row() {
  local number="$1" title="$2" state="$3" run_id="$4" running="$5" width="$6"
  local icon room run_col run_color

  if [[ "$running" == "1" ]]; then
    icon="${C_YELLOW}⟳${C_RESET}"
    run_color="$C_YELLOW"
  else
    case "$state" in
      success)       icon="${C_GREEN}${OK}${C_RESET}" ;;
      pending)       icon="${C_YELLOW}…${C_RESET}" ;;
      failure|error) icon="${C_RED}${NO}${C_RESET}" ;;   # a sign-off attempt ran and failed
      *)             icon="${C_DIM}○${C_RESET}" ;;       # none: never attempted
    esac
    run_color="$C_RED"
  fi

  if [[ -n "$run_id" ]]; then
    run_col="${run_color}$(printf '%-12s' "$run_id")${C_RESET}"
  else
    run_col="$(printf '%-12s' '')"
  fi

  room=$(( width - 22 ))  # icon(1) + space + "#NNNNN"(6) + space + run id(12) + 2 spaces
  (( room < 20 )) && room=20
  printf '%s %-6s %s %s\n' "$icon" "#${number}" "$run_col" "$(truncate_str "$title" "$room")"
}

# List the sign-off/attestation status of every open PR authored by the
# authenticated user, one row per PR, including whether a Remote Sign-off run
# is currently in flight for that PR's branch.
cmd_mine() {
  require_tools
  require_jq

  local repo prs count
  repo=$(repo_slug)

  prs=$(gh pr list --repo "$repo" --author @me --state open \
    --json number,title,headRefName,headRefOid) \
    || fail "failed to list your open PRs on ${repo} (auth/rate-limit/network?)"
  count=$(jq 'length' <<<"$prs")
  if [[ "$count" -eq 0 ]]; then
    echo "${C_DIM}No open PRs authored by you on ${repo}.${C_RESET}"
    return 0
  fi

  # Fetch in-flight Remote Sign-off runs once for all PRs, not once per PR.
  # Match on displayTitle, not headBranch: a workflow_dispatch run's headBranch
  # is the ref it was dispatched *against* (always trunk here — cmd_remote
  # doesn't pass --ref), not the `branch` input. signoff.yml's `run-name:
  # Remote Sign-off (${{ inputs.branch }})` puts the actual branch in the
  # title instead, so we match on that exact string.
  local remote_runs
  remote_runs=$(gh run list --repo "$repo" --workflow signoff.yml \
    --json displayTitle,status,conclusion,databaseId --limit 50) || remote_runs="[]"

  local width
  width=$(tput cols 2>/dev/null) || width=100

  echo "${C_BOLD}${repo}${C_RESET} — ${count} open PR(s)"
  echo

  local i pr number title branch sha combined state run_id running
  for ((i = 0; i < count; i++)); do
    pr=$(jq -c ".[$i]" <<<"$prs")
    number=$(jq -r '.number' <<<"$pr")
    title=$(jq -r '.title' <<<"$pr")
    branch=$(jq -r '.headRefName' <<<"$pr")
    sha=$(jq -r '.headRefOid' <<<"$pr")

    combined=$(gh api "repos/${repo}/commits/${sha}/status" 2>/dev/null) || combined='{}'
    state=$(jq -r "first(.statuses[]? | select(.context==\"${STATUS_CONTEXT}\") | .state) // \"none\"" <<<"$combined")

    running=0
    run_id=$(jq -r --arg title "Remote Sign-off (${branch})" \
      '[.[] | select(.displayTitle == $title and (.status == "in_progress" or .status == "queued"))][0].databaseId // empty' \
      <<<"$remote_runs")
    if [[ -n "$run_id" ]]; then
      running=1
    elif [[ "$state" == "failure" || "$state" == "error" ]]; then
      # Most recent completed+failed run for this branch, so a failed
      # attestation links straight to its logs instead of a bare icon.
      run_id=$(jq -r --arg title "Remote Sign-off (${branch})" \
        '[.[] | select(.displayTitle == $title and .status == "completed" and .conclusion == "failure")][0].databaseId // empty' \
        <<<"$remote_runs")
    fi

    print_pr_row "$number" "$title" "$state" "$run_id" "$running" "$width"
  done

  echo
  echo "${C_DIM}○ not attested   ${NO} attestation failed   … pending   ⟳ remote sign-off running   ${OK} attested${C_RESET}"
  echo "${C_DIM}Sign off with: make signoff  (or: scripts/signoff remote)${C_RESET}"
}

# Resolve the ruleset id for TARGET_BRANCH by name. `first(...)` returns a single
# id inside jq — avoids `head`, which SIGPIPEs the writer under pipefail.
ruleset_id() {
  local repo="$1" rulesets
  rulesets=$(gh api "repos/${repo}/rulesets") \
    || fail "failed to list rulesets on ${repo} (auth/rate-limit/network?)"
  jq -r "first(.[] | select(.name==\"${TARGET_BRANCH}\") | .id) // empty" <<<"$rulesets"
}

cmd_check() {
  require_tools
  require_jq
  local repo id ruleset checks
  repo=$(repo_slug)
  id=$(ruleset_id "$repo")
  [[ -n "$id" ]] || fail "no ruleset named '${TARGET_BRANCH}' on ${repo}"
  # Fail loudly on an API error instead of reporting "not required" — a swallowed
  # auth/rate-limit/network error would otherwise look like a missing sign-off gate.
  ruleset=$(gh api "repos/${repo}/rulesets/${id}") \
    || fail "failed to read ruleset ${id} on ${repo} (auth/rate-limit/network?)"
  checks=$(jq -r '.rules[]? | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context' <<<"$ruleset")
  if grep -qx "Attestation" <<<"$checks"; then
    echo "${OK} '${TARGET_BRANCH}' requires developer sign-off (Attestation). Required checks:"
  else
    echo "${NO} '${TARGET_BRANCH}' does not yet require sign-off. Run: scripts/signoff install --yes"
  fi
  # `|| true`: bullet returns non-zero on an empty list, which under pipefail
  # would otherwise make this (last) statement exit the command non-zero.
  echo "$checks" | bullet "  - " || true
}

cmd_install() {
  local apply=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) apply=true; shift ;;
      -h|--help) cmd_help; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
  done

  require_tools
  require_jq
  local repo id ruleset
  repo=$(repo_slug)
  id=$(ruleset_id "$repo")
  [[ -n "$id" ]] || fail "no ruleset named '${TARGET_BRANCH}' on ${repo} (create it in the repo settings first)"
  # Fetch the ruleset once; both the preview and the PUT body derive from it.
  ruleset=$(gh api "repos/${repo}/rulesets/${id}") \
    || fail "failed to read ruleset ${id} on ${repo}"

  info "Ruleset '${TARGET_BRANCH}' (id ${id}) on ${repo}"
  info ""
  info "Current required checks:"
  jq -r '.rules[]? | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context' <<<"$ruleset" \
    | bullet "  - " >&2 || info "  (none)"
  info ""
  info "New required checks:"
  printf '%s\n' "${REQUIRED_CHECKS[@]}" | bullet "  + " >&2

  if ! $apply; then
    info ""
    info "Dry run. Re-run with --yes to apply:  scripts/signoff install --yes"
    return 0
  fi

  # Swap only the required_status_checks array, preserving every other rule
  # (pull_request approvals, merge_queue, etc.).
  local desired body
  desired=$(jq -n --argjson iid "$ACTIONS_INTEGRATION_ID" \
    '$ARGS.positional | map({context: ., integration_id: $iid})' --args "${REQUIRED_CHECKS[@]}")
  body=$(jq --argjson checks "$desired" '
    {
      name,
      target,
      enforcement,
      conditions,
      bypass_actors: (.bypass_actors // []),
      rules: (
        if any((.rules // [])[]; .type == "required_status_checks")
        then (.rules | map(
          if .type == "required_status_checks"
          then (.parameters.required_status_checks = $checks)
          else . end
        ))
        else ((.rules // []) + [{
          type: "required_status_checks",
          parameters: {
            strict_required_status_checks_policy: false,
            do_not_enforce_on_create: false,
            required_status_checks: $checks
          }
        }])
        end
      )
    }' <<<"$ruleset")

  echo "$body" | gh api --method PUT "repos/${repo}/rulesets/${id}" --input - >/dev/null \
    || fail "failed to update ruleset ${id} (need admin on ${repo})"
  echo "${OK} '${TARGET_BRANCH}' now requires developer sign-off + the full merge-queue suite."
}

# Dispatch remote sign-off for the current branch (Git or JJ) on the GitHub
# Actions Remote Sign-off workflow. Deliberately never SSH: ad-hoc hosts run
# unaccountable checks, and the LAN lab boxes double as benchmark machines —
# a workspace build there mid-run silently corrupts the measurement.
# Branch names are validated to a safe charset so they cannot break shell
# quoting or the workflow input parser.
cmd_remote() {
  require_tools

  local branch
  if [[ "$VCS" == "jj" ]]; then
    # Prefer a local bookmark on @, then on the selected remote tip revision.
    # Take the first line without `head` (SIGPIPE under pipefail).
    local bookmarks
    bookmarks=$(jj --color=never --no-pager log -r '@ & bookmarks()' --no-graph \
      -T 'local_bookmarks.map(|b| b.name()).join("\n")' 2>/dev/null || true)
    branch="${bookmarks%%$'\n'*}"
    if [[ -z "$branch" ]]; then
      local revision
      revision=$(current_revision false)
      bookmarks=$(jj --color=never --no-pager log -r "${revision} & bookmarks()" --no-graph \
        -T 'local_bookmarks.map(|b| b.name()).join("\n")' 2>/dev/null || true)
      branch="${bookmarks%%$'\n'*}"
    fi
    [[ -n "$branch" ]] \
      || fail "no JJ bookmark on the working-copy tip — bookmark the change, or: gh workflow run signoff.yml -f branch=<name>"
  else
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    [[ -n "$branch" && "$branch" != "HEAD" ]] \
      || fail "not on a named Git branch — check out a branch, or: gh workflow run signoff.yml -f branch=<name>"
  fi

  # Mirror the workflow input validation: allow feature/foo, reject whitespace,
  # quotes, and path tricks so -f branch=… cannot be broken by the name.
  if [[ "$branch" =~ [[:space:]] || "$branch" == -* || "$branch" == /* || "$branch" == *..* \
      || "$branch" == *\"* || "$branch" == *\'* || "$branch" == *\$* || "$branch" == *\`* ]]; then
    fail "refusing to dispatch Remote Sign-off for unsafe branch name: '${branch}'"
  fi
  if [[ ! "$branch" =~ ^[A-Za-z0-9._/-]+$ ]]; then
    fail "refusing to dispatch Remote Sign-off for invalid branch name: '${branch}'"
  fi

  local repo
  repo=$(repo_slug) || fail "could not resolve GitHub repo for workflow dispatch"

  info "Dispatching GitHub Actions Remote Sign-off for ${branch} on ${repo}…"
  # --repo so non-colocated JJ workspaces (no .git) still resolve the remote;
  # --raw-field avoids shell re-quoting pitfalls; the branch was validated above.
  gh workflow run signoff.yml --repo "$repo" --raw-field "branch=${branch}" \
    || fail "failed to dispatch signoff.yml"
  echo "${OK} Dispatched. Watch with: gh run watch --repo ${repo} --workflow signoff.yml"
}

cmd_help() {
  cat >&2 <<EOF
scripts/signoff ${VERSION} — local CI attestation for Spice.ai

Developers:
  make signoff                 Run lint + unit tests, then sign off on HEAD
  make signoff-remote          Dispatch GHA Remote Sign-off for the current branch
  scripts/signoff remote       Same as make signoff-remote (Git + JJ)
  scripts/signoff -f           Sign off even with a dirty/unpushed tree
  scripts/signoff --no-verify  Sign off without running checks (honor system)
  scripts/signoff status       Show the sign-off status of HEAD
  scripts/signoff mine         Show attestation status for all your open PRs
  scripts/signoff clear-pending [reason]
                               Replace a left-behind '${STATUS_CONTEXT}' pending status
                               on HEAD with a failure (no-op for any other state)

CI (.github/workflows/signoff.yml):
  scripts/signoff preflight-disk
                               Check the work volume against the ${DEFAULT_MIN_FREE_GIB} GiB floor
                               before the toolchain setup steps run; fatal only
                               on a remote run (override: SIGNOFF_MIN_FREE_GIB)

Maintainers:
  scripts/signoff check        Show whether '${TARGET_BRANCH}' requires sign-off
  scripts/signoff install      Preview the required-checks change (dry run)
  scripts/signoff install --yes  Apply it (needs admin on the repo)

Checks (when verify is on):
  0. If the branch has no Rust-affecting files vs trunk (.rs, Cargo.toml/lock,
     rust-toolchain*, .cargo/*, clippy/rustfmt/nextest/layers config, the lint
     guards, the root Makefile) → skip Rust lint/build/tests (still posts
     status)
  1. Targeted lint of crates touched by this branch vs trunk
     (make lint-rust PACKAGES="…") — fail-fast feedback
  2. Targeted unit tests for those crates (make nextest-packages PACKAGES="…")
  3. Full workspace lint (make lint-rust)
  4. CLI build + unit tests (make build-cli-dev nextest)

  Steps 1-2 pass the features each crate resolves to in a workspace build, not
  the crate's own defaults — a scoped build of a crate that declares no
  'default' (runtime) would otherwise compile with no features at all.

  Set SIGNOFF_SKIP_TARGETED_LINT=1 to skip step 1, SIGNOFF_SKIP_TARGETED_TESTS=1
  to skip step 2 (both trade an extra compile of those crates for early failure).
  Remote runs (.github/workflows/signoff.yml) set SIGNOFF_REMOTE_RUN and use
  the GitHub compare API when the clone is too shallow for merge-base.

  make signoff-remote dispatches signoff.yml on GitHub Actions (self-hosted
  runner) for the current branch. Sign-off runs only where it is accountable:
  this machine, or the runner — never ad-hoc SSH hosts.

The sign-off is a '${STATUS_CONTEXT}' commit status bound to the exact commit you
pushed. Sign off again after any code change or manual conflict resolution. The
Attestation check can carry a sign-off across a first-parent chain of unmodified,
conflict-free base merges. The full test suite runs in the merge queue.
EOF
}

main() {
  case "${1:-}" in
    ""|signoff) shift || true; cmd_signoff "$@" ;;
    -f|--force|--no-verify) cmd_signoff "$@" ;;
    remote)   shift; cmd_remote "$@" ;;
    status)   shift; cmd_status "$@" ;;
    mine)     shift; cmd_mine "$@" ;;
    clear-pending) shift; cmd_clear_pending "$@" ;;
    preflight-disk) shift; cmd_preflight_disk "$@" ;;
    check)    shift; cmd_check "$@" ;;
    install)  shift; cmd_install "$@" ;;
    version|--version) echo "signoff ${VERSION}" ;;
    -h|--help) cmd_help ;;
    *) fail "unknown command: $1 (see: scripts/signoff --help)" ;;
  esac
}

# Only dispatch when executed. The unit tests source this file to call
# individual functions, and sourcing must not run a command. BASH_SOURCE is unset
# when the script's *contents* are fed to bash (`bash -c "$(cat …)"`, a piped
# download), which `set -u` would abort on — default it to $0, which dispatches,
# since that invocation means to run the thing.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
  main "$@"
fi
