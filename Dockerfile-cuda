#syntax=docker/dockerfile:1.2@sha256:e2a8561e419ab1ba6b2fe6cbdf49fd92b95912df1cf7d313c3e2230a333fdbcc
ARG RUST_VERSION=1.99.1

FROM nvidia/cuda:13.4.3-cudnn-devel-ubuntu24.04@sha256:f2d23b75391766a02175908d3fa1c2afee9849aa13d09326d71649de2b33cfe9 AS build

# cache mounts below may already exist and owned by root
USER root

RUN apt update \
    && apt install --yes pkg-config libssl-dev build-essential libsqlite3-dev cmake protobuf-compiler unixodbc-dev curl \
    && rm -rf /var/lib/{apt,dpkg,cache,log}

# rustup from the rustup-init .github/ci-cache/pins.json pins, checked against its SHA-256
# before it runs; check_ci_cache_pins.py keeps these values equal to the pins.
ARG RUSTUP_VERSION=1.29.3
ARG RUSTUP_INIT_SHA256_X86_64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
ARG RUSTUP_INIT_SHA256_AARCH64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
RUN case "$(uname -m)" in \
        x86_64) triple=x86_64-unknown-linux-gnu sha256="${RUSTUP_INIT_SHA256_X86_64}" ;; \
        aarch64) triple=aarch64-unknown-linux-gnu sha256="${RUSTUP_INIT_SHA256_AARCH64}" ;; \
        *) echo "No rustup-init is pinned for $(uname -m)." >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${triple}/rustup-init" \
    && echo "${sha256}  /tmp/rustup-init" | sha256sum --check --strict \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --default-toolchain none \
    && rm -f /tmp/rustup-init \
    && echo 'source $HOME/.cargo/env' >> $HOME/.bashrc \
    && /bin/bash -c "source $HOME/.cargo/env && rustup set auto-self-update disable && rustup default ${RUST_VERSION} && rustup update"

# Configurable CUDA compute capability `<https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#compute-capabilities>`.
ARG CUDA_COMPUTE_CAP=80

# Add environment variables for CUDA
ENV PATH="/root/.cargo/bin:${PATH}" \
    CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP} \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

COPY . /build
WORKDIR /build

ARG CARGO_FEATURES=default
ARG CARGO_INCREMENTAL=yes
ARG CARGO_NET_GIT_FETCH_WITH_CLI=false
ARG TARGETARCH
ENV CARGO_FEATURES=$CARGO_FEATURES \
    CARGO_INCREMENTAL=$CARGO_INCREMENTAL \
    CARGO_NET_GIT_FETCH_WITH_CLI=$CARGO_NET_GIT_FETCH_WITH_CLI

RUN \
    --mount=type=cache,id=spiceai_registry,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,id=spiceai_git,sharing=locked,target=/usr/local/cargo/git \
    --mount=type=cache,id=spiceai_target,sharing=locked,target=/build/target \
    case "${TARGETARCH}" in \
      arm64) export CFLAGS="-O3 -ffunction-sections -fdata-sections -fPIC" ;; \
      amd64) export CFLAGS="-O3 -ffunction-sections -fdata-sections -fPIC -march=x86-64" ;; \
      *) export CFLAGS="-O3 -ffunction-sections -fdata-sections -fPIC" ;; \
    esac && \
    cargo build --release --features ${CARGO_FEATURES:-default} && \
    cp /build/target/release/spiced /root/spiced

# `duckdb:` and `ducklake:` datasets read through the DuckDB library installed
# on the host, loaded by name at runtime. Keep DUCKDB_VERSION at the newest
# release test/duckdb_versions.json lists.
ARG DUCKDB_VERSION=2.0.0
ARG DUCKDB_SHA256_AMD64=993ad89e7dfca66cd6da994c2cad090c2fc160ddf9f550498a098ab4bb13cfb1
ARG DUCKDB_SHA256_ARM64=c60eecf91143ca6bbac55c4f4d40dc22520488b0ac257c86e0fe9a2b451cf2b7
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64|"") duckdb_platform=linux-amd64; duckdb_sha256="${DUCKDB_SHA256_AMD64}" ;; \
      arm64) duckdb_platform=linux-arm64; duckdb_sha256="${DUCKDB_SHA256_ARM64}" ;; \
      *) echo "Unsupported TARGETARCH for libduckdb: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fSLo /tmp/libduckdb.tar.gz "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb-shared-libs-${duckdb_platform}.tar.gz"; \
    echo "${duckdb_sha256}  /tmp/libduckdb.tar.gz" | sha256sum -c -; \
    tar -C /root -xzf /tmp/libduckdb.tar.gz libduckdb.so; \
    rm -f /tmp/libduckdb.tar.gz

FROM nvidia/cuda:13.4.3-cudnn-runtime-ubuntu24.04@sha256:534ea2e94fd17f053b4422d094f50a43a7e75a03240c4b89cbe9ad42085ec1c3 AS runtime
ENV CUDA_NVCC_FLAGS=-fPIE
ARG CARGO_FEATURES

# Allow DuckDB to load extensions
RUN mkdir /.duckdb/ && chmod 777 /.duckdb/

RUN apt update \
    && apt install --yes ca-certificates libssl3 tzdata cuda-compat-12-6 --no-install-recommends \
    && rm -rf /var/lib/{apt,dpkg,cache,log}

RUN if echo "$CARGO_FEATURES" | grep -q "odbc"; then \
    apt update \
    && apt install --yes unixodbc --no-install-recommends \
    && rm -rf /var/lib/{apt,dpkg,cache,log}; \
    fi

COPY --from=build /root/spiced /usr/local/bin/spiced

# Copy libduckdb onto the default library path (loaded by name at runtime for
# `duckdb:` and `ducklake:`)
COPY --from=build /root/libduckdb.so /usr/lib/libduckdb.so

ENV LD_LIBRARY_PATH=/usr/local/cuda-12.6/compat:${LD_LIBRARY_PATH}

WORKDIR /app

EXPOSE 8090
EXPOSE 9090
EXPOSE 50051

ENTRYPOINT ["/usr/local/bin/spiced"]
CMD ["--http","0.0.0.0:8090","--metrics", "0.0.0.0:9090","--flight","0.0.0.0:50051"]
