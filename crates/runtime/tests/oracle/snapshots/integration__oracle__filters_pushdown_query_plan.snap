|               |     TableScan: test_tbl projection=[ID, VAL_NUMBER, VAL_DECIMAL, VAL_FLOAT, VAL_DOUBLE, VAL_CHAR, VAL_NCHAR, VAL_VARCHAR2, VAL_NVARCHAR2, VAL_CLOB, VAL_NCLOB, VAL_DATE, VAL_TIMESTAMP, VAL_TIMESTAMP_TZ, VAL_TIMESTAMP_LOCAL_TZ, VAL_BINARY_FLOAT, VAL_BINARY_DOUBLE, VAL_RAW, VAL_BLOB, VAL_BOOL], full_filters=[test_tbl.VAL_NUMBER = Decimal128(Some(12345),10,2), CAST(test_tbl.VAL_FLOAT AS Float64) > Float64(2.8), test_tbl.VAL_DECIMAL < Decimal128(Some(100000000),18,4), test_tbl.VAL_VARCHAR2 = Utf8("ghi"), test_tbl.VAL_BOOL = Utf8("Y")] |
| physical_plan | GlobalLimitExec: skip=0, fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     OracleExec sql=SELECT "ID", "VAL_NUMBER", "VAL_DECIMAL", "VAL_FLOAT", "VAL_DOUBLE", "VAL_CHAR", "VAL_NCHAR", "VAL_VARCHAR2", "VAL_NVARCHAR2", "VAL_CLOB", "VAL_NCLOB", "VAL_DATE", "VAL_TIMESTAMP", "VAL_TIMESTAMP_TZ", "VAL_TIMESTAMP_LOCAL_TZ", "VAL_BINARY_FLOAT", "VAL_BINARY_DOUBLE", "VAL_RAW", "VAL_BLOB", "VAL_BOOL" FROM "TEST_TABLE" WHERE ("VAL_NUMBER" = 123.45) AND (CAST("VAL_FLOAT" AS FLOAT) > 2.8) AND ("VAL_DECIMAL" < 10000.0000) AND ("VAL_VARCHAR2" = 'ghi') AND ("VAL_BOOL" = 'Y')                                            |
