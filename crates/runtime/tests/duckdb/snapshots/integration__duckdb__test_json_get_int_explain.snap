---
source: crates/runtime/tests/duckdb/mod.rs
expression: stable_plan(&explain_plan)
---
logical_plan: Projection: age
logical_plan:   Sort: json_test.id ASC NULLS LAST
logical_plan:     Projection: json_get_int(json_test.data, Utf8("age")) AS age, json_test.id
logical_plan:       Federated
logical_plan:  Projection: json_test.id, json_test.data
logical_plan:   TableScan: json_test projection=[id, data]
physical_plan: ProjectionExec: expr=[age@0 as age]
physical_plan:   SortExec: expr=[id@1 ASC NULLS LAST], preserve_partitioning=[false]
physical_plan:     ProjectionExec: expr=[json_get_int(data@1, age) as age, id@0 as id]
physical_plan:       SchemaCastScanExec
physical_plan:         CooperativeExec
physical_plan:           BytesProcessedExec
physical_plan:             VirtualExecutionPlan name=adbc compute_context=<id> base_sql=SELECT "<duckdb_view>"."id", "<duckdb_view>"."data" FROM "<duckdb_view>"
