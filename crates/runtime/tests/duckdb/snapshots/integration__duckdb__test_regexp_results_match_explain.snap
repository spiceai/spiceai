---
source: crates/runtime/tests/duckdb/mod.rs
expression: stable_plan(&explain_plan)
---
logical_plan: Inner Join: d.region = a.region
logical_plan:   SubqueryAlias: d
logical_plan:     SubqueryAlias: duckdb_regexp_like
logical_plan:       Filter: csv_test.region ILIKE Utf8("%america%")
logical_plan:         Federated
logical_plan:  Projection: csv_test.region
logical_plan:   TableScan: csv_test projection=[region]
logical_plan:   SubqueryAlias: a
logical_plan:     SubqueryAlias: cayenne_regexp_like
logical_plan:       Filter: csv_test_cayenne.region ILIKE Utf8("%america%")
logical_plan:         TableScan: csv_test_cayenne projection=[region], partial_filters=[csv_test_cayenne.region ILIKE Utf8("%america%")]
physical_plan: HashJoinExec: mode=CollectLeft, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(region@0, region@0)]
physical_plan:   CoalescePartitionsExec
physical_plan:     FilterExec: region@0 ILIKE %america%
physical_plan:       RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1
physical_plan:         SchemaCastScanExec
physical_plan:           BytesProcessedExec
physical_plan:             VirtualExecutionPlan name=adbc compute_context=<id> base_sql=SELECT "<duckdb_view>"."region" FROM "<duckdb_view>"
physical_plan:   RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1
physical_plan:     SchemaCastScanExec
physical_plan:       CayenneAccelerationExec: snapshots_scanned=0, files_scanned=0
physical_plan:         FilterExec: region@0 ILIKE %america%
physical_plan:           BytesProcessedExec
physical_plan:             DataSourceExec: partitions=1, partition_sizes=[1]
