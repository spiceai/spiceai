---
source: crates/runtime/tests/duckdb/mod.rs
expression: stable_plan(&explain_plan)
---
logical_plan: Federated
logical_plan:  Projection: regexp_count(csv_test.region, Utf8("AMERICA"))
logical_plan:   TableScan: csv_test projection=[region]
physical_plan: SchemaCastScanExec
physical_plan:   CooperativeExec
physical_plan:     BytesProcessedExec
physical_plan:       VirtualExecutionPlan name=adbc compute_context=<id> base_sql=SELECT len(regexp_extract_all("<duckdb_view>"."region", 'AMERICA')) AS "regexp_count(csv_test.region,Utf8(""AMERICA""))" FROM "<duckdb_view>"
