---
source: crates/runtime/tests/duckdb/mod.rs
expression: stable_plan(&explain_plan)
---
logical_plan: Projection: json_test.id
logical_plan:   Filter: __datafusion_extracted_1 = Utf8("alice")
logical_plan:     Projection: json_get_str(json_test.data, Utf8("name")) AS __datafusion_extracted_1, json_test.id
logical_plan:       Federated
logical_plan:  Projection: json_test.id, json_test.data
logical_plan:   TableScan: json_test projection=[id, data]
physical_plan: FilterExec: __datafusion_extracted_1@0 = alice, projection=[id@1]
physical_plan:   RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1
physical_plan:     ProjectionExec: expr=[json_get_str(data@1, name) as __datafusion_extracted_1, id@0 as id]
physical_plan:       SchemaCastScanExec
physical_plan:         BytesProcessedExec
physical_plan:           VirtualExecutionPlan name=adbc compute_context=<id> base_sql=SELECT "<duckdb_view>"."id", "<duckdb_view>"."data" FROM "<duckdb_view>"
