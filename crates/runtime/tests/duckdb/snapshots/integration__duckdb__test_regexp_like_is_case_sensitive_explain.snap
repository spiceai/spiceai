---
source: crates/runtime/tests/duckdb/mod.rs
expression: stable_plan(&explain_plan)
---
logical_plan: Federated
logical_plan:  Projection: csv_test.region
logical_plan:   TableScan: csv_test projection=[region], full_filters=[regexp_like(csv_test.region, Utf8("america"))]
physical_plan: SchemaCastScanExec
physical_plan:   CooperativeExec
physical_plan:     BytesProcessedExec
physical_plan:       VirtualExecutionPlan name=adbc compute_context=<id> base_sql=SELECT "<duckdb_view>"."region" FROM "<duckdb_view>" WHERE regexp_matches("<duckdb_view>"."region", 'america')
