---
source: crates/runtime/tests/duckdb/mod.rs
expression: stable_plan(&explain_plan)
---
logical_plan: Federated
logical_plan:  Projection: regexp_replace(csv_test.region, Utf8("AMERICA"), Utf8("AUSTRALIA"))
logical_plan:   TableScan: csv_test projection=[region]
physical_plan: SchemaCastScanExec
physical_plan:   CooperativeExec
physical_plan:     BytesProcessedExec
physical_plan:       VirtualExecutionPlan name=adbc compute_context=<id> base_sql=SELECT regexp_replace("<duckdb_view>"."region", 'AMERICA', 'AUSTRALIA') AS "regexp_replace(csv_test.region,Utf8(""AMERICA""),Utf8(""AUSTRALIA""))" FROM "<duckdb_view>"
