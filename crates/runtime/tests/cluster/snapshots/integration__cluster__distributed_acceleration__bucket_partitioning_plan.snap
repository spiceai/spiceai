|               |       VirtualExecutionPlan name=flightsql compute_context=endpoint=[endpoint] base_sql=SELECT test_data.id, test_data."name", test_data.age, test_data.city, test_data.score FROM test_data WHERE (((bucket(3, test_data.id) = '0') OR (bucket(3, test_data.id) = '1')) OR (bucket(3, test_data.id) = '2')) ORDER BY test_data.id ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                       |
