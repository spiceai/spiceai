+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Sort: test_data.id ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                             |
|               |   Projection: test_data.id, test_data.name, test_data.score                                                                                                                                                                                                                                                                                                                    |
|               |     Filter: test_data.score > Int64(85)                                                                                                                                                                                                                                                                                                                                        |
|               |       TableScan: test_data projection=[id, name, score], partial_filters=[bucket(Int64(3), id) = Utf8("0") OR bucket(Int64(3), id) = Utf8("1") OR bucket(Int64(3), id) = Utf8("2"), test_data.score > Int64(85)]                                                                                                                                                               |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=flightsql compute_context=endpoint=[endpoint] base_sql=SELECT test_data.id, test_data."name", test_data.score FROM test_data WHERE (test_data.score > 85) AND ((((bucket(3, test_data.id) = '0') OR (bucket(3, test_data.id) = '1')) OR (bucket(3, test_data.id) = '2')) AND (test_data.score > 85)) ORDER BY test_data.id ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                |
