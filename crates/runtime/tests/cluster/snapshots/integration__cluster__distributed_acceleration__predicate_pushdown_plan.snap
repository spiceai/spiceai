|               |   SchemaCastScanExec                                                                                                                                                                                                                               |
|               |     CooperativeExec                                                                                                                                                                                                                                |
|               |       BytesProcessedExec                                                                                                                                                                                                                           |
|               |         VirtualExecutionPlan name=flightsql compute_context=endpoint=[endpoint] base_sql=SELECT test_data.id, test_data."name", test_data.score FROM test_data AS test_data WHERE (test_data.score > 85) ORDER BY test_data.id ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                    |
