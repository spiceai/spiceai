|               |  Projection: count(Int64(1)) AS total_rows, avg(test_data.score) AS avg_score, min(test_data.age) AS min_age, max(test_data.age) AS max_age                                                                                                                                                                                                                               |
|               |   Aggregate: groupBy=[[]], aggr=[[count(Int64(1)), avg(CAST(test_data.score AS Float64)), min(test_data.age), max(test_data.age)]]                                                                                                                                                                                                                                        |
|               |     TableScan: test_data projection=[age, score], partial_filters=[bucket(Int64(3), id) = Utf8("0") OR bucket(Int64(3), id) = Utf8("1") OR bucket(Int64(3), id) = Utf8("2")]                                                                                                                                                                                              |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                        |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                         |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                    |
|               |       VirtualExecutionPlan name=flightsql compute_context=endpoint=[endpoint] base_sql=SELECT count(1) AS total_rows, avg(CAST(test_data.score AS DOUBLE)) AS avg_score, min(test_data.age) AS min_age, max(test_data.age) AS max_age FROM test_data WHERE (((bucket(3, test_data.id) = '0') OR (bucket(3, test_data.id) = '1')) OR (bucket(3, test_data.id) = '2')) |
|               |                                                                                                                                                                                                                                                                                                                                                                           |
