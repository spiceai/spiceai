|               |         VirtualExecutionPlan name=flightsql compute_context=endpoint=[endpoint] base_sql=SELECT CAST(p."name" AS TEXT) AS "name", total_qty FROM (SELECT "name", sum(o.quantity) AS total_qty FROM jcat.store.orders AS orders INNER JOIN jcat.store.products AS products ON (o.product_id = p.product_id) GROUP BY p."name" ORDER BY "name" ASC NULLS LAST) rewritten_sql=SELECT CAST(products."name" AS TEXT) AS "name", total_qty FROM (SELECT "name", sum(orders.quantity) AS total_qty FROM jcat.store.orders AS orders INNER JOIN jcat.store.products AS products ON (orders.product_id = products.product_id) GROUP BY products."name") ORDER BY "name" ASC NULLS LAST |
