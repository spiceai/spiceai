+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: vector_search(delivery, Utf8("wrong location")).event.id DESC NULLS FIRST, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   Projection: vector_search(delivery, Utf8("wrong location")).event.id, round(vector_search(delivery, Utf8("wrong location"))._score, Int32(1)) AS round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     TableScan: vector_search(delivery, Utf8("wrong location")) projection=[_score, event.id], full_filters=[vector_search(delivery, Utf8("wrong location")).account.tier = Utf8("BUSINESS")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| physical_plan | SortPreservingMergeExec: [event.id@0 DESC], fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   SortExec: TopK(fetch=10), expr=[event.id@0 DESC], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |     ProjectionExec: expr=[event.id@1 as event.id, round(1 - cosine_distance([-0.13936752, 0.18599659, 0.16405481, 0.05095296, 0.040796414, -0.018515524, 0.38630947, -0.16316591, 0.08066893, 0.1798965, -0.1059881, -0.21802936, -0.044913843, -0.13224208, -0.08074871, -0.019555071, -0.023514856, 0.0748685, -0.050689265, -0.059976593, 0.043387674, 0.28947443, -0.05394865, 0.016003214, -0.07631955, -0.09952688, 0.11588978, -0.0035968018, -0.13089755, 0.0151300905, -0.14572942, -0.13504319, -0.14826499, -0.032901697, 0.093028, 0.17135742, 0.030899603, -0.0021911548, -0.22262152, 0.108252265, 0.16129175, -0.19284129, -0.07370497, -0.040595807, 0.18784483, 0.107370086, -0.1951122, -0.022211365, -0.012488519, -0.20037127, -0.18940096, -0.08240605, -0.13783425, 0.0051184576, -0.06050031, -0.0087315105, 0.056267343, 0.09116591, 0.09238926, -0.010739375, 0.023838365, -0.14257154, 0.018097306, -0.03630276], message.body_embedding@2), 1) as round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1))] |
|               |       RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
