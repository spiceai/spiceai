    }
  },
  {
    "description": "Load memories previously saved by the language model.",
    "name": "mcp_from_spiced/load_memory",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "last": {
          "description": "Retrieve memories created in the 'last' interval as a human-readable duration string, e.g. \"1h\", \"2m30s\".",
          "type": "string"
        },
