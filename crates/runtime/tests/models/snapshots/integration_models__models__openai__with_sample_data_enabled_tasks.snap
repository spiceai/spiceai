    "input": "SELECT \"VendorID\" FROM (\n                SELECT \"VendorID\", 1 as priority\n                FROM (SELECT DISTINCT \"VendorID\" FROM spice.public.taxi_trips)\n                UNION ALL\n                SELECT \"VendorID\", 2 as priority\n                FROM spice.public.taxi_trips\n            ) combined\n            ORDER BY priority, \"VendorID\"\n            LIMIT 3",
    "task": "sql_query"
  },
