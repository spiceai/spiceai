---
source: crates/runtime/tests/models/s3_vectors.rs
expression: replace_s3_vector_index_names(&formatted)
---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Projection: vector_search(delivery, Utf8("wrong location")).message.body, vector_search(delivery, Utf8("wrong location")).attempt_count, vector_search(delivery, Utf8("wrong location")).message.status, vector_search(delivery, Utf8("wrong location")).package_weight_kg, round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   Sort: vector_search(delivery, Utf8("wrong location")).package_weight_kg DESC NULLS FIRST, vector_search(delivery, Utf8("wrong location"))._score DESC NULLS FIRST, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     Projection: vector_search(delivery, Utf8("wrong location")).message.body, vector_search(delivery, Utf8("wrong location")).attempt_count, vector_search(delivery, Utf8("wrong location")).message.status, vector_search(delivery, Utf8("wrong location")).package_weight_kg, round(vector_search(delivery, Utf8("wrong location"))._score, Int32(1)) AS round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1)), vector_search(delivery, Utf8("wrong location"))._score                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       TableScan: vector_search(delivery, Utf8("wrong location")) projection=[_score, attempt_count, message.body, message.status, package_weight_kg], full_filters=[vector_search(delivery, Utf8("wrong location")).attempt_count > Int64(1), vector_search(delivery, Utf8("wrong location")).package_weight_kg > Float64(5), vector_search(delivery, Utf8("wrong location")).message.status = Utf8("FAILED")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| physical_plan | ProjectionExec: expr=[message.body@0 as message.body, attempt_count@1 as attempt_count, message.status@2 as message.status, package_weight_kg@3 as package_weight_kg, round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1))@4 as round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1))]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   SortPreservingMergeExec: [package_weight_kg@3 DESC, _score@5 DESC], fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     SortExec: TopK(fetch=10), expr=[package_weight_kg@3 DESC, _score@5 DESC], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       ProjectionExec: expr=[message.body@2 as message.body, attempt_count@1 as attempt_count, message.status@3 as message.status, package_weight_kg@4 as package_weight_kg, round(_score@0, 1) as round(vector_search(delivery, Utf8("wrong location"))._score,Int64(1)), _score@0 as _score]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |         RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           ProjectionExec: expr=[_score@4 as _score, attempt_count@0 as attempt_count, message.body@5 as message.body, message.status@2 as message.status, package_weight_kg@3 as package_weight_kg]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             HashJoinExec: mode=CollectLeft, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(event.id@1, event.id@0)], projection=[attempt_count@0, event.id@1, message.status@2, package_weight_kg@3, _score@4, message.body@6]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |               CoalescePartitionsExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                 ProjectionExec: expr=[attempt_count@0 as attempt_count, event.id@1 as event.id, message.status@3 as message.status, package_weight_kg@4 as package_weight_kg, 1 - cosine_distance([-0.13936752, 0.18599659, 0.16405481, 0.05095296, 0.040796414, -0.018515524, 0.38630947, -0.16316591, 0.08066893, 0.1798965, -0.1059881, -0.21802936, -0.044913843, -0.13224208, -0.08074871, -0.019555071, -0.023514856, 0.0748685, -0.050689265, -0.059976593, 0.043387674, 0.28947443, -0.05394865, 0.016003214, -0.07631955, -0.09952688, 0.11588978, -0.0035968018, -0.13089755, 0.0151300905, -0.14572942, -0.13504319, -0.14826499, -0.032901697, 0.093028, 0.17135742, 0.030899603, -0.0021911548, -0.22262152, 0.108252265, 0.16129175, -0.19284129, -0.07370497, -0.040595807, 0.18784483, 0.107370086, -0.1951122, -0.022211365, -0.012488519, -0.20037127, -0.18940096, -0.08240605, -0.13783425, 0.0051184576, -0.06050031, -0.0087315105, 0.056267343, 0.09116591, 0.09238926, -0.010739375, 0.023838365, -0.14257154, 0.018097306, -0.03630276], message.body_embedding@2) as _score] |
|               |                   RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                     FilterExec: attempt_count@0 > 1 AND package_weight_kg@4 > 5 AND message.status@3 = FAILED                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |                       BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                         DataSourceExec: partitions=1, partition_sizes=[1]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
