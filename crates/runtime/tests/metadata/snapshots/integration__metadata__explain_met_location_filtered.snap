---
source: crates/runtime/tests/metadata/mod.rs
expression: explain_met_location_filtered
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: met_location.id ASC NULLS LAST, met_location._location ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   Filter: met_location._location = Utf8("s3://spiceai-public-datasets/hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     TableScan: met_location projection=[id, value, year, month, day, _location], partial_filters=[met_location._location = Utf8("s3://spiceai-public-datasets/hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| physical_plan | SortExec: expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     DataSourceExec: file_groups={1 group: [[hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet]]}, projection=[id, value, year, month, day, _location], file_type=parquet, predicate=_location@5 = s3://spiceai-public-datasets/hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet, sort_order_for_reorder=[id@0 ASC NULLS LAST], pruning_predicate=_location_null_count@2 != row_count@3 AND _location_min@0 <= s3://spiceai-public-datasets/hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet AND s3://spiceai-public-datasets/hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet <= _location_max@1, required_guarantees=[_location in (s3://spiceai-public-datasets/hive_partitioned_data/year=2023/month=2/day=2/data_1.parquet)] |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
