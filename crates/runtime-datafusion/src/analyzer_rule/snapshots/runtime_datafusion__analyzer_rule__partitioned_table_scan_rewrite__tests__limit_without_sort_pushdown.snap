  SubqueryAlias: test_table
    Union
      Limit: skip=0, fetch=5
        TableScan: test_table, unsupported_filters=[partition_id = Utf8("0")]
      Limit: skip=0, fetch=5
        TableScan: test_table, unsupported_filters=[partition_id = Utf8("1")]
