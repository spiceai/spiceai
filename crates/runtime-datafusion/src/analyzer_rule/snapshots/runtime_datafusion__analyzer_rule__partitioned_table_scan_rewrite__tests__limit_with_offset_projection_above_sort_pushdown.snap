---
source: crates/runtime-datafusion/src/analyzer_rule/partitioned_table_scan_rewrite.rs
expression: result.display_indent()
---
Limit: skip=5, fetch=3
  Projection: test_table.id, test_table.name
    Sort: test_table.partition_id DESC NULLS FIRST
      SubqueryAlias: test_table
        Union
          Sort: test_table.partition_id DESC NULLS FIRST, fetch=8
            SubqueryAlias: test_table
              Projection: test_table.id, test_table.name, test_table.partition_id
                Filter: test_table.partition_id = CAST(Int64(0) AS Int32)
                  TableScan: test_table
          Sort: test_table.partition_id DESC NULLS FIRST, fetch=8
            SubqueryAlias: test_table
              Projection: test_table.id, test_table.name, test_table.partition_id
                Filter: test_table.partition_id = CAST(Int64(1) AS Int32)
                  TableScan: test_table
