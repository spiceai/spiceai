---
source: crates/datafusion-optimizer-rules/src/logical_plan/reorder_join/chbench_tests.rs
expression: plan
---
Sort: nation.n_name ASC NULLS LAST, supplier.su_name ASC NULLS LAST, item.i_id ASC NULLS LAST
  Projection: supplier.su_suppkey, supplier.su_name, nation.n_name, item.i_id, item.i_name, supplier.su_address, supplier.su_phone, supplier.su_comment
    Inner Join: stock.s_i_id = item.i_id, mod(stock.s_w_id * stock.s_i_id, Int64(10000)) = supplier.su_suppkey, stock.s_quantity = m.m_s_quantity
      TableScan: stock projection=[s_w_id, s_i_id, s_quantity]
      Projection: nation.n_name, supplier.su_suppkey, supplier.su_name, supplier.su_address, supplier.su_phone, supplier.su_comment, m.m_s_quantity, item.i_id, item.i_name
        Inner Join: m.m_i_id = item.i_id
          Cross Join:
            Projection: nation.n_name, supplier.su_suppkey, supplier.su_name, supplier.su_address, supplier.su_phone, supplier.su_comment
              Inner Join: nation.n_nationkey = supplier.su_nationkey
                Projection: nation.n_nationkey, nation.n_name
                  Inner Join: region.r_regionkey = nation.n_regionkey
                    Projection: region.r_regionkey
                      Filter: region.r_name LIKE Utf8("EUROP%")
                        TableScan: region projection=[r_regionkey, r_name]
                    TableScan: nation projection=[n_nationkey, n_name, n_regionkey]
                TableScan: supplier projection=[su_suppkey, su_nationkey, su_name, su_address, su_phone, su_comment]
            SubqueryAlias: m
              Projection: stock.s_i_id AS m_i_id, min(stock.s_quantity) AS m_s_quantity
                Aggregate: groupBy=[[stock.s_i_id]], aggr=[[min(stock.s_quantity)]]
                  Projection: stock.s_i_id, stock.s_quantity
                    Inner Join: nation.n_regionkey = region.r_regionkey
                      Projection: stock.s_i_id, stock.s_quantity, nation.n_regionkey
                        Inner Join: supplier.su_nationkey = nation.n_nationkey
                          Projection: stock.s_i_id, stock.s_quantity, supplier.su_nationkey
                            Inner Join: mod(stock.s_w_id * stock.s_i_id, Int64(10000)) = supplier.su_suppkey
                              TableScan: stock projection=[s_w_id, s_i_id, s_quantity]
                              TableScan: supplier projection=[su_suppkey, su_nationkey]
                          TableScan: nation projection=[n_nationkey, n_regionkey]
                      Projection: region.r_regionkey
                        Filter: region.r_name LIKE Utf8("EUROP%")
                          TableScan: region projection=[r_regionkey, r_name]
          Projection: item.i_id, item.i_name
            Filter: item.i_data LIKE Utf8("%b")
              TableScan: item projection=[i_id, i_data, i_name]
