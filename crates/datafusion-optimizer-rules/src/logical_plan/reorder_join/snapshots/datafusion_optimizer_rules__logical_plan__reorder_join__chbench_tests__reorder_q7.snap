---
source: crates/datafusion-optimizer-rules/src/logical_plan/reorder_join/chbench_tests.rs
expression: plan
---
Sort: supp_nation ASC NULLS LAST, cust_nation ASC NULLS LAST, l_year ASC NULLS LAST
  Projection: supplier.su_nationkey AS supp_nation, substr(customer.c_state,Int64(1),Int64(1)) AS cust_nation, date_part(Utf8("YEAR"),oorder.o_entry_d) AS l_year, sum(order_line.ol_amount) AS revenue
    Aggregate: groupBy=[[supplier.su_nationkey, substr(customer.c_state, Int64(1), Int64(1)), date_part(Utf8("YEAR"), oorder.o_entry_d)]], aggr=[[sum(order_line.ol_amount)]]
      Projection: supplier.su_nationkey, order_line.ol_amount, oorder.o_entry_d, customer.c_state
        Inner Join: CAST(ascii(substr(customer.c_state, Int64(1), Int64(1))) AS Int64) - Int64(65) = n2.n_nationkey Filter: n1.n_name = Utf8("JAPAN") AND n2.n_name = Utf8("CHINA") OR n1.n_name = Utf8("CHINA") AND n2.n_name = Utf8("JAPAN")
          Projection: n1.n_name, supplier.su_nationkey, order_line.ol_amount, oorder.o_entry_d, customer.c_state
            Inner Join: oorder.o_c_id = customer.c_id, oorder.o_w_id = customer.c_w_id, oorder.o_d_id = customer.c_d_id
              Projection: n1.n_name, supplier.su_nationkey, order_line.ol_amount, oorder.o_c_id, oorder.o_w_id, oorder.o_d_id, oorder.o_entry_d
                Inner Join: order_line.ol_w_id = oorder.o_w_id, order_line.ol_d_id = oorder.o_d_id, order_line.ol_o_id = oorder.o_id
                  Projection: n1.n_name, supplier.su_nationkey, order_line.ol_o_id, order_line.ol_w_id, order_line.ol_d_id, order_line.ol_amount
                    Inner Join: stock.s_w_id = order_line.ol_supply_w_id, stock.s_i_id = order_line.ol_i_id
                      Projection: n1.n_name, supplier.su_nationkey, stock.s_w_id, stock.s_i_id
                        Inner Join: supplier.su_suppkey = mod(stock.s_w_id * stock.s_i_id, Int64(10000))
                          Projection: n1.n_name, supplier.su_suppkey, supplier.su_nationkey
                            Inner Join: n1.n_nationkey = supplier.su_nationkey
                              SubqueryAlias: n1
                                Filter: nation.n_name = Utf8("JAPAN") OR nation.n_name = Utf8("CHINA")
                                  TableScan: nation projection=[n_nationkey, n_name]
                              TableScan: supplier projection=[su_suppkey, su_nationkey]
                          TableScan: stock projection=[s_w_id, s_i_id]
                      TableScan: order_line projection=[ol_o_id, ol_w_id, ol_d_id, ol_i_id, ol_supply_w_id, ol_amount]
                  TableScan: oorder projection=[o_id, o_c_id, o_w_id, o_d_id, o_entry_d]
              TableScan: customer projection=[c_id, c_w_id, c_d_id, c_state]
          SubqueryAlias: n2
            Filter: nation.n_name = Utf8("CHINA") OR nation.n_name = Utf8("JAPAN")
              TableScan: nation projection=[n_nationkey, n_name]
