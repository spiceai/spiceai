---
source: crates/datafusion-optimizer-rules/src/logical_plan/reorder_join/chbench_tests.rs
expression: plan
---
Sort: numwait DESC NULLS FIRST, supplier.su_name ASC NULLS LAST
  Projection: supplier.su_name, count(Int64(1)) AS numwait
    Aggregate: groupBy=[[supplier.su_name]], aggr=[[count(Int64(1))]]
      Projection: supplier.su_name
        LeftAnti Join: l1.ol_o_id = __correlated_sq_1.ol_o_id, l1.ol_w_id = __correlated_sq_1.ol_w_id, l1.ol_d_id = __correlated_sq_1.ol_d_id Filter: __correlated_sq_1.ol_delivery_d > l1.ol_delivery_d
          Projection: supplier.su_name, l1.ol_o_id, l1.ol_w_id, l1.ol_d_id, l1.ol_delivery_d
            Inner Join: supplier.su_nationkey = nation.n_nationkey
              Projection: supplier.su_nationkey, supplier.su_name, l1.ol_o_id, l1.ol_w_id, l1.ol_d_id, l1.ol_delivery_d
                Inner Join: l1.ol_w_id = stock.s_w_id, l1.ol_i_id = stock.s_i_id, supplier.su_suppkey = mod(stock.s_w_id * stock.s_i_id, Int64(10000))
                  Projection: supplier.su_suppkey, supplier.su_nationkey, supplier.su_name, l1.ol_o_id, l1.ol_w_id, l1.ol_d_id, l1.ol_i_id, l1.ol_delivery_d
                    Inner Join: l1.ol_o_id = oorder.o_id, l1.ol_w_id = oorder.o_w_id, l1.ol_d_id = oorder.o_d_id Filter: oorder.o_entry_d < l1.ol_delivery_d
                      Cross Join:
                        TableScan: supplier projection=[su_suppkey, su_nationkey, su_name]
                        SubqueryAlias: l1
                          TableScan: order_line projection=[ol_o_id, ol_w_id, ol_d_id, ol_i_id, ol_delivery_d]
                      TableScan: oorder projection=[o_id, o_w_id, o_d_id, o_entry_d]
                  TableScan: stock projection=[s_w_id, s_i_id]
              Projection: nation.n_nationkey
                Filter: nation.n_name = Utf8("CHINA")
                  TableScan: nation projection=[n_nationkey, n_name]
          SubqueryAlias: __correlated_sq_1
            SubqueryAlias: l2
              TableScan: order_line projection=[ol_o_id, ol_w_id, ol_d_id, ol_delivery_d]
