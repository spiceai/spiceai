|               |       VirtualExecutionPlan name=adbc compute_context=de69e2e8a78269b25e483452df2f22cb5083f81f94ec7b76bdeaca5b5011da83 base_sql=SELECT sum((`lineitem`.`l_extendedprice` * `lineitem`.`l_discount`)) AS `revenue` FROM `lineitem` WHERE ((((`lineitem`.`l_shipdate` >= CAST('1994-01-01' AS DATE)) AND (`lineitem`.`l_shipdate` < CAST('1995-01-01' AS DATE))) AND (`lineitem`.`l_discount` BETWEEN 0.05 AND 0.07)) AND (`lineitem`.`l_quantity` < 24)) |
