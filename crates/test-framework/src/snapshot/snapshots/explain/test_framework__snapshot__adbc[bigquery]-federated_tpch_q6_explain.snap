|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       VirtualExecutionPlan name=adbc compute_context=2ccce95fe2d4be687104db4fa81b90e6f680f2d2a8a2b7739b83e7164907678e base_sql=SELECT sum((`lineitem`.`l_extendedprice` * `lineitem`.`l_discount`)) AS `revenue` FROM `lineitem` WHERE ((((`lineitem`.`l_shipdate` >= CAST(TIMESTAMP(REGEXP_REPLACE('1994-01-01', R'(\.\d{6})\d+', R'\1')) AS DATE)) AND (`lineitem`.`l_shipdate` < CAST(TIMESTAMP(REGEXP_REPLACE('1995-01-01', R'(\.\d{6})\d+', R'\1')) AS DATE))) AND (`lineitem`.`l_discount` BETWEEN 0.05 AND 0.07)) AND (`lineitem`.`l_quantity` < 24)) |
