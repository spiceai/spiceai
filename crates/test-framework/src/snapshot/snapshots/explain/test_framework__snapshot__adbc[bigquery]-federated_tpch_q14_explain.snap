description: "Query: tpch_q14"
---
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |  Projection: Float64(100) * sum(CASE WHEN part.p_type LIKE Utf8("PROMO%") THEN lineitem.l_extendedprice * Int64(1) - lineitem.l_discount ELSE Int64(0) END) / sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount) AS promo_revenue                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   Aggregate: groupBy=[[]], aggr=[[sum(CASE WHEN part.p_type LIKE Utf8("PROMO%") THEN lineitem.l_extendedprice * (Int64(1) - lineitem.l_discount) ELSE Int64(0) END), sum(lineitem.l_extendedprice * (Int64(1) - lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     Inner Join:  Filter: lineitem.l_partkey = part.p_partkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       TableScan: lineitem projection=[l_partkey, l_extendedprice, l_discount], full_filters=[lineitem.l_shipdate >= CAST(Utf8("1995-09-01") AS Date32), lineitem.l_shipdate < CAST(Utf8("1995-10-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       TableScan: part projection=[p_partkey, p_type]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       VirtualExecutionPlan name=adbc compute_context=2ccce95fe2d4be687104db4fa81b90e6f680f2d2a8a2b7739b83e7164907678e base_sql=SELECT ((100.0 * sum(CASE WHEN `part`.`p_type` LIKE 'PROMO%' THEN (`lineitem`.`l_extendedprice` * (1 - `lineitem`.`l_discount`)) ELSE 0 END)) / sum((`lineitem`.`l_extendedprice` * (1 - `lineitem`.`l_discount`)))) AS `promo_revenue` FROM `lineitem` INNER JOIN `part` ON (`lineitem`.`l_partkey` = `part`.`p_partkey`) WHERE (`lineitem`.`l_shipdate` >= CAST(TIMESTAMP(REGEXP_REPLACE('1995-09-01', R'(\.\d{6})\d+', R'\1')) AS DATE)) AND (`lineitem`.`l_shipdate` < CAST(TIMESTAMP(REGEXP_REPLACE('1995-10-01', R'(\.\d{6})\d+', R'\1')) AS DATE)) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
