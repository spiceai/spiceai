| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Limit: skip=0, fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Sort: NUMWAIT DESC NULLS FIRST, snowflake.TPCH_SF1.SUPPLIER.S_NAME ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     Projection: snowflake.TPCH_SF1.SUPPLIER.S_NAME, count(Int64(1)) AS NUMWAIT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       Aggregate: groupBy=[[snowflake.TPCH_SF1.SUPPLIER.S_NAME]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |         Inner Join:  Filter: snowflake.TPCH_SF1.SUPPLIER.S_NATIONKEY = snowflake.TPCH_SF1.NATION.N_NATIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           Inner Join:  Filter: snowflake.TPCH_SF1.ORDERS.O_ORDERKEY = l1.L_ORDERKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |             Inner Join:  Filter: snowflake.TPCH_SF1.SUPPLIER.S_SUPPKEY = l1.L_SUPPKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |               Filter: EXISTS (<subquery>) AND NOT EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |                 Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                   Projection: l2.L_ORDERKEY, l2.L_PARTKEY, l2.L_SUPPKEY, l2.L_LINENUMBER, l2.L_QUANTITY, l2.L_EXTENDEDPRICE, l2.L_DISCOUNT, l2.L_TAX, l2.L_RETURNFLAG, l2.L_LINESTATUS, l2.L_SHIPDATE, l2.L_COMMITDATE, l2.L_RECEIPTDATE, l2.L_SHIPINSTRUCT, l2.L_SHIPMODE, l2.L_COMMENT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |                     Filter: l2.L_ORDERKEY = outer_ref(l1.L_ORDERKEY) AND l2.L_SUPPKEY != outer_ref(l1.L_SUPPKEY)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                       SubqueryAlias: l2                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                         TableScan: snowflake.TPCH_SF1.LINEITEM                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                 Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                   Projection: l3.L_ORDERKEY, l3.L_PARTKEY, l3.L_SUPPKEY, l3.L_LINENUMBER, l3.L_QUANTITY, l3.L_EXTENDEDPRICE, l3.L_DISCOUNT, l3.L_TAX, l3.L_RETURNFLAG, l3.L_LINESTATUS, l3.L_SHIPDATE, l3.L_COMMITDATE, l3.L_RECEIPTDATE, l3.L_SHIPINSTRUCT, l3.L_SHIPMODE, l3.L_COMMENT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |                     Filter: l3.L_ORDERKEY = outer_ref(l1.L_ORDERKEY) AND l3.L_SUPPKEY != outer_ref(l1.L_SUPPKEY) AND l3.L_RECEIPTDATE > l3.L_COMMITDATE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                       SubqueryAlias: l3                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                         TableScan: snowflake.TPCH_SF1.LINEITEM                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                 TableScan: snowflake.TPCH_SF1.SUPPLIER projection=[S_SUPPKEY, S_NAME, S_NATIONKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |               Filter: l1.L_RECEIPTDATE > l1.L_COMMITDATE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |                 SubqueryAlias: l1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |                   TableScan: snowflake.TPCH_SF1.LINEITEM projection=[L_ORDERKEY, L_SUPPKEY, L_COMMITDATE, L_RECEIPTDATE]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |             TableScan: snowflake.TPCH_SF1.ORDERS projection=[O_ORDERKEY], full_filters=[snowflake.TPCH_SF1.ORDERS.O_ORDERSTATUS = Utf8("F")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           TableScan: snowflake.TPCH_SF1.NATION projection=[N_NATIONKEY], full_filters=[snowflake.TPCH_SF1.NATION.N_NAME = Utf8("SAUDI ARABIA")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "S_NAME", count(1) AS "NUMWAIT" FROM "BENCHMARKS"."TPCH_SF1"."SUPPLIER" INNER JOIN "BENCHMARKS"."TPCH_SF1"."LINEITEM" AS "l1" ON (("SUPPLIER"."S_SUPPKEY" = "l1"."L_SUPPKEY") AND ((EXISTS (SELECT "l2"."L_ORDERKEY", "l2"."L_PARTKEY", "l2"."L_SUPPKEY", "l2"."L_LINENUMBER", "l2"."L_QUANTITY", "l2"."L_EXTENDEDPRICE", "l2"."L_DISCOUNT", "l2"."L_TAX", "l2"."L_RETURNFLAG", "l2"."L_LINESTATUS", "l2"."L_SHIPDATE", "l2"."L_COMMITDATE", "l2"."L_RECEIPTDATE", "l2"."L_SHIPINSTRUCT", "l2"."L_SHIPMODE", "l2"."L_COMMENT" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" AS "l2" WHERE (("l2"."L_ORDERKEY" = "l1"."L_ORDERKEY") AND ("l2"."L_SUPPKEY" <> "l1"."L_SUPPKEY"))) AND NOT EXISTS (SELECT "l3"."L_ORDERKEY", "l3"."L_PARTKEY", "l3"."L_SUPPKEY", "l3"."L_LINENUMBER", "l3"."L_QUANTITY", "l3"."L_EXTENDEDPRICE", "l3"."L_DISCOUNT", "l3"."L_TAX", "l3"."L_RETURNFLAG", "l3"."L_LINESTATUS", "l3"."L_SHIPDATE", "l3"."L_COMMITDATE", "l3"."L_RECEIPTDATE", "l3"."L_SHIPINSTRUCT", "l3"."L_SHIPMODE", "l3"."L_COMMENT" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" AS "l3" WHERE ((("l3"."L_ORDERKEY" = "l1"."L_ORDERKEY") AND ("l3"."L_SUPPKEY" <> "l1"."L_SUPPKEY")) AND ("l3"."L_RECEIPTDATE" > "l3"."L_COMMITDATE")))) AND ("l1"."L_RECEIPTDATE" > "l1"."L_COMMITDATE"))) INNER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("ORDERS"."O_ORDERKEY" = "l1"."L_ORDERKEY") AND ("ORDERS"."O_ORDERSTATUS" = 'F')) INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON (("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") AND ("NATION"."N_NAME" = 'SAUDI ARABIA')) GROUP BY "SUPPLIER"."S_NAME" ORDER BY "NUMWAIT" DESC NULLS FIRST, "S_NAME" ASC NULLS LAST LIMIT 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
