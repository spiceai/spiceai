source: crates/test-framework/src/snapshot/mod.rs
description: "Query: clickbench_q39"
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |  Limit: skip=1000, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     Projection: hits.URL, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       Aggregate: groupBy=[[hits.URL]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         TableScan: hits projection=[URL], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) >= CAST(Utf8("2013-07-01") AS Timestamp(ns)), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) <= CAST(Utf8("2013-07-31") AS Timestamp(ns)), CAST(hits.IsRefresh AS Int64) = Int64(0), CAST(hits.IsLink AS Int64) != Int64(0), CAST(hits.IsDownload AS Int64) = Int64(0)]                                                                                                                                                                                                                   |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "hits"."URL", count(1) AS "PageViews" FROM "hits" WHERE ((((((CAST("hits"."CounterID" AS BIGINT) = 62) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) >= CAST('2013-07-01' AS TIMESTAMP))) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) <= CAST('2013-07-31' AS TIMESTAMP))) AND (CAST("hits"."IsRefresh" AS BIGINT) = 0)) AND (CAST("hits"."IsLink" AS BIGINT) <> 0)) AND (CAST("hits"."IsDownload" AS BIGINT) = 0)) GROUP BY "hits"."URL" ORDER BY "PageViews" DESC NULLS FIRST LIMIT 10 OFFSET 1000 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
