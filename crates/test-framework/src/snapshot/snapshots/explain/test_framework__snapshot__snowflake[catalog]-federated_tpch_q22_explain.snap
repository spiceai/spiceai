|               |           Filter: snowflake.TPCH_SF1.CUSTOMER.C_ACCTBAL > (<subquery>) AND NOT EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |               Projection: avg(snowflake.TPCH_SF1.CUSTOMER.C_ACCTBAL)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                 Aggregate: groupBy=[[]], aggr=[[avg(snowflake.TPCH_SF1.CUSTOMER.C_ACCTBAL)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                   TableScan: snowflake.TPCH_SF1.CUSTOMER, full_filters=[snowflake.TPCH_SF1.CUSTOMER.C_ACCTBAL > Float64(0), substr(snowflake.TPCH_SF1.CUSTOMER.C_PHONE, Int64(1), Int64(2)) IN ([Utf8("13"), Utf8("31"), Utf8("23"), Utf8("29"), Utf8("30"), Utf8("18"), Utf8("17")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |             Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
