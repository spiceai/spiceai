|               |             BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |               VirtualExecutionPlan name=adbc compute_context=duckdb:file:./data/tpcds.db base_sql=SELECT "ss"."ss_sold_year", "ss"."ss_item_sk", "ss"."ss_customer_sk", "ss"."ss_qty", "ss"."ss_wc", "ss"."ss_sp", "ws"."ws_sold_year", "ws"."ws_item_sk", "ws"."ws_customer_sk", "ws"."ws_qty", "ws"."ws_wc", "ws"."ws_sp", "cs"."cs_sold_year", "cs"."cs_item_sk", "cs"."cs_customer_sk", "cs"."cs_qty", "cs"."cs_wc", "cs"."cs_sp" FROM (SELECT "date_dim"."d_year" AS "ss_sold_year", "store_sales"."ss_item_sk", "store_sales"."ss_customer_sk", sum("store_sales"."ss_quantity") AS "ss_qty", sum("store_sales"."ss_wholesale_cost") AS "ss_wc", sum("store_sales"."ss_sales_price") AS "ss_sp" FROM "store_sales" LEFT OUTER JOIN "store_returns" ON (("store_returns"."sr_ticket_number" = "store_sales"."ss_ticket_number") AND ("store_sales"."ss_item_sk" = "store_returns"."sr_item_sk")) INNER JOIN "date_dim" ON ("store_sales"."ss_sold_date_sk" = "date_dim"."d_date_sk") WHERE "store_returns"."sr_ticket_number" IS NULL GROUP BY "date_dim"."d_year", "store_sales"."ss_item_sk", "store_sales"."ss_customer_sk") AS "ss" LEFT OUTER JOIN (SELECT "date_dim"."d_year" AS "ws_sold_year", "web_sales"."ws_item_sk", "web_sales"."ws_bill_customer_sk" AS "ws_customer_sk", sum("web_sales"."ws_quantity") AS "ws_qty", sum("web_sales"."ws_wholesale_cost") AS "ws_wc", sum("web_sales"."ws_sales_price") AS "ws_sp" FROM "web_sales" LEFT OUTER JOIN "web_returns" ON (("web_returns"."wr_order_number" = "web_sales"."ws_order_number") AND ("web_sales"."ws_item_sk" = "web_returns"."wr_item_sk")) INNER JOIN "date_dim" ON ("web_sales"."ws_sold_date_sk" = "date_dim"."d_date_sk") WHERE "web_returns"."wr_order_number" IS NULL GROUP BY "date_dim"."d_year", "web_sales"."ws_item_sk", "web_sales"."ws_bill_customer_sk") AS "ws" ON ((("ws"."ws_sold_year" = "ss"."ss_sold_year") AND ("ws"."ws_item_sk" = "ss"."ss_item_sk")) AND ("ws"."ws_customer_sk" = "ss"."ss_customer_sk")) LEFT OUTER JOIN (SELECT "date_dim"."d_year" AS "cs_sold_year", "catalog_sales"."cs_item_sk", "catalog_sales"."cs_bill_customer_sk" AS "cs_customer_sk", sum("catalog_sales"."cs_quantity") AS "cs_qty", sum("catalog_sales"."cs_wholesale_cost") AS "cs_wc", sum("catalog_sales"."cs_sales_price") AS "cs_sp" FROM "catalog_sales" LEFT OUTER JOIN "catalog_returns" ON (("catalog_returns"."cr_order_number" = "catalog_sales"."cs_order_number") AND ("catalog_sales"."cs_item_sk" = "catalog_returns"."cr_item_sk")) INNER JOIN "date_dim" ON ("catalog_sales"."cs_sold_date_sk" = "date_dim"."d_date_sk") WHERE "catalog_returns"."cr_order_number" IS NULL GROUP BY "date_dim"."d_year", "catalog_sales"."cs_item_sk", "catalog_sales"."cs_bill_customer_sk") AS "cs" ON ((("cs"."cs_sold_year" = "ss"."ss_sold_year") AND ("cs"."cs_item_sk" = "ss"."ss_item_sk")) AND ("cs"."cs_customer_sk" = "ss"."ss_customer_sk")) WHERE ((coalesce("ws"."ws_qty", 0) > 0) OR (coalesce("cs"."cs_qty", 0) > 0)) AND ("ss"."ss_sold_year" = 2001) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
