| physical_plan | SortPreservingMergeExec: [ss_customer_sk@0 ASC NULLS LAST, store_qty@2 DESC, store_wholesale_cost@3 DESC, store_sales_price@4 DESC, other_chan_qty@5 ASC NULLS LAST, other_chan_wholesale_cost@6 ASC NULLS LAST, other_chan_sales_price@7 ASC NULLS LAST, ratio@1 ASC NULLS LAST], fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
