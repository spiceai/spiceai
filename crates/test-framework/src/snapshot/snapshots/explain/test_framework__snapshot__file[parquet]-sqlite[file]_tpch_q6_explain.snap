|               |               VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT `lineitem`.`l_extendedprice`, `lineitem`.`l_discount` FROM `lineitem` WHERE ((((`lineitem`.`l_shipdate` >= CAST('1994-01-01' AS TEXT)) AND (`lineitem`.`l_shipdate` < CAST('1995-01-01' AS TEXT))) AND (`lineitem`.`l_discount` BETWEEN (0.06 - 0.01) AND (0.06 + 0.01))) AND (`lineitem`.`l_quantity` < 24)) rewritten_executor_sql=SELECT `lineitem`.`l_extendedprice`, `lineitem`.`l_discount` FROM `lineitem` WHERE ((((`lineitem`.`l_shipdate` >= CAST('1994-01-01' AS TEXT)) AND (`lineitem`.`l_shipdate` < CAST('1995-01-01' AS TEXT))) AND (decimal_cmp(`lineitem`.`l_discount`, (decimal_sub(decimal('0.06'), decimal('0.01')))) >= 0 AND decimal_cmp(`lineitem`.`l_discount`, (decimal_add(decimal('0.06'), decimal('0.01')))) <= 0)) AND (`lineitem`.`l_quantity` < 24)) |
