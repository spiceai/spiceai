description: "Query: clickbench_q43"
---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |  Limit: skip=1000, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Sort: date_trunc(Utf8("minute"), M) ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     Projection: date_trunc(Utf8("minute"),to_timestamp(hits.EventTime)) AS M, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       Aggregate: groupBy=[[date_trunc(Utf8("minute"), CAST(to_timestamp(hits.EventTime) AS Timestamp(ns)))]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         TableScan: hits projection=[EventTime], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) >= CAST(Utf8("2013-07-14") AS Timestamp(ns)), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) <= CAST(Utf8("2013-07-15") AS Timestamp(ns)), CAST(hits.IsRefresh AS Int64) = Int64(0), CAST(hits.DontCountHits AS Int64) = Int64(0)]                                                                                                                                                                                                                                                                                                            |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT date_trunc('minute', CAST(to_timestamp("hits"."EventTime") AS TIMESTAMP)) AS "M", count(1) AS "PageViews" FROM "hits" WHERE (((((CAST("hits"."CounterID" AS BIGINT) = 62) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) >= CAST('2013-07-14' AS TIMESTAMP))) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) <= CAST('2013-07-15' AS TIMESTAMP))) AND (CAST("hits"."IsRefresh" AS BIGINT) = 0)) AND (CAST("hits"."DontCountHits" AS BIGINT) = 0)) GROUP BY date_trunc('minute', CAST(to_timestamp("hits"."EventTime") AS TIMESTAMP)) ORDER BY date_trunc('minute', "M") ASC NULLS LAST LIMIT 10 OFFSET 1000 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
