---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: clickbench_q29"
---
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |  Projection: CAST(k AS LargeUtf8) AS k, l, c, min(hits.Referer)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   Limit: skip=0, fetch=25                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     Sort: l DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       Projection: regexp_replace(hits.Referer,Utf8("^https?://(?:www\.)?([^/]+)/.*$"),Utf8("\1")) AS k, avg(length(hits.Referer)) AS l, count(Int64(1)) AS c, min(hits.Referer)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         Filter: count(Int64(1)) > Int64(100000)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           Aggregate: groupBy=[[regexp_replace(CAST(hits.Referer AS Utf8View), CAST(Utf8("^https?://(?:www\.)?([^/]+)/.*$") AS Utf8View), CAST(Utf8("\1") AS Utf8View))]], aggr=[[avg(CAST(length(hits.Referer) AS Float64)), count(Int64(1)), min(hits.Referer)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |             Filter: CAST(hits.Referer AS Utf8View) != CAST(Utf8("") AS Utf8View)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |               TableScan: hits projection=[Referer]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT CAST("k" AS TEXT) AS "k", "l", "c", "min(hits.Referer)" FROM (SELECT regexp_replace(CAST("hits"."Referer" AS VARCHAR), CAST('^https?://(?:www\.)?([^/]+)/.*$' AS VARCHAR), CAST('\1' AS VARCHAR)) AS "k", avg(CAST(length("hits"."Referer") AS DOUBLE)) AS "l", count(1) AS "c", min("hits"."Referer") FROM "hits" WHERE (CAST("hits"."Referer" AS VARCHAR) <> CAST('' AS VARCHAR)) GROUP BY regexp_replace(CAST("hits"."Referer" AS VARCHAR), CAST('^https?://(?:www\.)?([^/]+)/.*$' AS VARCHAR), CAST('\1' AS VARCHAR)) HAVING (count(1) > 100000) ORDER BY "l" DESC NULLS FIRST LIMIT 25) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
