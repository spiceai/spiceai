| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   Sort: REVENUE DESC NULLS FIRST, snowflake.TPCH_SF1.ORDERS.O_ORDERDATE ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Projection: snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY, sum(snowflake.TPCH_SF1.LINEITEM.L_EXTENDEDPRICE * Int64(1) - snowflake.TPCH_SF1.LINEITEM.L_DISCOUNT) AS REVENUE, snowflake.TPCH_SF1.ORDERS.O_ORDERDATE, snowflake.TPCH_SF1.ORDERS.O_SHIPPRIORITY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       Aggregate: groupBy=[[snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY, snowflake.TPCH_SF1.ORDERS.O_ORDERDATE, snowflake.TPCH_SF1.ORDERS.O_SHIPPRIORITY]], aggr=[[sum(snowflake.TPCH_SF1.LINEITEM.L_EXTENDEDPRICE * (Int64(1) - snowflake.TPCH_SF1.LINEITEM.L_DISCOUNT))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         Inner Join:  Filter: snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY = snowflake.TPCH_SF1.ORDERS.O_ORDERKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           Inner Join:  Filter: snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY = snowflake.TPCH_SF1.ORDERS.O_CUSTKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             TableScan: snowflake.TPCH_SF1.CUSTOMER projection=[C_CUSTKEY], full_filters=[snowflake.TPCH_SF1.CUSTOMER.C_MKTSEGMENT = Utf8("BUILDING")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |             TableScan: snowflake.TPCH_SF1.ORDERS projection=[O_ORDERKEY, O_CUSTKEY, O_ORDERDATE, O_SHIPPRIORITY], full_filters=[snowflake.TPCH_SF1.ORDERS.O_ORDERDATE < CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |           TableScan: snowflake.TPCH_SF1.LINEITEM projection=[L_ORDERKEY, L_EXTENDEDPRICE, L_DISCOUNT], full_filters=[snowflake.TPCH_SF1.LINEITEM.L_SHIPDATE > CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "L_ORDERKEY", sum(("LINEITEM"."L_EXTENDEDPRICE" * (1 - "LINEITEM"."L_DISCOUNT"))) AS "REVENUE", "O_ORDERDATE", "O_SHIPPRIORITY" FROM "BENCHMARKS"."TPCH_SF1"."CUSTOMER" INNER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("CUSTOMER"."C_CUSTKEY" = "ORDERS"."O_CUSTKEY") AND (("CUSTOMER"."C_MKTSEGMENT" = 'BUILDING') AND ("ORDERS"."O_ORDERDATE" < CAST('1995-03-15' AS DATE)))) INNER JOIN "BENCHMARKS"."TPCH_SF1"."LINEITEM" ON (("LINEITEM"."L_ORDERKEY" = "ORDERS"."O_ORDERKEY") AND ("LINEITEM"."L_SHIPDATE" > CAST('1995-03-15' AS DATE))) GROUP BY "LINEITEM"."L_ORDERKEY", "ORDERS"."O_ORDERDATE", "ORDERS"."O_SHIPPRIORITY" ORDER BY "REVENUE" DESC NULLS FIRST, "O_ORDERDATE" ASC NULLS LAST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
