|               |               HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(ss_item_sk@1, i_item_sk@0)], projection=[ca_state@0]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                 RepartitionExec: partitioning=Hash([ss_item_sk@1], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                   ProjectionExec: expr=[ca_state@1 as ca_state, ss_item_sk@5 as ss_item_sk]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                     SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                       BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                         VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `a`.`ca_address_sk`, `a`.`ca_state`, `c`.`c_customer_sk`, `c`.`c_current_addr_sk`, `s`.`ss_sold_date_sk`, `s`.`ss_item_sk`, `s`.`ss_customer_sk`, `d`.`d_date_sk`, `d`.`d_month_seq` FROM `customer_address` AS `a` INNER JOIN `customer` AS `c` ON (`a`.`ca_address_sk` = `c`.`c_current_addr_sk`) INNER JOIN `store_sales` AS `s` ON (`c`.`c_customer_sk` = `s`.`ss_customer_sk`) INNER JOIN `date_dim` AS `d` ON (`s`.`ss_sold_date_sk` = `d`.`d_date_sk`) WHERE (`d`.`d_month_seq` = (SELECT DISTINCT `date_dim`.`d_month_seq` FROM `date_dim` WHERE ((`date_dim`.`d_year` = 1998) AND (`date_dim`.`d_moy` = 3)))) |
|               |                 RepartitionExec: partitioning=Hash([i_item_sk@0], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                   HashJoinExec: mode=Partitioned, join_type=LeftSemi, accumulator=MinMaxLeftAccumulator, on=[(i_category@2, i_category@1)], filter=CAST(i_current_price@0 AS Decimal128(30, 15)) > CAST(1.2 * avg(j.i_current_price)@1 AS Decimal128(30, 15)), projection=[i_item_sk@0]                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |                     RepartitionExec: partitioning=Hash([i_category@2], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                       SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
