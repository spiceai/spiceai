description: "Query: clickbench_q37"
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     Projection: hits.URL, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       Aggregate: groupBy=[[hits.URL]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Filter: CAST(hits.URL AS Utf8View) != CAST(Utf8("") AS Utf8View)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |           TableScan: hits projection=[URL], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) >= CAST(Utf8("2013-07-01") AS Timestamp(ns)), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) <= CAST(Utf8("2013-07-31") AS Timestamp(ns)), CAST(hits.DontCountHits AS Int64) = Int64(0), CAST(hits.IsRefresh AS Int64) = Int64(0)]                                                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "hits"."URL", count(1) AS "PageViews" FROM "hits" WHERE (CAST("hits"."URL" AS VARCHAR) <> CAST('' AS VARCHAR)) AND (((((CAST("hits"."CounterID" AS BIGINT) = 62) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) >= CAST('2013-07-01' AS TIMESTAMP))) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) <= CAST('2013-07-31' AS TIMESTAMP))) AND (CAST("hits"."DontCountHits" AS BIGINT) = 0)) AND (CAST("hits"."IsRefresh" AS BIGINT) = 0)) GROUP BY "hits"."URL" ORDER BY "PageViews" DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
