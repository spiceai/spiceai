---
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |  Sort: pg.public.lineitem.l_returnflag ASC NULLS LAST, pg.public.lineitem.l_linestatus ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   Projection: pg.public.lineitem.l_returnflag, pg.public.lineitem.l_linestatus, sum(pg.public.lineitem.l_quantity) AS sum_qty, sum(pg.public.lineitem.l_extendedprice) AS sum_base_price, sum(pg.public.lineitem.l_extendedprice * Int64(1) - pg.public.lineitem.l_discount) AS sum_disc_price, sum(pg.public.lineitem.l_extendedprice * Int64(1) - pg.public.lineitem.l_discount * Int64(1) + pg.public.lineitem.l_tax) AS sum_charge, avg(pg.public.lineitem.l_quantity) AS avg_qty, avg(pg.public.lineitem.l_extendedprice) AS avg_price, avg(pg.public.lineitem.l_discount) AS avg_disc, count(Int64(1)) AS count_order                                                                                                                                                                                                                                                                                                                         |
|               |     Aggregate: groupBy=[[pg.public.lineitem.l_returnflag, pg.public.lineitem.l_linestatus]], aggr=[[sum(pg.public.lineitem.l_quantity), sum(pg.public.lineitem.l_extendedprice), sum(pg.public.lineitem.l_extendedprice * (Int64(1) - pg.public.lineitem.l_discount)), sum(pg.public.lineitem.l_extendedprice * (Int64(1) - pg.public.lineitem.l_discount) * (Int64(1) + pg.public.lineitem.l_tax)), avg(pg.public.lineitem.l_quantity), avg(pg.public.lineitem.l_extendedprice), avg(pg.public.lineitem.l_discount), count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       TableScan: pg.public.lineitem projection=[l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus], full_filters=[pg.public.lineitem.l_shipdate <= CAST(Utf8("1998-12-01") AS Date32) - IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 90, nanoseconds: 0 }")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "l_returnflag", "l_linestatus", sum("lineitem"."l_quantity") AS "sum_qty", sum("lineitem"."l_extendedprice") AS "sum_base_price", sum(("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount"))) AS "sum_disc_price", sum((("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount")) * (1 + "lineitem"."l_tax"))) AS "sum_charge", avg("lineitem"."l_quantity") AS "avg_qty", avg("lineitem"."l_extendedprice") AS "avg_price", avg("lineitem"."l_discount") AS "avg_disc", count(1) AS "count_order" FROM "public"."lineitem" WHERE ("lineitem"."l_shipdate" <= (CAST('1998-12-01' AS DATE) - INTERVAL '90 DAYS')) GROUP BY "lineitem"."l_returnflag", "lineitem"."l_linestatus" ORDER BY "l_returnflag" ASC NULLS LAST, "l_linestatus" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
