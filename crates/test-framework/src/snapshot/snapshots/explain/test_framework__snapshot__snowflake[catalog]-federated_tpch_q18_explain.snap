|               |                   Aggregate: groupBy=[[snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY]], aggr=[[sum(snowflake.TPCH_SF1.LINEITEM.L_QUANTITY)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
