|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "C_NAME", "C_CUSTKEY", "O_ORDERKEY", "O_ORDERDATE", "O_TOTALPRICE", sum("LINEITEM"."L_QUANTITY") FROM "BENCHMARKS"."TPCH_SF1"."CUSTOMER" INNER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("CUSTOMER"."C_CUSTKEY" = "ORDERS"."O_CUSTKEY") AND "ORDERS"."O_ORDERKEY" IN (SELECT "L_ORDERKEY" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" GROUP BY "LINEITEM"."L_ORDERKEY" HAVING (sum("LINEITEM"."L_QUANTITY") > 300))) INNER JOIN "BENCHMARKS"."TPCH_SF1"."LINEITEM" ON ("ORDERS"."O_ORDERKEY" = "LINEITEM"."L_ORDERKEY") GROUP BY "CUSTOMER"."C_NAME", "CUSTOMER"."C_CUSTKEY", "ORDERS"."O_ORDERKEY", "ORDERS"."O_ORDERDATE", "ORDERS"."O_TOTALPRICE" ORDER BY "O_TOTALPRICE" DESC NULLS FIRST, "O_ORDERDATE" ASC NULLS LAST |
