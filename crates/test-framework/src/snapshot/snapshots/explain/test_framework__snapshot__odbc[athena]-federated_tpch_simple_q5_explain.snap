| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                       |
|               |  Sort: total_price DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                             |
|               |   Projection: sum(o.o_totalprice) AS total_price, l.l_linestatus                                                                                                                                                                                                                                                                                                                |
|               |     Aggregate: groupBy=[[l.l_linestatus]], aggr=[[sum(o.o_totalprice)]]                                                                                                                                                                                                                                                                                                         |
|               |       Inner Join:  Filter: o.o_orderkey = l.l_orderkey                                                                                                                                                                                                                                                                                                                          |
|               |         SubqueryAlias: o                                                                                                                                                                                                                                                                                                                                                        |
|               |           TableScan: orders projection=[o_orderkey, o_totalprice]                                                                                                                                                                                                                                                                                                               |
|               |         SubqueryAlias: l                                                                                                                                                                                                                                                                                                                                                        |
|               |           TableScan: lineitem projection=[l_orderkey, l_linestatus]                                                                                                                                                                                                                                                                                                             |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                              |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                               |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                          |
|               |       VirtualExecutionPlan name=odbc compute_context=077d9b3fa2ecf0bc5a089d4ec267cf9216120d3bbe7cbc7f383b99b40aceab61 base_sql=SELECT sum("o"."o_totalprice") AS "total_price", "l"."l_linestatus" FROM "tpch"."orders" AS "o" INNER JOIN "tpch"."lineitem" AS "l" ON ("o"."o_orderkey" = "l"."l_orderkey") GROUP BY "l"."l_linestatus" ORDER BY "total_price" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                 |
