+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                              |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                         |
|               |  Sort: total_price DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                               |
|               |   Projection: sum(o.o_totalprice) AS total_price, l.l_linestatus                                                                                                                                                                                                                                                                                                  |
|               |     Aggregate: groupBy=[[l.l_linestatus]], aggr=[[sum(o.o_totalprice)]]                                                                                                                                                                                                                                                                                           |
|               |       Inner Join:  Filter: o.o_orderkey = l.l_orderkey                                                                                                                                                                                                                                                                                                            |
|               |         SubqueryAlias: o                                                                                                                                                                                                                                                                                                                                          |
|               |           TableScan: orders projection=[o_orderkey, o_totalprice]                                                                                                                                                                                                                                                                                                 |
|               |         SubqueryAlias: l                                                                                                                                                                                                                                                                                                                                          |
|               |           TableScan: lineitem projection=[l_orderkey, l_linestatus]                                                                                                                                                                                                                                                                                               |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                 |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                            |
|               |       VirtualExecutionPlan name=adbc compute_context=de69e2e8a78269b25e483452df2f22cb5083f81f94ec7b76bdeaca5b5011da83 base_sql=SELECT sum(`o`.`o_totalprice`) AS `total_price`, `l`.`l_linestatus` FROM `orders` AS `o` INNER JOIN `lineitem` AS `l` ON (`o`.`o_orderkey` = `l`.`l_orderkey`) GROUP BY `l`.`l_linestatus` ORDER BY `total_price` DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                   |
