| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |  Limit: skip=1000, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   Sort: date_trunc(Utf8("minute"), M) ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     Projection: date_trunc(Utf8("minute"),to_timestamp(hits.EventTime)) AS M, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       Aggregate: groupBy=[[date_trunc(Utf8("minute"), CAST(to_timestamp(hits.EventTime) AS Timestamp(ns)))]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Filter: hits.CounterID = Int64(62) AND to_timestamp(hits.EventDate * Int64(86400)) >= Utf8("2013-07-14") AND to_timestamp(hits.EventDate * Int64(86400)) <= Utf8("2013-07-15") AND hits.IsRefresh = Int64(0) AND hits.DontCountHits = Int64(0)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           TableScan: hits projection=[EventTime, EventDate, CounterID, IsRefresh, DontCountHits], partial_filters=[hits.CounterID = Int64(62), to_timestamp(hits.EventDate * Int64(86400)) >= Utf8("2013-07-14"), to_timestamp(hits.EventDate * Int64(86400)) <= Utf8("2013-07-15"), hits.IsRefresh = Int64(0), hits.DontCountHits = Int64(0)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |       VirtualExecutionPlan name=spice.ai compute_context=url=https://us-east-1-prod-aws-flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench base_sql=SELECT date_trunc('minute', CAST(to_timestamp("hits"."EventTime") AS TIMESTAMP)) AS "M", count(1) AS "PageViews" FROM "clickbench"."hits" WHERE ((((("hits"."CounterID" = 62) AND (to_timestamp(("hits"."EventDate" * 86400)) >= '2013-07-14')) AND (to_timestamp(("hits"."EventDate" * 86400)) <= '2013-07-15')) AND ("hits"."IsRefresh" = 0)) AND ("hits"."DontCountHits" = 0)) AND ((((("hits"."CounterID" = 62) AND (to_timestamp(("hits"."EventDate" * 86400)) >= '2013-07-14')) AND (to_timestamp(("hits"."EventDate" * 86400)) <= '2013-07-15')) AND ("hits"."IsRefresh" = 0)) AND ("hits"."DontCountHits" = 0)) GROUP BY date_trunc('minute', CAST(to_timestamp("hits"."EventTime") AS TIMESTAMP)) ORDER BY date_trunc('minute', "M") ASC NULLS LAST LIMIT 10 OFFSET 1000 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
