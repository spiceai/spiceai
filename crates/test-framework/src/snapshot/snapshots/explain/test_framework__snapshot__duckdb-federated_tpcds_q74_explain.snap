|               |               VirtualExecutionPlan name=adbc compute_context=duckdb:file:./data/tpcds.db base_sql=SELECT "t_s_firstyear"."customer_id", "t_s_firstyear"."year", "t_s_firstyear"."year_total", "t_s_firstyear"."sale_type", "t_s_secyear"."customer_id", "t_s_secyear"."customer_first_name", "t_s_secyear"."customer_last_name", "t_s_secyear"."year", "t_s_secyear"."year_total", "t_s_secyear"."sale_type", "t_w_firstyear"."customer_id", "t_w_firstyear"."year", "t_w_firstyear"."year_total", "t_w_firstyear"."sale_type" FROM (SELECT "customer"."c_customer_id" AS "customer_id", "date_dim"."d_year" AS "year", stddev("store_sales"."ss_net_paid") AS "year_total", 's' AS "sale_type" FROM "customer" INNER JOIN "store_sales" ON ("customer"."c_customer_sk" = "store_sales"."ss_customer_sk") INNER JOIN "date_dim" ON ("store_sales"."ss_sold_date_sk" = "date_dim"."d_date_sk") WHERE "date_dim"."d_year" IN (2001, (2001 + 1)) GROUP BY "customer"."c_customer_id", "customer"."c_first_name", "customer"."c_last_name", "date_dim"."d_year" UNION ALL SELECT "customer"."c_customer_id" AS "customer_id", "date_dim"."d_year" AS "year", stddev("web_sales"."ws_net_paid") AS "year_total", 'w' AS "sale_type" FROM "customer" INNER JOIN "web_sales" ON ("customer"."c_customer_sk" = "web_sales"."ws_bill_customer_sk") INNER JOIN "date_dim" ON ("web_sales"."ws_sold_date_sk" = "date_dim"."d_date_sk") WHERE "date_dim"."d_year" IN (2001, (2001 + 1)) GROUP BY "customer"."c_customer_id", "customer"."c_first_name", "customer"."c_last_name", "date_dim"."d_year") AS "t_s_firstyear" INNER JOIN (SELECT "customer"."c_customer_id" AS "customer_id", "customer"."c_first_name" AS "customer_first_name", "customer"."c_last_name" AS "customer_last_name", "date_dim"."d_year" AS "year", stddev("store_sales"."ss_net_paid") AS "year_total", 's' AS "sale_type" FROM "customer" INNER JOIN "store_sales" ON ("customer"."c_customer_sk" = "store_sales"."ss_customer_sk") INNER JOIN "date_dim" ON ("store_sales"."ss_sold_date_sk" = "date_dim"."d_date_sk") WHERE "date_dim"."d_year" IN (2001, (2001 + 1)) GROUP BY "customer"."c_customer_id", "customer"."c_first_name", "customer"."c_last_name", "date_dim"."d_year" UNION ALL SELECT "customer"."c_customer_id" AS "customer_id", "customer"."c_first_name" AS "customer_first_name", "customer"."c_last_name" AS "customer_last_name", "date_dim"."d_year" AS "year", stddev("web_sales"."ws_net_paid") AS "year_total", 'w' AS "sale_type" FROM "customer" INNER JOIN "web_sales" ON ("customer"."c_customer_sk" = "web_sales"."ws_bill_customer_sk") INNER JOIN "date_dim" ON ("web_sales"."ws_sold_date_sk" = "date_dim"."d_date_sk") WHERE "date_dim"."d_year" IN (2001, (2001 + 1)) GROUP BY "customer"."c_customer_id", "customer"."c_first_name", "customer"."c_last_name", "date_dim"."d_year") AS "t_s_secyear" ON ("t_s_secyear"."customer_id" = "t_s_firstyear"."customer_id") INNER JOIN (SELECT "customer"."c_customer_id" AS "customer_id", "date_dim"."d_year" AS "year", stddev("store_sales"."ss_net_paid") AS "year_total", 's' AS "sale_type" FROM "customer" INNER JOIN "store_sales" ON ("customer"."c_customer_sk" = "store_sales"."ss_customer_sk") INNER JOIN "date_dim" ON ("store_sales"."ss_sold_date_sk" = "date_dim"."d_date_sk") WHERE "date_dim"."d_year" IN (2001, (2001 + 1)) GROUP BY "customer"."c_customer_id", "customer"."c_first_name", "customer"."c_last_name", "date_dim"."d_year" UNION ALL SELECT "customer"."c_customer_id" AS "customer_id", "date_dim"."d_year" AS "year", stddev("web_sales"."ws_net_paid") AS "year_total", 'w' AS "sale_type" FROM "customer" INNER JOIN "web_sales" ON ("customer"."c_customer_sk" = "web_sales"."ws_bill_customer_sk") INNER JOIN "date_dim" ON ("web_sales"."ws_sold_date_sk" = "date_dim"."d_date_sk") WHERE "date_dim"."d_year" IN (2001, (2001 + 1)) GROUP BY "customer"."c_customer_id", "customer"."c_first_name", "customer"."c_last_name", "date_dim"."d_year") AS "t_w_firstyear" ON ("t_s_firstyear"."customer_id" = "t_w_firstyear"."customer_id") WHERE ((("t_s_firstyear"."sale_type" = 's') AND ("t_s_firstyear"."year" = 2001)) AND ("t_s_firstyear"."year_total" > 0)) AND (("t_s_secyear"."sale_type" = 's') AND ("t_s_secyear"."year" = (2001 + 1))) AND ((("t_w_firstyear"."sale_type" = 'w') AND ("t_w_firstyear"."year" = 2001)) AND ("t_w_firstyear"."year_total" > 0)) |
|               |       RepartitionExec: partitioning=Hash([customer_id@0], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             