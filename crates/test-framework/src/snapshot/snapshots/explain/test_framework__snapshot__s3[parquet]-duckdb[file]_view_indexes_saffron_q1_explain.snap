---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: saffron_q1"
---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: A.MaxRate ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   Projection: A.MaxRate, count(Int64(1)) AS Count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     Aggregate: groupBy=[[A.MaxRate]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |       SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         TableScan: number_info_with_cap projection=[MaxRate], full_filters=[number_info_with_cap.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info_with_cap.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info_with_cap.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info_with_cap.Capability = LargeUtf8("sms"), number_info_with_cap.AvailableForNumberSelection = Int8(1) OR number_info_with_cap.AvailableForNumberSelection = Int8(0)]                                        |
| physical_plan | SortPreservingMergeExec: [MaxRate@0 ASC NULLS LAST]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   SortExec: expr=[MaxRate@0 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     ProjectionExec: expr=[MaxRate@0 as MaxRate, count(Int64(1))@1 as Count]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       AggregateExec: mode=FinalPartitioned, gby=[MaxRate@0 as MaxRate], aggr=[count(Int64(1))]                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         RepartitionExec: partitioning=Hash([MaxRate@0], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |           AggregateExec: mode=Partial, gby=[MaxRate@0 as MaxRate], aggr=[count(Int64(1))]                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             RepartitionExec: partitioning=RoundRobinBatch(32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |               SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                 CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |                   BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                     DuckSqlExec sql=WITH _intermediate_materialize AS MATERIALIZED (SELECT "AvailableForNumberSelection", "Capability", "MaxRate", "NumberSid" FROM number_info_with_cap WHERE "AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066' AND "NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9') SELECT "MaxRate" FROM _intermediate_materialize WHERE (true) AND (true) AND ("NumberSid" <> 'PN00000000000000000000000000000099') AND ("Capability" = 'sms') AND (("AvailableForNumberSelection" = 1) OR ("AvailableForNumberSelection" = 0)) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
