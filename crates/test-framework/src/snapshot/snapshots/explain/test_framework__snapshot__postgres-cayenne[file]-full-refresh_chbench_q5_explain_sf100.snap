| logical_plan  | Sort: revenue DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                            |
|               |   Projection: nation.n_name, sum(order_line.ol_amount) AS revenue                                                                                                                                                                                                                                                                                         |
|               |     Aggregate: groupBy=[[nation.n_name]], aggr=[[sum(order_line.ol_amount)]]                                                                                                                                                                                                                                                                              |
|               |       Projection: order_line.ol_amount, nation.n_name                                                                                                                                                                                                                                                                                                     |
|               |         Inner Join: nation.n_regionkey = region.r_regionkey                                                                                                                                                                                                                                                                                               |
