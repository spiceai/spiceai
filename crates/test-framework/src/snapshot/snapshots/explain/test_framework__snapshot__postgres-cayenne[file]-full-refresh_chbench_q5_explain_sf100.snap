|               |               Projection: order_line.ol_amount, supplier.su_nationkey                                                                                                                                                                                                                                                                                     |
|               |                 Inner Join: mod(CAST(stock.s_w_id * stock.s_i_id AS Int64), Int64(10000)) = supplier.su_suppkey, CAST(ascii(substr(customer.c_state, Int64(1), Int64(1))) AS Int64) - Int64(65) = supplier.su_nationkey                                                                                                                                   |
