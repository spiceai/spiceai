|               |                     Inner Join: order_line.ol_w_id = stock.s_w_id, order_line.ol_i_id = stock.s_i_id                                                                                                                                                                                                                                                      |
|               |                       Projection: customer.c_state, order_line.ol_w_id, order_line.ol_i_id, order_line.ol_amount                                                                                                                                                                                                                                          |
|               |                         Inner Join: oorder.o_id = order_line.ol_o_id, oorder.o_w_id = order_line.ol_w_id, oorder.o_d_id = order_line.ol_d_id                                                                                                                                                                                                              |
|               |                           Projection: customer.c_state, oorder.o_id, oorder.o_d_id, oorder.o_w_id                                                                                                                                                                                                                                                         |
