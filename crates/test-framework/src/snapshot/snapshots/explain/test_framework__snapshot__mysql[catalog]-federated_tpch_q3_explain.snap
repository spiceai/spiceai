| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   Sort: revenue DESC NULLS FIRST, mysql.tpch_sf1.orders.o_orderdate ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     Projection: mysql.tpch_sf1.lineitem.l_orderkey, sum(mysql.tpch_sf1.lineitem.l_extendedprice * Int64(1) - mysql.tpch_sf1.lineitem.l_discount) AS revenue, mysql.tpch_sf1.orders.o_orderdate, mysql.tpch_sf1.orders.o_shippriority                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       Aggregate: groupBy=[[mysql.tpch_sf1.lineitem.l_orderkey, mysql.tpch_sf1.orders.o_orderdate, mysql.tpch_sf1.orders.o_shippriority]], aggr=[[sum(mysql.tpch_sf1.lineitem.l_extendedprice * (Int64(1) - mysql.tpch_sf1.lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |         Inner Join:  Filter: mysql.tpch_sf1.lineitem.l_orderkey = mysql.tpch_sf1.orders.o_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           Inner Join:  Filter: mysql.tpch_sf1.customer.c_custkey = mysql.tpch_sf1.orders.o_custkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             TableScan: mysql.tpch_sf1.customer projection=[c_custkey], full_filters=[mysql.tpch_sf1.customer.c_mktsegment = Utf8("BUILDING")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |             TableScan: mysql.tpch_sf1.orders projection=[o_orderkey, o_custkey, o_orderdate, o_shippriority], full_filters=[mysql.tpch_sf1.orders.o_orderdate < CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |           TableScan: mysql.tpch_sf1.lineitem projection=[l_orderkey, l_extendedprice, l_discount], full_filters=[mysql.tpch_sf1.lineitem.l_shipdate > CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `l_orderkey`, sum((`lineitem`.`l_extendedprice` * (1 - `lineitem`.`l_discount`))) AS `revenue`, `o_orderdate`, `o_shippriority` FROM `tpch_sf1`.`customer` INNER JOIN `tpch_sf1`.`orders` ON ((`customer`.`c_custkey` = `orders`.`o_custkey`) AND ((`customer`.`c_mktsegment` = 'BUILDING') AND (`orders`.`o_orderdate` < CAST('1995-03-15' AS DATE)))) INNER JOIN `tpch_sf1`.`lineitem` ON ((`lineitem`.`l_orderkey` = `orders`.`o_orderkey`) AND (`lineitem`.`l_shipdate` > CAST('1995-03-15' AS DATE))) GROUP BY `lineitem`.`l_orderkey`, `orders`.`o_orderdate`, `orders`.`o_shippriority` ORDER BY `revenue` DESC, `o_orderdate` ASC LIMIT 10 |
