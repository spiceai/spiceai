|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "sender_info"."AccountSid", "sender_info"."NumberPoolSid", "sender_info"."SenderSid", "sender_info"."SenderIdentity", "sender_info"."Region", "sender_info"."Rate", "sender_info"."SenderType", "sender_info"."LastUsed", "sender_info"."DateCreated", "sender_info"."DateUpdated" FROM "sender_info" WHERE (("sender_info"."AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066') AND ("sender_info"."SenderIdentity" = '55800')) ORDER BY "sender_info"."DateCreated" ASC NULLS LAST, "sender_info"."SenderSid" ASC NULLS LAST LIMIT 1 |
