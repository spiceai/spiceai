|               |                     VirtualExecutionPlan name=lineitem compute_context=//data/lineitem.turso base_sql=SELECT `lineitem`.`l_partkey`, `lineitem`.`l_quantity`, `lineitem`.`l_extendedprice`, `lineitem`.`l_discount`, `lineitem`.`l_shipinstruct`, `lineitem`.`l_shipmode` FROM `lineitem` WHERE ((((((`lineitem`.`l_quantity` >= 1) AND (`lineitem`.`l_quantity` <= (1 + 10))) AND `lineitem`.`l_shipmode` IN ('AIR', 'AIR REG')) AND (`lineitem`.`l_shipinstruct` = 'DELIVER IN PERSON')) OR ((((`lineitem`.`l_quantity` >= 10) AND (`lineitem`.`l_quantity` <= (10 + 10))) AND `lineitem`.`l_shipmode` IN ('AIR', 'AIR REG')) AND (`lineitem`.`l_shipinstruct` = 'DELIVER IN PERSON'))) OR ((((`lineitem`.`l_quantity` >= 20) AND (`lineitem`.`l_quantity` <= (20 + 10))) AND `lineitem`.`l_shipmode` IN ('AIR', 'AIR REG')) AND (`lineitem`.`l_shipinstruct` = 'DELIVER IN PERSON')))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
