|               |       TableScan: store_sales projection=[ss_sold_date_sk, ss_customer_sk, ss_hdemo_sk, ss_store_sk, ss_ticket_number]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       TableScan: date_dim projection=[d_date_sk], full_filters=[date_dim.d_dom BETWEEN Int64(1) AND Int64(3) OR date_dim.d_dom BETWEEN Int64(25) AND Int64(28), date_dim.d_year IN ([Int64(2000), Int64(2000) + Int64(1), Int64(2000) + Int64(2)])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     TableScan: store projection=[s_store_sk], full_filters=[store.s_county IN ([Utf8("Williamson County"), Utf8("Williamson County"), Utf8("Williamson County"), Utf8("Williamson County"), Utf8("Williamson County"), Utf8("Williamson County"), Utf8("Williamson County"), Utf8("Williamson County")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
