---
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |  Projection: sum(mysql.tpch_sf1.lineitem.l_extendedprice) / Float64(7) AS avg_yearly                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Aggregate: groupBy=[[]], aggr=[[sum(mysql.tpch_sf1.lineitem.l_extendedprice)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Inner Join:  Filter: mysql.tpch_sf1.part.p_partkey = mysql.tpch_sf1.lineitem.l_partkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       Filter: mysql.tpch_sf1.lineitem.l_quantity < (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           Projection: Float64(0.2) * avg(mysql.tpch_sf1.lineitem.l_quantity)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             Aggregate: groupBy=[[]], aggr=[[avg(mysql.tpch_sf1.lineitem.l_quantity)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               Filter: mysql.tpch_sf1.lineitem.l_partkey = outer_ref(mysql.tpch_sf1.part.p_partkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                 TableScan: mysql.tpch_sf1.lineitem                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         TableScan: mysql.tpch_sf1.lineitem projection=[l_partkey, l_quantity, l_extendedprice]                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       TableScan: mysql.tpch_sf1.part projection=[p_partkey], full_filters=[mysql.tpch_sf1.part.p_brand = Utf8("Brand#23"), mysql.tpch_sf1.part.p_container = Utf8("MED BOX")]                                                                                                                                                                                                                                                                                                                                                                                          |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT (sum(`lineitem`.`l_extendedprice`) / 7.0) AS `avg_yearly` FROM `tpch_sf1`.`lineitem` INNER JOIN `tpch_sf1`.`part` ON (`part`.`p_partkey` = `lineitem`.`l_partkey`) WHERE (`lineitem`.`l_quantity` < (SELECT (0.2 * avg(`lineitem`.`l_quantity`)) FROM `tpch_sf1`.`lineitem` WHERE (`lineitem`.`l_partkey` = `part`.`p_partkey`))) AND (`part`.`p_brand` = 'Brand#23') AND (`part`.`p_container` = 'MED BOX') |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
