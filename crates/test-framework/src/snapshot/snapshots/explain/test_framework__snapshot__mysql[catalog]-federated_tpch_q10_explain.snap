+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Limit: skip=0, fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   Sort: revenue DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     Projection: mysql.tpch_sf1.customer.c_custkey, mysql.tpch_sf1.customer.c_name, sum(mysql.tpch_sf1.lineitem.l_extendedprice * Int64(1) - mysql.tpch_sf1.lineitem.l_discount) AS revenue, mysql.tpch_sf1.customer.c_acctbal, mysql.tpch_sf1.nation.n_name, mysql.tpch_sf1.customer.c_address, mysql.tpch_sf1.customer.c_phone, mysql.tpch_sf1.customer.c_comment                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       Aggregate: groupBy=[[mysql.tpch_sf1.customer.c_custkey, mysql.tpch_sf1.customer.c_name, mysql.tpch_sf1.customer.c_acctbal, mysql.tpch_sf1.customer.c_phone, mysql.tpch_sf1.nation.n_name, mysql.tpch_sf1.customer.c_address, mysql.tpch_sf1.customer.c_comment]], aggr=[[sum(mysql.tpch_sf1.lineitem.l_extendedprice * (Int64(1) - mysql.tpch_sf1.lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |         Inner Join:  Filter: mysql.tpch_sf1.customer.c_nationkey = mysql.tpch_sf1.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           Inner Join:  Filter: mysql.tpch_sf1.lineitem.l_orderkey = mysql.tpch_sf1.orders.o_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             Inner Join:  Filter: mysql.tpch_sf1.customer.c_custkey = mysql.tpch_sf1.orders.o_custkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |               TableScan: mysql.tpch_sf1.customer projection=[c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_comment]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |               TableScan: mysql.tpch_sf1.orders projection=[o_orderkey, o_custkey], full_filters=[mysql.tpch_sf1.orders.o_orderdate >= CAST(Utf8("1993-10-01") AS Date32), mysql.tpch_sf1.orders.o_orderdate < CAST(Utf8("1994-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |             TableScan: mysql.tpch_sf1.lineitem projection=[l_orderkey, l_extendedprice, l_discount], full_filters=[mysql.tpch_sf1.lineitem.l_returnflag = Utf8("R")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           TableScan: mysql.tpch_sf1.nation projection=[n_nationkey, n_name]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `c_custkey`, `c_name`, sum((`lineitem`.`l_extendedprice` * (1 - `lineitem`.`l_discount`))) AS `revenue`, `c_acctbal`, `n_name`, `c_address`, `c_phone`, `c_comment` FROM `tpch_sf1`.`customer` INNER JOIN `tpch_sf1`.`orders` ON ((`customer`.`c_custkey` = `orders`.`o_custkey`) AND ((`orders`.`o_orderdate` >= CAST('1993-10-01' AS DATE)) AND (`orders`.`o_orderdate` < CAST('1994-01-01' AS DATE)))) INNER JOIN `tpch_sf1`.`lineitem` ON ((`lineitem`.`l_orderkey` = `orders`.`o_orderkey`) AND (`lineitem`.`l_returnflag` = 'R')) INNER JOIN `tpch_sf1`.`nation` ON (`customer`.`c_nationkey` = `nation`.`n_nationkey`) GROUP BY `customer`.`c_custkey`, `customer`.`c_name`, `customer`.`c_acctbal`, `customer`.`c_phone`, `nation`.`n_name`, `customer`.`c_address`, `customer`.`c_comment` ORDER BY `revenue` DESC LIMIT 20 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
