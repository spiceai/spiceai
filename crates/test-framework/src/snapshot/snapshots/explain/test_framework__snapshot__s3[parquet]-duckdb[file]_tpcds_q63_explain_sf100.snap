| logical_plan  | Sort: tmp1.i_manager_id ASC NULLS LAST, tmp1.avg_monthly_sales ASC NULLS LAST, tmp1.sum_sales ASC NULLS LAST, fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
