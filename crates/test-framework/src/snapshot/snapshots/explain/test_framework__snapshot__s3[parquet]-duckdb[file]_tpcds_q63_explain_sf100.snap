|               |           TableScan: item projection=[i_item_sk, i_manager_id], full_filters=[item.i_category IN ([Utf8("Books"), Utf8("Children"), Utf8("Electronics")]) AND item.i_class IN ([Utf8("personal"), Utf8("portable"), Utf8("reference"), Utf8("self-help")]) AND item.i_brand IN ([Utf8("scholaramalgamalg #14"), Utf8("scholaramalgamalg #7"), Utf8("exportiunivamalg #9"), Utf8("scholaramalgamalg #9")]) OR item.i_category IN ([Utf8("Women"), Utf8("Music"), Utf8("Men")]) AND item.i_class IN ([Utf8("accessories"), Utf8("classical"), Utf8("fragrances"), Utf8("pants")]) AND item.i_brand IN ([Utf8("amalgimporto #1"), Utf8("edu packscholar #1"), Utf8("exportiimporto #1"), Utf8("importoamalg #1")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
