|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT (sum("LINEITEM"."L_EXTENDEDPRICE") / 7.0) AS "AVG_YEARLY" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" INNER JOIN "BENCHMARKS"."TPCH_SF1"."PART" ON (("PART"."P_PARTKEY" = "LINEITEM"."L_PARTKEY") AND ((("LINEITEM"."L_QUANTITY" < (SELECT (0.2 * avg("LINEITEM"."L_QUANTITY")) FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" WHERE ("LINEITEM"."L_PARTKEY" = "PART"."P_PARTKEY"))) AND ("PART"."P_BRAND" = 'Brand#23')) AND ("PART"."P_CONTAINER" = 'MED BOX'))) |
