|               |               TableScan: pg.public.part projection=[p_partkey, p_mfgr], full_filters=[pg.public.part.p_size = Int64(15), pg.public.part.p_type LIKE Utf8("%BRASS")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
