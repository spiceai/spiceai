|               |           Inner Join:  Filter: pg.public.part.p_partkey = pg.public.partsupp.ps_partkey AND pg.public.supplier.s_suppkey = pg.public.partsupp.ps_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
