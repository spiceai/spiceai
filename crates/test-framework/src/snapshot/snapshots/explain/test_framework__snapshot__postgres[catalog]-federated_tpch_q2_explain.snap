|               |                       TableScan: pg.public.region, full_filters=[pg.public.region.r_name = Utf8("EUROPE")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
