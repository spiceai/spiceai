source: crates/test-framework/src/snapshot/mod.rs
description: "Query: chbench_q16"
---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |  Sort: supplier_cnt DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Projection: item.i_name, substr(item.i_data,Int64(1),Int64(3)) AS brand, item.i_price, count(DISTINCT mod(stock.s_w_id * stock.s_i_id,Int64(10000))) AS supplier_cnt                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Aggregate: groupBy=[[item.i_name, substr(item.i_data, Int64(1), Int64(3)), item.i_price]], aggr=[[count(DISTINCT mod(stock.s_w_id * stock.s_i_id, Int64(10000)))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       Inner Join:  Filter: item.i_id = stock.s_i_id                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |         Filter: mod(stock.s_w_id * stock.s_i_id, Int64(10000)) NOT IN (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |             Projection: supplier.su_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               TableScan: supplier, full_filters=[supplier.su_comment LIKE Utf8("%bad%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |           TableScan: stock projection=[s_i_id, s_w_id]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         TableScan: item projection=[i_id, i_name, i_price, i_data], full_filters=[item.i_data NOT LIKE Utf8("zz%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "item"."i_name", substr("item"."i_data", 1, 3) AS "brand", "item"."i_price", count(DISTINCT mod(("stock"."s_w_id" * "stock"."s_i_id"), 10000)) AS "supplier_cnt" FROM "stock" INNER JOIN "item" ON (("item"."i_id" = "stock"."s_i_id") AND (mod(("stock"."s_w_id" * "stock"."s_i_id"), 10000) NOT IN (SELECT "supplier"."su_suppkey" FROM "supplier" WHERE "supplier"."su_comment" LIKE '%bad%') AND "item"."i_data" NOT LIKE 'zz%')) GROUP BY "item"."i_name", substr("item"."i_data", 1, 3), "item"."i_price" ORDER BY "supplier_cnt" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
