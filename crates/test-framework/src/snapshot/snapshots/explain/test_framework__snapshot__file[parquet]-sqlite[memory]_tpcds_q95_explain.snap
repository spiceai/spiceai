|               |               Filter: date_dim.d_date >= Date32("2002-05-01") AND date_dim.d_date <= Date32("2002-06-30")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                 Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Projection: date_dim.d_date_sk, date_dim.d_date                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   TableScan: date_dim projection=[d_date_sk, d_date]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| physical_plan | ProjectionExec: expr=[count(alias1)@0 as order count, sum(alias2)@1 as total shipping cost, sum(alias3)@2 as total net profit]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   GlobalLimitExec: skip=0, fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     AggregateExec: mode=Final, gby=[], aggr=[count(alias1), sum(alias2), sum(alias3)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       CoalescePartitionsExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |         AggregateExec: mode=Partial, gby=[], aggr=[count(alias1), sum(alias2), sum(alias3)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |           AggregateExec: mode=FinalPartitioned, gby=[alias1@0 as alias1], aggr=[sum(ws1.ws_ext_ship_cost) as alias2, sum(ws1.ws_net_profit) as alias3]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |             RepartitionExec: partitioning=Hash([alias1@0], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |               AggregateExec: mode=Partial, gby=[ws_order_number@0 as alias1], aggr=[sum(ws1.ws_ext_ship_cost) as alias2, sum(ws1.ws_net_profit) as alias3]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                 HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(ws_ship_date_sk@0, d_date_sk@0)], projection=[ws_order_number@1, ws_ext_ship_cost@2, ws_net_profit@3]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                   RepartitionExec: partitioning=Hash([ws_ship_date_sk@0], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                     HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(ws_ship_addr_sk@1, ca_address_sk@0)], projection=[ws_ship_date_sk@0, ws_order_number@2, ws_ext_ship_cost@3, ws_net_profit@4]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                       RepartitionExec: partitioning=Hash([ws_ship_addr_sk@1], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                         HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(ws_web_site_sk@2, web_site_sk@0)], projection=[ws_ship_date_sk@0, ws_ship_addr_sk@1, ws_order_number@3, ws_ext_ship_cost@4, ws_net_profit@5]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                           RepartitionExec: partitioning=Hash([ws_web_site_sk@2], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |                             SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                               BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                                 VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `ws1`.`ws_ship_date_sk`, `ws1`.`ws_ship_addr_sk`, `ws1`.`ws_web_site_sk`, `ws1`.`ws_order_number`, `ws1`.`ws_ext_ship_cost`, `ws1`.`ws_net_profit` FROM `web_sales` AS `ws1` WHERE (`ws1`.`ws_order_number` IN (SELECT `ws_wh`.`ws_order_number` FROM (SELECT `ws1`.`ws_order_number`, `ws1`.`ws_warehouse_sk` AS `wh1`, `ws2`.`ws_warehouse_sk` AS `wh2` FROM `web_sales` AS `ws1` INNER JOIN `web_sales` AS `ws2` ON ((`ws1`.`ws_order_number` = `ws2`.`ws_order_number`) AND (`ws1`.`ws_warehouse_sk` <> `ws2`.`ws_warehouse_sk`))) AS `ws_wh`) AND `ws1`.`ws_order_number` IN (SELECT `web_returns`.`wr_order_number` FROM `web_returns` INNER JOIN (SELECT `ws1`.`ws_order_number`, `ws1`.`ws_warehouse_sk` AS `wh1`, `ws2`.`ws_warehouse_sk` AS `wh2` FROM `web_sales` AS `ws1` INNER JOIN `web_sales` AS `ws2` ON ((`ws1`.`ws_order_number` = `ws2`.`ws_order_number`) AND (`ws1`.`ws_warehouse_sk` <> `ws2`.`ws_warehouse_sk`))) AS `ws_wh` ON (`web_returns`.`wr_order_number` = `ws_wh`.`ws_order_number`))) |
|               |                           RepartitionExec: partitioning=Hash([web_site_sk@0], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |                             SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                               BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                                 VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `web_site`.`web_site_sk` FROM `web_site` WHERE (`web_site`.`web_company_name` = 'pri')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                       RepartitionExec: partitioning=Hash([ca_address_sk@0], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                         SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                           BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                             VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `customer_address`.`ca_address_sk` FROM `customer_address` WHERE (`customer_address`.`ca_state` = 'MA')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                   RepartitionExec: partitioning=Hash([d_date_sk@0], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                     FilterExec: d_date@1 >= 2002-05-01 AND d_date@1 <= 2002-06-30, projection=[d_date_sk@0]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                       RepartitionExec: partitioning=RoundRobinBatch(32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                         SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                           BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                             VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `date_dim`.`d_date_sk`, `date_dim`.`d_date` FROM `date_dim`                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
