---
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                               |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                          |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                           |
|               |   Sort: c DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                         |
|               |     Projection: hits.SearchPhrase, min(hits.URL), count(Int64(1)) AS c                                                                                                                                                                                                                                                                             |
|               |       Aggregate: groupBy=[[hits.SearchPhrase]], aggr=[[min(hits.URL), count(Int64(1))]]                                                                                                                                                                                                                                                            |
|               |         Filter: hits.URL LIKE CAST(Utf8("%google%") AS LargeUtf8) AND CAST(hits.SearchPhrase AS Utf8View) != CAST(Utf8("") AS Utf8View)                                                                                                                                                                                                            |
|               |           TableScan: hits projection=[URL, SearchPhrase]                                                                                                                                                                                                                                                                                           |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                 |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                  |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                             |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "hits"."SearchPhrase", min("hits"."URL"), count(1) AS "c" FROM "hits" WHERE ("hits"."URL" LIKE CAST('%google%' AS TEXT) AND (CAST("hits"."SearchPhrase" AS VARCHAR) <> CAST('' AS VARCHAR))) GROUP BY "hits"."SearchPhrase" ORDER BY "c" DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                    |
