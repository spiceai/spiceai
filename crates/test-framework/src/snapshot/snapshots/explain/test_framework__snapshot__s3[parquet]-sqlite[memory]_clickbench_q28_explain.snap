+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                   |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                              |
|               |  Limit: skip=0, fetch=25                                                                                                                                                                                                                                                                                               |
|               |   Sort: l DESC NULLS FIRST                                                                                                                                                                                                                                                                                             |
|               |     Projection: hits.CounterID, avg(length(hits.URL)) AS l, count(Int64(1)) AS c                                                                                                                                                                                                                                       |
|               |       Filter: count(Int64(1)) > Int64(100000)                                                                                                                                                                                                                                                                          |
|               |         Aggregate: groupBy=[[hits.CounterID]], aggr=[[avg(CAST(length(hits.URL) AS Float64)), count(Int64(1))]]                                                                                                                                                                                                        |
|               |           Filter: hits.URL != CAST(Utf8("") AS LargeUtf8)                                                                                                                                                                                                                                                              |
|               |             TableScan: hits projection=[CounterID, URL]                                                                                                                                                                                                                                                                |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                     |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                      |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                 |
|               |       VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `hits`.`CounterID`, avg(CAST(length(`hits`.`URL`) AS DOUBLE)) AS `l`, count(1) AS `c` FROM `hits` WHERE (`hits`.`URL` <> CAST('' AS TEXT)) GROUP BY `hits`.`CounterID` HAVING (count(1) > 100000) ORDER BY `l` DESC NULLS FIRST LIMIT 25 |
|               |                                                                                                                                                                                                                                                                                                                        |
