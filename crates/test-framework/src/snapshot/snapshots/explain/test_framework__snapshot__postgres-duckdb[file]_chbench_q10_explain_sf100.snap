source: crates/test-framework/src/snapshot/mod.rs
description: "Query: chbench_q10"
---
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Sort: revenue DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Projection: customer.c_id, customer.c_last, sum(order_line.ol_amount) AS revenue, customer.c_city, customer.c_phone, nation.n_name                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     Aggregate: groupBy=[[customer.c_id, customer.c_last, customer.c_city, customer.c_phone, nation.n_name]], aggr=[[sum(order_line.ol_amount)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       Inner Join:  Filter: nation.n_nationkey = ascii(substr(customer.c_state, Int64(1), Int64(1))) - Int64(65)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |         Inner Join:  Filter: order_line.ol_w_id = oorder.o_w_id AND order_line.ol_d_id = oorder.o_d_id AND order_line.ol_o_id = oorder.o_id AND oorder.o_entry_d <= order_line.ol_delivery_d                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           Inner Join:  Filter: customer.c_id = oorder.o_c_id AND customer.c_w_id = oorder.o_w_id AND customer.c_d_id = oorder.o_d_id                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             TableScan: customer projection=[c_id, c_d_id, c_w_id, c_last, c_city, c_state, c_phone]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |             TableScan: oorder projection=[o_id, o_d_id, o_w_id, o_c_id, o_entry_d], full_filters=[oorder.o_entry_d >= Utf8("2007-01-02 00:00:00.000000")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           TableScan: order_line projection=[ol_o_id, ol_d_id, ol_w_id, ol_delivery_d, ol_amount]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         TableScan: nation projection=[n_nationkey, n_name]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "customer"."c_id", "customer"."c_last", sum("order_line"."ol_amount") AS "revenue", "customer"."c_city", "customer"."c_phone", "nation"."n_name" FROM "customer" INNER JOIN "oorder" ON (((("customer"."c_id" = "oorder"."o_c_id") AND ("customer"."c_w_id" = "oorder"."o_w_id")) AND ("customer"."c_d_id" = "oorder"."o_d_id")) AND ("oorder"."o_entry_d" >= '2007-01-02 00:00:00.000000')) INNER JOIN "order_line" ON (((("order_line"."ol_w_id" = "oorder"."o_w_id") AND ("order_line"."ol_d_id" = "oorder"."o_d_id")) AND ("order_line"."ol_o_id" = "oorder"."o_id")) AND ("oorder"."o_entry_d" <= "order_line"."ol_delivery_d")) INNER JOIN "nation" ON ("nation"."n_nationkey" = (ascii(substr("customer"."c_state", 1, 1)) - 65)) GROUP BY "customer"."c_id", "customer"."c_last", "customer"."c_city", "customer"."c_phone", "nation"."n_name" ORDER BY "revenue" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
