+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |  Sort: pg.public.orders.o_orderpriority ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |   Projection: pg.public.orders.o_orderpriority, count(Int64(1)) AS order_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     Aggregate: groupBy=[[pg.public.orders.o_orderpriority]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       Filter: EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |           Projection: pg.public.lineitem.l_orderkey, pg.public.lineitem.l_partkey, pg.public.lineitem.l_suppkey, pg.public.lineitem.l_linenumber, pg.public.lineitem.l_quantity, pg.public.lineitem.l_extendedprice, pg.public.lineitem.l_discount, pg.public.lineitem.l_tax, pg.public.lineitem.l_returnflag, pg.public.lineitem.l_linestatus, pg.public.lineitem.l_shipdate, pg.public.lineitem.l_commitdate, pg.public.lineitem.l_receiptdate, pg.public.lineitem.l_shipinstruct, pg.public.lineitem.l_shipmode, pg.public.lineitem.l_comment                                                                                                                                                                                                                                                                                                                          |
|               |             Filter: pg.public.lineitem.l_orderkey = outer_ref(pg.public.orders.o_orderkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |               TableScan: pg.public.lineitem, full_filters=[pg.public.lineitem.l_commitdate < pg.public.lineitem.l_receiptdate]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |         TableScan: pg.public.orders projection=[o_orderkey, o_orderpriority], full_filters=[pg.public.orders.o_orderdate >= CAST(Utf8("1993-07-01") AS Date32), pg.public.orders.o_orderdate < CAST(Utf8("1993-10-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "o_orderpriority", count(1) AS "order_count" FROM "public"."orders" WHERE EXISTS (SELECT "l_orderkey", "l_partkey", "l_suppkey", "l_linenumber", "l_quantity", "l_extendedprice", "l_discount", "l_tax", "l_returnflag", "l_linestatus", "l_shipdate", "l_commitdate", "l_receiptdate", "l_shipinstruct", "l_shipmode", "l_comment" FROM "public"."lineitem" WHERE ("lineitem"."l_orderkey" = "orders"."o_orderkey") AND ("lineitem"."l_commitdate" < "lineitem"."l_receiptdate")) AND (("orders"."o_orderdate" >= CAST('1993-07-01' AS DATE)) AND ("orders"."o_orderdate" < CAST('1993-10-01' AS DATE))) GROUP BY "orders"."o_orderpriority" ORDER BY "o_orderpriority" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
