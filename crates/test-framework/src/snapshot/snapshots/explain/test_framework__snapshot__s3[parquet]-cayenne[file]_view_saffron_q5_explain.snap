|               |             TableScan: number_info_with_cap projection=[AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberType, NumberRegion, AvailableForNumberSelection, Capability], partial_filters=[number_info_with_cap.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info_with_cap.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info_with_cap.NumberRegion = LargeUtf8("US"), number_info_with_cap.NumberType = LargeUtf8("lc"), number_info_with_cap.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info_with_cap.Capability = LargeUtf8("sms"), number_info_with_cap.AvailableForNumberSelection = Int8(1) OR number_info_with_cap.AvailableForNumberSelection = Int8(0)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
