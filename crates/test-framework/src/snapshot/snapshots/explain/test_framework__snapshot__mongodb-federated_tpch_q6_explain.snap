|               |   AggregateExec: mode=Final, gby=[], aggr=[sum(lineitem.l_extendedprice * lineitem.l_discount)]                                                                                                                                                                                                                                                                                                                                  |
|               |     CoalescePartitionsExec                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       AggregateExec: mode=Partial, gby=[], aggr=[sum(lineitem.l_extendedprice * lineitem.l_discount)]                                                                                                                                                                                                                                                                                                                            |
|               |         ProjectionExec: expr=[l_discount@0 as l_discount, l_extendedprice@1 as l_extendedprice]                                                                                                                                                                                                                                                                                                                                  |
|               |           FilterExec: l_discount@0 >= 0.050000 AND l_discount@0 <= 0.070000 AND l_quantity@2 < 24.000000                                                                                                                                                                                                                                                                                                                         |
|               |             RepartitionExec: partitioning=RoundRobinBatch(32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                |
|               |               BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                 MongoDBExec projection=[l_discount, l_extendedprice, l_quantity] filters=[{"$and":[{"l_shipdate":{"$type":"date","$gte":{"$date":{"$numberLong":"757382400000"}},"$lte":{"$date":{"$numberLong":"8210266876799999"}},"$not":{"$type":"array"}}},{"l_shipdate":{"$type":"date","$gte":{"$date":{"$numberLong":"-8334601228800000"}},"$lte":{"$date":{"$numberLong":"788918399999"}},"$not":{"$type":"array"}}}]}] |
