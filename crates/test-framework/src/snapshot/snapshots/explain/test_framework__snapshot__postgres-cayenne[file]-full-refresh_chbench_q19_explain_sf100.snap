+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Projection: sum(order_line.ol_amount) AS revenue                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Aggregate: groupBy=[[]], aggr=[[sum(order_line.ol_amount)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     Projection: order_line.ol_amount                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       Inner Join: order_line.ol_i_id = item.i_id Filter: item.i_data LIKE Utf8View("%a") AND (order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(2) OR order_line.ol_w_id = Int32(3)) OR item.i_data LIKE Utf8View("%b") AND (order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(2) OR order_line.ol_w_id = Int32(4)) OR item.i_data LIKE Utf8View("%c") AND (order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(5) OR order_line.ol_w_id = Int32(3))                                                                                      |
|               |         Projection: order_line.ol_w_id, order_line.ol_i_id, order_line.ol_amount                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           Filter: order_line.ol_quantity >= Int32(1) AND order_line.ol_quantity <= Int32(10) AND order_line.ol_w_id IN ([Int32(1), Int32(2), Int32(3), Int32(4), Int32(5)]) AND (order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(2) OR order_line.ol_w_id = Int32(3) OR order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(2) OR order_line.ol_w_id = Int32(4) OR order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(5) OR order_line.ol_w_id = Int32(3))                                                                               |
|               |             TableScan: order_line projection=[ol_w_id, ol_i_id, ol_quantity, ol_amount], partial_filters=[order_line.ol_quantity >= Int32(1), order_line.ol_quantity <= Int32(10), order_line.ol_w_id IN ([Int32(1), Int32(2), Int32(3), Int32(4), Int32(5)]), order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(2) OR order_line.ol_w_id = Int32(3) OR order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(2) OR order_line.ol_w_id = Int32(4) OR order_line.ol_w_id = Int32(1) OR order_line.ol_w_id = Int32(5) OR order_line.ol_w_id = Int32(3)] |
|               |         Projection: item.i_id, item.i_data                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |           Filter: item.i_price >= Float64(1) AND item.i_price <= Float64(400000) AND (item.i_data LIKE Utf8View("%a") OR item.i_data LIKE Utf8View("%b") OR item.i_data LIKE Utf8View("%c"))                                                                                                                                                                                                                                                                                                                                                                          |
|               |             TableScan: item projection=[i_id, i_price, i_data], partial_filters=[item.i_price >= Float64(1), item.i_price <= Float64(400000), item.i_data LIKE Utf8View("%a") OR item.i_data LIKE Utf8View("%b") OR item.i_data LIKE Utf8View("%c")]                                                                                                                                                                                                                                                                                                                  |
| physical_plan | ProjectionExec: expr=[sum(order_line.ol_amount)@0 as revenue]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   AggregateExec: mode=Final, gby=[], aggr=[sum(order_line.ol_amount)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     CoalescePartitionsExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       AggregateExec: mode=Partial, gby=[], aggr=[sum(order_line.ol_amount)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |         HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(i_id@0, ol_i_id@1)], filter=i_data@1 LIKE %a AND (ol_w_id@0 = 1 OR ol_w_id@0 = 2 OR ol_w_id@0 = 3) OR i_data@1 LIKE %b AND (ol_w_id@0 = 1 OR ol_w_id@0 = 2 OR ol_w_id@0 = 4) OR i_data@1 LIKE %c AND (ol_w_id@0 = 1 OR ol_w_id@0 = 5 OR ol_w_id@0 = 3), projection=[ol_amount@4]                                                                                                                                                                                     |
|               |           RepartitionExec: partitioning=Hash([i_id@0], 16), input_partitions=4                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |             ProjectionExec: expr=[i_id@0 as i_id, i_data@2 as i_data]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |               SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                 CayenneAccelerationExec: snapshots_scanned=1, files_scanned=4                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                   BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                     DataSourceExec: file_groups={4 groups: [<redacted>]}, projection=[i_id, i_price, i_data], file_type=vortex, predicate: i_price@3 >= 1 AND i_price@3 <= 400000 AND (i_data@4 LIKE %a OR i_data@4 LIKE %b OR i_data@4 LIKE %c)                                                                                                                                                                                                                                                                                                                      |
|               |           RepartitionExec: partitioning=Hash([ol_i_id@1], 16), input_partitions=16                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             ProjectionExec: expr=[ol_w_id@0 as ol_w_id, ol_i_id@1 as ol_i_id, ol_amount@3 as ol_amount]                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |               SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                 CayenneAccelerationExec: snapshots_scanned=1, files_scanned=19                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                   BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                     DataSourceExec: file_groups={16 groups: [<redacted>]}, projection=[ol_w_id, ol_i_id, ol_quantity, ol_amount], file_type=vortex, predicate: ol_quantity@7 >= 1 AND ol_quantity@7 <= 10 AND ol_w_id@2 IN (SET) ([1, 2, 3, 4, 5]) AND (ol_w_id@2 = 1 OR ol_w_id@2 = 2 OR ol_w_id@2 = 3 OR ol_w_id@2 = 1 OR ol_w_id@2 = 2 OR ol_w_id@2 = 4 OR ol_w_id@2 = 1 OR ol_w_id@2 = 5 OR ol_w_id@2 = 3) AND DynamicFilter [ empty ]                                                                                                                            |
