|               |                       Inner Join: supplier.s_suppkey = lineitem.l_suppkey                                                                                                                                                                                                                               |
|               |                         Projection: nation.n_name, supplier.s_suppkey                                                                                                                                                                                                                                   |
|               |                           Inner Join: nation.n_nationkey = supplier.s_nationkey                                                                                                                                                                                                                         |
|               |                             TableScan: nation projection=[n_name, n_nationkey]                                                                                                                                                                                                                          |
|               |                             TableScan: supplier projection=[s_nationkey, s_suppkey]                                                                                                                                                                                                                     |
