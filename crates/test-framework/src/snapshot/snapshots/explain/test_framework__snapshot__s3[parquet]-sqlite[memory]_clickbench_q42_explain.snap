| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |  Limit: skip=10000, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     Projection: hits.WindowClientWidth, hits.WindowClientHeight, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       Aggregate: groupBy=[[hits.WindowClientWidth, hits.WindowClientHeight]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |         TableScan: hits projection=[WindowClientWidth, WindowClientHeight], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), CAST(date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) AS Timestamp(ns)) >= CAST(Utf8("2013-07-01") AS Timestamp(ns)), CAST(date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) AS Timestamp(ns)) <= CAST(Utf8("2013-07-31") AS Timestamp(ns)), CAST(hits.IsRefresh AS Int64) = Int64(0), CAST(hits.DontCountHits AS Int64) = Int64(0), hits.URLHash = Int64(2868770270353813622)]                                                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `hits`.`WindowClientWidth`, `hits`.`WindowClientHeight`, count(1) AS `PageViews` FROM `hits` WHERE ((((((CAST(`hits`.`CounterID` AS BIGINT) = 62) AND (CAST(strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) AS TEXT) >= CAST('2013-07-01' AS TEXT))) AND (CAST(strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) AS TEXT) <= CAST('2013-07-31' AS TEXT))) AND (CAST(`hits`.`IsRefresh` AS BIGINT) = 0)) AND (CAST(`hits`.`DontCountHits` AS BIGINT) = 0)) AND (`hits`.`URLHash` = 2868770270353813622)) GROUP BY `hits`.`WindowClientWidth`, `hits`.`WindowClientHeight` ORDER BY `PageViews` DESC NULLS FIRST LIMIT 10 OFFSET 10000 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
