|               |           Aggregate: groupBy=[[]], aggr=[[sum(pg.public.partsupp.ps_supplycost * pg.public.partsupp.ps_availqty)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
