|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "ps_partkey", sum(("partsupp"."ps_supplycost" * "partsupp"."ps_availqty")) AS "value" FROM "public"."partsupp" INNER JOIN "public"."supplier" ON ("partsupp"."ps_suppkey" = "supplier"."s_suppkey") INNER JOIN "public"."nation" ON ("supplier"."s_nationkey" = "nation"."n_nationkey") WHERE ("nation"."n_name" = 'GERMANY') GROUP BY "partsupp"."ps_partkey" HAVING (sum(("partsupp"."ps_supplycost" * "partsupp"."ps_availqty")) > (SELECT (sum(("partsupp"."ps_supplycost" * "partsupp"."ps_availqty")) * 0.0001) FROM "public"."partsupp" INNER JOIN "public"."supplier" ON ("partsupp"."ps_suppkey" = "supplier"."s_suppkey") INNER JOIN "public"."nation" ON ("supplier"."s_nationkey" = "nation"."n_nationkey") WHERE ("nation"."n_name" = 'GERMANY'))) ORDER BY "value" DESC NULLS FIRST |
