|               |           Inner Join:  Filter: pg.public.partsupp.ps_suppkey = pg.public.supplier.s_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
