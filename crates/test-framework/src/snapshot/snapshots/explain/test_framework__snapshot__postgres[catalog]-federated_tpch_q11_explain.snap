|               |   Projection: pg.public.partsupp.ps_partkey, sum(pg.public.partsupp.ps_supplycost * pg.public.partsupp.ps_availqty) AS value                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |     Filter: sum(pg.public.partsupp.ps_supplycost * pg.public.partsupp.ps_availqty) > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
