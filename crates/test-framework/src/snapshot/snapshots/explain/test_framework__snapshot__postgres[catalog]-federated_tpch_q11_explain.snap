|               |       Aggregate: groupBy=[[pg.public.partsupp.ps_partkey]], aggr=[[sum(pg.public.partsupp.ps_supplycost * pg.public.partsupp.ps_availqty)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
