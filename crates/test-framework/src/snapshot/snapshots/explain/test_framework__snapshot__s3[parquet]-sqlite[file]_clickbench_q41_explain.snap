| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |  Limit: skip=100, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     Projection: hits.URLHash, date_trunc(Utf8("day"),from_unixtime(hits.EventTime)), count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       Aggregate: groupBy=[[hits.URLHash, date_trunc(Utf8("day"), from_unixtime(hits.EventTime))]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |         TableScan: hits projection=[EventTime, URLHash], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), CAST(date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) AS Timestamp(ns)) >= CAST(Utf8("2013-07-01") AS Timestamp(ns)), CAST(date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) AS Timestamp(ns)) <= CAST(Utf8("2013-07-31") AS Timestamp(ns)), CAST(hits.IsRefresh AS Int64) = Int64(0), CAST(hits.TraficSourceID AS Int64) IN ([Int64(-1), Int64(6)]), hits.RefererHash = Int64(3594120000172545465)]                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT `hits`.`URLHash`, strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')), count(1) AS `PageViews` FROM `hits` WHERE ((((((CAST(`hits`.`CounterID` AS BIGINT) = 62) AND (CAST(strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) AS TEXT) >= CAST('2013-07-01' AS TEXT))) AND (CAST(strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) AS TEXT) <= CAST('2013-07-31' AS TEXT))) AND (CAST(`hits`.`IsRefresh` AS BIGINT) = 0)) AND CAST(`hits`.`TraficSourceID` AS BIGINT) IN (-1, 6)) AND (`hits`.`RefererHash` = 3594120000172545465)) GROUP BY `hits`.`URLHash`, strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) ORDER BY `PageViews` DESC NULLS FIRST LIMIT 10 OFFSET 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
