| logical_plan  | Sort: Returns_Loss DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Projection: call_center.cc_call_center_id AS Call_Center, call_center.cc_name AS Call_Center_Name, call_center.cc_manager AS Manager, sum(catalog_returns.cr_net_loss) AS Returns_Loss                                                                                                                                                                                                                           |
|               |     Aggregate: groupBy=[[call_center.cc_call_center_id, call_center.cc_name, call_center.cc_manager, customer_demographics.cd_marital_status, customer_demographics.cd_education_status]], aggr=[[sum(catalog_returns.cr_net_loss)]]                                                                                                                                                                               |
|               |       Projection: customer_demographics.cd_marital_status, customer_demographics.cd_education_status, catalog_returns.cr_net_loss, call_center.cc_call_center_id, call_center.cc_name, call_center.cc_manager                                                                                                                                                                                                      |
|               |         Inner Join: catalog_returns.cr_call_center_sk = call_center.cc_call_center_sk                                                                                                                                                                                                                                                                                                                              |
|               |           Projection: customer_demographics.cd_marital_status, customer_demographics.cd_education_status, catalog_returns.cr_call_center_sk, catalog_returns.cr_net_loss                                                                                                                                                                                                                                           |
|               |             Inner Join: catalog_returns.cr_returned_date_sk = date_dim.d_date_sk                                                                                                                                                                                                                                                                                                                                   |
|               |               Projection: customer_demographics.cd_marital_status, customer_demographics.cd_education_status, catalog_returns.cr_returned_date_sk, catalog_returns.cr_call_center_sk, catalog_returns.cr_net_loss                                                                                                                                                                                                  |
|               |                 Inner Join: customer.c_customer_sk = catalog_returns.cr_returning_customer_sk                                                                                                                                                                                                                                                                                                                      |
|               |                   Projection: customer.c_customer_sk, customer_demographics.cd_marital_status, customer_demographics.cd_education_status                                                                                                                                                                                                                                                                           |
|               |                     Inner Join: customer.c_current_cdemo_sk = customer_demographics.cd_demo_sk                                                                                                                                                                                                                                                                                                                     |
|               |                       Projection: customer.c_customer_sk, customer.c_current_cdemo_sk                                                                                                                                                                                                                                                                                                                              |
|               |                         Inner Join: customer.c_current_addr_sk = customer_address.ca_address_sk                                                                                                                                                                                                                                                                                                                    |
|               |                           Projection: customer.c_customer_sk, customer.c_current_cdemo_sk, customer.c_current_addr_sk                                                                                                                                                                                                                                                                                              |
|               |                             Inner Join: household_demographics.hd_demo_sk = customer.c_current_hdemo_sk                                                                                                                                                                                                                                                                                                            |
|               |                               Projection: household_demographics.hd_demo_sk                                                                                                                                                                                                                                                                                                                                        |
|               |                                 Filter: household_demographics.hd_buy_potential LIKE LargeUtf8("Unknown%")                                                                                                                                                                                                                                                                                                         |
|               |                                   TableScan: household_demographics projection=[hd_demo_sk, hd_buy_potential], partial_filters=[household_demographics.hd_buy_potential LIKE LargeUtf8("Unknown%")]                                                                                                                                                                                                                |
|               |                               TableScan: customer projection=[c_customer_sk, c_current_cdemo_sk, c_current_hdemo_sk, c_current_addr_sk]                                                                                                                                                                                                                                                                            |
|               |                           Projection: customer_address.ca_address_sk                                                                                                                                                                                                                                                                                                                                               |
|               |                             Filter: customer_address.ca_gmt_offset = Decimal128(Some(-600),5,2)                                                                                                                                                                                                                                                                                                                    |
|               |                               TableScan: customer_address projection=[ca_address_sk, ca_gmt_offset], partial_filters=[customer_address.ca_gmt_offset = Decimal128(Some(-600),5,2)]                                                                                                                                                                                                                                 |
|               |                       Filter: customer_demographics.cd_marital_status = LargeUtf8("M") AND customer_demographics.cd_education_status = LargeUtf8("Unknown") OR customer_demographics.cd_marital_status = LargeUtf8("W") AND customer_demographics.cd_education_status = LargeUtf8("Advanced Degree")                                                                                                               |
|               |                         TableScan: customer_demographics projection=[cd_demo_sk, cd_marital_status, cd_education_status], partial_filters=[customer_demographics.cd_marital_status = LargeUtf8("M") AND customer_demographics.cd_education_status = LargeUtf8("Unknown") OR customer_demographics.cd_marital_status = LargeUtf8("W") AND customer_demographics.cd_education_status = LargeUtf8("Advanced Degree")] |
|               |                   TableScan: catalog_returns projection=[cr_returned_date_sk, cr_returning_customer_sk, cr_call_center_sk, cr_net_loss]                                                                                                                                                                                                                                                                            |
|               |               Projection: date_dim.d_date_sk                                                                                                                                                                                                                                                                                                                                                                       |
|               |                 Filter: date_dim.d_year = Int32(2002) AND date_dim.d_moy = Int32(11)                                                                                                                                                                                                                                                                                                                               |
|               |                   TableScan: date_dim projection=[d_date_sk, d_year, d_moy], partial_filters=[date_dim.d_year = Int32(2002), date_dim.d_moy = Int32(11)]                                                                                                                                                                                                                                                           |
