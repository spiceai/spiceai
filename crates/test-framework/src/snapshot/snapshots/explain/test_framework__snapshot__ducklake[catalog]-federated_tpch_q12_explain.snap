---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpch_q12"
---
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |  Sort: ducklake.main.lineitem.l_shipmode ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   Projection: ducklake.main.lineitem.l_shipmode, sum(CASE WHEN ducklake.main.orders.o_orderpriority = Utf8("1-URGENT") OR ducklake.main.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS high_line_count, sum(CASE WHEN ducklake.main.orders.o_orderpriority != Utf8("1-URGENT") AND ducklake.main.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS low_line_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     Aggregate: groupBy=[[ducklake.main.lineitem.l_shipmode]], aggr=[[sum(CASE WHEN ducklake.main.orders.o_orderpriority = Utf8("1-URGENT") OR ducklake.main.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END), sum(CASE WHEN ducklake.main.orders.o_orderpriority != Utf8("1-URGENT") AND ducklake.main.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       Inner Join:  Filter: ducklake.main.orders.o_orderkey = ducklake.main.lineitem.l_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |         TableScan: ducklake.main.orders projection=[o_orderkey, o_orderpriority]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         TableScan: ducklake.main.lineitem projection=[l_orderkey, l_shipmode], full_filters=[ducklake.main.lineitem.l_shipmode IN ([Utf8("MAIL"), Utf8("SHIP")]), ducklake.main.lineitem.l_commitdate < ducklake.main.lineitem.l_receiptdate, ducklake.main.lineitem.l_shipdate < ducklake.main.lineitem.l_commitdate, ducklake.main.lineitem.l_receiptdate >= CAST(Utf8("1994-01-01") AS Date32), ducklake.main.lineitem.l_receiptdate < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "l_shipmode", sum(CASE WHEN (("orders"."o_orderpriority" = '1-URGENT') OR ("orders"."o_orderpriority" = '2-HIGH')) THEN 1 ELSE 0 END) AS "high_line_count", sum(CASE WHEN (("orders"."o_orderpriority" <> '1-URGENT') AND ("orders"."o_orderpriority" <> '2-HIGH')) THEN 1 ELSE 0 END) AS "low_line_count" FROM "ducklake"."main"."orders" INNER JOIN "ducklake"."main"."lineitem" ON ("orders"."o_orderkey" = "lineitem"."l_orderkey") WHERE "lineitem"."l_shipmode" IN ('MAIL', 'SHIP') AND ("lineitem"."l_commitdate" < "lineitem"."l_receiptdate") AND ("lineitem"."l_shipdate" < "lineitem"."l_commitdate") AND ("lineitem"."l_receiptdate" >= CAST('1994-01-01' AS DATE)) AND ("lineitem"."l_receiptdate" < CAST('1995-01-01' AS DATE)) GROUP BY "lineitem"."l_shipmode" ORDER BY "l_shipmode" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
