| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Sort: c DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     Projection: hits.SearchPhrase, min(hits.URL), count(Int64(1)) AS c                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       Aggregate: groupBy=[[hits.SearchPhrase]], aggr=[[min(hits.URL), count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Filter: hits.URL LIKE Utf8("%google%") AND hits.SearchPhrase != Utf8("")                                                                                                                                                                                                                                                                                                                                                                                        |
|               |           TableScan: hits projection=[URL, SearchPhrase], partial_filters=[hits.URL LIKE Utf8("%google%"), hits.SearchPhrase != Utf8("")]                                                                                                                                                                                                                                                                                                                               |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       VirtualExecutionPlan name=spice.ai compute_context=url=https://us-east-1-prod-aws-flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench base_sql=SELECT "SearchPhrase", min("hits"."URL"), count(1) AS "c" FROM "clickbench"."hits" WHERE ("hits"."URL" LIKE '%google%' AND ("hits"."SearchPhrase" <> '')) AND ("hits"."URL" LIKE '%google%' AND ("hits"."SearchPhrase" <> '')) GROUP BY "hits"."SearchPhrase" ORDER BY "c" DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
