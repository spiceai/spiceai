+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                           |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                            |
|               |   Sort: c DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                          |
|               |     Projection: hits.SearchPhrase, min(hits.URL), count(Int64(1)) AS c                                                                                                                                                                                                                                                                                                              |
|               |       Aggregate: groupBy=[[hits.SearchPhrase]], aggr=[[min(hits.URL), count(Int64(1))]]                                                                                                                                                                                                                                                                                             |
|               |         Filter: hits.SearchPhrase != Utf8("") AND hits.URL LIKE Utf8("%google%")                                                                                                                                                                                                                                                                                                    |
|               |           TableScan: hits projection=[URL, SearchPhrase], partial_filters=[hits.SearchPhrase != Utf8(""), hits.URL LIKE Utf8("%google%")]                                                                                                                                                                                                                                           |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=spice.ai compute_context=<CONNECTION> base_sql=SELECT "SearchPhrase", min("hits"."URL"), count(1) AS "c" FROM "clickbench"."hits" WHERE (("hits"."SearchPhrase" <> '') AND "hits"."URL" LIKE '%google%') AND (("hits"."SearchPhrase" <> '') AND "hits"."URL" LIKE '%google%') GROUP BY "hits"."SearchPhrase" ORDER BY "c" DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                     |
