description: "Query: tpcds_q82"
---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |  Limit: skip=0, fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   Sort: item.i_item_id ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     Projection: item.i_item_id, item.i_item_desc, item.i_current_price                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       Aggregate: groupBy=[[item.i_item_id, item.i_item_desc, item.i_current_price]], aggr=[[]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |         Inner Join:  Filter: store_sales.ss_item_sk = item.i_item_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           Inner Join:  Filter: date_dim.d_date_sk = inventory.inv_date_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |             Inner Join:  Filter: inventory.inv_item_sk = item.i_item_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |               TableScan: item projection=[i_item_sk, i_item_id, i_item_desc, i_current_price], full_filters=[item.i_current_price BETWEEN Int64(69) AND Int64(69) + Int64(30), item.i_manufact_id IN ([Int64(105), Int64(513), Int64(180), Int64(137)])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |               TableScan: inventory projection=[inv_date_sk, inv_item_sk], full_filters=[inventory.inv_quantity_on_hand BETWEEN Int64(100) AND Int64(500)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |             TableScan: date_dim projection=[d_date_sk], full_filters=[date_dim.d_date BETWEEN CAST(Utf8("1998-06-06") AS Date32) AND CAST(Utf8("1998-06-06") AS Date32) + IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 60, nanoseconds: 0 }")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |           TableScan: store_sales projection=[ss_item_sk]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=duckdb compute_context=./data/tpcds.db base_sql=SELECT "item"."i_item_id", "item"."i_item_desc", "item"."i_current_price" FROM "item" INNER JOIN "inventory" ON ("inventory"."inv_item_sk" = "item"."i_item_sk") INNER JOIN "date_dim" ON ("date_dim"."d_date_sk" = "inventory"."inv_date_sk") INNER JOIN "store_sales" ON ("store_sales"."ss_item_sk" = "item"."i_item_sk") WHERE ("item"."i_current_price" BETWEEN 69 AND (69 + 30)) AND "item"."i_manufact_id" IN (105, 513, 180, 137) AND ("inventory"."inv_quantity_on_hand" BETWEEN 100 AND 500) AND ("date_dim"."d_date" BETWEEN CAST('1998-06-06' AS DATE) AND (CAST('1998-06-06' AS DATE) + INTERVAL '60 DAYS')) GROUP BY "item"."i_item_id", "item"."i_item_desc", "item"."i_current_price" ORDER BY "item"."i_item_id" ASC NULLS LAST LIMIT 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
