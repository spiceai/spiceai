| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |  Sort: mysql.tpch_sf1.orders.o_orderpriority ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Projection: mysql.tpch_sf1.orders.o_orderpriority, count(Int64(1)) AS order_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     Aggregate: groupBy=[[mysql.tpch_sf1.orders.o_orderpriority]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       Filter: EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |           Projection: mysql.tpch_sf1.lineitem.l_orderkey, mysql.tpch_sf1.lineitem.l_partkey, mysql.tpch_sf1.lineitem.l_suppkey, mysql.tpch_sf1.lineitem.l_linenumber, mysql.tpch_sf1.lineitem.l_quantity, mysql.tpch_sf1.lineitem.l_extendedprice, mysql.tpch_sf1.lineitem.l_discount, mysql.tpch_sf1.lineitem.l_tax, mysql.tpch_sf1.lineitem.l_returnflag, mysql.tpch_sf1.lineitem.l_linestatus, mysql.tpch_sf1.lineitem.l_shipdate, mysql.tpch_sf1.lineitem.l_commitdate, mysql.tpch_sf1.lineitem.l_receiptdate, mysql.tpch_sf1.lineitem.l_shipinstruct, mysql.tpch_sf1.lineitem.l_shipmode, mysql.tpch_sf1.lineitem.l_comment                                                                                                                                                                                                                                                                                                                                      |
|               |             Filter: mysql.tpch_sf1.lineitem.l_orderkey = outer_ref(mysql.tpch_sf1.orders.o_orderkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               TableScan: mysql.tpch_sf1.lineitem, full_filters=[mysql.tpch_sf1.lineitem.l_commitdate < mysql.tpch_sf1.lineitem.l_receiptdate]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |         TableScan: mysql.tpch_sf1.orders projection=[o_orderkey, o_orderpriority], full_filters=[mysql.tpch_sf1.orders.o_orderdate >= CAST(Utf8("1993-07-01") AS Date32), mysql.tpch_sf1.orders.o_orderdate < CAST(Utf8("1993-10-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       VirtualExecutionPlan name=mysql compute_context=<CONNECTION> base_sql=SELECT `orders`.`o_orderpriority`, count(1) AS `order_count` FROM `tpch_sf1`.`orders` WHERE EXISTS (SELECT `lineitem`.`l_orderkey`, `lineitem`.`l_partkey`, `lineitem`.`l_suppkey`, `lineitem`.`l_linenumber`, `lineitem`.`l_quantity`, `lineitem`.`l_extendedprice`, `lineitem`.`l_discount`, `lineitem`.`l_tax`, `lineitem`.`l_returnflag`, `lineitem`.`l_linestatus`, `lineitem`.`l_shipdate`, `lineitem`.`l_commitdate`, `lineitem`.`l_receiptdate`, `lineitem`.`l_shipinstruct`, `lineitem`.`l_shipmode`, `lineitem`.`l_comment` FROM `tpch_sf1`.`lineitem` WHERE (`lineitem`.`l_orderkey` = `orders`.`o_orderkey`) AND (`lineitem`.`l_commitdate` < `lineitem`.`l_receiptdate`)) AND ((`orders`.`o_orderdate` >= CAST('1993-07-01' AS DATE)) AND (`orders`.`o_orderdate` < CAST('1993-10-01' AS DATE))) GROUP BY `orders`.`o_orderpriority` ORDER BY `orders`.`o_orderpriority` ASC |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
