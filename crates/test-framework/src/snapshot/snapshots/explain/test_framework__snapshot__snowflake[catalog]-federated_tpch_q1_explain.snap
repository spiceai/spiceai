|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "L_RETURNFLAG", "L_LINESTATUS", sum("LINEITEM"."L_QUANTITY") AS "sum_qty", sum("LINEITEM"."L_EXTENDEDPRICE") AS "sum_base_price", sum(("LINEITEM"."L_EXTENDEDPRICE" * (1 - "LINEITEM"."L_DISCOUNT"))) AS "sum_disc_price", sum((("LINEITEM"."L_EXTENDEDPRICE" * (1 - "LINEITEM"."L_DISCOUNT")) * (1 + "LINEITEM"."L_TAX"))) AS "sum_charge", avg("LINEITEM"."L_QUANTITY") AS "avg_qty", avg("LINEITEM"."L_EXTENDEDPRICE") AS "avg_price", avg("LINEITEM"."L_DISCOUNT") AS "avg_disc", count(1) AS "count_order" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" WHERE ("LINEITEM"."L_SHIPDATE" <= CAST('1998-09-02' AS DATE)) GROUP BY "LINEITEM"."L_RETURNFLAG", "LINEITEM"."L_LINESTATUS" ORDER BY "L_RETURNFLAG" ASC NULLS LAST, "L_LINESTATUS" ASC NULLS LAST |
