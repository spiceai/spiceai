---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   Sort: revenue DESC NULLS FIRST, pg.public.orders.o_orderdate ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     Projection: pg.public.lineitem.l_orderkey, sum(pg.public.lineitem.l_extendedprice * Int64(1) - pg.public.lineitem.l_discount) AS revenue, pg.public.orders.o_orderdate, pg.public.orders.o_shippriority                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       Aggregate: groupBy=[[pg.public.lineitem.l_orderkey, pg.public.orders.o_orderdate, pg.public.orders.o_shippriority]], aggr=[[sum(pg.public.lineitem.l_extendedprice * (Int64(1) - pg.public.lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |         Inner Join:  Filter: pg.public.lineitem.l_orderkey = pg.public.orders.o_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |           Inner Join:  Filter: pg.public.customer.c_custkey = pg.public.orders.o_custkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |             TableScan: pg.public.customer projection=[c_custkey], full_filters=[pg.public.customer.c_mktsegment = Utf8("BUILDING")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             TableScan: pg.public.orders projection=[o_orderkey, o_custkey, o_orderdate, o_shippriority], full_filters=[pg.public.orders.o_orderdate < CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |           TableScan: pg.public.lineitem projection=[l_orderkey, l_extendedprice, l_discount], full_filters=[pg.public.lineitem.l_shipdate > CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "l_orderkey", sum(("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount"))) AS "revenue", "o_orderdate", "o_shippriority" FROM "public"."customer" INNER JOIN "public"."orders" ON (("customer"."c_custkey" = "orders"."o_custkey") AND (("customer"."c_mktsegment" = 'BUILDING') AND ("orders"."o_orderdate" < CAST('1995-03-15' AS DATE)))) INNER JOIN "public"."lineitem" ON (("lineitem"."l_orderkey" = "orders"."o_orderkey") AND ("lineitem"."l_shipdate" > CAST('1995-03-15' AS DATE))) GROUP BY "lineitem"."l_orderkey", "orders"."o_orderdate", "orders"."o_shippriority" ORDER BY "revenue" DESC NULLS FIRST, "o_orderdate" ASC NULLS LAST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
