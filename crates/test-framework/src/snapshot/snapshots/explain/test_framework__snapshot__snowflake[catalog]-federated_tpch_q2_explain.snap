|               |                   Aggregate: groupBy=[[]], aggr=[[min(snowflake.TPCH_SF1.PARTSUPP.PS_SUPPLYCOST)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |                     Inner Join:  Filter: snowflake.TPCH_SF1.NATION.N_REGIONKEY = snowflake.TPCH_SF1.REGION.R_REGIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |                       Inner Join:  Filter: snowflake.TPCH_SF1.SUPPLIER.S_NATIONKEY = snowflake.TPCH_SF1.NATION.N_NATIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |                         Inner Join:  Filter: snowflake.TPCH_SF1.SUPPLIER.S_SUPPKEY = snowflake.TPCH_SF1.PARTSUPP.PS_SUPPKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
