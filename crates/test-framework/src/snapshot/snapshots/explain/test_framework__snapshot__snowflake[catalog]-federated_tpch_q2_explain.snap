|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "S_ACCTBAL", "S_NAME", "N_NAME", "P_PARTKEY", "P_MFGR", "S_ADDRESS", "S_PHONE", "S_COMMENT" FROM "BENCHMARKS"."TPCH_SF1"."PART" INNER JOIN "BENCHMARKS"."TPCH_SF1"."SUPPLIER" ON (("PART"."P_SIZE" = 15) AND "PART"."P_TYPE" LIKE '%BRASS') INNER JOIN "BENCHMARKS"."TPCH_SF1"."PARTSUPP" ON ((("PART"."P_PARTKEY" = "PARTSUPP"."PS_PARTKEY") AND ("SUPPLIER"."S_SUPPKEY" = "PARTSUPP"."PS_SUPPKEY")) AND ("PARTSUPP"."PS_SUPPLYCOST" = (SELECT min("PARTSUPP"."PS_SUPPLYCOST") FROM "BENCHMARKS"."TPCH_SF1"."PARTSUPP" INNER JOIN "BENCHMARKS"."TPCH_SF1"."SUPPLIER" ON (("SUPPLIER"."S_SUPPKEY" = "PARTSUPP"."PS_SUPPKEY") AND ("PART"."P_PARTKEY" = "PARTSUPP"."PS_PARTKEY")) INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON ("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") INNER JOIN "BENCHMARKS"."TPCH_SF1"."REGION" ON (("NATION"."N_REGIONKEY" = "REGION"."R_REGIONKEY") AND ("REGION"."R_NAME" = 'EUROPE'))))) INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON ("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") INNER JOIN "BENCHMARKS"."TPCH_SF1"."REGION" ON (("NATION"."N_REGIONKEY" = "REGION"."R_REGIONKEY") AND ("REGION"."R_NAME" = 'EUROPE')) ORDER BY "S_ACCTBAL" DESC NULLS FIRST, "N_NAME" ASC NULLS LAST, "S_NAME" ASC NULLS LAST, "P_PARTKEY" ASC NULLS LAST LIMIT 100 |
