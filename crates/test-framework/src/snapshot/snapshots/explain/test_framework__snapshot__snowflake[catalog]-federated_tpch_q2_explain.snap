|               |             Filter: snowflake.TPCH_SF1.PARTSUPP.PS_SUPPLYCOST = (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
