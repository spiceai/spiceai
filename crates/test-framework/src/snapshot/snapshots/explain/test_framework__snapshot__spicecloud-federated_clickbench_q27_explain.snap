|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Projection: hits.SearchPhrase                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     Sort: to_timestamp(hits.EventTime) ASC NULLS LAST, hits.SearchPhrase ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                            |
|               |       Projection: hits.SearchPhrase, hits.EventTime                                                                                                                                                                                                                                                                                                                                                                                |
|               |         Filter: hits.SearchPhrase != Utf8("")                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           TableScan: hits projection=[EventTime, SearchPhrase], partial_filters=[hits.SearchPhrase != Utf8("")]                                                                                                                                                                                                                                                                                                                    |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       VirtualExecutionPlan name=spice.ai compute_context=url=https://us-east-1-prod-aws-flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench base_sql=SELECT "SearchPhrase" FROM (SELECT "SearchPhrase", "EventTime" FROM "clickbench"."hits" WHERE ("hits"."SearchPhrase" <> '') AND ("hits"."SearchPhrase" <> '') ORDER BY to_timestamp("hits"."EventTime") ASC NULLS LAST, "SearchPhrase" ASC NULLS LAST) LIMIT 10 |
