---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |  Projection: sum(order_line.ol_amount) / Float64(2) AS avg_yearly                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   Aggregate: groupBy=[[]], aggr=[[sum(order_line.ol_amount)]]                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     Inner Join:  Filter: order_line.ol_i_id = t.i_id AND order_line.ol_quantity < t.a                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       TableScan: order_line projection=[ol_i_id, ol_quantity, ol_amount]                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       SubqueryAlias: t                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         Projection: item.i_id, avg(order_line.ol_quantity) AS a                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |           Aggregate: groupBy=[[item.i_id]], aggr=[[avg(order_line.ol_quantity)]]                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             Inner Join:  Filter: order_line.ol_i_id = item.i_id                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |               TableScan: item projection=[i_id], full_filters=[item.i_data LIKE Utf8("%b")]                                                                                                                                                                                                                                                                                                                                                                                                |
|               |               TableScan: order_line projection=[ol_i_id, ol_quantity]                                                                                                                                                                                                                                                                                                                                                                                                                      |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT (sum("order_line"."ol_amount") // 2.0) AS "avg_yearly" FROM "order_line" INNER JOIN (SELECT "item"."i_id", avg("order_line"."ol_quantity") AS "a" FROM "item" INNER JOIN "order_line" ON (("order_line"."ol_i_id" = "item"."i_id") AND "item"."i_data" LIKE '%b') GROUP BY "item"."i_id") AS "t" ON (("order_line"."ol_i_id" = "t"."i_id") AND ("order_line"."ol_quantity" < "t"."a")) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
