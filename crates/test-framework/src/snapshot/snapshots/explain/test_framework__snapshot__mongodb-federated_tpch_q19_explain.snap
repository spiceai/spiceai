                                 |
|               |               ProjectionExec: expr=[l_discount@0 as l_discount, l_extendedprice@1 as l_extendedprice, l_partkey@2 as l_partkey, l_quantity@3 as l_quantity]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   