                                 |
|               |           HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(l_partkey@2, p_partkey@2)], filter=p_brand@1 = Brand#12 AND p_container@2 IN (SET) ([SM CASE, SM BOX, SM PACK, SM PKG]) AND l_quantity@0 >= 1.000000 AND l_quantity@0 <= 11.000000 AND p_size@3 <= 5 OR p_brand@1 = Brand#23 AND p_container@2 IN (SET) ([MED BAG, MED BOX, MED PKG, MED PACK]) AND l_quantity@0 >= 10.000000 AND l_quantity@0 <= 20.000000 AND p_size@3 <= 10 OR p_brand@1 = Brand#34 AND p_container@2 IN (SET) ([LG CASE, LG BOX, LG PACK, LG PKG]) AND l_quantity@0 >= 20.000000 AND l_quantity@0 <= 30.000000 AND p_size@3 <= 15                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      