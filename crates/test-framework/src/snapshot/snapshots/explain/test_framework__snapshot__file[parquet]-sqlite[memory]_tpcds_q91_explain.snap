|               |             Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |  Projection: call_center.cc_call_center_sk, call_center.cc_call_center_id, call_center.cc_name, call_center.cc_manager, catalog_returns.cr_returned_date_sk, catalog_returns.cr_returning_customer_sk, catalog_returns.cr_call_center_sk, catalog_returns.cr_net_loss, date_dim.d_date_sk, customer.c_customer_sk, customer.c_current_cdemo_sk, customer.c_current_hdemo_sk, customer.c_current_addr_sk, customer_address.ca_address_sk, customer_demographics.cd_demo_sk, customer_demographics.cd_marital_status, customer_demographics.cd_education_status                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Inner Join:  Filter: customer_demographics.cd_demo_sk = customer.c_current_cdemo_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     Inner Join:  Filter: customer_address.ca_address_sk = customer.c_current_addr_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       Inner Join:  Filter: catalog_returns.cr_returning_customer_sk = customer.c_customer_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |         Inner Join:  Filter: catalog_returns.cr_returned_date_sk = date_dim.d_date_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |           Inner Join:  Filter: catalog_returns.cr_call_center_sk = call_center.cc_call_center_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |             TableScan: call_center projection=[cc_call_center_sk, cc_call_center_id, cc_name, cc_manager]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |             TableScan: catalog_returns projection=[cr_returned_date_sk, cr_returning_customer_sk, cr_call_center_sk, cr_net_loss]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |           TableScan: date_dim projection=[d_date_sk], full_filters=[date_dim.d_moy = Int64(11), date_dim.d_year = Int64(2002)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         TableScan: customer projection=[c_customer_sk, c_current_cdemo_sk, c_current_hdemo_sk, c_current_addr_sk]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       TableScan: customer_address projection=[ca_address_sk], full_filters=[customer_address.ca_gmt_offset = Int64(-6)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     TableScan: customer_demographics projection=[cd_demo_sk, cd_marital_status, cd_education_status], full_filters=[customer_demographics.cd_marital_status = Utf8("M") AND customer_demographics.cd_education_status = Utf8("Unknown") OR customer_demographics.cd_marital_status = Utf8("W") AND customer_demographics.cd_education_status = Utf8("Advanced Degree")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |           Projection: household_demographics.hd_demo_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |             Filter: household_demographics.hd_buy_potential LIKE LargeUtf8("Unknown%")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |               Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |  Projection: household_demographics.hd_demo_sk, household_demographics.hd_buy_potential                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   TableScan: household_demographics projection=[hd_demo_sk, hd_buy_potential]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| physical_plan | SortPreservingMergeExec: [Returns_Loss@3 DESC]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   SortExec: expr=[Returns_Loss@3 DESC], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     ProjectionExec: expr=[cc_call_center_id@0 as Call_Center, cc_name@1 as Call_Center_Name, cc_manager@2 as Manager, sum(catalog_returns.cr_net_loss)@5 as Returns_Loss]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       AggregateExec: mode=FinalPartitioned, gby=[cc_call_center_id@0 as cc_call_center_id, cc_name@1 as cc_name, cc_manager@2 as cc_manager, cd_marital_status@3 as cd_marital_status, cd_education_status@4 as cd_education_status], aggr=[sum(catalog_returns.cr_net_loss)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         RepartitionExec: partitioning=Hash([cc_call_center_id@0, cc_name@1, cc_manager@2, cd_marital_status@3, cd_education_status@4], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           AggregateExec: mode=Partial, gby=[cc_call_center_id@0 as cc_call_center_id, cc_name@1 as cc_name, cc_manager@2 as cc_manager, cd_marital_status@4 as cd_marital_status, cd_education_status@5 as cd_education_status], aggr=[sum(catalog_returns.cr_net_loss)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |             HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(c_current_hdemo_sk@4, hd_demo_sk@0)], projection=[cc_call_center_id@0, cc_name@1, cc_manager@2, cr_net_loss@3, cd_marital_status@5, cd_education_status@6]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |               RepartitionExec: partitioning=Hash([c_current_hdemo_sk@4], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                 ProjectionExec: expr=[cc_call_center_id@1 as cc_call_center_id, cc_name@2 as cc_name, cc_manager@3 as cc_manager, cr_net_loss@7 as cr_net_loss, c_current_hdemo_sk@11 as c_current_hdemo_sk, cd_marital_status@15 as cd_marital_status, cd_education_status@16 as cd_education_status]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                   SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |                       VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `call_center`.`cc_call_center_sk`, `call_center`.`cc_call_center_id`, `call_center`.`cc_name`, `call_center`.`cc_manager`, `catalog_returns`.`cr_returned_date_sk`, `catalog_returns`.`cr_returning_customer_sk`, `catalog_returns`.`cr_call_center_sk`, `catalog_returns`.`cr_net_loss`, `date_dim`.`d_date_sk`, `customer`.`c_customer_sk`, `customer`.`c_current_cdemo_sk`, `customer`.`c_current_hdemo_sk`, `customer`.`c_current_addr_sk`, `customer_address`.`ca_address_sk`, `customer_demographics`.`cd_demo_sk`, `customer_demographics`.`cd_marital_status`, `customer_demographics`.`cd_education_status` FROM `call_center` INNER JOIN `catalog_returns` ON (`catalog_returns`.`cr_call_center_sk` = `call_center`.`cc_call_center_sk`) INNER JOIN `date_dim` ON (`catalog_returns`.`cr_returned_date_sk` = `date_dim`.`d_date_sk`) INNER JOIN `customer` ON (`catalog_returns`.`cr_returning_customer_sk` = `customer`.`c_customer_sk`) INNER JOIN `customer_address` ON (`customer_address`.`ca_address_sk` = `customer`.`c_current_addr_sk`) INNER JOIN `customer_demographics` ON (`customer_demographics`.`cd_demo_sk` = `customer`.`c_current_cdemo_sk`) WHERE (`date_dim`.`d_moy` = 11) AND (`date_dim`.`d_year` = 2002) AND (`customer_address`.`ca_gmt_offset` = -6) AND (((`customer_demographics`.`cd_marital_status` = 'M') AND (`customer_demographics`.`cd_education_status` = 'Unknown')) OR ((`customer_demographics`.`cd_marital_status` = 'W') AND (`customer_demographics`.`cd_education_status` = 'Advanced Degree'))) |
