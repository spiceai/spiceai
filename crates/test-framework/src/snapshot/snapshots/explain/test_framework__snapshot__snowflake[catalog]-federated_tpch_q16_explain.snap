+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |  Sort: SUPPLIER_CNT DESC NULLS FIRST, snowflake.TPCH_SF1.PART.P_BRAND ASC NULLS LAST, snowflake.TPCH_SF1.PART.P_TYPE ASC NULLS LAST, snowflake.TPCH_SF1.PART.P_SIZE ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   Projection: snowflake.TPCH_SF1.PART.P_BRAND, snowflake.TPCH_SF1.PART.P_TYPE, snowflake.TPCH_SF1.PART.P_SIZE, count(DISTINCT snowflake.TPCH_SF1.PARTSUPP.PS_SUPPKEY) AS SUPPLIER_CNT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     Aggregate: groupBy=[[snowflake.TPCH_SF1.PART.P_BRAND, snowflake.TPCH_SF1.PART.P_TYPE, snowflake.TPCH_SF1.PART.P_SIZE]], aggr=[[count(DISTINCT snowflake.TPCH_SF1.PARTSUPP.PS_SUPPKEY)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       Inner Join:  Filter: snowflake.TPCH_SF1.PART.P_PARTKEY = snowflake.TPCH_SF1.PARTSUPP.PS_PARTKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |         Filter: snowflake.TPCH_SF1.PARTSUPP.PS_SUPPKEY NOT IN (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |           Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             Projection: snowflake.TPCH_SF1.SUPPLIER.S_SUPPKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |               TableScan: snowflake.TPCH_SF1.SUPPLIER, full_filters=[snowflake.TPCH_SF1.SUPPLIER.S_COMMENT LIKE Utf8("%Customer%Complaints%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |           TableScan: snowflake.TPCH_SF1.PARTSUPP projection=[PS_PARTKEY, PS_SUPPKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |         TableScan: snowflake.TPCH_SF1.PART projection=[P_PARTKEY, P_BRAND, P_TYPE, P_SIZE], full_filters=[snowflake.TPCH_SF1.PART.P_BRAND != Utf8("Brand#45"), snowflake.TPCH_SF1.PART.P_TYPE NOT LIKE Utf8("MEDIUM POLISHED%"), snowflake.TPCH_SF1.PART.P_SIZE IN ([Int64(49), Int64(14), Int64(23), Int64(45), Int64(19), Int64(3), Int64(36), Int64(9)])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "P_BRAND", "P_TYPE", "P_SIZE", count(DISTINCT "PARTSUPP"."PS_SUPPKEY") AS "SUPPLIER_CNT" FROM "BENCHMARKS"."TPCH_SF1"."PARTSUPP" INNER JOIN "BENCHMARKS"."TPCH_SF1"."PART" ON (("PART"."P_PARTKEY" = "PARTSUPP"."PS_PARTKEY") AND ((("PARTSUPP"."PS_SUPPKEY" NOT IN (SELECT "S_SUPPKEY" FROM "BENCHMARKS"."TPCH_SF1"."SUPPLIER" WHERE "SUPPLIER"."S_COMMENT" LIKE '%Customer%Complaints%') AND ("PART"."P_BRAND" <> 'Brand#45')) AND "PART"."P_TYPE" NOT LIKE 'MEDIUM POLISHED%') AND "PART"."P_SIZE" IN (49, 14, 23, 45, 19, 3, 36, 9))) GROUP BY "PART"."P_BRAND", "PART"."P_TYPE", "PART"."P_SIZE" ORDER BY "SUPPLIER_CNT" DESC NULLS FIRST, "P_BRAND" ASC NULLS LAST, "P_TYPE" ASC NULLS LAST, "P_SIZE" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
