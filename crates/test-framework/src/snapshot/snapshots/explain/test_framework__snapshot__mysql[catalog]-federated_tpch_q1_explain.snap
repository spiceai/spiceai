|               |  Sort: mysql.tpch_sf1.lineitem.l_returnflag ASC NULLS LAST, mysql.tpch_sf1.lineitem.l_linestatus ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Projection: mysql.tpch_sf1.lineitem.l_returnflag, mysql.tpch_sf1.lineitem.l_linestatus, sum(mysql.tpch_sf1.lineitem.l_quantity) AS sum_qty, sum(mysql.tpch_sf1.lineitem.l_extendedprice) AS sum_base_price, sum(mysql.tpch_sf1.lineitem.l_extendedprice * Int64(1) - mysql.tpch_sf1.lineitem.l_discount) AS sum_disc_price, sum(mysql.tpch_sf1.lineitem.l_extendedprice * Int64(1) - mysql.tpch_sf1.lineitem.l_discount * Int64(1) + mysql.tpch_sf1.lineitem.l_tax) AS sum_charge, avg(mysql.tpch_sf1.lineitem.l_quantity) AS avg_qty, avg(mysql.tpch_sf1.lineitem.l_extendedprice) AS avg_price, avg(mysql.tpch_sf1.lineitem.l_discount) AS avg_disc, count(Int64(1)) AS count_order                                                                                                                                                                                                              |
|               |     Aggregate: groupBy=[[mysql.tpch_sf1.lineitem.l_returnflag, mysql.tpch_sf1.lineitem.l_linestatus]], aggr=[[sum(mysql.tpch_sf1.lineitem.l_quantity), sum(mysql.tpch_sf1.lineitem.l_extendedprice), sum(mysql.tpch_sf1.lineitem.l_extendedprice * (Int64(1) - mysql.tpch_sf1.lineitem.l_discount)), sum(mysql.tpch_sf1.lineitem.l_extendedprice * (Int64(1) - mysql.tpch_sf1.lineitem.l_discount) * (Int64(1) + mysql.tpch_sf1.lineitem.l_tax)), avg(mysql.tpch_sf1.lineitem.l_quantity), avg(mysql.tpch_sf1.lineitem.l_extendedprice), avg(mysql.tpch_sf1.lineitem.l_discount), count(Int64(1))]]                                                                                                                                                                                                                                                                                                  |
