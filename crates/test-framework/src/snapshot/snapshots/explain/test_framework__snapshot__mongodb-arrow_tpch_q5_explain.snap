---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpch_q5"
---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                          |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: revenue DESC NULLS FIRST                                                                                                                                                                                                                                                |
|               |   Projection: nation.n_name, sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount) AS revenue                                                                                                                                                                        |
|               |     Aggregate: groupBy=[[nation.n_name]], aggr=[[sum(lineitem.l_extendedprice * (Decimal128(1,20,0) - lineitem.l_discount)) AS sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)]]                                                                               |
|               |       Projection: lineitem.l_discount, lineitem.l_extendedprice, nation.n_name                                                                                                                                                                                                |
|               |         Inner Join: nation.n_regionkey = region.r_regionkey                                                                                                                                                                                                                   |
|               |           Projection: lineitem.l_discount, lineitem.l_extendedprice, nation.n_name, nation.n_regionkey                                                                                                                                                                        |
|               |             Inner Join: supplier.s_nationkey = nation.n_nationkey                                                                                                                                                                                                             |
|               |               Projection: lineitem.l_discount, lineitem.l_extendedprice, supplier.s_nationkey                                                                                                                                                                                 |
|               |                 Inner Join: lineitem.l_suppkey = supplier.s_suppkey, customer.c_nationkey = supplier.s_nationkey                                                                                                                                                              |
|               |                   Projection: customer.c_nationkey, lineitem.l_discount, lineitem.l_extendedprice, lineitem.l_suppkey                                                                                                                                                         |
|               |                     Inner Join: orders.o_orderkey = lineitem.l_orderkey                                                                                                                                                                                                       |
|               |                       Projection: customer.c_nationkey, orders.o_orderkey                                                                                                                                                                                                     |
|               |                         Inner Join: customer.c_custkey = orders.o_custkey                                                                                                                                                                                                     |
|               |                           TableScan: customer projection=[c_custkey, c_nationkey]                                                                                                                                                                                             |
|               |                           Projection: orders.o_custkey, orders.o_orderkey                                                                                                                                                                                                     |
|               |                             Filter: orders.o_orderdate >= Date32("1994-01-01") AND orders.o_orderdate < Date32("1995-01-01")                                                                                                                                                  |
|               |                               TableScan: orders projection=[o_custkey, o_orderdate, o_orderkey]                                                                                                                                                                               |
|               |                       TableScan: lineitem projection=[l_discount, l_extendedprice, l_orderkey, l_suppkey]                                                                                                                                                                     |
|               |                   TableScan: supplier projection=[s_nationkey, s_suppkey]                                                                                                                                                                                                     |
|               |               TableScan: nation projection=[n_name, n_nationkey, n_regionkey]                                                                                                                                                                                                 |
|               |           Projection: region.r_regionkey                                                                                                                                                                                                                                      |
|               |             Filter: region.r_name = Utf8("ASIA")                                                                                                                                                                                                                              |
|               |               TableScan: region projection=[r_name, r_regionkey]                                                                                                                                                                                                              |
| physical_plan | SortPreservingMergeExec: [revenue@1 DESC]                                                                                                                                                                                                                                     |
|               |   ProjectionExec: expr=[n_name@0 as n_name, sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)@1 as revenue]                                                                                                                                                      |
|               |     SortExec: expr=[sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)@1 DESC], preserve_partitioning=[true]                                                                                                                                                      |
|               |       AggregateExec: mode=FinalPartitioned, gby=[n_name@0 as n_name], aggr=[sum(lineitem.l_extendedprice * 1 - lineitem.l_discount) as sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)]                                                                        |
|               |         RepartitionExec: partitioning=Hash([n_name@0], 32), input_partitions=32                                                                                                                                                                                               |
|               |           AggregateExec: mode=Partial, gby=[n_name@2 as n_name], aggr=[sum(lineitem.l_extendedprice * 1 - lineitem.l_discount) as sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)]                                                                             |
|               |             HashJoinExec: mode=CollectLeft, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(r_regionkey@0, n_regionkey@3)], projection=[l_discount@1, l_extendedprice@2, n_name@3]                                                                                   |
|               |               ProjectionExec: expr=[r_regionkey@1 as r_regionkey]                                                                                                                                                                                                             |
|               |                 FilterExec: r_name@0 = ASIA                                                                                                                                                                                                                                   |
|               |                   SchemaCastScanExec                                                                                                                                                                                                                                          |
|               |                     BytesProcessedExec                                                                                                                                                                                                                                        |
|               |                       DataSourceExec: partitions=1, partition_sizes=[<redacted>]                                                                                                                                                                                              |
|               |               ProjectionExec: expr=[l_discount@0 as l_discount, l_extendedprice@1 as l_extendedprice, n_name@3 as n_name, n_regionkey@5 as n_regionkey]                                                                                                                       |
|               |                 HashJoinExec: mode=CollectLeft, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(n_nationkey@1, s_nationkey@2)], projection=[l_discount@3, l_extendedprice@4, s_nationkey@5, n_name@0, n_nationkey@1, n_regionkey@2]                                  |
|               |                   SchemaCastScanExec                                                                                                                                                                                                                                          |
|               |                     BytesProcessedExec                                                                                                                                                                                                                                        |
|               |                       DataSourceExec: partitions=1, partition_sizes=[<redacted>]                                                                                                                                                                                              |
|               |                   ProjectionExec: expr=[l_discount@1 as l_discount, l_extendedprice@2 as l_extendedprice, s_nationkey@4 as s_nationkey]                                                                                                                                       |
|               |                     HashJoinExec: mode=CollectLeft, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(s_suppkey@1, l_suppkey@3), (s_nationkey@0, c_nationkey@0)], projection=[c_nationkey@2, l_discount@3, l_extendedprice@4, l_suppkey@5, s_nationkey@0, s_suppkey@1] |
|               |                       SchemaCastScanExec                                                                                                                                                                                                                                      |
|               |                         BytesProcessedExec                                                                                                                                                                                                                                    |
|               |                           DataSourceExec: partitions=1, partition_sizes=[<redacted>]                                                                                                                                                                                          |
|               |                       ProjectionExec: expr=[c_nationkey@0 as c_nationkey, l_discount@2 as l_discount, l_extendedprice@3 as l_extendedprice, l_suppkey@5 as l_suppkey]                                                                                                         |
|               |                         HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(o_orderkey@1, l_orderkey@2)]                                                                                                                                 |
|               |                           RepartitionExec: partitioning=Hash([o_orderkey@1], 32), input_partitions=32                                                                                                                                                                         |
|               |                             ProjectionExec: expr=[c_nationkey@1 as c_nationkey, o_orderkey@3 as o_orderkey]                                                                                                                                                                   |
|               |                               HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(c_custkey@0, o_custkey@0)]                                                                                                                             |
|               |                                 RepartitionExec: partitioning=Hash([c_custkey@0], 32), input_partitions=1                                                                                                                                                                     |
|               |                                   SchemaCastScanExec                                                                                                                                                                                                                          |
|               |                                     BytesProcessedExec                                                                                                                                                                                                                        |
|               |                                       DataSourceExec: partitions=1, partition_sizes=[<redacted>]                                                                                                                                                                              |
|               |                                 RepartitionExec: partitioning=Hash([o_custkey@0], 32), input_partitions=32                                                                                                                                                                    |
|               |                                   ProjectionExec: expr=[o_custkey@0 as o_custkey, o_orderkey@2 as o_orderkey]                                                                                                                                                                 |
|               |                                     FilterExec: o_orderdate@1 >= 1994-01-01 AND o_orderdate@1 < 1995-01-01                                                                                                                                                                    |
|               |                                       SchemaCastScanExec                                                                                                                                                                                                                      |
|               |                                         BytesProcessedExec                                                                                                                                                                                                                    |
|               |                                           DataSourceExec: partitions=32, partition_sizes=[<redacted>]                                                                                                                                                                         |
|               |                           RepartitionExec: partitioning=Hash([l_orderkey@2], 32), input_partitions=32                                                                                                                                                                         |
|               |                             SchemaCastScanExec                                                                                                                                                                                                                                |
|               |                               BytesProcessedExec                                                                                                                                                                                                                              |
|               |                                 DataSourceExec: partitions=32, partition_sizes=[<redacted>]                                                                                                                                                                                   |
