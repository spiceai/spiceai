|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Projection: hits.UserID, hits.SearchPhrase, count(*)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     Sort: count(Int64(1)) AS count(*) AS count(*) DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       Projection: hits.UserID, hits.SearchPhrase, count(Int64(1)) AS count(*), count(Int64(1))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |         Aggregate: groupBy=[[hits.UserID, hits.SearchPhrase]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |           TableScan: hits projection=[UserID, SearchPhrase]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| physical_plan | BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     VirtualExecutionPlan name=spice.ai compute_context=url=https://flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench sql=SELECT UserID, SearchPhrase, "count(*)" FROM (SELECT hits.UserID, hits.SearchPhrase, count(1) AS "count(*)", count(1) FROM hits GROUP BY hits.UserID, hits.SearchPhrase ORDER BY "count(Int64(1))" DESC NULLS FIRST) LIMIT 10 rewritten_sql=SELECT "UserID", "SearchPhrase", "count(*)" FROM (SELECT "UserID", "SearchPhrase", count(1) AS "count(*)", count(1) FROM "clickbench"."hits" GROUP BY "hits"."UserID", "hits"."SearchPhrase" ORDER BY "count(Int64(1))" DESC NULLS FIRST) LIMIT 10 |
