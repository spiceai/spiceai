                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |         SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |           BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |             VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `at`.`amc`, `pt`.`pmc` FROM (SELECT count(1) AS `amc` FROM `web_sales` INNER JOIN `household_demographics` ON (`web_sales`.`ws_ship_hdemo_sk` = `household_demographics`.`hd_demo_sk`) INNER JOIN `time_dim` ON (`web_sales`.`ws_sold_time_sk` = `time_dim`.`t_time_sk`) INNER JOIN `web_page` ON (`web_sales`.`ws_web_page_sk` = `web_page`.`wp_web_page_sk`) WHERE (`household_demographics`.`hd_dep_count` = 2) AND (`time_dim`.`t_hour` BETWEEN 9 AND (9 + 1)) AND (`web_page`.`wp_char_count` BETWEEN 2500 AND 5200)) AS `at` CROSS JOIN (SELECT count(1) AS `pmc` FROM `web_sales` INNER JOIN `household_demographics` ON (`web_sales`.`ws_ship_hdemo_sk` = `household_demographics`.`hd_demo_sk`) INNER JOIN `time_dim` ON (`web_sales`.`ws_sold_time_sk` = `time_dim`.`t_time_sk`) INNER JOIN `web_page` ON (`web_sales`.`ws_web_page_sk` = `web_page`.`wp_web_page_sk`) WHERE (`household_demographics`.`hd_dep_count` = 2) AND (`time_dim`.`t_hour` BETWEEN 15 AND (15 + 1)) AND (`web_page`.`wp_char_count` BETWEEN 2500 AND 5200)) AS `pt` rewritten_executor_sql=SELECT `at`.`amc`, `pt`.`pmc` FROM (SELECT count(1) AS `amc` FROM `web_sales` INNER JOIN `household_demographics` ON (`web_sales`.`ws_ship_hdemo_sk` = `household_demographics`.`hd_demo_sk`) INNER JOIN `time_dim` ON (`web_sales`.`ws_sold_time_sk` = `time_dim`.`t_time_sk`) INNER JOIN `web_page` ON (`web_sales`.`ws_web_page_sk` = `web_page`.`wp_web_page_sk`) WHERE (`household_demographics`.`hd_dep_count` = 2) AND (decimal_cmp(`time_dim`.`t_hour`, decimal('9')) >= 0 AND decimal_cmp(`time_dim`.`t_hour`, (decimal_add(decimal('9'), decimal('1')))) <= 0) AND (decimal_cmp(`web_page`.`wp_char_count`, decimal('2500')) >= 0 AND decimal_cmp(`web_page`.`wp_char_count`, decimal('5200')) <= 0)) AS `at` CROSS JOIN (SELECT count(1) AS `pmc` FROM `web_sales` INNER JOIN `household_demographics` ON (`web_sales`.`ws_ship_hdemo_sk` = `household_demographics`.`hd_demo_sk`) INNER JOIN `time_dim` ON (`web_sales`.`ws_sold_time_sk` = `time_dim`.`t_time_sk`) INNER JOIN `web_page` ON (`web_sales`.`ws_web_page_sk` = `web_page`.`wp_web_page_sk`) WHERE (`household_demographics`.`hd_dep_count` = 2) AND (decimal_cmp(`time_dim`.`t_hour`, decimal('15')) >= 0 AND decimal_cmp(`time_dim`.`t_hour`, (decimal_add(decimal('15'), decimal('1')))) <= 0) AND (decimal_cmp(`web_page`.`wp_char_count`, decimal('2500')) >= 0 AND decimal_cmp(`web_page`.`wp_char_count`, decimal('5200')) <= 0)) AS `pt` |
