|               |                       DuckSqlExec sql=WITH _intermediate_materialize AS MATERIALIZED (SELECT "AreaCodeRegion", "AvailableForNumberSelection", "MaxRate", "NumberRegion", "NumberSid", "NumberType" FROM number_info WHERE "AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066' AND "NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9') SELECT "NumberSid", "MaxRate" FROM _intermediate_materialize WHERE (true) AND (true) AND ("NumberRegion" = 'US') AND ("NumberType" = 'lc') AND ("AreaCodeRegion" = '617') AND ("NumberSid" <> 'PN00000000000000000000000000000099') AND (("AvailableForNumberSelection" = 1) OR ("AvailableForNumberSelection" = 0)) |
