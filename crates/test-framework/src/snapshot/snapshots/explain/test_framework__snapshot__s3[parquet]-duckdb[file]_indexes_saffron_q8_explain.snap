---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: saffron_q8"
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |  Limit: skip=0, fetch=CAST(Int64(20) AS Int64)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Sort: A.NumberSid ASC NULLS LAST, B.Capability ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Projection: A.DateCreated, A.DateUpdated, A.AccountSid, A.NumberPoolSid, A.NumberSid, A.MaxRate, A.NumberDid, A.NumberType, A.SupportedDestRegion, A.NumberRegion, A.CurrentRate, A.IsAvailable, A.ProviderSid, A.AreaCodeRegion, A.AvailableForNumberSelection, B.Capability                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       Inner Join:  Filter: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |         Filter: A.AccountSid = Utf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND A.NumberPoolSid = Utf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND A.NumberType = Utf8("lc") AND A.NumberSid NOT IN ([Utf8("PN00000000000000000000000000000099")])                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |           SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |             TableScan: number_info projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Filter: B.Capability = Utf8("sms")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |           SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |             TableScan: number_caps projection=[NumberSid, Capability]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "A"."DateCreated", "A"."DateUpdated", "A"."AccountSid", "A"."NumberPoolSid", "A"."NumberSid", "A"."MaxRate", "A"."NumberDid", "A"."NumberType", "A"."SupportedDestRegion", "A"."NumberRegion", "A"."CurrentRate", "A"."IsAvailable", "A"."ProviderSid", "A"."AreaCodeRegion", "A"."AvailableForNumberSelection", "B"."Capability" FROM "number_info" AS "A" INNER JOIN "number_caps" AS "B" ON (("A"."NumberSid" = "B"."NumberSid") AND ((((("A"."AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066') AND ("A"."NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9')) AND ("A"."NumberType" = 'lc')) AND "A"."NumberSid" NOT IN ('PN00000000000000000000000000000099')) AND ("B"."Capability" = 'sms'))) ORDER BY "A"."NumberSid" ASC NULLS LAST, "B"."Capability" ASC NULLS LAST LIMIT CAST(20 AS BIGINT) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
