+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |  Limit: skip=100, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     Projection: hits.URLHash, to_timestamp(hits.EventDate * Int64(86400)), count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       Aggregate: groupBy=[[hits.URLHash, to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400))]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |         TableScan: hits projection=[EventDate, URLHash], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) >= CAST(Utf8("2013-07-01") AS Timestamp(ns)), to_timestamp(CAST(hits.EventDate AS Int64) * Int64(86400)) <= CAST(Utf8("2013-07-31") AS Timestamp(ns)), CAST(hits.IsRefresh AS Int64) = Int64(0), CAST(hits.TraficSourceID AS Int64) IN ([Int64(-1), Int64(6)]), hits.RefererHash = Int64(3594120000172545465)]                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "hits"."URLHash", to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)), count(1) AS "PageViews" FROM "hits" WHERE ((((((CAST("hits"."CounterID" AS BIGINT) = 62) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) >= CAST('2013-07-01' AS TIMESTAMP))) AND (to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) <= CAST('2013-07-31' AS TIMESTAMP))) AND (CAST("hits"."IsRefresh" AS BIGINT) = 0)) AND CAST("hits"."TraficSourceID" AS BIGINT) IN (-1, 6)) AND ("hits"."RefererHash" = 3594120000172545465)) GROUP BY "hits"."URLHash", to_timestamp((CAST("hits"."EventDate" AS BIGINT) * 86400)) ORDER BY "PageViews" DESC NULLS FIRST LIMIT 10 OFFSET 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
