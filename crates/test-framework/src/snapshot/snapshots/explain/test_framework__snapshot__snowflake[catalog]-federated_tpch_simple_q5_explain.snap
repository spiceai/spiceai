|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT sum("O"."O_TOTALPRICE") AS "TOTAL_PRICE", "L"."L_LINESTATUS" FROM "BENCHMARKS"."TPCH_SF1"."ORDERS" AS "O" INNER JOIN "BENCHMARKS"."TPCH_SF1"."LINEITEM" AS "L" ON ("O"."O_ORDERKEY" = "L"."L_ORDERKEY") GROUP BY "L"."L_LINESTATUS" ORDER BY "TOTAL_PRICE" DESC NULLS FIRST |
