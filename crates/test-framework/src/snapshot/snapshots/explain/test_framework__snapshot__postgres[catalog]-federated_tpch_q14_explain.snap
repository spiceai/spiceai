+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |  Projection: Float64(100) * sum(CASE WHEN pg.public.part.p_type LIKE Utf8("PROMO%") THEN pg.public.lineitem.l_extendedprice * Int64(1) - pg.public.lineitem.l_discount ELSE Int64(0) END) / sum(pg.public.lineitem.l_extendedprice * Int64(1) - pg.public.lineitem.l_discount) AS promo_revenue                                                                                                                                                                                                                                                                                                                                                  |
|               |   Aggregate: groupBy=[[]], aggr=[[sum(CASE WHEN pg.public.part.p_type LIKE Utf8("PROMO%") THEN pg.public.lineitem.l_extendedprice * (Int64(1) - pg.public.lineitem.l_discount) ELSE Int64(0) END), sum(pg.public.lineitem.l_extendedprice * (Int64(1) - pg.public.lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                        |
|               |     Inner Join:  Filter: pg.public.lineitem.l_partkey = pg.public.part.p_partkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       TableScan: pg.public.lineitem projection=[l_partkey, l_extendedprice, l_discount], full_filters=[pg.public.lineitem.l_shipdate >= CAST(Utf8("1995-09-01") AS Date32), pg.public.lineitem.l_shipdate < CAST(Utf8("1995-10-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       TableScan: pg.public.part projection=[p_partkey, p_type]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT ((100.0 * sum(CASE WHEN "part"."p_type" LIKE 'PROMO%' THEN ("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount")) ELSE 0 END)) / sum(("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount")))) AS "promo_revenue" FROM "public"."lineitem" INNER JOIN "public"."part" ON ("lineitem"."l_partkey" = "part"."p_partkey") WHERE ("lineitem"."l_shipdate" >= CAST('1995-09-01' AS DATE)) AND ("lineitem"."l_shipdate" < CAST('1995-10-01' AS DATE)) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
