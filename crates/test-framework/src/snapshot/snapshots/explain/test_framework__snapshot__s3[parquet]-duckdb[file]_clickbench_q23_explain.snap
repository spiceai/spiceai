description: "Query: clickbench_q23"
---
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Sort: c DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     Projection: hits.SearchPhrase, min(hits.URL), min(hits.Title), count(Int64(1)) AS c, count(DISTINCT hits.UserID)                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       Aggregate: groupBy=[[hits.SearchPhrase]], aggr=[[min(hits.URL), min(hits.Title), count(Int64(1)), count(DISTINCT hits.UserID)]]                                                                                                                                                                                                                                                                                                                                                                      |
|               |         Filter: hits.Title LIKE CAST(Utf8("%Google%") AS LargeUtf8) AND hits.URL NOT LIKE CAST(Utf8("%.google.%") AS LargeUtf8) AND CAST(hits.SearchPhrase AS Utf8View) != CAST(Utf8("") AS Utf8View)                                                                                                                                                                                                                                                                                                      |
|               |           TableScan: hits projection=[Title, UserID, URL, SearchPhrase]                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "hits"."SearchPhrase", min("hits"."URL"), min("hits"."Title"), count(1) AS "c", count(DISTINCT "hits"."UserID") FROM "hits" WHERE (("hits"."Title" LIKE CAST('%Google%' AS TEXT) AND "hits"."URL" NOT LIKE CAST('%.google.%' AS TEXT)) AND (CAST("hits"."SearchPhrase" AS VARCHAR) <> CAST('' AS VARCHAR))) GROUP BY "hits"."SearchPhrase" ORDER BY "c" DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
