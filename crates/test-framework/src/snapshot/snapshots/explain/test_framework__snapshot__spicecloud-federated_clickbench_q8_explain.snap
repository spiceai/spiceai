|               |     VirtualExecutionPlan name=spice.ai compute_context=url=https://flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench sql=SELECT AdvEngineID, "count(*)" FROM (SELECT hits.AdvEngineID, count(1) AS "count(*)", count(1) FROM hits WHERE (hits.AdvEngineID <> 0) GROUP BY hits.AdvEngineID ORDER BY "count(Int64(1))" DESC NULLS FIRST) rewritten_sql=SELECT "AdvEngineID", "count(*)" FROM (SELECT "AdvEngineID", count(1) AS "count(*)", count(1) FROM "clickbench"."hits" WHERE ("hits"."AdvEngineID" <> 0) GROUP BY "hits"."AdvEngineID" ORDER BY "count(Int64(1))" DESC NULLS FIRST) |
