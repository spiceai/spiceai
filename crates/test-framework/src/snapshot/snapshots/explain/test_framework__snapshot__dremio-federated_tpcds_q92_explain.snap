source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpcds_q92"
---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |  Limit: skip=0, fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Sort: Excess Discount Amount ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     Projection: sum(web_sales.ws_ext_discount_amt) AS Excess Discount Amount                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       Aggregate: groupBy=[[]], aggr=[[sum(web_sales.ws_ext_discount_amt)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Inner Join:  Filter: date_dim.d_date_sk = web_sales.ws_sold_date_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |           Inner Join:  Filter: item.i_item_sk = web_sales.ws_item_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |             Filter: web_sales.ws_ext_discount_amt > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |               Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                 Projection: Float64(1.3) * avg(web_sales.ws_ext_discount_amt)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                   Aggregate: groupBy=[[]], aggr=[[avg(web_sales.ws_ext_discount_amt)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                     Inner Join:  Filter: date_dim.d_date_sk = web_sales.ws_sold_date_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                       Filter: web_sales.ws_item_sk = outer_ref(item.i_item_sk)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |                         TableScan: web_sales, partial_filters=[web_sales.ws_item_sk = outer_ref(item.i_item_sk)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                       Filter: date_dim.d_date BETWEEN Utf8("2001-01-25") AND CAST(Utf8("2001-01-25") AS Date32) + IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 90, nanoseconds: 0 }")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                         TableScan: date_dim, partial_filters=[date_dim.d_date BETWEEN Utf8("2001-01-25") AND CAST(Utf8("2001-01-25") AS Date32) + IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 90, nanoseconds: 0 }")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               TableScan: web_sales projection=[ws_sold_date_sk, ws_item_sk, ws_ext_discount_amt]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |             Filter: item.i_manufact_id = Int64(914)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |               TableScan: item projection=[i_item_sk, i_manufact_id], partial_filters=[item.i_manufact_id = Int64(914)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           Filter: date_dim.d_date BETWEEN Utf8("2001-01-25") AND CAST(Utf8("2001-01-25") AS Date32) + IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 90, nanoseconds: 0 }")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |             TableScan: date_dim projection=[d_date_sk, d_date], partial_filters=[date_dim.d_date BETWEEN Utf8("2001-01-25") AND CAST(Utf8("2001-01-25") AS Date32) + IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 90, nanoseconds: 0 }")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       VirtualExecutionPlan name=dremio compute_context=url=grpc://dremio-client.dataplatform.svc.cluster.local:32010,username=spicedev base_sql=SELECT sum(web_sales.ws_ext_discount_amt) AS "Excess Discount Amount" FROM tpcds.web_sales INNER JOIN tpcds.item ON (item.i_item_sk = web_sales.ws_item_sk) INNER JOIN tpcds.date_dim ON (date_dim.d_date_sk = web_sales.ws_sold_date_sk) WHERE (web_sales.ws_ext_discount_amt > (SELECT (1.3 * avg(web_sales.ws_ext_discount_amt)) FROM tpcds.web_sales INNER JOIN tpcds.date_dim ON (date_dim.d_date_sk = web_sales.ws_sold_date_sk) WHERE (web_sales.ws_item_sk = item.i_item_sk) AND (date_dim.d_date BETWEEN '2001-01-25' AND (CAST('2001-01-25' AS DATE) + INTERVAL '90 0:0:0.000' DAY TO SECOND)))) AND (item.i_manufact_id = 914) AND (date_dim.d_date BETWEEN '2001-01-25' AND (CAST('2001-01-25' AS DATE) + INTERVAL '90 0:0:0.000' DAY TO SECOND)) ORDER BY "Excess Discount Amount" ASC NULLS LAST LIMIT 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
