source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpch_q12"
---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |  Sort: pg.public.lineitem.l_shipmode ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   Projection: pg.public.lineitem.l_shipmode, sum(CASE WHEN pg.public.orders.o_orderpriority = Utf8("1-URGENT") OR pg.public.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS high_line_count, sum(CASE WHEN pg.public.orders.o_orderpriority != Utf8("1-URGENT") AND pg.public.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS low_line_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     Aggregate: groupBy=[[pg.public.lineitem.l_shipmode]], aggr=[[sum(CASE WHEN pg.public.orders.o_orderpriority = Utf8("1-URGENT") OR pg.public.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END), sum(CASE WHEN pg.public.orders.o_orderpriority != Utf8("1-URGENT") AND pg.public.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       Inner Join:  Filter: pg.public.orders.o_orderkey = pg.public.lineitem.l_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |         TableScan: pg.public.orders projection=[o_orderkey, o_orderpriority]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         TableScan: pg.public.lineitem projection=[l_orderkey, l_shipmode], full_filters=[pg.public.lineitem.l_shipmode IN ([Utf8("MAIL"), Utf8("SHIP")]), pg.public.lineitem.l_commitdate < pg.public.lineitem.l_receiptdate, pg.public.lineitem.l_shipdate < pg.public.lineitem.l_commitdate, pg.public.lineitem.l_receiptdate >= CAST(Utf8("1994-01-01") AS Date32), pg.public.lineitem.l_receiptdate < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "l_shipmode", sum(CASE WHEN (("orders"."o_orderpriority" = '1-URGENT') OR ("orders"."o_orderpriority" = '2-HIGH')) THEN 1 ELSE 0 END) AS "high_line_count", sum(CASE WHEN (("orders"."o_orderpriority" <> '1-URGENT') AND ("orders"."o_orderpriority" <> '2-HIGH')) THEN 1 ELSE 0 END) AS "low_line_count" FROM "public"."orders" INNER JOIN "public"."lineitem" ON ("orders"."o_orderkey" = "lineitem"."l_orderkey") WHERE "lineitem"."l_shipmode" IN ('MAIL', 'SHIP') AND ("lineitem"."l_commitdate" < "lineitem"."l_receiptdate") AND ("lineitem"."l_shipdate" < "lineitem"."l_commitdate") AND ("lineitem"."l_receiptdate" >= CAST('1994-01-01' AS DATE)) AND ("lineitem"."l_receiptdate" < CAST('1995-01-01' AS DATE)) GROUP BY "lineitem"."l_shipmode" ORDER BY "l_shipmode" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
