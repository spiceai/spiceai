| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |  Sort: mysql.tpch_sf1.lineitem.l_shipmode ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   Projection: mysql.tpch_sf1.lineitem.l_shipmode, sum(CASE WHEN mysql.tpch_sf1.orders.o_orderpriority = Utf8("1-URGENT") OR mysql.tpch_sf1.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS high_line_count, sum(CASE WHEN mysql.tpch_sf1.orders.o_orderpriority != Utf8("1-URGENT") AND mysql.tpch_sf1.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS low_line_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Aggregate: groupBy=[[mysql.tpch_sf1.lineitem.l_shipmode]], aggr=[[sum(CASE WHEN mysql.tpch_sf1.orders.o_orderpriority = Utf8("1-URGENT") OR mysql.tpch_sf1.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END), sum(CASE WHEN mysql.tpch_sf1.orders.o_orderpriority != Utf8("1-URGENT") AND mysql.tpch_sf1.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       Inner Join:  Filter: mysql.tpch_sf1.orders.o_orderkey = mysql.tpch_sf1.lineitem.l_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         TableScan: mysql.tpch_sf1.orders projection=[o_orderkey, o_orderpriority]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         TableScan: mysql.tpch_sf1.lineitem projection=[l_orderkey, l_shipmode], full_filters=[mysql.tpch_sf1.lineitem.l_shipmode IN ([Utf8("MAIL"), Utf8("SHIP")]), mysql.tpch_sf1.lineitem.l_commitdate < mysql.tpch_sf1.lineitem.l_receiptdate, mysql.tpch_sf1.lineitem.l_shipdate < mysql.tpch_sf1.lineitem.l_commitdate, mysql.tpch_sf1.lineitem.l_receiptdate >= CAST(Utf8("1994-01-01") AS Date32), mysql.tpch_sf1.lineitem.l_receiptdate < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `l_shipmode`, sum(CASE WHEN ((`orders`.`o_orderpriority` = '1-URGENT') OR (`orders`.`o_orderpriority` = '2-HIGH')) THEN 1 ELSE 0 END) AS `high_line_count`, sum(CASE WHEN ((`orders`.`o_orderpriority` <> '1-URGENT') AND (`orders`.`o_orderpriority` <> '2-HIGH')) THEN 1 ELSE 0 END) AS `low_line_count` FROM `tpch_sf1`.`orders` INNER JOIN `tpch_sf1`.`lineitem` ON (`orders`.`o_orderkey` = `lineitem`.`l_orderkey`) WHERE `lineitem`.`l_shipmode` IN ('MAIL', 'SHIP') AND (`lineitem`.`l_commitdate` < `lineitem`.`l_receiptdate`) AND (`lineitem`.`l_shipdate` < `lineitem`.`l_commitdate`) AND (`lineitem`.`l_receiptdate` >= CAST('1994-01-01' AS DATE)) AND (`lineitem`.`l_receiptdate` < CAST('1995-01-01' AS DATE)) GROUP BY `lineitem`.`l_shipmode` ORDER BY `l_shipmode` ASC |
