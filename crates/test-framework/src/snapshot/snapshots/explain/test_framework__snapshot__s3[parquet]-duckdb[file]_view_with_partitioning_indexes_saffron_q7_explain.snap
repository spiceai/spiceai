---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Limit: skip=0, fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     TableScan: number_info_with_cap projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection, Capability], full_filters=[number_info_with_cap.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info_with_cap.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info_with_cap.SupportedDestRegion = LargeUtf8("00") OR number_info_with_cap.SupportedDestRegion = LargeUtf8("US"), number_info_with_cap.NumberRegion = LargeUtf8("US") OR number_info_with_cap.NumberRegion IS NULL, number_info_with_cap.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info_with_cap.NumberType = LargeUtf8("lc"), number_info_with_cap.Capability = LargeUtf8("sms")], fetch=20                                                                                                                                                                                              |
| physical_plan | GlobalLimitExec: skip=0, fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |         DuckSqlExec sql=WITH _intermediate_materialize AS MATERIALIZED (SELECT "DateCreated", "DateUpdated", "AccountSid", "NumberPoolSid", "NumberSid", "MaxRate", "NumberDid", "NumberType", "SupportedDestRegion", "NumberRegion", "CurrentRate", "IsAvailable", "ProviderSid", "AreaCodeRegion", "AvailableForNumberSelection", "Capability" FROM "expression=25/number_info_with_cap" WHERE "NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9' AND "AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066') SELECT "DateCreated", "DateUpdated", "AccountSid", "NumberPoolSid", "NumberSid", "MaxRate", "NumberDid", "NumberType", "SupportedDestRegion", "NumberRegion", "CurrentRate", "IsAvailable", "ProviderSid", "AreaCodeRegion", "AvailableForNumberSelection", "Capability" FROM _intermediate_materialize WHERE (true) AND (true) AND (("SupportedDestRegion" = '00') OR ("SupportedDestRegion" = 'US')) AND (("NumberRegion" = 'US') OR "NumberRegion" IS NULL) AND ("NumberSid" <> 'PN00000000000000000000000000000099') AND ("NumberType" = 'lc') AND ("Capability" = 'sms') LIMIT 20 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
