+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                           |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                            |
|               |   Sort: c DESC NULLS FIRST                                                                                                                                                                                                                                                                          |
|               |     Projection: hits.SearchPhrase, count(Int64(1)) AS c                                                                                                                                                                                                                                             |
|               |       Aggregate: groupBy=[[hits.SearchPhrase]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                            |
|               |         Filter: hits.SearchPhrase != CAST(Utf8("") AS LargeUtf8)                                                                                                                                                                                                                                    |
|               |           TableScan: hits projection=[SearchPhrase]                                                                                                                                                                                                                                                 |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT `hits`.`SearchPhrase`, count(1) AS `c` FROM `hits` WHERE (`hits`.`SearchPhrase` <> CAST('' AS TEXT)) GROUP BY `hits`.`SearchPhrase` ORDER BY `c` DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                     |
