|               |   CooperativeExec                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `hits`.`WatchID`, `hits`.`ClientIP`, count(1) AS `c`, sum(CAST(`hits`.`IsRefresh` AS BIGINT)), avg(CAST(`hits`.`ResolutionWidth` AS DOUBLE)) FROM `hits` GROUP BY `hits`.`WatchID`, `hits`.`ClientIP` ORDER BY `c` DESC NULLS FIRST LIMIT 10 |
