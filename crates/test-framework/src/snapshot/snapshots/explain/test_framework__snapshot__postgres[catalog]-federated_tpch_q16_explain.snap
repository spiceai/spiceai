+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |  Sort: supplier_cnt DESC NULLS FIRST, pg.public.part.p_brand ASC NULLS LAST, pg.public.part.p_type ASC NULLS LAST, pg.public.part.p_size ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Projection: pg.public.part.p_brand, pg.public.part.p_type, pg.public.part.p_size, count(DISTINCT pg.public.partsupp.ps_suppkey) AS supplier_cnt                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     Aggregate: groupBy=[[pg.public.part.p_brand, pg.public.part.p_type, pg.public.part.p_size]], aggr=[[count(DISTINCT pg.public.partsupp.ps_suppkey)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       Inner Join:  Filter: pg.public.part.p_partkey = pg.public.partsupp.ps_partkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |         Filter: pg.public.partsupp.ps_suppkey NOT IN (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |             Projection: pg.public.supplier.s_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |               TableScan: pg.public.supplier, full_filters=[pg.public.supplier.s_comment LIKE Utf8("%Customer%Complaints%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |           TableScan: pg.public.partsupp projection=[ps_partkey, ps_suppkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         TableScan: pg.public.part projection=[p_partkey, p_brand, p_type, p_size], full_filters=[pg.public.part.p_brand != Utf8("Brand#45"), pg.public.part.p_type NOT LIKE Utf8("MEDIUM POLISHED%"), pg.public.part.p_size IN ([Int64(49), Int64(14), Int64(23), Int64(45), Int64(19), Int64(3), Int64(36), Int64(9)])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "p_brand", "p_type", "p_size", count(DISTINCT "partsupp"."ps_suppkey") AS "supplier_cnt" FROM "public"."partsupp" INNER JOIN "public"."part" ON (("part"."p_partkey" = "partsupp"."ps_partkey") AND ((("partsupp"."ps_suppkey" NOT IN (SELECT "s_suppkey" FROM "public"."supplier" WHERE "supplier"."s_comment" LIKE '%Customer%Complaints%') AND ("part"."p_brand" <> 'Brand#45')) AND "part"."p_type" NOT LIKE 'MEDIUM POLISHED%') AND "part"."p_size" IN (49, 14, 23, 45, 19, 3, 36, 9))) GROUP BY "part"."p_brand", "part"."p_type", "part"."p_size" ORDER BY "supplier_cnt" DESC NULLS FIRST, "p_brand" ASC NULLS LAST, "p_type" ASC NULLS LAST, "p_size" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
