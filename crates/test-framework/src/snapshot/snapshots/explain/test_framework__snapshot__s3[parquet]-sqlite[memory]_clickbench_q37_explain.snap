---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: clickbench_q37"
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     Projection: hits.URL, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       Aggregate: groupBy=[[hits.URL]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         Filter: hits.URL != CAST(Utf8("") AS LargeUtf8)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           TableScan: hits projection=[URL], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), CAST(date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) AS Timestamp(ns)) >= CAST(Utf8("2013-07-01") AS Timestamp(ns)), CAST(date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) AS Timestamp(ns)) <= CAST(Utf8("2013-07-31") AS Timestamp(ns)), CAST(hits.DontCountHits AS Int64) = Int64(0), CAST(hits.IsRefresh AS Int64) = Int64(0)]                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `hits`.`URL`, count(1) AS `PageViews` FROM `hits` WHERE (`hits`.`URL` <> CAST('' AS TEXT)) AND (((((CAST(`hits`.`CounterID` AS BIGINT) = 62) AND (CAST(strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) AS TEXT) >= CAST('2013-07-01' AS TEXT))) AND (CAST(strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) AS TEXT) <= CAST('2013-07-31' AS TEXT))) AND (CAST(`hits`.`DontCountHits` AS BIGINT) = 0)) AND (CAST(`hits`.`IsRefresh` AS BIGINT) = 0)) GROUP BY `hits`.`URL` ORDER BY `PageViews` DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
