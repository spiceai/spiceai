|               |     Filter: sender_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND sender_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND sender_info.SenderType = LargeUtf8("shortcode") AND sender_info.Region = LargeUtf8("US")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |       TableScan: sender_info projection=[AccountSid, NumberPoolSid, SenderSid, SenderIdentity, Region, Rate, SenderType, DateCreated, DateUpdated, LastUsed], partial_filters=[sender_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), sender_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), sender_info.SenderType = LargeUtf8("shortcode"), sender_info.Region = LargeUtf8("US")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
