| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |  Sort: value DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Projection: ducklake.main.partsupp.ps_partkey, sum(ducklake.main.partsupp.ps_supplycost * ducklake.main.partsupp.ps_availqty) AS value                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     Filter: sum(ducklake.main.partsupp.ps_supplycost * ducklake.main.partsupp.ps_availqty) > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |       Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |         Projection: sum(ducklake.main.partsupp.ps_supplycost * ducklake.main.partsupp.ps_availqty) * Float64(0.0001)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |           Aggregate: groupBy=[[]], aggr=[[sum(ducklake.main.partsupp.ps_supplycost * ducklake.main.partsupp.ps_availqty)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |             Inner Join:  Filter: ducklake.main.supplier.s_nationkey = ducklake.main.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               Inner Join:  Filter: ducklake.main.partsupp.ps_suppkey = ducklake.main.supplier.s_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                 TableScan: ducklake.main.partsupp                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |                 TableScan: ducklake.main.supplier                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |               TableScan: ducklake.main.nation, full_filters=[ducklake.main.nation.n_name = Utf8("GERMANY")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |       Aggregate: groupBy=[[ducklake.main.partsupp.ps_partkey]], aggr=[[sum(ducklake.main.partsupp.ps_supplycost * ducklake.main.partsupp.ps_availqty)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Inner Join:  Filter: ducklake.main.supplier.s_nationkey = ducklake.main.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           Inner Join:  Filter: ducklake.main.partsupp.ps_suppkey = ducklake.main.supplier.s_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |             TableScan: ducklake.main.partsupp projection=[ps_partkey, ps_suppkey, ps_availqty, ps_supplycost]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             TableScan: ducklake.main.supplier projection=[s_suppkey, s_nationkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           TableScan: ducklake.main.nation projection=[n_nationkey], full_filters=[ducklake.main.nation.n_name = Utf8("GERMANY")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "ps_partkey", sum(("partsupp"."ps_supplycost" * "partsupp"."ps_availqty")) AS "value" FROM "ducklake"."main"."partsupp" INNER JOIN "ducklake"."main"."supplier" ON ("partsupp"."ps_suppkey" = "supplier"."s_suppkey") INNER JOIN "ducklake"."main"."nation" ON (("supplier"."s_nationkey" = "nation"."n_nationkey") AND ("nation"."n_name" = 'GERMANY')) GROUP BY "partsupp"."ps_partkey" HAVING (sum(("partsupp"."ps_supplycost" * "partsupp"."ps_availqty")) > (SELECT (sum(("partsupp"."ps_supplycost" * "partsupp"."ps_availqty")) * 0.0001) FROM "ducklake"."main"."partsupp" INNER JOIN "ducklake"."main"."supplier" ON ("partsupp"."ps_suppkey" = "supplier"."s_suppkey") INNER JOIN "ducklake"."main"."nation" ON (("supplier"."s_nationkey" = "nation"."n_nationkey") AND ("nation"."n_name" = 'GERMANY')))) ORDER BY "value" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
