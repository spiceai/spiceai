| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |  Limit: skip=0, fetch=100                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Sort: ducklake.main.supplier.s_acctbal DESC NULLS FIRST, ducklake.main.nation.n_name ASC NULLS LAST, ducklake.main.supplier.s_name ASC NULLS LAST, ducklake.main.part.p_partkey ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     Projection: ducklake.main.supplier.s_acctbal, ducklake.main.supplier.s_name, ducklake.main.nation.n_name, ducklake.main.part.p_partkey, ducklake.main.part.p_mfgr, ducklake.main.supplier.s_address, ducklake.main.supplier.s_phone, ducklake.main.supplier.s_comment                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       Inner Join:  Filter: ducklake.main.nation.n_regionkey = ducklake.main.region.r_regionkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |         Inner Join:  Filter: ducklake.main.supplier.s_nationkey = ducklake.main.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           Inner Join:  Filter: ducklake.main.part.p_partkey = ducklake.main.partsupp.ps_partkey AND ducklake.main.supplier.s_suppkey = ducklake.main.partsupp.ps_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |             Cross Join:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               TableScan: ducklake.main.part projection=[p_partkey, p_mfgr], full_filters=[ducklake.main.part.p_size = Int64(15), ducklake.main.part.p_type LIKE Utf8("%BRASS")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |               TableScan: ducklake.main.supplier projection=[s_suppkey, s_name, s_address, s_nationkey, s_phone, s_acctbal, s_comment]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             Filter: ducklake.main.partsupp.ps_supplycost = (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                 Projection: min(ducklake.main.partsupp.ps_supplycost)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                   Aggregate: groupBy=[[]], aggr=[[min(ducklake.main.partsupp.ps_supplycost)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                     Inner Join:  Filter: ducklake.main.nation.n_regionkey = ducklake.main.region.r_regionkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                       Inner Join:  Filter: ducklake.main.supplier.s_nationkey = ducklake.main.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                         Inner Join:  Filter: ducklake.main.supplier.s_suppkey = ducklake.main.partsupp.ps_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                           Filter: outer_ref(ducklake.main.part.p_partkey) = ducklake.main.partsupp.ps_partkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                             TableScan: ducklake.main.partsupp                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                           TableScan: ducklake.main.supplier                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |                         TableScan: ducklake.main.nation                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                       TableScan: ducklake.main.region, full_filters=[ducklake.main.region.r_name = Utf8("EUROPE")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |               TableScan: ducklake.main.partsupp projection=[ps_partkey, ps_suppkey, ps_supplycost]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           TableScan: ducklake.main.nation projection=[n_nationkey, n_name, n_regionkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |         TableScan: ducklake.main.region projection=[r_regionkey], full_filters=[ducklake.main.region.r_name = Utf8("EUROPE")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "s_acctbal", "s_name", "n_name", "p_partkey", "p_mfgr", "s_address", "s_phone", "s_comment" FROM "ducklake"."main"."part" CROSS JOIN "ducklake"."main"."supplier" INNER JOIN "ducklake"."main"."partsupp" ON (("part"."p_partkey" = "partsupp"."ps_partkey") AND ("supplier"."s_suppkey" = "partsupp"."ps_suppkey")) INNER JOIN "ducklake"."main"."nation" ON ("supplier"."s_nationkey" = "nation"."n_nationkey") INNER JOIN "ducklake"."main"."region" ON ("nation"."n_regionkey" = "region"."r_regionkey") WHERE ("part"."p_size" = 15) AND "part"."p_type" LIKE '%BRASS' AND ("partsupp"."ps_supplycost" = (SELECT min("partsupp"."ps_supplycost") FROM "ducklake"."main"."partsupp" INNER JOIN "ducklake"."main"."supplier" ON ("supplier"."s_suppkey" = "partsupp"."ps_suppkey") INNER JOIN "ducklake"."main"."nation" ON ("supplier"."s_nationkey" = "nation"."n_nationkey") INNER JOIN "ducklake"."main"."region" ON ("nation"."n_regionkey" = "region"."r_regionkey") WHERE ("part"."p_partkey" = "partsupp"."ps_partkey") AND ("region"."r_name" = 'EUROPE'))) AND ("region"."r_name" = 'EUROPE') ORDER BY "s_acctbal" DESC NULLS FIRST, "n_name" ASC NULLS LAST, "s_name" ASC NULLS LAST, "p_partkey" ASC NULLS LAST LIMIT 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
