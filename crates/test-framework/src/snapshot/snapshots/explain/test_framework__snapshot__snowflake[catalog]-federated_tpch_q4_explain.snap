|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "O_ORDERPRIORITY", count(1) AS "ORDER_COUNT" FROM "BENCHMARKS"."TPCH_SF1"."ORDERS" WHERE EXISTS (SELECT "L_ORDERKEY", "L_PARTKEY", "L_SUPPKEY", "L_LINENUMBER", "L_QUANTITY", "L_EXTENDEDPRICE", "L_DISCOUNT", "L_TAX", "L_RETURNFLAG", "L_LINESTATUS", "L_SHIPDATE", "L_COMMITDATE", "L_RECEIPTDATE", "L_SHIPINSTRUCT", "L_SHIPMODE", "L_COMMENT" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" WHERE ("LINEITEM"."L_ORDERKEY" = "ORDERS"."O_ORDERKEY") AND ("LINEITEM"."L_COMMITDATE" < "LINEITEM"."L_RECEIPTDATE")) AND (("ORDERS"."O_ORDERDATE" >= '1993-07-01') AND ("ORDERS"."O_ORDERDATE" < (CAST('1993-07-01' AS DATE) + INTERVAL '3 MONS'))) GROUP BY "ORDERS"."O_ORDERPRIORITY" ORDER BY "O_ORDERPRIORITY" ASC NULLS LAST |
