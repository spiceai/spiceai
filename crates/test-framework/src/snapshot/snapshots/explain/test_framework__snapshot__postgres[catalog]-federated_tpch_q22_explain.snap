| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |  Sort: custsale.cntrycode ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Projection: custsale.cntrycode, count(Int64(1)) AS numcust, sum(custsale.c_acctbal) AS totacctbal                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     Aggregate: groupBy=[[custsale.cntrycode]], aggr=[[count(Int64(1)), sum(custsale.c_acctbal)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       SubqueryAlias: custsale                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Projection: substr(pg.public.customer.c_phone, Int64(1), Int64(2)) AS cntrycode, pg.public.customer.c_acctbal                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |           Filter: NOT EXISTS (<subquery>) AND pg.public.customer.c_acctbal > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |             Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |               Projection: pg.public.orders.o_orderkey, pg.public.orders.o_custkey, pg.public.orders.o_orderstatus, pg.public.orders.o_totalprice, pg.public.orders.o_orderdate, pg.public.orders.o_orderpriority, pg.public.orders.o_clerk, pg.public.orders.o_shippriority, pg.public.orders.o_comment                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |                 Filter: pg.public.orders.o_custkey = outer_ref(pg.public.customer.c_custkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                   TableScan: pg.public.orders                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |             Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |               Projection: avg(pg.public.customer.c_acctbal)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                 Aggregate: groupBy=[[]], aggr=[[avg(pg.public.customer.c_acctbal)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |                   TableScan: pg.public.customer, full_filters=[pg.public.customer.c_acctbal > Float64(0), substr(pg.public.customer.c_phone, Int64(1), Int64(2)) IN ([Utf8("13"), Utf8("31"), Utf8("23"), Utf8("29"), Utf8("30"), Utf8("18"), Utf8("17")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             TableScan: pg.public.customer projection=[c_custkey, c_phone, c_acctbal], full_filters=[substr(pg.public.customer.c_phone, Int64(1), Int64(2)) IN ([Utf8("13"), Utf8("31"), Utf8("23"), Utf8("29"), Utf8("30"), Utf8("18"), Utf8("17")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       VirtualExecutionPlan name=postgres compute_context=host=Tcp("benchmarking-postgres-rw.dataplatform.svc.cluster.local"),port=5432,db=tpch_sf1,user=postgres, base_sql=SELECT "custsale"."cntrycode", count(1) AS "numcust", sum("custsale"."c_acctbal") AS "totacctbal" FROM (SELECT substr("customer"."c_phone", 1, 2) AS "cntrycode", "c_acctbal" FROM "public"."customer" WHERE (NOT EXISTS (SELECT "o_orderkey", "o_custkey", "o_orderstatus", "o_totalprice", "o_orderdate", "o_orderpriority", "o_clerk", "o_shippriority", "o_comment" FROM "public"."orders" WHERE ("orders"."o_custkey" = "customer"."c_custkey")) AND ("customer"."c_acctbal" > (SELECT avg("customer"."c_acctbal") FROM "public"."customer" WHERE (("customer"."c_acctbal" > 0.0) AND substr("customer"."c_phone", 1, 2) IN ('13', '31', '23', '29', '30', '18', '17'))))) AND substr("customer"."c_phone", 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')) AS "custsale" GROUP BY "custsale"."cntrycode" ORDER BY "custsale"."cntrycode" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
