|               |   Aggregate: groupBy=[[dt.d_year, item.i_category_id, item.i_category]], aggr=[[sum(store_sales.ss_ext_sales_price)]]                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     Inner Join:  Filter: store_sales.ss_item_sk = item.i_item_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       Inner Join:  Filter: dt.d_date_sk = store_sales.ss_sold_date_sk                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Filter: dt.d_moy = Int64(11) AND dt.d_year = Int64(1998)                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
