+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: A.NumberSid ASC NULLS LAST, fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     BytesProcessedNode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       TableScan: number_info_with_cap projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection, Capability], full_filters=[number_info_with_cap.AccountSid = LargeUtf8("AC02da2b759e8342d4b73ff6e64a77ce58"), number_info_with_cap.NumberPoolSid = LargeUtf8("NPcb39bd63c0a54ab8b106d8f9e0aa6507"), number_info_with_cap.NumberType = LargeUtf8("tf"), number_info_with_cap.MaxRate = Int32(49), number_info_with_cap.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info_with_cap.AvailableForNumberSelection = Int8(1) OR number_info_with_cap.AvailableForNumberSelection = Int8(0), number_info_with_cap.Capability = LargeUtf8("sms")] |
| physical_plan | SortPreservingMergeExec: [NumberSid@4 ASC NULLS LAST], fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   SortExec: TopK(fetch=1), expr=[NumberSid@4 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |         RepartitionExec: partitioning=RoundRobinBatch(32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |           CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |             DuckSqlExec sql= SELECT "DateCreated", "DateUpdated", "AccountSid", "NumberPoolSid", "NumberSid", "MaxRate", "NumberDid", "NumberType", "SupportedDestRegion", "NumberRegion", "CurrentRate", "IsAvailable", "ProviderSid", "AreaCodeRegion", "AvailableForNumberSelection", "Capability" FROM "expression=16/number_info_with_cap" WHERE ("AccountSid" = 'AC02da2b759e8342d4b73ff6e64a77ce58') AND ("NumberPoolSid" = 'NPcb39bd63c0a54ab8b106d8f9e0aa6507') AND ("NumberType" = 'tf') AND ("MaxRate" = 49) AND ("NumberSid" <> 'PN00000000000000000000000000000099') AND (("AvailableForNumberSelection" = 1) OR ("AvailableForNumberSelection" = 0)) AND ("Capability" = 'sms')                                                                                                                                              |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
