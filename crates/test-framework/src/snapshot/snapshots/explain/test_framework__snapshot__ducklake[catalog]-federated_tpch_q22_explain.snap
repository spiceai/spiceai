| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |  Sort: custsale.cntrycode ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   Projection: custsale.cntrycode, count(Int64(1)) AS numcust, sum(custsale.c_acctbal) AS totacctbal                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     Aggregate: groupBy=[[custsale.cntrycode]], aggr=[[count(Int64(1)), sum(custsale.c_acctbal)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |       SubqueryAlias: custsale                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |         Projection: substr(ducklake.main.customer.c_phone, Int64(1), Int64(2)) AS cntrycode, ducklake.main.customer.c_acctbal                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |           Filter: NOT EXISTS (<subquery>) AND ducklake.main.customer.c_acctbal > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |             Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               Projection: ducklake.main.orders.o_orderkey, ducklake.main.orders.o_custkey, ducklake.main.orders.o_orderstatus, ducklake.main.orders.o_totalprice, ducklake.main.orders.o_orderdate, ducklake.main.orders.o_orderpriority, ducklake.main.orders.o_clerk, ducklake.main.orders.o_shippriority, ducklake.main.orders.o_comment                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                 Filter: ducklake.main.orders.o_custkey = outer_ref(ducklake.main.customer.c_custkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                   TableScan: ducklake.main.orders                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |             Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |               Projection: avg(ducklake.main.customer.c_acctbal)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                 Aggregate: groupBy=[[]], aggr=[[avg(ducklake.main.customer.c_acctbal)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |                   TableScan: ducklake.main.customer, full_filters=[ducklake.main.customer.c_acctbal > Float64(0), substr(ducklake.main.customer.c_phone, Int64(1), Int64(2)) IN ([Utf8("13"), Utf8("31"), Utf8("23"), Utf8("29"), Utf8("30"), Utf8("18"), Utf8("17")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |             TableScan: ducklake.main.customer projection=[c_custkey, c_phone, c_acctbal], full_filters=[substr(ducklake.main.customer.c_phone, Int64(1), Int64(2)) IN ([Utf8("13"), Utf8("31"), Utf8("23"), Utf8("29"), Utf8("30"), Utf8("18"), Utf8("17")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "custsale"."cntrycode", count(1) AS "numcust", sum("custsale"."c_acctbal") AS "totacctbal" FROM (SELECT substr("customer"."c_phone", 1, 2) AS "cntrycode", "c_acctbal" FROM "ducklake"."main"."customer" WHERE (NOT EXISTS (SELECT "o_orderkey", "o_custkey", "o_orderstatus", "o_totalprice", "o_orderdate", "o_orderpriority", "o_clerk", "o_shippriority", "o_comment" FROM "ducklake"."main"."orders" WHERE ("orders"."o_custkey" = "customer"."c_custkey")) AND ("customer"."c_acctbal" > (SELECT avg("customer"."c_acctbal") FROM "ducklake"."main"."customer" WHERE (("customer"."c_acctbal" > 0.0) AND substr("customer"."c_phone", 1, 2) IN ('13', '31', '23', '29', '30', '18', '17'))))) AND substr("customer"."c_phone", 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')) AS "custsale" GROUP BY "custsale"."cntrycode" ORDER BY "custsale"."cntrycode" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
