|               |         Projection: sum(snowflake.TPCH_SF1.PARTSUPP.PS_SUPPLYCOST * snowflake.TPCH_SF1.PARTSUPP.PS_AVAILQTY) * Float64(0.0001)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |           Aggregate: groupBy=[[]], aggr=[[sum(snowflake.TPCH_SF1.PARTSUPP.PS_SUPPLYCOST * snowflake.TPCH_SF1.PARTSUPP.PS_AVAILQTY)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
