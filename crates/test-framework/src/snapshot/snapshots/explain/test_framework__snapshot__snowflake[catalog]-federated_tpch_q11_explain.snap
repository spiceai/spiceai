|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "PS_PARTKEY", sum(("PARTSUPP"."PS_SUPPLYCOST" * "PARTSUPP"."PS_AVAILQTY")) AS "VALUE" FROM "BENCHMARKS"."TPCH_SF1"."PARTSUPP" INNER JOIN "BENCHMARKS"."TPCH_SF1"."SUPPLIER" ON ("PARTSUPP"."PS_SUPPKEY" = "SUPPLIER"."S_SUPPKEY") INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON (("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") AND ("NATION"."N_NAME" = 'GERMANY')) GROUP BY "PARTSUPP"."PS_PARTKEY" HAVING (sum(("PARTSUPP"."PS_SUPPLYCOST" * "PARTSUPP"."PS_AVAILQTY")) > (SELECT (sum(("PARTSUPP"."PS_SUPPLYCOST" * "PARTSUPP"."PS_AVAILQTY")) * 0.0001) FROM "BENCHMARKS"."TPCH_SF1"."PARTSUPP" INNER JOIN "BENCHMARKS"."TPCH_SF1"."SUPPLIER" ON ("PARTSUPP"."PS_SUPPKEY" = "SUPPLIER"."S_SUPPKEY") INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON (("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") AND ("NATION"."N_NAME" = 'GERMANY')))) ORDER BY "VALUE" DESC NULLS FIRST |
