|               |       Aggregate: groupBy=[[snowflake.TPCH_SF1.PARTSUPP.PS_PARTKEY]], aggr=[[sum(snowflake.TPCH_SF1.PARTSUPP.PS_SUPPLYCOST * snowflake.TPCH_SF1.PARTSUPP.PS_AVAILQTY)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
