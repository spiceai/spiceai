---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: chbench_q13"
---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |  Sort: custdist DESC NULLS FIRST, c_orders.c_count DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Projection: c_orders.c_count, count(Int64(1)) AS custdist                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     Aggregate: groupBy=[[c_orders.c_count]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       SubqueryAlias: c_orders                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Projection: count(oorder.o_id) AS c_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |           Aggregate: groupBy=[[customer.c_id]], aggr=[[count(oorder.o_id)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             Left Join:  Filter: customer.c_w_id = oorder.o_w_id AND customer.c_d_id = oorder.o_d_id AND customer.c_id = oorder.o_c_id                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |               TableScan: customer projection=[c_id, c_d_id, c_w_id]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |               TableScan: oorder projection=[o_id, o_d_id, o_w_id, o_c_id], full_filters=[oorder.o_carrier_id > Int64(8)]                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "c_orders"."c_count", count(1) AS "custdist" FROM (SELECT count("oorder"."o_id") AS "c_count" FROM "customer" LEFT OUTER JOIN "oorder" ON (((("customer"."c_w_id" = "oorder"."o_w_id") AND ("customer"."c_d_id" = "oorder"."o_d_id")) AND ("customer"."c_id" = "oorder"."o_c_id")) AND ("oorder"."o_carrier_id" > 8)) GROUP BY "customer"."c_id") AS "c_orders" GROUP BY "c_orders"."c_count" ORDER BY "custdist" DESC NULLS FIRST, "c_orders"."c_count" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
