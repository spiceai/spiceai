|               |           Projection: lineitem.l_discount, lineitem.l_extendedprice, lineitem.l_orderkey                                                                                                                                                                                                                                                                 |
|               |             Filter: lineitem.l_returnflag = Utf8("R")                                                                                                                                                                                                                                                                                                    |
|               |               TableScan: lineitem projection=[l_discount, l_extendedprice, l_orderkey, l_returnflag], partial_filters=[lineitem.l_returnflag = Utf8("R")]                                                                                                                                                                                                |
