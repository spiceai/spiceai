|               |                 Inner Join: nation.n_nationkey = customer.c_nationkey                                                                                                                                                                                                                                                                                    |
|               |                   TableScan: nation projection=[n_name, n_nationkey]                                                                                                                                                                                                                                                                                     |
|               |                   TableScan: customer projection=[c_acctbal, c_address, c_comment, c_custkey, c_name, c_nationkey, c_phone]                                                                                                                                                                                                                              |
|               |               Projection: orders.o_custkey, orders.o_orderkey                                                                                                                                                                                                                                                                                            |
|               |                 Filter: orders.o_orderdate >= Date32("1993-10-01") AND orders.o_orderdate < Date32("1994-01-01")                                                                                                                                                                                                                                         |
