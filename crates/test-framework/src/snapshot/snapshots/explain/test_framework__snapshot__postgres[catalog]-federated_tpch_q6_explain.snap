|               |       VirtualExecutionPlan name=postgres compute_context=<CONNECTION> base_sql=SELECT sum(("lineitem"."l_extendedprice" * "lineitem"."l_discount")) AS "revenue" FROM "public"."lineitem" WHERE (((("lineitem"."l_shipdate" >= CAST('1994-01-01' AS DATE)) AND ("lineitem"."l_shipdate" < CAST('1995-01-01' AS DATE))) AND ("lineitem"."l_discount" BETWEEN 0.050000000000000 AND 0.070000000000000)) AND ("lineitem"."l_quantity" < 24)) |
