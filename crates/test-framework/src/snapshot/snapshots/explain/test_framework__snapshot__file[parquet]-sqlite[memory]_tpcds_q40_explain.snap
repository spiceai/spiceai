                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Aggregate: groupBy=[[warehouse.w_state, item.i_item_id]], aggr=[[sum(CASE WHEN date_dim.d_date < Date32("2002-05-18") THEN catalog_sales.cs_sales_price - CASE WHEN CAST(catalog_returns.cr_refunded_cash AS Decimal128(22, 2)) IS NOT NULL THEN CAST(catalog_returns.cr_refunded_cash AS Decimal128(22, 2)) ELSE Decimal128(0.00,22,2) END ELSE Decimal128(0.00,23,2) END) AS sum(CASE WHEN date_dim.d_date < Utf8("2002-05-18") THEN catalog_sales.cs_sales_price - coalesce(catalog_returns.cr_refunded_cash,Int64(0)) ELSE Int64(0) END), sum(CASE WHEN date_dim.d_date >= Date32("2002-05-18") THEN catalog_sales.cs_sales_price - CASE WHEN CAST(catalog_returns.cr_refunded_cash AS Decimal128(22, 2)) IS NOT NULL THEN CAST(catalog_returns.cr_refunded_cash AS Decimal128(22, 2)) ELSE Decimal128(0.00,22,2) END ELSE Decimal128(0.00,23,2) END) AS sum(CASE WHEN date_dim.d_date >= Utf8("2002-05-18") THEN catalog_sales.cs_sales_price - coalesce(catalog_returns.cr_refunded_cash,Int64(0)) ELSE Int64(0) END)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             