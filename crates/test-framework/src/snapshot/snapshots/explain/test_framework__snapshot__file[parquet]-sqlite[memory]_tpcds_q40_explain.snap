                                                                                                                                                                                                                                                                                                                                                                       |
|               |                     VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `catalog_sales`.`cs_sold_date_sk`, `catalog_sales`.`cs_warehouse_sk`, `catalog_sales`.`cs_item_sk`, `catalog_sales`.`cs_order_number`, `catalog_sales`.`cs_sales_price`, `catalog_returns`.`cr_item_sk`, `catalog_returns`.`cr_order_number`, `catalog_returns`.`cr_refunded_cash`, `warehouse`.`w_warehouse_sk`, `warehouse`.`w_state`, `item`.`i_item_sk`, `item`.`i_item_id`, `date_dim`.`d_date_sk`, `date_dim`.`d_date` FROM `catalog_sales` LEFT OUTER JOIN `catalog_returns` ON ((`catalog_sales`.`cs_order_number` = `catalog_returns`.`cr_order_number`) AND (`catalog_sales`.`cs_item_sk` = `catalog_returns`.`cr_item_sk`)) INNER JOIN `warehouse` ON (`catalog_sales`.`cs_warehouse_sk` = `warehouse`.`w_warehouse_sk`) INNER JOIN `item` ON (`item`.`i_item_sk` = `catalog_sales`.`cs_item_sk`) INNER JOIN `date_dim` ON (`catalog_sales`.`cs_sold_date_sk` = `date_dim`.`d_date_sk`) WHERE (`item`.`i_current_price` BETWEEN 0.99 AND 1.49) AND (`date_dim`.`d_date` BETWEEN (CAST('2002-05-18' AS TEXT) - INTERVAL '30 DAYS') AND (CAST('2002-05-18' AS TEXT) + INTERVAL '30 DAYS')) rewritten_executor_sql=SELECT `catalog_sales`.`cs_sold_date_sk`, `catalog_sales`.`cs_warehouse_sk`, `catalog_sales`.`cs_item_sk`, `catalog_sales`.`cs_order_number`, `catalog_sales`.`cs_sales_price`, `catalog_returns`.`cr_item_sk`, `catalog_returns`.`cr_order_number`, `catalog_returns`.`cr_refunded_cash`, `warehouse`.`w_warehouse_sk`, `warehouse`.`w_state`, `item`.`i_item_sk`, `item`.`i_item_id`, `date_dim`.`d_date_sk`, `date_dim`.`d_date` FROM `catalog_sales` LEFT OUTER JOIN `catalog_returns` ON ((`catalog_sales`.`cs_order_number` = `catalog_returns`.`cr_order_number`) AND (`catalog_sales`.`cs_item_sk` = `catalog_returns`.`cr_item_sk`)) INNER JOIN `warehouse` ON (`catalog_sales`.`cs_warehouse_sk` = `warehouse`.`w_warehouse_sk`) INNER JOIN `item` ON (`item`.`i_item_sk` = `catalog_sales`.`cs_item_sk`) INNER JOIN `date_dim` ON (`catalog_sales`.`cs_sold_date_sk` = `date_dim`.`d_date_sk`) WHERE (decimal_cmp(`item`.`i_current_price`, decimal('0.99')) >= 0 AND decimal_cmp(`item`.`i_current_price`, decimal('1.49')) <= 0) AND (`date_dim`.`d_date` BETWEEN (CAST(date(CAST('2002-05-18' AS TEXT), '-30 days') AS TEXT)) AND (CAST(date(CAST('2002-05-18' AS TEXT), '+30 days') AS TEXT))) |
