|               |   TableScan: number_info_with_cap projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection, Capability], full_filters=[number_info_with_cap.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info_with_cap.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info_with_cap.NumberDid = LargeUtf8("+16176906114")]                                                                                                                                                                                                                                                                                                                              |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       DuckSqlExec sql=WITH _intermediate_materialize AS MATERIALIZED (SELECT "DateCreated", "DateUpdated", "AccountSid", "NumberPoolSid", "NumberSid", "MaxRate", "NumberDid", "NumberType", "SupportedDestRegion", "NumberRegion", "CurrentRate", "IsAvailable", "ProviderSid", "AreaCodeRegion", "AvailableForNumberSelection", "Capability" FROM number_info_with_cap WHERE "AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066' AND "NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9') SELECT "DateCreated", "DateUpdated", "AccountSid", "NumberPoolSid", "NumberSid", "MaxRate", "NumberDid", "NumberType", "SupportedDestRegion", "NumberRegion", "CurrentRate", "IsAvailable", "ProviderSid", "AreaCodeRegion", "AvailableForNumberSelection", "Capability" FROM _intermediate_materialize WHERE (true) AND (true) AND ("NumberDid" = '+16176906114') |
