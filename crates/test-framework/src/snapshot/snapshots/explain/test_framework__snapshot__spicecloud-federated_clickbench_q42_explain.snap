|               |  Limit: skip=10000, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     Projection: hits.WindowClientWidth, hits.WindowClientHeight, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |       Aggregate: groupBy=[[hits.WindowClientWidth, hits.WindowClientHeight]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |         Filter: hits.CounterID = Int64(62) AND to_timestamp(hits.EventDate * Int64(86400)) >= Utf8("2013-07-01") AND to_timestamp(hits.EventDate * Int64(86400)) <= Utf8("2013-07-31") AND hits.IsRefresh = Int64(0) AND hits.DontCountHits = Int64(0) AND hits.URLHash = Int64(2868770270353813622)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           TableScan: hits projection=[EventDate, CounterID, IsRefresh, WindowClientWidth, WindowClientHeight, DontCountHits, URLHash], partial_filters=[hits.CounterID = Int64(62), to_timestamp(hits.EventDate * Int64(86400)) >= Utf8("2013-07-01"), to_timestamp(hits.EventDate * Int64(86400)) <= Utf8("2013-07-31"), hits.IsRefresh = Int64(0), hits.DontCountHits = Int64(0), hits.URLHash = Int64(2868770270353813622)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
