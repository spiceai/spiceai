|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=spice.ai compute_context=url=https://us-east-1-prod-aws-flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench base_sql=SELECT "WindowClientWidth", "WindowClientHeight", count(1) AS "PageViews" FROM "clickbench"."hits" WHERE (((((("hits"."CounterID" = 62) AND (to_timestamp(("hits"."EventDate" * 86400)) >= '2013-07-01')) AND (to_timestamp(("hits"."EventDate" * 86400)) <= '2013-07-31')) AND ("hits"."IsRefresh" = 0)) AND ("hits"."DontCountHits" = 0)) AND ("hits"."URLHash" = 2868770270353813622)) AND (((((("hits"."CounterID" = 62) AND (to_timestamp(("hits"."EventDate" * 86400)) >= '2013-07-01')) AND (to_timestamp(("hits"."EventDate" * 86400)) <= '2013-07-31')) AND ("hits"."IsRefresh" = 0)) AND ("hits"."DontCountHits" = 0)) AND ("hits"."URLHash" = 2868770270353813622)) GROUP BY "hits"."WindowClientWidth", "hits"."WindowClientHeight" ORDER BY "PageViews" DESC NULLS FIRST LIMIT 10 OFFSET 10000 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
