|               |                       Inner Join: lineitem.l_orderkey = orders.o_orderkey                                                                                                                                                                                                  |
|               |                         Projection: lineitem.l_discount, lineitem.l_extendedprice, lineitem.l_orderkey, lineitem.l_partkey, lineitem.l_quantity, lineitem.l_suppkey                                                                                                        |
|               |                           Inner Join: part.p_partkey = lineitem.l_partkey                                                                                                                                                                                                  |
|               |                             Projection: part.p_partkey                                                                                                                                                                                                                     |
|               |                               Filter: part.p_name LIKE Utf8("%green%")                                                                                                                                                                                                     |
|               |                                 TableScan: part projection=[p_name, p_partkey]                                                                                                                                                                                             |
