| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |  Sort: snowflake.TPCH_SF1.LINEITEM.L_SHIPMODE ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Projection: snowflake.TPCH_SF1.LINEITEM.L_SHIPMODE, sum(CASE WHEN snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY = Utf8("1-URGENT") OR snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS HIGH_LINE_COUNT, sum(CASE WHEN snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY != Utf8("1-URGENT") AND snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS LOW_LINE_COUNT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     Aggregate: groupBy=[[snowflake.TPCH_SF1.LINEITEM.L_SHIPMODE]], aggr=[[sum(CASE WHEN snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY = Utf8("1-URGENT") OR snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END), sum(CASE WHEN snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY != Utf8("1-URGENT") AND snowflake.TPCH_SF1.ORDERS.O_ORDERPRIORITY != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       Inner Join:  Filter: snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY = snowflake.TPCH_SF1.ORDERS.O_ORDERKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |         TableScan: snowflake.TPCH_SF1.LINEITEM projection=[L_ORDERKEY, L_SHIPMODE], full_filters=[snowflake.TPCH_SF1.LINEITEM.L_SHIPMODE IN ([Utf8("MAIL"), Utf8("SHIP")]), snowflake.TPCH_SF1.LINEITEM.L_COMMITDATE < snowflake.TPCH_SF1.LINEITEM.L_RECEIPTDATE, snowflake.TPCH_SF1.LINEITEM.L_SHIPDATE < snowflake.TPCH_SF1.LINEITEM.L_COMMITDATE, snowflake.TPCH_SF1.LINEITEM.L_RECEIPTDATE >= CAST(Utf8("1994-01-01") AS Date32), snowflake.TPCH_SF1.LINEITEM.L_RECEIPTDATE < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         TableScan: snowflake.TPCH_SF1.ORDERS projection=[O_ORDERKEY, O_ORDERPRIORITY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "L_SHIPMODE", sum(CASE WHEN (("ORDERS"."O_ORDERPRIORITY" = '1-URGENT') OR ("ORDERS"."O_ORDERPRIORITY" = '2-HIGH')) THEN 1 ELSE 0 END) AS "HIGH_LINE_COUNT", sum(CASE WHEN (("ORDERS"."O_ORDERPRIORITY" <> '1-URGENT') AND ("ORDERS"."O_ORDERPRIORITY" <> '2-HIGH')) THEN 1 ELSE 0 END) AS "LOW_LINE_COUNT" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" INNER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("LINEITEM"."L_ORDERKEY" = "ORDERS"."O_ORDERKEY") AND (((("LINEITEM"."L_SHIPMODE" IN ('MAIL', 'SHIP') AND ("LINEITEM"."L_COMMITDATE" < "LINEITEM"."L_RECEIPTDATE")) AND ("LINEITEM"."L_SHIPDATE" < "LINEITEM"."L_COMMITDATE")) AND ("LINEITEM"."L_RECEIPTDATE" >= CAST('1994-01-01' AS DATE))) AND ("LINEITEM"."L_RECEIPTDATE" < CAST('1995-01-01' AS DATE)))) GROUP BY "LINEITEM"."L_SHIPMODE" ORDER BY "L_SHIPMODE" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
