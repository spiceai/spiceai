source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpch_q4"
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |  Sort: ducklake.main.orders.o_orderpriority ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   Projection: ducklake.main.orders.o_orderpriority, count(Int64(1)) AS order_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     Aggregate: groupBy=[[ducklake.main.orders.o_orderpriority]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       Filter: EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           Projection: ducklake.main.lineitem.l_orderkey, ducklake.main.lineitem.l_partkey, ducklake.main.lineitem.l_suppkey, ducklake.main.lineitem.l_linenumber, ducklake.main.lineitem.l_quantity, ducklake.main.lineitem.l_extendedprice, ducklake.main.lineitem.l_discount, ducklake.main.lineitem.l_tax, ducklake.main.lineitem.l_returnflag, ducklake.main.lineitem.l_linestatus, ducklake.main.lineitem.l_shipdate, ducklake.main.lineitem.l_commitdate, ducklake.main.lineitem.l_receiptdate, ducklake.main.lineitem.l_shipinstruct, ducklake.main.lineitem.l_shipmode, ducklake.main.lineitem.l_comment                                                                                                                                                                                                                                                                                                                                                                            |
|               |             Filter: ducklake.main.lineitem.l_orderkey = outer_ref(ducklake.main.orders.o_orderkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |               TableScan: ducklake.main.lineitem, full_filters=[ducklake.main.lineitem.l_commitdate < ducklake.main.lineitem.l_receiptdate]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |         TableScan: ducklake.main.orders projection=[o_orderkey, o_orderpriority], full_filters=[ducklake.main.orders.o_orderdate >= CAST(Utf8("1993-07-01") AS Date32), ducklake.main.orders.o_orderdate < CAST(Utf8("1993-10-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "orders"."o_orderpriority", count(1) AS "order_count" FROM "ducklake"."main"."orders" WHERE EXISTS (SELECT "lineitem"."l_orderkey", "lineitem"."l_partkey", "lineitem"."l_suppkey", "lineitem"."l_linenumber", "lineitem"."l_quantity", "lineitem"."l_extendedprice", "lineitem"."l_discount", "lineitem"."l_tax", "lineitem"."l_returnflag", "lineitem"."l_linestatus", "lineitem"."l_shipdate", "lineitem"."l_commitdate", "lineitem"."l_receiptdate", "lineitem"."l_shipinstruct", "lineitem"."l_shipmode", "lineitem"."l_comment" FROM "ducklake"."main"."lineitem" WHERE ("lineitem"."l_orderkey" = "orders"."o_orderkey") AND ("lineitem"."l_commitdate" < "lineitem"."l_receiptdate")) AND (("orders"."o_orderdate" >= CAST('1993-07-01' AS DATE)) AND ("orders"."o_orderdate" < CAST('1993-10-01' AS DATE))) GROUP BY "orders"."o_orderpriority" ORDER BY "orders"."o_orderpriority" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
