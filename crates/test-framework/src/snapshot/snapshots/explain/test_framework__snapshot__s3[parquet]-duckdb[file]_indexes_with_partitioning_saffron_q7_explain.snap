| logical_plan  | Sort: A.NumberSid ASC NULLS LAST, B.Capability ASC NULLS LAST, fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   Projection: A.DateCreated, A.DateUpdated, A.AccountSid, A.NumberPoolSid, A.NumberSid, A.MaxRate, A.NumberDid, A.NumberType, A.SupportedDestRegion, A.NumberRegion, A.CurrentRate, A.IsAvailable, A.ProviderSid, A.AreaCodeRegion, A.AvailableForNumberSelection, B.Capability                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     Inner Join: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         TableScan: number_info projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection], full_filters=[number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info.SupportedDestRegion = LargeUtf8("00") OR number_info.SupportedDestRegion = LargeUtf8("US"), number_info.NumberRegion = LargeUtf8("US") OR number_info.NumberRegion IS NULL, number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info.NumberType = LargeUtf8("lc")]                                                                                                                                                                                                                                                                  |
|               |       SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         TableScan: number_caps projection=[NumberSid, Capability], full_filters=[number_caps.Capability = LargeUtf8("sms"), number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| physical_plan | SortPreservingMergeExec: [NumberSid@4 ASC NULLS LAST, Capability@15 ASC NULLS LAST], fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   SortExec: TopK(fetch=20), expr=[NumberSid@4 ASC NULLS LAST, Capability@15 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(NumberSid@4, NumberSid@0)], projection=[DateCreated@0, DateUpdated@1, AccountSid@2, NumberPoolSid@3, NumberSid@4, MaxRate@5, NumberDid@6, NumberType@7, SupportedDestRegion@8, NumberRegion@9, CurrentRate@10, IsAvailable@11, ProviderSid@12, AreaCodeRegion@13, AvailableForNumberSelection@14, Capability@16]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       RepartitionExec: partitioning=Hash([NumberSid@4], 32), input_partitions=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
