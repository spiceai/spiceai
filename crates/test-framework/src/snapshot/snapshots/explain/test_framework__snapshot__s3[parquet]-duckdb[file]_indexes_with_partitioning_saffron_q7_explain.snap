|               |               DuckSqlExec sql=WITH _intermediate_materialize AS MATERIALIZED (SELECT "AccountSid", "AreaCodeRegion", "AvailableForNumberSelection", "CurrentRate", "DateCreated", "DateUpdated", "IsAvailable", "MaxRate", "NumberDid", "NumberPoolSid", "NumberRegion", "NumberSid", "NumberType", "ProviderSid", "SupportedDestRegion" FROM number_info WHERE "NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9' AND "AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066') SELECT "DateCreated", "DateUpdated", "AccountSid", "NumberPoolSid", "NumberSid", "MaxRate", "NumberDid", "NumberType", "SupportedDestRegion", "NumberRegion", "CurrentRate", "IsAvailable", "ProviderSid", "AreaCodeRegion", "AvailableForNumberSelection" FROM _intermediate_materialize WHERE (true) AND (true) AND (("SupportedDestRegion" = '00') OR ("SupportedDestRegion" = 'US')) AND (("NumberRegion" = 'US') OR "NumberRegion" IS NULL) AND ("NumberSid" <> 'PN00000000000000000000000000000099') AND ("NumberType" = 'lc') |
