description: "Query: clickbench_q38"
---
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     Projection: hits.Title, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       Aggregate: groupBy=[[hits.Title]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |         TableScan: hits projection=[Title], full_filters=[hits.Title != Utf8(""), hits.CounterID = Int64(62), hits.DontCountHits = Int64(0), hits.IsRefresh = Int64(0), date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) >= Utf8("2013-07-01"), date_trunc(Utf8("day"), from_unixtime(hits.EventTime)) <= Utf8("2013-07-31")]                                                                                                                                                                                                           |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT `hits`.`Title`, count(1) AS `PageViews` FROM `hits` WHERE ((((((`hits`.`Title` <> '') AND (`hits`.`CounterID` = 62)) AND (`hits`.`DontCountHits` = 0)) AND (`hits`.`IsRefresh` = 0)) AND (strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) >= '2013-07-01')) AND (strftime('%Y-%m-%d', datetime(`hits`.`EventTime`, 'unixepoch')) <= '2013-07-31')) GROUP BY `hits`.`Title` ORDER BY `PageViews` DESC NULLS FIRST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
