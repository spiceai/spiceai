| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Sort: revenue DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Projection: mysql.tpch_sf1.nation.n_name, sum(mysql.tpch_sf1.lineitem.l_extendedprice * Int64(1) - mysql.tpch_sf1.lineitem.l_discount) AS revenue                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |     Aggregate: groupBy=[[mysql.tpch_sf1.nation.n_name]], aggr=[[sum(mysql.tpch_sf1.lineitem.l_extendedprice * (Int64(1) - mysql.tpch_sf1.lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |       Inner Join:  Filter: mysql.tpch_sf1.nation.n_regionkey = mysql.tpch_sf1.region.r_regionkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Inner Join:  Filter: mysql.tpch_sf1.supplier.s_nationkey = mysql.tpch_sf1.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           Inner Join:  Filter: mysql.tpch_sf1.lineitem.l_suppkey = mysql.tpch_sf1.supplier.s_suppkey AND mysql.tpch_sf1.customer.c_nationkey = mysql.tpch_sf1.supplier.s_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |             Inner Join:  Filter: mysql.tpch_sf1.lineitem.l_orderkey = mysql.tpch_sf1.orders.o_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |               Inner Join:  Filter: mysql.tpch_sf1.customer.c_custkey = mysql.tpch_sf1.orders.o_custkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                 TableScan: mysql.tpch_sf1.customer projection=[c_custkey, c_nationkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                 TableScan: mysql.tpch_sf1.orders projection=[o_orderkey, o_custkey], full_filters=[mysql.tpch_sf1.orders.o_orderdate >= CAST(Utf8("1994-01-01") AS Date32), mysql.tpch_sf1.orders.o_orderdate < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |               TableScan: mysql.tpch_sf1.lineitem projection=[l_orderkey, l_suppkey, l_extendedprice, l_discount]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |             TableScan: mysql.tpch_sf1.supplier projection=[s_suppkey, s_nationkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |           TableScan: mysql.tpch_sf1.nation projection=[n_nationkey, n_name, n_regionkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         TableScan: mysql.tpch_sf1.region projection=[r_regionkey], full_filters=[mysql.tpch_sf1.region.r_name = Utf8("ASIA")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `n_name`, sum((`lineitem`.`l_extendedprice` * (1 - `lineitem`.`l_discount`))) AS `revenue` FROM `tpch_sf1`.`customer` INNER JOIN `tpch_sf1`.`orders` ON (`customer`.`c_custkey` = `orders`.`o_custkey`) INNER JOIN `tpch_sf1`.`lineitem` ON (`lineitem`.`l_orderkey` = `orders`.`o_orderkey`) INNER JOIN `tpch_sf1`.`supplier` ON ((`lineitem`.`l_suppkey` = `supplier`.`s_suppkey`) AND (`customer`.`c_nationkey` = `supplier`.`s_nationkey`)) INNER JOIN `tpch_sf1`.`nation` ON (`supplier`.`s_nationkey` = `nation`.`n_nationkey`) INNER JOIN `tpch_sf1`.`region` ON (`nation`.`n_regionkey` = `region`.`r_regionkey`) WHERE (`orders`.`o_orderdate` >= CAST('1994-01-01' AS DATE)) AND (`orders`.`o_orderdate` < CAST('1995-01-01' AS DATE)) AND (`region`.`r_name` = 'ASIA') GROUP BY `nation`.`n_name` ORDER BY `revenue` DESC |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
