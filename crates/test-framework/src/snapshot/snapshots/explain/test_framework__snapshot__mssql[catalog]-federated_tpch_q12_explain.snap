| logical_plan  | Sort: mssql.dbo.lineitem.l_shipmode ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Projection: mssql.dbo.lineitem.l_shipmode, sum(CASE WHEN mssql.dbo.orders.o_orderpriority = Utf8("1-URGENT") OR mssql.dbo.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS high_line_count, sum(CASE WHEN mssql.dbo.orders.o_orderpriority != Utf8("1-URGENT") AND mssql.dbo.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END) AS low_line_count                                                                |
