|               |       AggregateExec: mode=FinalPartitioned, gby=[l_shipmode@0 as l_shipmode], aggr=[sum(CASE WHEN mssql.dbo.orders.o_orderpriority = Utf8("1-URGENT") OR mssql.dbo.orders.o_orderpriority = Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END), sum(CASE WHEN mssql.dbo.orders.o_orderpriority != Utf8("1-URGENT") AND mssql.dbo.orders.o_orderpriority != Utf8("2-HIGH") THEN Int64(1) ELSE Int64(0) END)]                                                             |
