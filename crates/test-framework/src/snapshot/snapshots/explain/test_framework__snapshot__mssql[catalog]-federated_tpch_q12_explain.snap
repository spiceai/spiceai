|               |       Projection: mssql.dbo.lineitem.l_shipmode, mssql.dbo.orders.o_orderpriority                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         Inner Join: mssql.dbo.lineitem.l_orderkey = mssql.dbo.orders.o_orderkey                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           Filter: mssql.dbo.lineitem.l_shipmode = Utf8("MAIL") OR mssql.dbo.lineitem.l_shipmode = Utf8("SHIP")                                                                                                                                                                                                                                                                                                                                                       |
|               |             TableScan: mssql.dbo.lineitem projection=[l_orderkey, l_shipmode], full_filters=[mssql.dbo.lineitem.l_receiptdate > mssql.dbo.lineitem.l_commitdate, mssql.dbo.lineitem.l_shipdate < mssql.dbo.lineitem.l_commitdate, mssql.dbo.lineitem.l_receiptdate >= Date32("1994-01-01"), mssql.dbo.lineitem.l_receiptdate < Date32("1995-01-01")], partial_filters=[mssql.dbo.lineitem.l_shipmode = Utf8("MAIL") OR mssql.dbo.lineitem.l_shipmode = Utf8("SHIP")] |
|               |           TableScan: mssql.dbo.orders projection=[o_orderkey, o_orderpriority]                                                                                                                                                                                                                                                                                                                                                                                       |
