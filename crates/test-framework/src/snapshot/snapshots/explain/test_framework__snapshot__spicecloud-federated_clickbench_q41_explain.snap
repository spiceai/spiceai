| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |  Limit: skip=100, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   Sort: PageViews DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     Projection: hits.URLHash, to_timestamp(hits.EventDate * Int64(86400)), count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       Aggregate: groupBy=[[hits.URLHash, to_timestamp(hits.EventDate * Int64(86400))]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |         Filter: hits.CounterID = Int64(62) AND to_timestamp(hits.EventDate * Int64(86400)) >= Utf8("2013-07-01") AND to_timestamp(hits.EventDate * Int64(86400)) <= Utf8("2013-07-31") AND hits.IsRefresh = Int64(0) AND hits.TraficSourceID IN ([Int64(-1), Int64(6)]) AND hits.RefererHash = Int64(3594120000172545465)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |           TableScan: hits projection=[EventDate, CounterID, IsRefresh, TraficSourceID, RefererHash, URLHash], partial_filters=[hits.CounterID = Int64(62), to_timestamp(hits.EventDate * Int64(86400)) >= Utf8("2013-07-01"), to_timestamp(hits.EventDate * Int64(86400)) <= Utf8("2013-07-31"), hits.IsRefresh = Int64(0), hits.TraficSourceID IN ([Int64(-1), Int64(6)]), hits.RefererHash = Int64(3594120000172545465)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       VirtualExecutionPlan name=spice.ai compute_context=url=https://us-east-1-prod-aws-flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench base_sql=SELECT "URLHash", to_timestamp(("hits"."EventDate" * 86400)), count(1) AS "PageViews" FROM "clickbench"."hits" WHERE (((((("hits"."CounterID" = 62) AND (to_timestamp(("hits"."EventDate" * 86400)) >= '2013-07-01')) AND (to_timestamp(("hits"."EventDate" * 86400)) <= '2013-07-31')) AND ("hits"."IsRefresh" = 0)) AND "hits"."TraficSourceID" IN (-1, 6)) AND ("hits"."RefererHash" = 3594120000172545465)) AND (((((("hits"."CounterID" = 62) AND (to_timestamp(("hits"."EventDate" * 86400)) >= '2013-07-01')) AND (to_timestamp(("hits"."EventDate" * 86400)) <= '2013-07-31')) AND ("hits"."IsRefresh" = 0)) AND "hits"."TraficSourceID" IN (-1, 6)) AND ("hits"."RefererHash" = 3594120000172545465)) GROUP BY "hits"."URLHash", to_timestamp(("hits"."EventDate" * 86400)) ORDER BY "PageViews" DESC NULLS FIRST LIMIT 10 OFFSET 100 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
