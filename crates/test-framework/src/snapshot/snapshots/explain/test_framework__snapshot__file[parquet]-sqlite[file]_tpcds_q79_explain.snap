                   |
|               |                           VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT `store_sales`.`ss_sold_date_sk`, `store_sales`.`ss_customer_sk`, `store_sales`.`ss_hdemo_sk`, `store_sales`.`ss_addr_sk`, `store_sales`.`ss_store_sk`, `store_sales`.`ss_ticket_number`, `store_sales`.`ss_coupon_amt`, `store_sales`.`ss_net_profit`, `date_dim`.`d_date_sk`, `store`.`s_store_sk`, `store`.`s_city`, `household_demographics`.`hd_demo_sk` FROM `store_sales` INNER JOIN `date_dim` ON (`store_sales`.`ss_sold_date_sk` = `date_dim`.`d_date_sk`) INNER JOIN `store` ON (`store_sales`.`ss_store_sk` = `store`.`s_store_sk`) INNER JOIN `household_demographics` ON (`store_sales`.`ss_hdemo_sk` = `household_demographics`.`hd_demo_sk`) WHERE (`date_dim`.`d_dow` = 1) AND `date_dim`.`d_year` IN (1999, (1999 + 1), (1999 + 2)) AND (`store`.`s_number_employees` BETWEEN 200 AND 295) AND ((`household_demographics`.`hd_dep_count` = 0) OR (`household_demographics`.`hd_vehicle_count` > 4)) rewritten_executor_sql=SELECT `store_sales`.`ss_sold_date_sk`, `store_sales`.`ss_customer_sk`, `store_sales`.`ss_hdemo_sk`, `store_sales`.`ss_addr_sk`, `store_sales`.`ss_store_sk`, `store_sales`.`ss_ticket_number`, `store_sales`.`ss_coupon_amt`, `store_sales`.`ss_net_profit`, `date_dim`.`d_date_sk`, `store`.`s_store_sk`, `store`.`s_city`, `household_demographics`.`hd_demo_sk` FROM `store_sales` INNER JOIN `date_dim` ON (`store_sales`.`ss_sold_date_sk` = `date_dim`.`d_date_sk`) INNER JOIN `store` ON (`store_sales`.`ss_store_sk` = `store`.`s_store_sk`) INNER JOIN `household_demographics` ON (`store_sales`.`ss_hdemo_sk` = `household_demographics`.`hd_demo_sk`) WHERE (`date_dim`.`d_dow` = 1) AND `date_dim`.`d_year` IN (1999, (1999 + 1), (1999 + 2)) AND (decimal_cmp(`store`.`s_number_employees`, decimal('200')) >= 0 AND decimal_cmp(`store`.`s_number_employees`, decimal('295')) <= 0) AND ((`household_demographics`.`hd_dep_count` = 0) OR (`household_demographics`.`hd_vehicle_count` > 4)) |
