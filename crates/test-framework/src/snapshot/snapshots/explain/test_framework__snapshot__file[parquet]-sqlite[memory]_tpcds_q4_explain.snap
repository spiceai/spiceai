|               |     Inner Join: t_s_firstyear.customer_id = t_s_secyear.customer_id Filter: CASE WHEN t_c_firstyear.year_total > Decimal128(0.000000,24,6) THEN t_c_secyear.year_total / t_c_firstyear.year_total ELSE Decimal128(NULL,34,10) END > CASE WHEN t_s_firstyear.year_total > Decimal128(0.000000,24,6) THEN t_s_secyear.year_total / t_s_firstyear.year_total ELSE Decimal128(NULL,34,10) END                                                                                                                                                                                                                                                                                                                                                                                                                                            |
