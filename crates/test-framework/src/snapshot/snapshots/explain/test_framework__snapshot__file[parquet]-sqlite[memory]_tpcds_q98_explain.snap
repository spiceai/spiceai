|               |                         BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                           VirtualExecutionPlan name=sqlite compute_context=memory base_sql=SELECT `store_sales`.`ss_sold_date_sk`, `store_sales`.`ss_item_sk`, `store_sales`.`ss_ext_sales_price`, `item`.`i_item_sk`, `item`.`i_item_id`, `item`.`i_item_desc`, `item`.`i_current_price`, `item`.`i_class`, `item`.`i_category`, `date_dim`.`d_date_sk` FROM `store_sales` INNER JOIN `item` ON (`store_sales`.`ss_item_sk` = `item`.`i_item_sk`) INNER JOIN `date_dim` ON (`store_sales`.`ss_sold_date_sk` = `date_dim`.`d_date_sk`) WHERE `item`.`i_category` IN ('Shoes', 'Music', 'Men') AND (`date_dim`.`d_date` BETWEEN CAST('2000-01-05' AS TEXT) AND (sqlite_date_operand(CAST('2000-01-05' AS TEXT)) + INTERVAL '30 DAYS')) rewritten_executor_sql=SELECT `store_sales`.`ss_sold_date_sk`, `store_sales`.`ss_item_sk`, `store_sales`.`ss_ext_sales_price`, `item`.`i_item_sk`, `item`.`i_item_id`, `item`.`i_item_desc`, `item`.`i_current_price`, `item`.`i_class`, `item`.`i_category`, `date_dim`.`d_date_sk` FROM `store_sales` INNER JOIN `item` ON (`store_sales`.`ss_item_sk` = `item`.`i_item_sk`) INNER JOIN `date_dim` ON (`store_sales`.`ss_sold_date_sk` = `date_dim`.`d_date_sk`) WHERE `item`.`i_category` IN ('Shoes', 'Music', 'Men') AND (`date_dim`.`d_date` BETWEEN CAST('2000-01-05' AS TEXT) AND (CAST(date(CAST('2000-01-05' AS TEXT), '+30 days') AS TEXT))) |
