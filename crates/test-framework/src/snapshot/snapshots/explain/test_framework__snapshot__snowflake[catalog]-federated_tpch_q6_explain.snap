|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT sum(("LINEITEM"."L_EXTENDEDPRICE" * "LINEITEM"."L_DISCOUNT")) AS "REVENUE" FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" WHERE (((("LINEITEM"."L_SHIPDATE" >= CAST('1994-01-01' AS DATE)) AND ("LINEITEM"."L_SHIPDATE" < CAST('1995-01-01' AS DATE))) AND ("LINEITEM"."L_DISCOUNT" BETWEEN (0.06 - 0.01) AND (0.06 + 0.01))) AND ("LINEITEM"."L_QUANTITY" < 24)) |
