---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: chbench_q12"
---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |  Sort: oorder.o_ol_cnt ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Projection: oorder.o_ol_cnt, sum(CASE WHEN oorder.o_carrier_id = Int64(1) OR oorder.o_carrier_id = Int64(2) THEN Int64(1) ELSE Int64(0) END) AS high_line_count, sum(CASE WHEN oorder.o_carrier_id != Int64(1) AND oorder.o_carrier_id != Int64(2) THEN Int64(1) ELSE Int64(0) END) AS low_line_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Aggregate: groupBy=[[oorder.o_ol_cnt]], aggr=[[sum(CASE WHEN oorder.o_carrier_id = Int64(1) OR oorder.o_carrier_id = Int64(2) THEN Int64(1) ELSE Int64(0) END), sum(CASE WHEN oorder.o_carrier_id != Int64(1) AND oorder.o_carrier_id != Int64(2) THEN Int64(1) ELSE Int64(0) END)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       Inner Join:  Filter: order_line.ol_w_id = oorder.o_w_id AND order_line.ol_d_id = oorder.o_d_id AND order_line.ol_o_id = oorder.o_id AND oorder.o_entry_d <= order_line.ol_delivery_d                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         TableScan: oorder projection=[o_id, o_d_id, o_w_id, o_entry_d, o_carrier_id, o_ol_cnt]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |         TableScan: order_line projection=[ol_o_id, ol_d_id, ol_w_id, ol_delivery_d], full_filters=[order_line.ol_delivery_d < Utf8("2030-01-01 00:00:00.000000")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "oorder"."o_ol_cnt", sum(CASE WHEN (("oorder"."o_carrier_id" = 1) OR ("oorder"."o_carrier_id" = 2)) THEN 1 ELSE 0 END) AS "high_line_count", sum(CASE WHEN (("oorder"."o_carrier_id" <> 1) AND ("oorder"."o_carrier_id" <> 2)) THEN 1 ELSE 0 END) AS "low_line_count" FROM "oorder" INNER JOIN "order_line" ON ((((("order_line"."ol_w_id" = "oorder"."o_w_id") AND ("order_line"."ol_d_id" = "oorder"."o_d_id")) AND ("order_line"."ol_o_id" = "oorder"."o_id")) AND ("oorder"."o_entry_d" <= "order_line"."ol_delivery_d")) AND ("order_line"."ol_delivery_d" < '2030-01-01 00:00:00.000000')) GROUP BY "oorder"."o_ol_cnt" ORDER BY "oorder"."o_ol_cnt" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
