---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: chbench_q18"
---
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |  Sort: amount_sum DESC NULLS FIRST, oorder.o_entry_d ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Projection: customer.c_last, customer.c_id, oorder.o_id, oorder.o_entry_d, oorder.o_ol_cnt, sum(order_line.ol_amount) AS amount_sum                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Filter: sum(order_line.ol_amount) > Int64(200)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       Aggregate: groupBy=[[oorder.o_id, oorder.o_w_id, oorder.o_d_id, customer.c_id, customer.c_last, oorder.o_entry_d, oorder.o_ol_cnt]], aggr=[[sum(order_line.ol_amount)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Inner Join:  Filter: order_line.ol_w_id = oorder.o_w_id AND order_line.ol_d_id = oorder.o_d_id AND order_line.ol_o_id = oorder.o_id                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |           Inner Join:  Filter: customer.c_id = oorder.o_c_id AND customer.c_w_id = oorder.o_w_id AND customer.c_d_id = oorder.o_d_id                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |             TableScan: customer projection=[c_id, c_d_id, c_w_id, c_last]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             TableScan: oorder projection=[o_id, o_d_id, o_w_id, o_c_id, o_entry_d, o_ol_cnt]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |           TableScan: order_line projection=[ol_o_id, ol_d_id, ol_w_id, ol_amount]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT "customer"."c_last", "customer"."c_id", "oorder"."o_id", "oorder"."o_entry_d", "oorder"."o_ol_cnt", sum("order_line"."ol_amount") AS "amount_sum" FROM "customer" INNER JOIN "oorder" ON ((("customer"."c_id" = "oorder"."o_c_id") AND ("customer"."c_w_id" = "oorder"."o_w_id")) AND ("customer"."c_d_id" = "oorder"."o_d_id")) INNER JOIN "order_line" ON ((("order_line"."ol_w_id" = "oorder"."o_w_id") AND ("order_line"."ol_d_id" = "oorder"."o_d_id")) AND ("order_line"."ol_o_id" = "oorder"."o_id")) GROUP BY "oorder"."o_id", "oorder"."o_w_id", "oorder"."o_d_id", "customer"."c_id", "customer"."c_last", "oorder"."o_entry_d", "oorder"."o_ol_cnt" HAVING (sum("order_line"."ol_amount") > 200) ORDER BY "amount_sum" DESC NULLS FIRST, "oorder"."o_entry_d" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
