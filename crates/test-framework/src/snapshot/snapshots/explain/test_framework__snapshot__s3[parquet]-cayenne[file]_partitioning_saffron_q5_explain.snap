| logical_plan  | Sort: NULL ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   Projection: A.MaxRate, count(Int64(1)) AS Count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |     Aggregate: groupBy=[[A.MaxRate]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       Projection: A.MaxRate                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         Inner Join: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |           SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |             Projection: number_info.NumberSid, number_info.MaxRate                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |               BytesProcessedNode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                 Filter: number_info.AccountSid = LargeUtf8("AC02da2b759e8342d4b73ff6e64a77ce58") AND number_info.NumberPoolSid = LargeUtf8("NPcb39bd63c0a54ab8b106d8f9e0aa6507") AND number_info.NumberRegion = LargeUtf8("CA") AND number_info.NumberType = LargeUtf8("tf") AND number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099") AND (number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0))                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                   TableScan: number_info projection=[AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberType, NumberRegion, AvailableForNumberSelection]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |           SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |             Projection: number_caps.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |               BytesProcessedNode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |                 Filter: number_caps.Capability = LargeUtf8("sms") AND number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                   TableScan: number_caps projection=[NumberSid, Capability], partial_filters=[number_caps.Capability = LargeUtf8("sms"), number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
