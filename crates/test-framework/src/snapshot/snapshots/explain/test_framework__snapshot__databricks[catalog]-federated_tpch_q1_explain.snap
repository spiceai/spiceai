| logical_plan  | Sort: tpch.tpch.lineitem.l_returnflag ASC NULLS LAST, tpch.tpch.lineitem.l_linestatus ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Projection: tpch.tpch.lineitem.l_returnflag, tpch.tpch.lineitem.l_linestatus, sum(tpch.tpch.lineitem.l_quantity) AS sum_qty, sum(tpch.tpch.lineitem.l_extendedprice) AS sum_base_price, sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount) AS sum_disc_price, sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount * Int64(1) + tpch.tpch.lineitem.l_tax) AS sum_charge, avg(tpch.tpch.lineitem.l_quantity) AS avg_qty, avg(tpch.tpch.lineitem.l_extendedprice) AS avg_price, avg(tpch.tpch.lineitem.l_discount) AS avg_disc, count(Int64(1)) AS count_order                                                                  |
|               |     Aggregate: groupBy=[[tpch.tpch.lineitem.l_returnflag, tpch.tpch.lineitem.l_linestatus]], aggr=[[sum(tpch.tpch.lineitem.l_quantity), sum(tpch.tpch.lineitem.l_extendedprice), sum(__common_expr_1) AS sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount), sum(__common_expr_1 * (Decimal128(Some(1),20,0) + tpch.tpch.lineitem.l_tax)) AS sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount * Int64(1) + tpch.tpch.lineitem.l_tax), avg(CAST(tpch.tpch.lineitem.l_quantity AS Float64)), avg(CAST(tpch.tpch.lineitem.l_extendedprice AS Float64)), avg(CAST(tpch.tpch.lineitem.l_discount AS Float64)), count(Int64(1))]] |
|               |       Projection: tpch.tpch.lineitem.l_extendedprice * (Decimal128(Some(1),20,0) - tpch.tpch.lineitem.l_discount) AS __common_expr_1, tpch.tpch.lineitem.l_quantity, tpch.tpch.lineitem.l_extendedprice, tpch.tpch.lineitem.l_discount, tpch.tpch.lineitem.l_tax, tpch.tpch.lineitem.l_returnflag, tpch.tpch.lineitem.l_linestatus                                                                                                                                                                                                                                                                                                                                                           |
|               |         Filter: tpch.tpch.lineitem.l_shipdate <= Date32("1998-09-02")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |           TableScan: tpch.tpch.lineitem projection=[l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate], partial_filters=[tpch.tpch.lineitem.l_shipdate <= Date32("1998-09-02")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| physical_plan | SortPreservingMergeExec: [l_returnflag@0 ASC NULLS LAST, l_linestatus@1 ASC NULLS LAST]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   SortExec: expr=[l_returnflag@0 ASC NULLS LAST, l_linestatus@1 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     ProjectionExec: expr=[l_returnflag@0 as l_returnflag, l_linestatus@1 as l_linestatus, sum(tpch.tpch.lineitem.l_quantity)@2 as sum_qty, sum(tpch.tpch.lineitem.l_extendedprice)@3 as sum_base_price, sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount)@4 as sum_disc_price, sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount * Int64(1) + tpch.tpch.lineitem.l_tax)@5 as sum_charge, avg(tpch.tpch.lineitem.l_quantity)@6 as avg_qty, avg(tpch.tpch.lineitem.l_extendedprice)@7 as avg_price, avg(tpch.tpch.lineitem.l_discount)@8 as avg_disc, count(Int64(1))@9 as count_order]                                       |
|               |       AggregateExec: mode=FinalPartitioned, gby=[l_returnflag@0 as l_returnflag, l_linestatus@1 as l_linestatus], aggr=[sum(tpch.tpch.lineitem.l_quantity), sum(tpch.tpch.lineitem.l_extendedprice), sum(__common_expr_1) as sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount), sum(__common_expr_1 * Some(1),20,0 + tpch.tpch.lineitem.l_tax) as sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount * Int64(1) + tpch.tpch.lineitem.l_tax), avg(tpch.tpch.lineitem.l_quantity), avg(tpch.tpch.lineitem.l_extendedprice), avg(tpch.tpch.lineitem.l_discount), count(Int64(1))]                                               |
|               |         RepartitionExec: partitioning=Hash([l_returnflag@0, l_linestatus@1], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |           AggregateExec: mode=Partial, gby=[l_returnflag@5 as l_returnflag, l_linestatus@6 as l_linestatus], aggr=[sum(tpch.tpch.lineitem.l_quantity), sum(tpch.tpch.lineitem.l_extendedprice), sum(__common_expr_1) as sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount), sum(__common_expr_1 * Some(1),20,0 + tpch.tpch.lineitem.l_tax) as sum(tpch.tpch.lineitem.l_extendedprice * Int64(1) - tpch.tpch.lineitem.l_discount * Int64(1) + tpch.tpch.lineitem.l_tax), avg(tpch.tpch.lineitem.l_quantity), avg(tpch.tpch.lineitem.l_extendedprice), avg(tpch.tpch.lineitem.l_discount), count(Int64(1))]                                                    |
