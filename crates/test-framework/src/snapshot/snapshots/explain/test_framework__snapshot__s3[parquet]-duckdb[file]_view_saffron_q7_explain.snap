+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |  Limit: skip=0, fetch=CAST(Int64(20) AS Int64)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   Sort: A.NumberSid ASC NULLS LAST, A.Capability ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |     Projection: A.DateCreated, A.DateUpdated, A.AccountSid, A.NumberPoolSid, A.NumberSid, A.MaxRate, A.NumberDid, A.NumberType, A.SupportedDestRegion, A.NumberRegion, A.CurrentRate, A.IsAvailable, A.ProviderSid, A.AreaCodeRegion, A.AvailableForNumberSelection, A.Capability                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       Filter: A.NumberPoolSid = Utf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND A.AccountSid = Utf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND (A.SupportedDestRegion = Utf8("00") OR A.SupportedDestRegion = Utf8("US")) AND (A.NumberRegion = Utf8("US") OR A.NumberRegion IS NULL) AND A.NumberSid NOT IN ([Utf8("PN00000000000000000000000000000099")]) AND A.NumberType = Utf8("lc") AND A.Capability = Utf8("sms")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |           TableScan: number_info_with_cap projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection, Capability]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db;number_info_with_cap.duckdb;sender_info.duckdb base_sql=SELECT "A"."DateCreated", "A"."DateUpdated", "A"."AccountSid", "A"."NumberPoolSid", "A"."NumberSid", "A"."MaxRate", "A"."NumberDid", "A"."NumberType", "A"."SupportedDestRegion", "A"."NumberRegion", "A"."CurrentRate", "A"."IsAvailable", "A"."ProviderSid", "A"."AreaCodeRegion", "A"."AvailableForNumberSelection", "A"."Capability" FROM "number_info_with_cap" AS "A" WHERE ((((((("A"."NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9') AND ("A"."AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066')) AND (("A"."SupportedDestRegion" = '00') OR ("A"."SupportedDestRegion" = 'US'))) AND (("A"."NumberRegion" = 'US') OR "A"."NumberRegion" IS NULL)) AND "A"."NumberSid" NOT IN ('PN00000000000000000000000000000099')) AND ("A"."NumberType" = 'lc')) AND ("A"."Capability" = 'sms')) ORDER BY "A"."NumberSid" ASC NULLS LAST, "A"."Capability" ASC NULLS LAST LIMIT CAST(20 AS BIGINT) |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
