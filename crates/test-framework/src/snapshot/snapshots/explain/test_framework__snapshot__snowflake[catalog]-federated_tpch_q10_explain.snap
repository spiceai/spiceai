| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |  Limit: skip=0, fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   Sort: REVENUE DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |     Projection: snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY, snowflake.TPCH_SF1.CUSTOMER.C_NAME, sum(snowflake.TPCH_SF1.LINEITEM.L_EXTENDEDPRICE * Int64(1) - snowflake.TPCH_SF1.LINEITEM.L_DISCOUNT) AS REVENUE, snowflake.TPCH_SF1.CUSTOMER.C_ACCTBAL, snowflake.TPCH_SF1.NATION.N_NAME, snowflake.TPCH_SF1.CUSTOMER.C_ADDRESS, snowflake.TPCH_SF1.CUSTOMER.C_PHONE, snowflake.TPCH_SF1.CUSTOMER.C_COMMENT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       Aggregate: groupBy=[[snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY, snowflake.TPCH_SF1.CUSTOMER.C_NAME, snowflake.TPCH_SF1.CUSTOMER.C_ACCTBAL, snowflake.TPCH_SF1.CUSTOMER.C_PHONE, snowflake.TPCH_SF1.NATION.N_NAME, snowflake.TPCH_SF1.CUSTOMER.C_ADDRESS, snowflake.TPCH_SF1.CUSTOMER.C_COMMENT]], aggr=[[sum(snowflake.TPCH_SF1.LINEITEM.L_EXTENDEDPRICE * (Int64(1) - snowflake.TPCH_SF1.LINEITEM.L_DISCOUNT))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |         Inner Join:  Filter: snowflake.TPCH_SF1.CUSTOMER.C_NATIONKEY = snowflake.TPCH_SF1.NATION.N_NATIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |           Inner Join:  Filter: snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY = snowflake.TPCH_SF1.ORDERS.O_ORDERKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |             Inner Join:  Filter: snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY = snowflake.TPCH_SF1.ORDERS.O_CUSTKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |               TableScan: snowflake.TPCH_SF1.CUSTOMER projection=[C_CUSTKEY, C_NAME, C_ADDRESS, C_NATIONKEY, C_PHONE, C_ACCTBAL, C_COMMENT]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |               TableScan: snowflake.TPCH_SF1.ORDERS projection=[O_ORDERKEY, O_CUSTKEY], full_filters=[snowflake.TPCH_SF1.ORDERS.O_ORDERDATE >= CAST(Utf8("1993-10-01") AS Date32), snowflake.TPCH_SF1.ORDERS.O_ORDERDATE < CAST(Utf8("1994-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             TableScan: snowflake.TPCH_SF1.LINEITEM projection=[L_ORDERKEY, L_EXTENDEDPRICE, L_DISCOUNT], full_filters=[snowflake.TPCH_SF1.LINEITEM.L_RETURNFLAG = Utf8("R")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |           TableScan: snowflake.TPCH_SF1.NATION projection=[N_NATIONKEY, N_NAME]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "C_CUSTKEY", "C_NAME", sum(("LINEITEM"."L_EXTENDEDPRICE" * (1 - "LINEITEM"."L_DISCOUNT"))) AS "REVENUE", "C_ACCTBAL", "N_NAME", "C_ADDRESS", "C_PHONE", "C_COMMENT" FROM "BENCHMARKS"."TPCH_SF1"."CUSTOMER" INNER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("CUSTOMER"."C_CUSTKEY" = "ORDERS"."O_CUSTKEY") AND (("ORDERS"."O_ORDERDATE" >= CAST('1993-10-01' AS DATE)) AND ("ORDERS"."O_ORDERDATE" < CAST('1994-01-01' AS DATE)))) INNER JOIN "BENCHMARKS"."TPCH_SF1"."LINEITEM" ON (("LINEITEM"."L_ORDERKEY" = "ORDERS"."O_ORDERKEY") AND ("LINEITEM"."L_RETURNFLAG" = 'R')) INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON ("CUSTOMER"."C_NATIONKEY" = "NATION"."N_NATIONKEY") GROUP BY "CUSTOMER"."C_CUSTKEY", "CUSTOMER"."C_NAME", "CUSTOMER"."C_ACCTBAL", "CUSTOMER"."C_PHONE", "NATION"."N_NAME", "CUSTOMER"."C_ADDRESS", "CUSTOMER"."C_COMMENT" ORDER BY "REVENUE" DESC NULLS FIRST LIMIT 20 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
