| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: A.NumberSid ASC NULLS LAST, B.Capability ASC NULLS LAST, fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |   Projection: A.DateCreated, A.DateUpdated, A.AccountSid, A.NumberPoolSid, A.NumberSid, A.MaxRate, A.NumberDid, A.NumberType, A.SupportedDestRegion, A.NumberRegion, A.CurrentRate, A.IsAvailable, A.ProviderSid, A.AreaCodeRegion, A.AvailableForNumberSelection, B.Capability                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |     Inner Join: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Filter: number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND number_info.NumberType = LargeUtf8("lc") AND number_info.MaxRate = Int32(20) AND number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099") AND (number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |           TableScan: number_info projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection], partial_filters=[number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info.NumberType = LargeUtf8("lc"), number_info.MaxRate = Int32(20), number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |       SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |         Filter: number_caps.Capability = LargeUtf8("sms") AND number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           TableScan: number_caps projection=[NumberSid, Capability], partial_filters=[number_caps.Capability = LargeUtf8("sms"), number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| physical_plan | SortPreservingMergeExec: [NumberSid@4 ASC NULLS LAST, Capability@15 ASC NULLS LAST], fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   SortExec: TopK(fetch=1), expr=[NumberSid@4 ASC NULLS LAST, Capability@15 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     ProjectionExec: expr=[DateCreated@1 as DateCreated, DateUpdated@2 as DateUpdated, AccountSid@3 as AccountSid, NumberPoolSid@4 as NumberPoolSid, NumberSid@5 as NumberSid, MaxRate@6 as MaxRate, NumberDid@7 as NumberDid, NumberType@8 as NumberType, SupportedDestRegion@9 as SupportedDestRegion, NumberRegion@10 as NumberRegion, CurrentRate@11 as CurrentRate, IsAvailable@12 as IsAvailable, ProviderSid@13 as ProviderSid, AreaCodeRegion@14 as AreaCodeRegion, AvailableForNumberSelection@15 as AvailableForNumberSelection, Capability@0 as Capability]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(NumberSid@0, NumberSid@4)], projection=[Capability@1, DateCreated@2, DateUpdated@3, AccountSid@4, NumberPoolSid@5, NumberSid@6, MaxRate@7, NumberDid@8, NumberType@9, SupportedDestRegion@10, NumberRegion@11, CurrentRate@12, IsAvailable@13, ProviderSid@14, AreaCodeRegion@15, AvailableForNumberSelection@16]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
