| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: A.NumberSid ASC NULLS LAST, fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   Projection: A.DateCreated, A.DateUpdated, A.AccountSid, A.NumberPoolSid, A.NumberSid, A.MaxRate, A.NumberDid, A.NumberType, A.SupportedDestRegion, A.NumberRegion, A.CurrentRate, A.IsAvailable, A.ProviderSid, A.AreaCodeRegion, A.AvailableForNumberSelection                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |     Inner Join: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         Filter: number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND number_info.NumberType = LargeUtf8("lc") AND number_info.MaxRate = Int32(20) AND number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099") AND (number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           TableScan: number_info projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection], partial_filters=[number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info.NumberType = LargeUtf8("lc"), number_info.MaxRate = Int32(20), number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         Projection: number_caps.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |           Filter: number_caps.Capability = LargeUtf8("sms") AND number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |             TableScan: number_caps projection=[NumberSid, Capability], partial_filters=[number_caps.Capability = LargeUtf8("sms"), number_caps.NumberSid != LargeUtf8("PN00000000000000000000000000000099")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| physical_plan | SortPreservingMergeExec: [NumberSid@4 ASC NULLS LAST], fetch=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   SortExec: TopK(fetch=1), expr=[NumberSid@4 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     CoalesceBatchesExec: target_batch_size=8192                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       HashJoinExec: mode=Partitioned, join_type=Inner, on=[(NumberSid@0, NumberSid@4)], projection=[DateCreated@1, DateUpdated@2, AccountSid@3, NumberPoolSid@4, NumberSid@5, MaxRate@6, NumberDid@7, NumberType@8, SupportedDestRegion@9, NumberRegion@10, CurrentRate@11, IsAvailable@12, ProviderSid@13, AreaCodeRegion@14, AvailableForNumberSelection@15]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |         CoalesceBatchesExec: target_batch_size=8192                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           RepartitionExec: partitioning=Hash([NumberSid@0], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |             ProjectionExec: expr=[NumberSid@0 as NumberSid]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |               SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |                 BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                   DataSourceExec: file_groups={32 groups: [[/data/number_caps/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_caps/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_caps/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_caps/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_caps/<CAYENNE_PATH>.vortex:<RANGE>], ...]}, projection=[NumberSid, Capability], file_type=vortex, predicate: Capability@1 = sms AND NumberSid@0 != PN00000000000000000000000000000099 AND DynamicFilterPhysicalExpr [ true ]                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |         CoalesceBatchesExec: target_batch_size=8192                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |           RepartitionExec: partitioning=Hash([NumberSid@4], 32), input_partitions=32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |             SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |               BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |                 DataSourceExec: file_groups={32 groups: [[/data/number_info/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_info/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_info/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_info/<CAYENNE_PATH>.vortex:<RANGE>], [/data/number_info/<CAYENNE_PATH>.vortex:<RANGE>], ...]}, projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection], file_type=vortex, predicate: AccountSid@2 = AC8ee2a82cf11c7c8860b192678c9e3066 AND NumberPoolSid@3 = NPe85ca269e9eb6b9268ffeab9d6ffaba9 AND NumberType@7 = lc AND MaxRate@5 = 20 AND NumberSid@4 != PN00000000000000000000000000000099 AND (AvailableForNumberSelection@14 = 1 OR AvailableForNumberSelection@14 = 0) AND DynamicFilterPhysicalExpr [ true ] AND DynamicFilterPhysicalExpr [ true ] |
