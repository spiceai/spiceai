|               |               BytesProcessedNode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                 Filter: number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND number_info.NumberRegion = LargeUtf8("US") AND number_info.NumberType = LargeUtf8("lc") AND number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099") AND (number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                   TableScan: number_info projection=[AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberType, NumberRegion, AvailableForNumberSelection], partial_filters=[number_info.AccountSid = LargeUtf8("AC8ee2a82cf11c7c8860b192678c9e3066"), number_info.NumberPoolSid = LargeUtf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9"), number_info.NumberRegion = LargeUtf8("US"), number_info.NumberType = LargeUtf8("lc"), number_info.NumberSid != LargeUtf8("PN00000000000000000000000000000099"), number_info.AvailableForNumberSelection = Int8(1) OR number_info.AvailableForNumberSelection = Int8(0)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |           SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
