| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                       |
|               |   Sort: c DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                     |
|               |     Projection: hits.SearchPhrase, count(Int64(1)) AS c                                                                                                                                                                                                                                                                                                                        |
|               |       Aggregate: groupBy=[[hits.SearchPhrase]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                       |
|               |         Filter: hits.SearchPhrase != Utf8("")                                                                                                                                                                                                                                                                                                                                  |
|               |           TableScan: hits projection=[SearchPhrase], partial_filters=[hits.SearchPhrase != Utf8("")]                                                                                                                                                                                                                                                                           |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=spice.ai compute_context=url=https://us-east-1-prod-aws-flight.spiceai.io,username=,org=spiceai,app=benchmarks-clickbench base_sql=SELECT "SearchPhrase", count(1) AS "c" FROM "clickbench"."hits" WHERE ("hits"."SearchPhrase" <> '') AND ("hits"."SearchPhrase" <> '') GROUP BY "hits"."SearchPhrase" ORDER BY "c" DESC NULLS FIRST LIMIT 10 |
