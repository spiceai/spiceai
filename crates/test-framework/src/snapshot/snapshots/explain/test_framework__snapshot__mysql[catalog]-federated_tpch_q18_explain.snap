|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `c_name`, `c_custkey`, `o_orderkey`, `o_orderdate`, `o_totalprice`, sum(`lineitem`.`l_quantity`) FROM `tpch_sf1`.`customer` INNER JOIN `tpch_sf1`.`orders` ON ((`customer`.`c_custkey` = `orders`.`o_custkey`) AND `orders`.`o_orderkey` IN (SELECT `l_orderkey` FROM `tpch_sf1`.`lineitem` GROUP BY `lineitem`.`l_orderkey` HAVING (sum(`lineitem`.`l_quantity`) > 300))) INNER JOIN `tpch_sf1`.`lineitem` ON (`orders`.`o_orderkey` = `lineitem`.`l_orderkey`) GROUP BY `customer`.`c_name`, `customer`.`c_custkey`, `orders`.`o_orderkey`, `orders`.`o_orderdate`, `orders`.`o_totalprice` ORDER BY `o_totalprice` DESC, `o_orderdate` ASC LIMIT 100 |
