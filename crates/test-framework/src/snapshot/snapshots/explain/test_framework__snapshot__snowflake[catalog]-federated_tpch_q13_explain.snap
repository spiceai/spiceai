+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |  Sort: custdist DESC NULLS FIRST, c_orders.c_count DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Projection: c_orders.c_count, count(Int64(1)) AS custdist                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     Aggregate: groupBy=[[c_orders.c_count]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       SubqueryAlias: c_orders                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         Projection: count(snowflake.TPCH_SF1.ORDERS.O_ORDERKEY) AS c_count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |           Aggregate: groupBy=[[snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY]], aggr=[[count(snowflake.TPCH_SF1.ORDERS.O_ORDERKEY)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |             Left Join:  Filter: snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY = snowflake.TPCH_SF1.ORDERS.O_CUSTKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |               TableScan: snowflake.TPCH_SF1.CUSTOMER projection=[C_CUSTKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |               TableScan: snowflake.TPCH_SF1.ORDERS projection=[O_ORDERKEY, O_CUSTKEY], full_filters=[snowflake.TPCH_SF1.ORDERS.O_COMMENT NOT LIKE Utf8("%special%requests%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "c_orders"."c_count", count(1) AS "custdist" FROM (SELECT count("ORDERS"."O_ORDERKEY") AS "c_count" FROM "BENCHMARKS"."TPCH_SF1"."CUSTOMER" LEFT OUTER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("CUSTOMER"."C_CUSTKEY" = "ORDERS"."O_CUSTKEY") AND "ORDERS"."O_COMMENT" NOT LIKE '%special%requests%') GROUP BY "CUSTOMER"."C_CUSTKEY") AS "c_orders" GROUP BY "c_orders"."c_count" ORDER BY "custdist" DESC NULLS FIRST, "c_orders"."c_count" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
