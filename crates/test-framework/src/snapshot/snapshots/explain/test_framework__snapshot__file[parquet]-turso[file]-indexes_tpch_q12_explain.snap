|               |                       VirtualExecutionPlan name=lineitem compute_context=//data/lineitem.turso base_sql=SELECT `lineitem`.`l_orderkey`, `lineitem`.`l_shipmode` FROM `lineitem` WHERE ((((`lineitem`.`l_shipmode` IN ('MAIL', 'SHIP') AND (`lineitem`.`l_commitdate` < `lineitem`.`l_receiptdate`)) AND (`lineitem`.`l_shipdate` < `lineitem`.`l_commitdate`)) AND (`lineitem`.`l_receiptdate` >= CAST('1994-01-01' AS TEXT))) AND (`lineitem`.`l_receiptdate` < CAST('1995-01-01' AS TEXT)))                                                                                                                                             |
