| logical_plan  | Sort: l_year ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                  |
|               |   Projection: date_part(Utf8("YEAR"),oorder.o_entry_d) AS l_year, sum(CASE WHEN n2.n_name = Utf8("INDIA") THEN order_line.ol_amount ELSE Int64(0) END) / sum(order_line.ol_amount) AS mkt_share                                                                                                                                                              |
|               |     Aggregate: groupBy=[[date_part(Utf8("YEAR"), oorder.o_entry_d)]], aggr=[[sum(CASE WHEN n2.n_name = Utf8("INDIA") THEN CAST(order_line.ol_amount AS Decimal128(22, 2)) ELSE Decimal128(0.00,22,2) END) AS sum(CASE WHEN n2.n_name = Utf8("INDIA") THEN order_line.ol_amount ELSE Int64(0) END), sum(order_line.ol_amount)]]                               |
|               |       Projection: order_line.ol_amount, oorder.o_entry_d, n2.n_name                                                                                                                                                                                                                                                                                          |
|               |         LeftSemi Join: n1.n_regionkey = region.r_regionkey                                                                                                                                                                                                                                                                                                   |
