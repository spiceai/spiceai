---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpch_q1"
---
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |  Sort: ducklake.main.lineitem.l_returnflag ASC NULLS LAST, ducklake.main.lineitem.l_linestatus ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   Projection: ducklake.main.lineitem.l_returnflag, ducklake.main.lineitem.l_linestatus, sum(ducklake.main.lineitem.l_quantity) AS sum_qty, sum(ducklake.main.lineitem.l_extendedprice) AS sum_base_price, sum(ducklake.main.lineitem.l_extendedprice * Int64(1) - ducklake.main.lineitem.l_discount) AS sum_disc_price, sum(ducklake.main.lineitem.l_extendedprice * Int64(1) - ducklake.main.lineitem.l_discount * Int64(1) + ducklake.main.lineitem.l_tax) AS sum_charge, avg(ducklake.main.lineitem.l_quantity) AS avg_qty, avg(ducklake.main.lineitem.l_extendedprice) AS avg_price, avg(ducklake.main.lineitem.l_discount) AS avg_disc, count(Int64(1)) AS count_order                                                                                                                                                                                |
|               |     Aggregate: groupBy=[[ducklake.main.lineitem.l_returnflag, ducklake.main.lineitem.l_linestatus]], aggr=[[sum(ducklake.main.lineitem.l_quantity), sum(ducklake.main.lineitem.l_extendedprice), sum(ducklake.main.lineitem.l_extendedprice * (Int64(1) - ducklake.main.lineitem.l_discount)), sum(ducklake.main.lineitem.l_extendedprice * (Int64(1) - ducklake.main.lineitem.l_discount) * (Int64(1) + ducklake.main.lineitem.l_tax)), avg(ducklake.main.lineitem.l_quantity), avg(ducklake.main.lineitem.l_extendedprice), avg(ducklake.main.lineitem.l_discount), count(Int64(1))]]                                                                                                                                                                                                                                                                    |
|               |       TableScan: ducklake.main.lineitem projection=[l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus], full_filters=[ducklake.main.lineitem.l_shipdate <= CAST(Utf8("1998-12-01") AS Date32) - IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 90, nanoseconds: 0 }")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "l_returnflag", "l_linestatus", sum("lineitem"."l_quantity") AS "sum_qty", sum("lineitem"."l_extendedprice") AS "sum_base_price", sum(("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount"))) AS "sum_disc_price", sum((("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount")) * (1 + "lineitem"."l_tax"))) AS "sum_charge", avg("lineitem"."l_quantity") AS "avg_qty", avg("lineitem"."l_extendedprice") AS "avg_price", avg("lineitem"."l_discount") AS "avg_disc", count(1) AS "count_order" FROM "ducklake"."main"."lineitem" WHERE ("lineitem"."l_shipdate" <= (CAST('1998-12-01' AS DATE) - INTERVAL '90 DAYS')) GROUP BY "lineitem"."l_returnflag", "lineitem"."l_linestatus" ORDER BY "l_returnflag" ASC NULLS LAST, "l_linestatus" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
