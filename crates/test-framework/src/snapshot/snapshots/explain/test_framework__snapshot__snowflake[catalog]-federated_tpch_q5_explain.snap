| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Sort: REVENUE DESC NULLS FIRST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Projection: snowflake.TPCH_SF1.NATION.N_NAME, sum(snowflake.TPCH_SF1.LINEITEM.L_EXTENDEDPRICE * Int64(1) - snowflake.TPCH_SF1.LINEITEM.L_DISCOUNT) AS REVENUE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     Aggregate: groupBy=[[snowflake.TPCH_SF1.NATION.N_NAME]], aggr=[[sum(snowflake.TPCH_SF1.LINEITEM.L_EXTENDEDPRICE * (Int64(1) - snowflake.TPCH_SF1.LINEITEM.L_DISCOUNT))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       Inner Join:  Filter: snowflake.TPCH_SF1.NATION.N_REGIONKEY = snowflake.TPCH_SF1.REGION.R_REGIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         Inner Join:  Filter: snowflake.TPCH_SF1.SUPPLIER.S_NATIONKEY = snowflake.TPCH_SF1.NATION.N_NATIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           Inner Join:  Filter: snowflake.TPCH_SF1.LINEITEM.L_SUPPKEY = snowflake.TPCH_SF1.SUPPLIER.S_SUPPKEY AND snowflake.TPCH_SF1.CUSTOMER.C_NATIONKEY = snowflake.TPCH_SF1.SUPPLIER.S_NATIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |             Inner Join:  Filter: snowflake.TPCH_SF1.LINEITEM.L_ORDERKEY = snowflake.TPCH_SF1.ORDERS.O_ORDERKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |               Inner Join:  Filter: snowflake.TPCH_SF1.CUSTOMER.C_CUSTKEY = snowflake.TPCH_SF1.ORDERS.O_CUSTKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                 TableScan: snowflake.TPCH_SF1.CUSTOMER projection=[C_CUSTKEY, C_NATIONKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                 TableScan: snowflake.TPCH_SF1.ORDERS projection=[O_ORDERKEY, O_CUSTKEY], full_filters=[snowflake.TPCH_SF1.ORDERS.O_ORDERDATE >= CAST(Utf8("1994-01-01") AS Date32), snowflake.TPCH_SF1.ORDERS.O_ORDERDATE < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |               TableScan: snowflake.TPCH_SF1.LINEITEM projection=[L_ORDERKEY, L_SUPPKEY, L_EXTENDEDPRICE, L_DISCOUNT]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |             TableScan: snowflake.TPCH_SF1.SUPPLIER projection=[S_SUPPKEY, S_NATIONKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |           TableScan: snowflake.TPCH_SF1.NATION projection=[N_NATIONKEY, N_NAME, N_REGIONKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |         TableScan: snowflake.TPCH_SF1.REGION projection=[R_REGIONKEY], full_filters=[snowflake.TPCH_SF1.REGION.R_NAME = Utf8("ASIA")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "N_NAME", sum(("LINEITEM"."L_EXTENDEDPRICE" * (1 - "LINEITEM"."L_DISCOUNT"))) AS "REVENUE" FROM "BENCHMARKS"."TPCH_SF1"."CUSTOMER" INNER JOIN "BENCHMARKS"."TPCH_SF1"."ORDERS" ON (("CUSTOMER"."C_CUSTKEY" = "ORDERS"."O_CUSTKEY") AND (("ORDERS"."O_ORDERDATE" >= CAST('1994-01-01' AS DATE)) AND ("ORDERS"."O_ORDERDATE" < CAST('1995-01-01' AS DATE)))) INNER JOIN "BENCHMARKS"."TPCH_SF1"."LINEITEM" ON ("LINEITEM"."L_ORDERKEY" = "ORDERS"."O_ORDERKEY") INNER JOIN "BENCHMARKS"."TPCH_SF1"."SUPPLIER" ON (("LINEITEM"."L_SUPPKEY" = "SUPPLIER"."S_SUPPKEY") AND ("CUSTOMER"."C_NATIONKEY" = "SUPPLIER"."S_NATIONKEY")) INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON ("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") INNER JOIN "BENCHMARKS"."TPCH_SF1"."REGION" ON (("NATION"."N_REGIONKEY" = "REGION"."R_REGIONKEY") AND ("REGION"."R_NAME" = 'ASIA')) GROUP BY "NATION"."N_NAME" ORDER BY "REVENUE" DESC NULLS FIRST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
