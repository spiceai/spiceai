+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |  Sort: snowflake.TPCH_SF1.SUPPLIER.S_NAME ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Projection: snowflake.TPCH_SF1.SUPPLIER.S_NAME, snowflake.TPCH_SF1.SUPPLIER.S_ADDRESS                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     Inner Join:  Filter: snowflake.TPCH_SF1.SUPPLIER.S_NATIONKEY = snowflake.TPCH_SF1.NATION.N_NATIONKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       Filter: snowflake.TPCH_SF1.SUPPLIER.S_SUPPKEY IN (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |           Projection: snowflake.TPCH_SF1.PARTSUPP.PS_SUPPKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |             Filter: snowflake.TPCH_SF1.PARTSUPP.PS_PARTKEY IN (<subquery>) AND snowflake.TPCH_SF1.PARTSUPP.PS_AVAILQTY > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |               Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                 Projection: snowflake.TPCH_SF1.PART.P_PARTKEY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |                   TableScan: snowflake.TPCH_SF1.PART, full_filters=[snowflake.TPCH_SF1.PART.P_NAME LIKE Utf8("forest%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |               Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |                 Projection: Float64(0.5) * sum(snowflake.TPCH_SF1.LINEITEM.L_QUANTITY)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |                   Aggregate: groupBy=[[]], aggr=[[sum(snowflake.TPCH_SF1.LINEITEM.L_QUANTITY)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |                     Filter: snowflake.TPCH_SF1.LINEITEM.L_PARTKEY = outer_ref(snowflake.TPCH_SF1.PARTSUPP.PS_PARTKEY) AND snowflake.TPCH_SF1.LINEITEM.L_SUPPKEY = outer_ref(snowflake.TPCH_SF1.PARTSUPP.PS_SUPPKEY)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |                       TableScan: snowflake.TPCH_SF1.LINEITEM, full_filters=[snowflake.TPCH_SF1.LINEITEM.L_SHIPDATE >= CAST(Utf8("1994-01-01") AS Date32), snowflake.TPCH_SF1.LINEITEM.L_SHIPDATE < CAST(Utf8("1994-01-01") AS Date32) + IntervalMonthDayNano("IntervalMonthDayNano { months: 12, days: 0, nanoseconds: 0 }")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |               TableScan: snowflake.TPCH_SF1.PARTSUPP                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |         TableScan: snowflake.TPCH_SF1.SUPPLIER projection=[S_SUPPKEY, S_NAME, S_ADDRESS, S_NATIONKEY]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       TableScan: snowflake.TPCH_SF1.NATION projection=[N_NATIONKEY], full_filters=[snowflake.TPCH_SF1.NATION.N_NAME = Utf8("CANADA")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=snowflake compute_context=username=SGREBNOV,account=MAAGZJQ-BIB84773,warehouse=COMPUTE_WH,role=accountadmin base_sql=SELECT "S_NAME", "S_ADDRESS" FROM "BENCHMARKS"."TPCH_SF1"."SUPPLIER" INNER JOIN "BENCHMARKS"."TPCH_SF1"."NATION" ON (("SUPPLIER"."S_NATIONKEY" = "NATION"."N_NATIONKEY") AND ("SUPPLIER"."S_SUPPKEY" IN (SELECT "PS_SUPPKEY" FROM "BENCHMARKS"."TPCH_SF1"."PARTSUPP" WHERE ("PARTSUPP"."PS_PARTKEY" IN (SELECT "P_PARTKEY" FROM "BENCHMARKS"."TPCH_SF1"."PART" WHERE "PART"."P_NAME" LIKE 'forest%') AND ("PARTSUPP"."PS_AVAILQTY" > (SELECT (0.5 * sum("LINEITEM"."L_QUANTITY")) FROM "BENCHMARKS"."TPCH_SF1"."LINEITEM" WHERE (("LINEITEM"."L_PARTKEY" = "PARTSUPP"."PS_PARTKEY") AND ("LINEITEM"."L_SUPPKEY" = "PARTSUPP"."PS_SUPPKEY")) AND (("LINEITEM"."L_SHIPDATE" >= CAST('1994-01-01' AS DATE)) AND ("LINEITEM"."L_SHIPDATE" < (CAST('1994-01-01' AS DATE) + INTERVAL '12 MONS'))))))) AND ("NATION"."N_NAME" = 'CANADA'))) ORDER BY "S_NAME" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
