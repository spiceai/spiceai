|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `s_acctbal`, `s_name`, `n_name`, `p_partkey`, `p_mfgr`, `s_address`, `s_phone`, `s_comment` FROM `tpch_sf1`.`part` CROSS JOIN `tpch_sf1`.`supplier` INNER JOIN `tpch_sf1`.`partsupp` ON ((`part`.`p_partkey` = `partsupp`.`ps_partkey`) AND (`supplier`.`s_suppkey` = `partsupp`.`ps_suppkey`)) INNER JOIN `tpch_sf1`.`nation` ON (`supplier`.`s_nationkey` = `nation`.`n_nationkey`) INNER JOIN `tpch_sf1`.`region` ON (`nation`.`n_regionkey` = `region`.`r_regionkey`) WHERE (`part`.`p_size` = 15) AND `part`.`p_type` LIKE '%BRASS' AND (`partsupp`.`ps_supplycost` = (SELECT min(`partsupp`.`ps_supplycost`) FROM `tpch_sf1`.`partsupp` INNER JOIN `tpch_sf1`.`supplier` ON (`supplier`.`s_suppkey` = `partsupp`.`ps_suppkey`) INNER JOIN `tpch_sf1`.`nation` ON (`supplier`.`s_nationkey` = `nation`.`n_nationkey`) INNER JOIN `tpch_sf1`.`region` ON (`nation`.`n_regionkey` = `region`.`r_regionkey`) WHERE (`part`.`p_partkey` = `partsupp`.`ps_partkey`) AND (`region`.`r_name` = 'EUROPE'))) AND (`region`.`r_name` = 'EUROPE') ORDER BY `s_acctbal` DESC, `n_name` ASC, `s_name` ASC, `p_partkey` ASC LIMIT 100 |
