---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: saffron_q7"
---
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | BytesProcessedNode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |  Limit: skip=0, fetch=20                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Projection: A.DateCreated, A.DateUpdated, A.AccountSid, A.NumberPoolSid, A.NumberSid, A.MaxRate, A.NumberDid, A.NumberType, A.SupportedDestRegion, A.NumberRegion, A.CurrentRate, A.IsAvailable, A.ProviderSid, A.AreaCodeRegion, A.AvailableForNumberSelection, B.Capability                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |     Inner Join:  Filter: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       Filter: A.NumberPoolSid = Utf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND A.AccountSid = Utf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND (A.SupportedDestRegion = Utf8("00") OR A.SupportedDestRegion = Utf8("US")) AND (A.NumberRegion = Utf8("US") OR A.NumberRegion IS NULL) AND A.NumberSid NOT IN ([Utf8("PN00000000000000000000000000000099")]) AND A.NumberType = Utf8("as")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |         SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           TableScan: number_info projection=[DateCreated, DateUpdated, AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberDid, NumberType, SupportedDestRegion, NumberRegion, CurrentRate, IsAvailable, ProviderSid, AreaCodeRegion, AvailableForNumberSelection]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       Filter: B.Capability = Utf8("sms")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |         SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |           TableScan: number_caps projection=[NumberSid, Capability]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| physical_plan | BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |   SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db initial_sql=SELECT "A"."DateCreated", "A"."DateUpdated", "A"."AccountSid", "A"."NumberPoolSid", "A"."NumberSid", "A"."MaxRate", "A"."NumberDid", "A"."NumberType", "A"."SupportedDestRegion", "A"."NumberRegion", "A"."CurrentRate", "A"."IsAvailable", "A"."ProviderSid", "A"."AreaCodeRegion", "A"."AvailableForNumberSelection", "B"."Capability" FROM "number_info" AS "A" INNER JOIN "number_caps" AS "B" ON (("A"."NumberSid" = "B"."NumberSid") AND ((((((("A"."NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9') AND ("A"."AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066')) AND (("A"."SupportedDestRegion" = '00') OR ("A"."SupportedDestRegion" = 'US'))) AND (("A"."NumberRegion" = 'US') OR "A"."NumberRegion" IS NULL)) AND "A"."NumberSid" NOT IN ('PN00000000000000000000000000000099')) AND ("A"."NumberType" = 'as')) AND ("B"."Capability" = 'sms'))) LIMIT 20 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
