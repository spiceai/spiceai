|               |                             VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT `store_sales`.`ss_sold_date_sk`, `store_sales`.`ss_item_sk`, `store_sales`.`ss_ext_sales_price`, `item`.`i_item_sk`, `item`.`i_item_id`, `date_dim`.`d_date_sk`, `date_dim`.`d_date` FROM `store_sales` INNER JOIN `item` ON (`store_sales`.`ss_item_sk` = `item`.`i_item_sk`) INNER JOIN `date_dim` ON (`store_sales`.`ss_sold_date_sk` = `date_dim`.`d_date_sk`) WHERE `date_dim`.`d_date` IN (SELECT `date_dim`.`d_date` FROM `date_dim` WHERE (`date_dim`.`d_week_seq` = (SELECT `date_dim`.`d_week_seq` FROM `date_dim` WHERE (`date_dim`.`d_date` = '2000-02-12'))))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
