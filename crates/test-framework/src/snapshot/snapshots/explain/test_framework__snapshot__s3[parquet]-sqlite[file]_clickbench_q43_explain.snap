description: "Query: clickbench_q43"
---
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |  Limit: skip=1000, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   Sort: M ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     Projection: date_part(Utf8("minute"),from_unixtime(hits.EventTime)) AS M, count(Int64(1)) AS PageViews                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       Aggregate: groupBy=[[date_part(Utf8("minute"), from_unixtime(hits.EventTime))]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |         Filter: CAST(hits.EventDate AS Utf8) >= Utf8("2013-07-14") AND CAST(hits.EventDate AS Utf8) <= Utf8("2013-07-15")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |           TableScan: hits projection=[EventTime, EventDate], full_filters=[CAST(hits.CounterID AS Int64) = Int64(62), CAST(hits.IsRefresh AS Int64) = Int64(0), CAST(hits.DontCountHits AS Int64) = Int64(0)]                                                                                                                                                                                                                                                                                                                                                                                                              |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |       VirtualExecutionPlan name=sqlite compute_context=//data/accelerated_sqlite.db base_sql=SELECT strftime('%M', datetime(`hits`.`EventTime`, 'unixepoch')) AS `M`, count(1) AS `PageViews` FROM `hits` WHERE ((CAST(`hits`.`EventDate` AS VARCHAR) >= '2013-07-14') AND (CAST(`hits`.`EventDate` AS VARCHAR) <= '2013-07-15')) AND (((CAST(`hits`.`CounterID` AS BIGINT) = 62) AND (CAST(`hits`.`IsRefresh` AS BIGINT) = 0)) AND (CAST(`hits`.`DontCountHits` AS BIGINT) = 0)) GROUP BY strftime('%M', datetime(`hits`.`EventTime`, 'unixepoch')) ORDER BY `M` ASC NULLS LAST LIMIT 10 OFFSET 1000 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
