---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: tpch_q5"
---
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                         |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: revenue DESC NULLS FIRST                                                                                                                                                                                               |
|               |   Projection: nation.n_name, sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount) AS revenue                                                                                                                       |
|               |     Aggregate: groupBy=[[nation.n_name]], aggr=[[sum(lineitem.l_extendedprice * (Decimal128(Some(1),20,0) - lineitem.l_discount)) AS sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)]]                        |
|               |       Projection: nation.n_name, lineitem.l_discount, lineitem.l_extendedprice                                                                                                                                               |
|               |         Inner Join: orders.o_custkey = customer.c_custkey, supplier.s_nationkey = customer.c_nationkey                                                                                                                       |
|               |           Projection: nation.n_name, supplier.s_nationkey, lineitem.l_discount, lineitem.l_extendedprice, orders.o_custkey                                                                                                   |
|               |             Inner Join: lineitem.l_orderkey = orders.o_orderkey                                                                                                                                                              |
|               |               Projection: nation.n_name, supplier.s_nationkey, lineitem.l_discount, lineitem.l_extendedprice, lineitem.l_orderkey                                                                                            |
|               |                 Inner Join: supplier.s_suppkey = lineitem.l_suppkey                                                                                                                                                          |
|               |                   Projection: nation.n_name, supplier.s_nationkey, supplier.s_suppkey                                                                                                                                        |
|               |                     Inner Join: nation.n_nationkey = supplier.s_nationkey                                                                                                                                                    |
|               |                       Projection: nation.n_name, nation.n_nationkey                                                                                                                                                          |
|               |                         Inner Join: region.r_regionkey = nation.n_regionkey                                                                                                                                                  |
|               |                           TableScan: region projection=[r_regionkey], full_filters=[region.r_name = Utf8("ASIA")]                                                                                                            |
|               |                           TableScan: nation projection=[n_name, n_nationkey, n_regionkey]                                                                                                                                    |
|               |                       TableScan: supplier projection=[s_nationkey, s_suppkey]                                                                                                                                                |
|               |                   TableScan: lineitem projection=[l_discount, l_extendedprice, l_orderkey, l_suppkey]                                                                                                                        |
|               |               TableScan: orders projection=[o_custkey, o_orderkey], full_filters=[orders.o_orderdate >= Date32("1994-01-01"), orders.o_orderdate < Date32("1995-01-01")]                                                     |
|               |           TableScan: customer projection=[c_custkey, c_nationkey]                                                                                                                                                            |
| physical_plan | SortPreservingMergeExec: [revenue@1 DESC]                                                                                                                                                                                    |
|               |   SortExec: expr=[revenue@1 DESC], preserve_partitioning=[true]                                                                                                                                                              |
|               |     ProjectionExec: expr=[n_name@0 as n_name, sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)@1 as revenue]                                                                                                   |
|               |       AggregateExec: mode=FinalPartitioned, gby=[n_name@0 as n_name], aggr=[sum(lineitem.l_extendedprice * Some(1),20,0 - lineitem.l_discount) as sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)]            |
|               |         RepartitionExec: partitioning=Hash([n_name@0], 32), input_partitions=32                                                                                                                                              |
|               |           AggregateExec: mode=Partial, gby=[n_name@0 as n_name], aggr=[sum(lineitem.l_extendedprice * Some(1),20,0 - lineitem.l_discount) as sum(lineitem.l_extendedprice * Int64(1) - lineitem.l_discount)]                 |
|               |             HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(o_custkey@4, c_custkey@0), (s_nationkey@1, c_nationkey@1)], projection=[n_name@0, l_discount@2, l_extendedprice@3]      |
|               |               RepartitionExec: partitioning=Hash([o_custkey@4, s_nationkey@1], 32), input_partitions=32                                                                                                                      |
|               |                 HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(l_orderkey@4, o_orderkey@1)], projection=[n_name@0, s_nationkey@1, l_discount@2, l_extendedprice@3, o_custkey@5]    |
|               |                   RepartitionExec: partitioning=Hash([l_orderkey@4], 32), input_partitions=32                                                                                                                                |
|               |                     HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(s_suppkey@2, l_suppkey@3)], projection=[n_name@0, s_nationkey@1, l_discount@3, l_extendedprice@4, l_orderkey@5] |
|               |                       RepartitionExec: partitioning=Hash([s_suppkey@2], 32), input_partitions=32                                                                                                                             |
|               |                         HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(n_nationkey@1, s_nationkey@0)], projection=[n_name@0, s_nationkey@2, s_suppkey@3]                           |
|               |                           RepartitionExec: partitioning=Hash([n_nationkey@1], 32), input_partitions=32                                                                                                                       |
|               |                             HashJoinExec: mode=Partitioned, join_type=Inner, accumulator=MinMaxLeftAccumulator, on=[(r_regionkey@0, n_regionkey@2)], projection=[n_name@1, n_nationkey@2]                                    |
|               |                               RepartitionExec: partitioning=Hash([r_regionkey@0], 32), input_partitions=1                                                                                                                    |
|               |                                 BytesProcessedExec                                                                                                                                                                           |
|               |                                   MongoDBExec projection=[r_regionkey] filters=[{"r_name":"ASIA"}]                                                                                                                           |
|               |                               RepartitionExec: partitioning=Hash([n_regionkey@2], 32), input_partitions=1                                                                                                                    |
|               |                                 BytesProcessedExec                                                                                                                                                                           |
|               |                                   MongoDBExec projection=[n_name, n_nationkey, n_regionkey] filters=[{}]                                                                                                                     |
|               |                           RepartitionExec: partitioning=Hash([s_nationkey@0], 32), input_partitions=1                                                                                                                        |
|               |                             BytesProcessedExec                                                                                                                                                                               |
|               |                               MongoDBExec projection=[s_nationkey, s_suppkey] filters=[{}]                                                                                                                                   |
|               |                       RepartitionExec: partitioning=Hash([l_suppkey@3], 32), input_partitions=1                                                                                                                              |
|               |                         BytesProcessedExec                                                                                                                                                                                   |
|               |                           MongoDBExec projection=[l_discount, l_extendedprice, l_orderkey, l_suppkey] filters=[{}]                                                                                                           |
|               |                   RepartitionExec: partitioning=Hash([o_orderkey@1], 32), input_partitions=1                                                                                                                                 |
|               |                     BytesProcessedExec                                                                                                                                                                                       |
|               |                       MongoDBExec projection=[o_custkey, o_orderkey] filters=[{"$and":[{"o_orderdate":{"$gte":{"$date":{"$numberLong":"757382400000"}}}},{"o_orderdate":{"$lt":{"$date":{"$numberLong":"788918400000"}}}}]}] |
|               |               RepartitionExec: partitioning=Hash([c_custkey@0, c_nationkey@1], 32), input_partitions=1                                                                                                                       |
|               |                 BytesProcessedExec                                                                                                                                                                                           |
|               |                   MongoDBExec projection=[c_custkey, c_nationkey] filters=[{}]                                                                                                                                               |
|               |                                                                                                                                                                                                                              |
