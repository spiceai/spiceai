description: "Query: tpch_q3"
---
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |  Limit: skip=0, fetch=10                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   Sort: revenue DESC NULLS FIRST, ducklake.main.orders.o_orderdate ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     Projection: ducklake.main.lineitem.l_orderkey, sum(ducklake.main.lineitem.l_extendedprice * Int64(1) - ducklake.main.lineitem.l_discount) AS revenue, ducklake.main.orders.o_orderdate, ducklake.main.orders.o_shippriority                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |       Aggregate: groupBy=[[ducklake.main.lineitem.l_orderkey, ducklake.main.orders.o_orderdate, ducklake.main.orders.o_shippriority]], aggr=[[sum(ducklake.main.lineitem.l_extendedprice * (Int64(1) - ducklake.main.lineitem.l_discount))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |         Inner Join:  Filter: ducklake.main.lineitem.l_orderkey = ducklake.main.orders.o_orderkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           Inner Join:  Filter: ducklake.main.customer.c_custkey = ducklake.main.orders.o_custkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |             TableScan: ducklake.main.customer projection=[c_custkey], full_filters=[ducklake.main.customer.c_mktsegment = Utf8("BUILDING")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             TableScan: ducklake.main.orders projection=[o_orderkey, o_custkey, o_orderdate, o_shippriority], full_filters=[ducklake.main.orders.o_orderdate < CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |           TableScan: ducklake.main.lineitem projection=[l_orderkey, l_extendedprice, l_discount], full_filters=[ducklake.main.lineitem.l_shipdate > CAST(Utf8("1995-03-15") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "l_orderkey", sum(("lineitem"."l_extendedprice" * (1 - "lineitem"."l_discount"))) AS "revenue", "o_orderdate", "o_shippriority" FROM "ducklake"."main"."customer" INNER JOIN "ducklake"."main"."orders" ON (("customer"."c_custkey" = "orders"."o_custkey") AND (("customer"."c_mktsegment" = 'BUILDING') AND ("orders"."o_orderdate" < CAST('1995-03-15' AS DATE)))) INNER JOIN "ducklake"."main"."lineitem" ON (("lineitem"."l_orderkey" = "orders"."o_orderkey") AND ("lineitem"."l_shipdate" > CAST('1995-03-15' AS DATE))) GROUP BY "lineitem"."l_orderkey", "orders"."o_orderdate", "orders"."o_shippriority" ORDER BY "revenue" DESC NULLS FIRST, "o_orderdate" ASC NULLS LAST LIMIT 10 |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
