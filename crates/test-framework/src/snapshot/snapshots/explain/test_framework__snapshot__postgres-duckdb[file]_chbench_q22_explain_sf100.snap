source: crates/test-framework/src/snapshot/mod.rs
description: "Query: chbench_q22"
---
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |  Sort: country ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |   Projection: substr(customer.c_state,Int64(1),Int64(1)) AS country, count(Int64(1)) AS numcust, sum(customer.c_balance) AS totacctbal                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |     Aggregate: groupBy=[[substr(customer.c_state, Int64(1), Int64(1))]], aggr=[[count(Int64(1)), sum(customer.c_balance)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       Filter: customer.c_balance > (<subquery>) AND NOT EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           Projection: avg(customer.c_balance)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |             Aggregate: groupBy=[[]], aggr=[[avg(customer.c_balance)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |               TableScan: customer, full_filters=[customer.c_balance > Float64(0), substr(customer.c_phone, Int64(1), Int64(1)) IN ([Utf8("1"), Utf8("2"), Utf8("3"), Utf8("4"), Utf8("5"), Utf8("6"), Utf8("7")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |           Projection: oorder.o_id, oorder.o_d_id, oorder.o_w_id, oorder.o_c_id, oorder.o_entry_d, oorder.o_carrier_id, oorder.o_ol_cnt, oorder.o_all_local, oorder._bench_ts                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |             Filter: oorder.o_c_id = outer_ref(customer.c_id) AND oorder.o_w_id = outer_ref(customer.c_w_id) AND oorder.o_d_id = outer_ref(customer.c_d_id)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |               TableScan: oorder                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |         TableScan: customer projection=[c_id, c_d_id, c_w_id, c_state, c_balance], full_filters=[substr(customer.c_phone, Int64(1), Int64(1)) IN ([Utf8("1"), Utf8("2"), Utf8("3"), Utf8("4"), Utf8("5"), Utf8("6"), Utf8("7")])]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db base_sql=SELECT substr("customer"."c_state", 1, 1) AS "country", count(1) AS "numcust", sum("customer"."c_balance") AS "totacctbal" FROM "customer" WHERE (("customer"."c_balance" > (SELECT avg("customer"."c_balance") FROM "customer" WHERE (("customer"."c_balance" > 0.0) AND substr("customer"."c_phone", 1, 1) IN ('1', '2', '3', '4', '5', '6', '7')))) AND NOT EXISTS (SELECT "oorder"."o_id", "oorder"."o_d_id", "oorder"."o_w_id", "oorder"."o_c_id", "oorder"."o_entry_d", "oorder"."o_carrier_id", "oorder"."o_ol_cnt", "oorder"."o_all_local", "oorder"."_bench_ts" FROM "oorder" WHERE ((("oorder"."o_c_id" = "customer"."c_id") AND ("oorder"."o_w_id" = "customer"."c_w_id")) AND ("oorder"."o_d_id" = "customer"."c_d_id")))) AND substr("customer"."c_phone", 1, 1) IN ('1', '2', '3', '4', '5', '6', '7') GROUP BY substr("customer"."c_state", 1, 1) ORDER BY "country" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
