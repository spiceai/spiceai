|               |  Projection: sum(lineitem.l_extendedprice * lineitem.l_discount) AS revenue                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |   Aggregate: groupBy=[[]], aggr=[[sum(lineitem.l_extendedprice * lineitem.l_discount)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
|               |     Filter: lineitem.l_shipdate >= CAST(Utf8("1994-01-01") AS Date32) AND lineitem.l_shipdate < CAST(Utf8("1995-01-01") AS Date32) AND lineitem.l_discount BETWEEN Decimal128(0.050000000000000,30,15) AND Decimal128(0.070000000000000,30,15) AND lineitem.l_quantity < Int64(24)                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       TableScan: lineitem projection=[l_quantity, l_extendedprice, l_discount, l_shipdate], partial_filters=[lineitem.l_shipdate >= CAST(Utf8("1994-01-01") AS Date32), lineitem.l_shipdate < CAST(Utf8("1995-01-01") AS Date32), lineitem.l_discount BETWEEN Decimal128(0.050000000000000,30,15) AND Decimal128(0.070000000000000,30,15), lineitem.l_quantity < Int64(24)]                                                                                                                                                                                                                                                                                                           |
