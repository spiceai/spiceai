---
source: crates/test-framework/src/snapshot/mod.rs
description: "Query: saffron_q3"
---
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |  Sort: A.MaxRate ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   Projection: A.MaxRate, count(Int64(1)) AS Count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |     Aggregate: groupBy=[[A.MaxRate]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |       Filter: A.AccountSid = Utf8("AC8ee2a82cf11c7c8860b192678c9e3066") AND A.NumberPoolSid = Utf8("NPe85ca269e9eb6b9268ffeab9d6ffaba9") AND A.NumberRegion IN ([Utf8("US")]) AND A.NumberType IN ([Utf8("lc")]) AND A.AreaCodeRegion IN ([Utf8("617")]) AND A.NumberSid NOT IN ([Utf8("PN00000000000000000000000000000099")]) AND A.Capability = Utf8("sms") AND CASE WHEN CAST(Int64(0) AS Int64) THEN A.AvailableForNumberSelection = Int64(1) ELSE A.AvailableForNumberSelection IN ([Int64(1), Int64(0)]) END                                                                                                                                                                                       |
|               |         SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |           TableScan: number_info_with_cap projection=[AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberType, NumberRegion, AreaCodeRegion, AvailableForNumberSelection, Capability]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       VirtualExecutionPlan name=duckdb compute_context=:memory: base_sql=SELECT "A"."MaxRate", count(1) AS "Count" FROM "number_info_with_cap" AS "A" WHERE (((((((("A"."AccountSid" = 'AC8ee2a82cf11c7c8860b192678c9e3066') AND ("A"."NumberPoolSid" = 'NPe85ca269e9eb6b9268ffeab9d6ffaba9')) AND "A"."NumberRegion" IN ('US')) AND "A"."NumberType" IN ('lc')) AND "A"."AreaCodeRegion" IN ('617')) AND "A"."NumberSid" NOT IN ('PN00000000000000000000000000000099')) AND ("A"."Capability" = 'sms')) AND CASE WHEN CAST(0 AS BIGINT) THEN ("A"."AvailableForNumberSelection" = 1) ELSE "A"."AvailableForNumberSelection" IN (1, 0) END) GROUP BY "A"."MaxRate" ORDER BY "A"."MaxRate" ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
