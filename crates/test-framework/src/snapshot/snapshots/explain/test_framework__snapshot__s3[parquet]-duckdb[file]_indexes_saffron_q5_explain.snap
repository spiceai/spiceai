source: crates/test-framework/src/snapshot/mod.rs
description: "Query: saffron_q5"
---
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | BytesProcessedNode                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   Federated                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |  Sort: NULL ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |   Projection: A.MaxRate, count(Int64(1)) AS Count                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     Aggregate: groupBy=[[A.MaxRate]], aggr=[[count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |       Inner Join:  Filter: A.NumberSid = B.NumberSid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |         Filter: A.AccountSid = Utf8("AC02da2b759e8342d4b73ff6e64a77ce58") AND A.NumberPoolSid = Utf8("NPcb39bd63c0a54ab8b106d8f9e0aa6507") AND A.NumberRegion IN ([Utf8("CA")]) AND A.NumberType IN ([Utf8("tf")]) AND A.NumberSid NOT IN ([Utf8("PN00000000000000000000000000000099")]) AND CASE WHEN Int64(0) THEN A.AvailableForNumberSelection = Int64(1) ELSE A.AvailableForNumberSelection IN ([Int64(1), Int64(0)]) END                                                                                                                                                                                                                                                                                                                      |
|               |           SubqueryAlias: A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |             TableScan: number_info projection=[AccountSid, NumberPoolSid, NumberSid, MaxRate, NumberType, NumberRegion, AvailableForNumberSelection]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |         Filter: B.Capability = Utf8("sms")                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |           SubqueryAlias: B                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |             TableScan: number_caps projection=[NumberSid, Capability]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| physical_plan | BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |       VirtualExecutionPlan name=duckdb compute_context=//data/accelerated_duckdb.db initial_sql=SELECT "A"."MaxRate", count(1) AS "Count" FROM "number_info" AS "A" INNER JOIN "number_caps" AS "B" ON (("A"."NumberSid" = "B"."NumberSid") AND ((((((("A"."AccountSid" = 'AC02da2b759e8342d4b73ff6e64a77ce58') AND ("A"."NumberPoolSid" = 'NPcb39bd63c0a54ab8b106d8f9e0aa6507')) AND "A"."NumberRegion" IN ('CA')) AND "A"."NumberType" IN ('tf')) AND "A"."NumberSid" NOT IN ('PN00000000000000000000000000000099')) AND CASE WHEN 0 THEN ("A"."AvailableForNumberSelection" = 1) ELSE "A"."AvailableForNumberSelection" IN (1, 0) END) AND ("B"."Capability" = 'sms'))) GROUP BY "A"."MaxRate" ORDER BY NULL ASC NULLS LAST |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
+---------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
