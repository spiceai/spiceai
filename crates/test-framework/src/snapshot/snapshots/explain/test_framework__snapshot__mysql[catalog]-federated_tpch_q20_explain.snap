|               |     Inner Join:  Filter: mysql.tpch_sf1.supplier.s_nationkey = mysql.tpch_sf1.nation.n_nationkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       Filter: mysql.tpch_sf1.supplier.s_suppkey IN (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |           Projection: mysql.tpch_sf1.partsupp.ps_suppkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
|               |             Filter: mysql.tpch_sf1.partsupp.ps_partkey IN (<subquery>) AND mysql.tpch_sf1.partsupp.ps_availqty > (<subquery>)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |               Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                 Projection: mysql.tpch_sf1.part.p_partkey                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
|               |                   TableScan: mysql.tpch_sf1.part, full_filters=[mysql.tpch_sf1.part.p_name LIKE Utf8("forest%")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |               Subquery:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
|               |                 Projection: Float64(0.5) * sum(mysql.tpch_sf1.lineitem.l_quantity)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |                   Aggregate: groupBy=[[]], aggr=[[sum(mysql.tpch_sf1.lineitem.l_quantity)]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
|               |                     Filter: mysql.tpch_sf1.lineitem.l_partkey = outer_ref(mysql.tpch_sf1.partsupp.ps_partkey) AND mysql.tpch_sf1.lineitem.l_suppkey = outer_ref(mysql.tpch_sf1.partsupp.ps_suppkey)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
|               |                       TableScan: mysql.tpch_sf1.lineitem, full_filters=[mysql.tpch_sf1.lineitem.l_shipdate >= CAST(Utf8("1994-01-01") AS Date32), mysql.tpch_sf1.lineitem.l_shipdate < CAST(Utf8("1995-01-01") AS Date32)]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
|               |               TableScan: mysql.tpch_sf1.partsupp                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |         TableScan: mysql.tpch_sf1.supplier projection=[s_suppkey, s_name, s_address, s_nationkey]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |       TableScan: mysql.tpch_sf1.nation projection=[n_nationkey], full_filters=[mysql.tpch_sf1.nation.n_name = Utf8("CANADA")]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| physical_plan | SchemaCastScanExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
|               |   CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
|               |     BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       VirtualExecutionPlan name=mysql compute_context=host=benchmark-mysql.dataplatform.svc.cluster.local,port=3306,db=tpch_sf1,user=root base_sql=SELECT `s_name`, `s_address` FROM `tpch_sf1`.`supplier` INNER JOIN `tpch_sf1`.`nation` ON (`supplier`.`s_nationkey` = `nation`.`n_nationkey`) WHERE `supplier`.`s_suppkey` IN (SELECT `ps_suppkey` FROM `tpch_sf1`.`partsupp` WHERE (`partsupp`.`ps_partkey` IN (SELECT `p_partkey` FROM `tpch_sf1`.`part` WHERE `part`.`p_name` LIKE 'forest%') AND (`partsupp`.`ps_availqty` > (SELECT (0.5 * sum(`lineitem`.`l_quantity`)) FROM `tpch_sf1`.`lineitem` WHERE ((`lineitem`.`l_partkey` = `partsupp`.`ps_partkey`) AND (`lineitem`.`l_suppkey` = `partsupp`.`ps_suppkey`)) AND ((`lineitem`.`l_shipdate` >= CAST('1994-01-01' AS DATE)) AND (`lineitem`.`l_shipdate` < CAST('1995-01-01' AS DATE))))))) AND (`nation`.`n_name` = 'CANADA') ORDER BY `s_name` ASC |
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
