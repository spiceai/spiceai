|               |                   VirtualExecutionPlan name=duckdb compute_context=./data/tpcds.db base_sql=SELECT "item"."i_category", "item"."i_class", "item"."i_brand", "store"."s_store_name", "store"."s_company_name", "date_dim"."d_moy", sum("store_sales"."ss_sales_price") FROM "item" INNER JOIN "store_sales" ON ("store_sales"."ss_item_sk" = "item"."i_item_sk") INNER JOIN "date_dim" ON ("store_sales"."ss_sold_date_sk" = "date_dim"."d_date_sk") INNER JOIN "store" ON ("store_sales"."ss_store_sk" = "store"."s_store_sk") WHERE (("item"."i_category" IN ('Children', 'Jewelry', 'Home') AND "item"."i_class" IN ('infants', 'birdal', 'flatware')) OR ("item"."i_category" IN ('Electronics', 'Music', 'Books') AND "item"."i_class" IN ('audio', 'classical', 'science'))) AND "date_dim"."d_year" IN (2001) GROUP BY "item"."i_category", "item"."i_class", "item"."i_brand", "store"."s_store_name", "store"."s_company_name", "date_dim"."d_moy" |
