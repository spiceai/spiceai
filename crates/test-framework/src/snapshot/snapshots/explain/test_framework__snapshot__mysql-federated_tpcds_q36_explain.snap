|               |               BytesProcessedExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |                 VirtualExecutionPlan name=mysql compute_context=<CONNECTION> base_sql=SELECT `item`.`i_category`, `item`.`i_class`, sum(`store_sales`.`ss_net_profit`), sum(`store_sales`.`ss_ext_sales_price`), grouping(`item`.`i_category`), grouping(`item`.`i_class`) FROM `store_sales` INNER JOIN `date_dim` AS `d1` ON (`d1`.`d_date_sk` = `store_sales`.`ss_sold_date_sk`) INNER JOIN `item` ON (`item`.`i_item_sk` = `store_sales`.`ss_item_sk`) INNER JOIN `store` ON (`store`.`s_store_sk` = `store_sales`.`ss_store_sk`) WHERE (`d1`.`d_year` = 2001) AND `store`.`s_state` IN ('TN', 'TN', 'TN', 'TN', 'TN', 'TN', 'TN', 'TN') GROUP BY ROLLUP (`item`.`i_category`, `item`.`i_class`)                            |
