#syntax=docker/dockerfile:1.7

# Build the ADBC BigQuery driver from source
ARG ADBC_BIGQUERY_COMMIT=feb542e756362a7203a7aa41b50af533427be5a6
ARG GO_VERSION=1.26.1
ARG BASE_IMAGE=debian:bookworm-slim

FROM golang:${GO_VERSION}-bookworm AS adbc-bigquery
ARG ADBC_BIGQUERY_COMMIT
RUN set -eu; \
    apt-get update && apt-get install -y --no-install-recommends git ca-certificates gcc libc6-dev && \
    rm -rf /var/lib/{apt,dpkg,cache,log}
RUN set -eu; \
    git clone https://github.com/adbc-drivers/bigquery.git /src/bigquery; \
    cd /src/bigquery; \
    git checkout "${ADBC_BIGQUERY_COMMIT}"; \
    cd go; \
    CGO_ENABLED=1 go build -tags driverlib -buildmode=c-shared \
      -o /libadbc_driver_bigquery.so ./pkg/; \
    rm -f /libadbc_driver_bigquery.h; \
    strip /libadbc_driver_bigquery.so

FROM ${BASE_IMAGE} AS binary

ARG REL_VERSION
ARG BINARY_VARIANT=default
ARG TARGETOS
ARG TARGETARCH
ARG GITHUB_REPOSITORY=spiceai/spiceai
ARG GITHUB_TOKEN

RUN if [ -z "$REL_VERSION" ]; then echo "REL_VERSION build-arg is required" >&2; exit 1; fi

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl tar jq \
    && rm -rf /var/lib/{apt,dpkg,cache,log}

ENV REL_VERSION=${REL_VERSION}
ENV BINARY_VARIANT=${BINARY_VARIANT}

RUN set -eux; \
    download_asset_url() { \
      if [ -n "${GITHUB_TOKEN:-}" ]; then \
        curl -fSL -H "Authorization: Bearer ${GITHUB_TOKEN}" -H "Accept: application/octet-stream" "$1" -o /tmp/spiced.tar.gz; \
      else \
        curl -fSL -H "Accept: application/octet-stream" "$1" -o /tmp/spiced.tar.gz; \
      fi; \
    }; \
    fetch_release_json() { \
      if [ -n "${GITHUB_TOKEN:-}" ]; then \
        curl -fSs -H "Authorization: Bearer ${GITHUB_TOKEN}" -H "Accept: application/vnd.github+json" "$1" -o /tmp/release.json; \
      else \
        curl -fSs -H "Accept: application/vnd.github+json" "$1" -o /tmp/release.json; \
      fi; \
    }; \
    download_via_api() { \
      asset_id="$1"; \
      asset_api_url="https://api.github.com/repos/${GITHUB_REPOSITORY}/releases/assets/${asset_id}"; \
      if [ -n "${GITHUB_TOKEN:-}" ]; then \
        curl -fSL -H "Authorization: Bearer ${GITHUB_TOKEN}" -H "Accept: application/octet-stream" "${asset_api_url}" -o /tmp/spiced.tar.gz; \
      else \
        curl -fSL -H "Accept: application/octet-stream" "${asset_api_url}" -o /tmp/spiced.tar.gz; \
      fi; \
    }; \
    case "${TARGETOS}" in \
      ""|linux) os_slug=linux ;; \
      *) echo "Unsupported TARGETOS: ${TARGETOS}" >&2; exit 1 ;; \
    esac; \
    case "${TARGETARCH}" in \
      amd64) arch_slug=x86_64 ;; \
      arm64) arch_slug=aarch64 ;; \
      "") arch_slug=x86_64 ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    if [ "${BINARY_VARIANT}" = "default" ]; then \
      asset="spiced_${os_slug}_${arch_slug}.tar.gz"; \
    else \
      variant_slug=$(printf '%s' "${BINARY_VARIANT}" | tr '[:upper:]' '[:lower:]' | tr '-' '_'); \
      asset="spiced_${variant_slug}_${os_slug}_${arch_slug}.tar.gz"; \
    fi; \
    set -- "${asset}"; \
    if [ "${BINARY_VARIANT}" = "odbc" ]; then \
      set -- "$@" "spiced_odbc_models_${os_slug}_${arch_slug}.tar.gz"; \
    fi; \
    release_url="https://api.github.com/repos/${GITHUB_REPOSITORY}/releases/tags/v${REL_VERSION}"; \
    asset_downloaded=false; \
    if fetch_release_json "${release_url}"; then \
      for candidate in "$@"; do \
        asset_id=$(jq -e --arg name "${candidate}" '.assets[] | select(.name == $name) | .id' /tmp/release.json 2>/dev/null || true); \
        if [ -n "${asset_id}" ]; then \
          download_via_api "${asset_id}"; \
          asset_downloaded=true; \
          asset="${candidate}"; \
          break; \
        fi; \
      done; \
    else \
      echo "Failed to query GitHub release API for v${REL_VERSION}, falling back to direct download URLs." >&2; \
    fi; \
    if [ "${asset_downloaded}" = false ]; then \
      if [ -f /tmp/release.json ]; then \
        echo "Available assets for v${REL_VERSION}:" >&2; \
        jq -r '.assets[].name' /tmp/release.json >&2 || true; \
      fi; \
      download_success=false; \
      for candidate in "$@"; do \
        fallback_url="https://github.com/${GITHUB_REPOSITORY}/releases/download/v${REL_VERSION}/${candidate}"; \
        echo "Attempting direct asset URL ${fallback_url}" >&2; \
        if download_asset_url "${fallback_url}"; then \
          asset="${candidate}"; \
          download_success=true; \
          break; \
        fi; \
      done; \
      if [ "${download_success}" = false ]; then \
        echo "Failed to download release asset matching candidates for ${BINARY_VARIANT}" >&2; \
        exit 1; \
      fi; \
    fi; \
    rm -f /tmp/release.json 2>/dev/null || true; \
    tar -C /root -xzf /tmp/spiced.tar.gz; \
    chmod +x /root/spiced; \
    rm -f /tmp/spiced.tar.gz

FROM ${BASE_IMAGE} AS sandbox-setup

ARG CARGO_FEATURES=default
ARG INSTALL_ORACLE_ODPIC=true
ARG ORACLE_INSTANTCLIENT_SHA256_AMD64=208bc7a9372efae098ab743d6e76aeb66e6f42579dcdbb7a6a8438412481b02e
ARG ORACLE_INSTANTCLIENT_SHA256_ARM64=390999bc623c39c065f1236b8b1331b342431564a7a5e36e4c645fe8d159fc5e

# Install required packages
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libssl3 findutils tzdata \
    && if echo "$CARGO_FEATURES" | grep -q "odbc"; then \
      apt-get install --yes --no-install-recommends unixodbc; \
    fi \
    && rm -rf /var/lib/{apt,dpkg,cache,log}

# Layout a tiny filesystem in /spice_sandbox
RUN mkdir -p /spice_sandbox/bin \
    && mkdir -p /spice_sandbox/lib \
    && mkdir -p /spice_sandbox/usr/lib \
    && mkdir -p /spice_sandbox/usr/local/bin \
    && mkdir -p /spice_sandbox/usr/share \
    && mkdir -p /spice_sandbox/etc \
    && mkdir -p /spice_sandbox/etc/ssl \
    && mkdir -p /spice_sandbox/dev \
    && mkdir -p /spice_sandbox/app

# Copy the binary
COPY --from=binary /root/spiced /spice_sandbox/usr/local/bin/

# Copy CA certificates
RUN cp -r /etc/ssl/certs /spice_sandbox/etc/ssl/certs

# Copy timezone database (IANA tzdb) - used by jiff, chrono, libc, and other timezone-aware libraries
RUN cp -r /usr/share/zoneinfo /spice_sandbox/usr/share/zoneinfo

# Copy every dependent library reported by ldd
RUN set -eux; \
    ldd /spice_sandbox/usr/local/bin/spiced \
    | awk '{ for (i = 1; i <= NF; i++) { if ($i ~ "^/") { path = $i; while (path ~ /[:)]$/) sub(/[:)]$/, "", path); if (path !~ "^/spice_sandbox/") print path; } } }' \
    | sort -u \
    | while read -r lib; do \
        mkdir -p "/spice_sandbox$(dirname "$lib")"; \
        cp "$lib" "/spice_sandbox$lib"; \
      done

# Copy additional required libraries
RUN find /lib /usr/lib -name 'libpthread.so.0' -exec sh -c 'mkdir -p /spice_sandbox/$(dirname "{}") && cp "{}" "/spice_sandbox{}"' \;
RUN find /lib /usr/lib -name 'librt.so.1' -exec sh -c 'mkdir -p /spice_sandbox/$(dirname "{}") && cp "{}" "/spice_sandbox{}"' \;
RUN find /lib /usr/lib -name 'libdl.so.2' -exec sh -c 'mkdir -p /spice_sandbox/$(dirname "{}") && cp "{}" "/spice_sandbox{}"' \;

# Preinstall Oracle ODPI-C (if enabled)
RUN if [ "$INSTALL_ORACLE_ODPIC" = "true" ]; then \
    set -eu; \
    apt-get update && apt-get install -y --no-install-recommends libaio1 unzip curl; \
    ARCH=$(dpkg --print-architecture); \
    if [ "$ARCH" = "amd64" ]; then \
      : "${ORACLE_INSTANTCLIENT_SHA256_AMD64:?ORACLE_INSTANTCLIENT_SHA256_AMD64 must be set to the expected SHA256 checksum}"; \
      curl -fsSLo basic.zip https://download.oracle.com/otn_software/linux/instantclient/2380000/instantclient-basiclite-linux.x64-23.8.0.25.04.zip; \
      echo "${ORACLE_INSTANTCLIENT_SHA256_AMD64}  basic.zip" | sha256sum -c -; \
    elif [ "$ARCH" = "arm64" ]; then \
      : "${ORACLE_INSTANTCLIENT_SHA256_ARM64:?ORACLE_INSTANTCLIENT_SHA256_ARM64 must be set to the expected SHA256 checksum}"; \
      curl -fsSLo basic.zip https://download.oracle.com/otn_software/linux/instantclient/2380000/instantclient-basiclite-linux.arm64-23.8.0.25.04.zip; \
      echo "${ORACLE_INSTANTCLIENT_SHA256_ARM64}  basic.zip" | sha256sum -c -; \
    else \
      echo "Unsupported architecture: $ARCH" >&2; exit 1; \
    fi; \
    unzip basic.zip && \
    cp -v \
      instantclient_*/libclntsh.so.23.1 \
      instantclient_*/libclntshcore.so.23.1 \
      instantclient_*/libnnz.so \
      instantclient_*/libociicus.so \
      instantclient_*/fips.so \
      instantclient_*/legacy.so \
      /spice_sandbox/usr/lib && \
    ln -s libclntsh.so.23.1 /spice_sandbox/usr/lib/libclntsh.so && \
    ln -s libclntshcore.so.23.1 /spice_sandbox/usr/lib/libclntshcore.so && \
    cp "$(find /usr/lib /lib -name 'libaio.so.1' | head -n 1)" /spice_sandbox/usr/lib && \
    cp "$(find /usr/lib /lib -name 'libresolv.so.2' | head -n 1)" /spice_sandbox/usr/lib && \
    rm -f basic.zip; \
  fi

# Minimal passwd & group for the nobody user
RUN echo 'nobody:x:65534:65534:nobody:/app:/usr/sbin/nologin' > /spice_sandbox/etc/passwd \
    && echo 'nogroup:x:65534:' > /spice_sandbox/etc/group

# Copy ADBC BigQuery driver into system ADBC driver search path
RUN mkdir -p /spice_sandbox/etc/adbc/drivers
COPY --from=adbc-bigquery /libadbc_driver_bigquery.so /spice_sandbox/etc/adbc/drivers/
RUN printf '[Driver]\nshared = "/etc/adbc/drivers/libadbc_driver_bigquery.so"\n' > /spice_sandbox/etc/adbc/drivers/bigquery.toml

# Create DuckDB directory in sandbox
RUN mkdir -p /spice_sandbox/.duckdb \
    && chmod 755 /spice_sandbox/.duckdb

# Give the nobody user ownership of app dir
RUN chown -R 65534:65534 /spice_sandbox/app

# Create HuggingFace cache directory in sandbox
RUN mkdir -p /spice_sandbox/.cache/huggingface/hub \
    && chown -R 65534:65534 /spice_sandbox/.cache \
    && chmod -R 755 /spice_sandbox/.cache

FROM scratch

COPY --from=sandbox-setup /spice_sandbox/ /

USER 65534:65534

EXPOSE 8090 50051

WORKDIR /app

ENV HOME=/app
ENV HF_HOME=/.cache/huggingface
ENV HF_HUB_CACHE=/.cache/huggingface/hub
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_DIR=/etc/ssl/certs

ENTRYPOINT ["/usr/local/bin/spiced"]
