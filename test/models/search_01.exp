#!/usr/bin/env python3

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

from interactive_cli import InteractionError, PtyProcess


PROMPT = re.compile(r"search>")
ERROR = re.compile(r" ERROR ")


def perform_search(process: PtyProcess, search_term: str, expected_term: str) -> None:
    process.send_line(search_term)
    process.read_until_prompt(
        PROMPT,
        timeout=10,
        expected=re.compile(expected_term),
        error=ERROR,
    )
    print("Search returned expected result")


def main() -> int:
    process = PtyProcess(["spice", "search"])

    try:
        process.read_until_prompt(PROMPT, timeout=10)
        perform_search(
            process,
            "Spice runtime error",
            r"1 +\S+ +.* +[0-9]+\.[0-9]+ +spice\.public\.issues",
        )
        perform_search(
            process,
            "friends",
            r"1 +\S+ +.* +[0-9]+\.[0-9]+ +spice\.public\.catalog_page",
        )
        process.send_ctrl_c()
        return 0
    except InteractionError as error:
        print(str(error), file=sys.stderr)
        return 1
    finally:
        process.close()


if __name__ == "__main__":
    raise SystemExit(main())
