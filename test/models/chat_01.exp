#!/usr/bin/expect -f

source [file join [file dirname [info script]] repl_helpers.exp]

# How long the runtime may go silent before the script calls it stalled. This is
# not a bound on how long a response may take — see repl_idle_timeout.
set timeout [repl_idle_timeout]

spawn spice chat {*}[repl_endpoint_args]

proc verify_datasets_access {} {
    global timeout

    set taxi_trips_available 0
    set gh_issues_available 0
    set catalog_page_available 0

    repl_send "What datasets you have access to\r"

    expect {
        -re "(?i)taxi_trips|taxi trips" {
            set taxi_trips_available 1
            exp_continue
        }
        -re "(?i)github_issues|github issues" {
            set gh_issues_available 1
            exp_continue
        }
        -re "(?i)catalog_page|catalog page" {
            set catalog_page_available 1
            exp_continue
        }
        " ERROR " {
            # allow stream to complete
            sleep 2
            send_user "Error detected\n"
            exit 1
        }
        "chat> " {
            # end of model response
        }
        -re {[^\n]*\n} {
            # Still streaming — restart the wait. Whole lines only, for the
            # reason given in repl_helpers.exp. The dataset patterns above are
            # tried first, so a name anywhere in the buffer still wins over
            # this branch.
            exp_continue
        }
        eof {
            repl_died "Waiting for the list of datasets"
        }
        timeout {
            repl_stalled "Waiting for the list of datasets"
        }
    }

    if { $taxi_trips_available == 1 && $gh_issues_available == 1 && $catalog_page_available == 1 } {
        send_user "Model confirmed access to all datasets\n"
    } else {
        send_user "Model did not return expected response\n"
        exit 1
    }
}

proc verify_num_issues {} {
    global timeout

    repl_send "How many issues stored in database?\r"

    expect {
        " ERROR " {
            # allow stream to complete
            sleep 2
            send_user "Error detected\n"
            exit 1
        }
        "chat> " {
            # end of model response
        }
        -re {[^\n]*\n} {
            # Still streaming — restart the wait. See verify_datasets_access.
            exp_continue
        }
        eof {
            repl_died "Waiting for the issue count"
        }
        timeout {
            repl_stalled "Waiting for the issue count"
        }
    }

    send_user "Model returned expected response\n"
}

proc verify_catalog_page {} {
    repl_send "find top 3 exclusive deals in catalog pages. Respond with a short bullet list.\r"

    expect {
        " ERROR " {
            # allow stream to complete
            sleep 2
            send_user "Error detected\n"
            exit 1
        }
        "chat> " {
            # end of model response
        }
        -re {[^\n]*\n} {
            # Still streaming — restart the wait. See verify_datasets_access.
            exp_continue
        }
        eof {
            repl_died "Waiting for the catalog page deals"
        }
        timeout {
            repl_stalled "Waiting for the catalog page deals"
        }
    }

    send_user "Model returned expected response\n"
}

expect {
    "chat>" {
        # runtime is ready for input
    }
    -re {[^\n]*\n} {
        # Banner and connection lines the CLI prints on its way to the prompt.
        exp_continue
    }
    eof {
        repl_died "Waiting for the initial chat prompt"
    }
    timeout {
        repl_stalled "Waiting for the initial chat prompt"
    }
}

verify_datasets_access
sleep 1

verify_num_issues
sleep 1

verify_catalog_page

# Every verification passed, so the REPL must still be sitting at its prompt.
repl_assert_running "Checking the chat REPL is still running"

# Signal to exit (Ctrl+C)
repl_send \x03

exit 0
