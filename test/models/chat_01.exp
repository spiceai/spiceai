#!/usr/bin/env python3

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

from interactive_cli import InteractionError, PtyProcess


PROMPT = re.compile(r"chat>")
ERROR = re.compile(r" ERROR ")


def verify_datasets_access(process: PtyProcess) -> None:
    process.send_line("What datasets you have access to")
    result = process.read_until_prompt(PROMPT, timeout=35, error=ERROR)
    output = result.output

    expected = [
        re.compile(r"(?i)taxi_trips|taxi trips"),
        re.compile(r"(?i)github_issues|github issues"),
        re.compile(r"(?i)catalog_page|catalog page"),
    ]

    if not all(pattern.search(output) for pattern in expected):
        raise InteractionError(f"Model did not return expected datasets. Output:\n{output}")

    print("Model confirmed access to all datasets")


def verify_round_trip(process: PtyProcess, message: str) -> None:
    process.send_line(message)
    process.read_until_prompt(PROMPT, timeout=35, error=ERROR)
    print("Model returned expected response")


def main() -> int:
    process = PtyProcess(["spice", "chat"])

    try:
        process.read_until_prompt(PROMPT, timeout=35)
        verify_datasets_access(process)
        verify_round_trip(process, "How many issues stored in database?")
        verify_round_trip(process, "find top 3 exclusive deals in catalog pages")
        process.send_ctrl_c()
        return 0
    except InteractionError as error:
        print(str(error), file=sys.stderr)
        return 1
    finally:
        process.close()


if __name__ == "__main__":
    raise SystemExit(main())
