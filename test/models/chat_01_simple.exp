#!/usr/bin/env python3

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

from interactive_cli import InteractionError, PtyProcess


PROMPT = re.compile(r"chat>")
ERROR = re.compile(r" ERROR ")


def chat(process: PtyProcess, message: str) -> None:
    process.send_line(message)
    process.read_until_prompt(PROMPT, timeout=35, error=ERROR)
    print("Model returned expected response")


def main() -> int:
    process = PtyProcess(["spice", "chat"])

    try:
        process.read_until_prompt(PROMPT, timeout=35)
        chat(process, "What datasets you have access to?")
        chat(process, "How many issues stored in database?")
        process.send_ctrl_c()
        return 0
    except InteractionError as error:
        print(str(error), file=sys.stderr)
        return 1
    finally:
        process.close()


if __name__ == "__main__":
    raise SystemExit(main())
