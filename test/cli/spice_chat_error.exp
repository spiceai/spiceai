#!/usr/bin/env python3

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

from interactive_cli import InteractionError, run_command


def assert_matches(output: str, pattern: str, message: str) -> None:
    if not re.search(pattern, output, re.DOTALL):
        raise InteractionError(f"{message}\nOutput:\n{output}")


def test_invalid_model() -> None:
    result = run_command(["spice", "chat", "--model", "not_exist"])
    output = result.stdout
    print(f"Command output: {output}")

    assert_matches(output, r"ERROR.*model not_exist does not exist", "Missing error about unavailable model")
    assert_matches(output, r"ERROR.*configured models", "Available models list not shown")
    assert_matches(output, r"model1", "Expected model 'model1' not found in the list")
    print("Invalid model test passed")


def test_invalid_http_endpoint() -> None:
    result = run_command(["spice", "chat", "--http-endpoint", "https://data.spicea"])
    output = result.stdout
    print(f"Command output: {output}")

    assert_matches(output, r"ERROR.*could not list models.*no such host", "Missing error about invalid host")
    assert_matches(output, r"lookup data.spicea: no such host", "Invalid hostname not correctly reported")
    print("Invalid host test passed")


def test_invalid_temperature() -> None:
    result = run_command(["spice", "chat", "--temperature", "-1"])
    output = result.stdout
    print(f"Command output: {output}")

    assert_matches(
        output,
        r"ERROR.*temperature must be greater than or equal to 0",
        "Missing error about invalid temperature",
    )
    print("Invalid temperature test passed")


def test_invalid_api_key() -> None:
    result = run_command(
        [
            "spice",
            "chat",
            "--http-endpoint",
            "https://data.spiceai.io",
            "--api-key",
            "wrong_key",
        ]
    )
    output = result.stdout
    print(f"Command output: {output}")

    assert_matches(
        output,
        r"ERROR.*could not list models.*unauthorized: invalid or missing Spice API key",
        "Missing error about invalid API key",
    )
    print("Invalid API key test passed")


def main() -> int:
    try:
        test_invalid_model()
        test_invalid_http_endpoint()
        test_invalid_temperature()
        test_invalid_api_key()
        return 0
    except InteractionError as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())