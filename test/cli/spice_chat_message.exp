#!/usr/bin/env python3

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

from interactive_cli import InteractionError, PtyProcess, run_command


def test_spice_chat_message() -> None:
    print("Testing single message mode...")
    result = run_command(["spice", "chat", "hello", "--model", "model1"], timeout=30)
    output = result.stdout

    if "chat>" in output:
        raise InteractionError("Command entered interactive mode when it should not have")

    if len(output.strip()) <= 1:
        raise InteractionError("Command produced insufficient output")

    print("Command completed without entering interactive mode")
    print("spice chat <message> test passed")


def test_spice_chat_model_select() -> None:
    print("Testing spice chat <message> with model selection...")
    process = PtyProcess(["spice", "chat", "hello"])

    try:
        prompt = process.read_until_match_or_eof(
            re.compile(r"Use the arrow keys to navigate:"),
            timeout=30,
        )
        print("Model selection prompt appeared")

        process.send_line("")

        confirmation = process.read_until_match_or_eof(
            re.compile(r"Using model:"),
            timeout=30,
        )
        print("Model selection confirmed")

        response = process.read_until_match_or_eof(
            re.compile(r"Time:.*Tokens:", re.DOTALL),
            timeout=30,
        )
        print("Complete response with usage statistics received")

        full_output = prompt + confirmation + response
        print(f"Full output captured:\n{full_output}")

        if not re.search(r"Using model:", full_output) or not re.search(
            r"Time:.*Tokens:", full_output, re.DOTALL
        ):
            raise InteractionError("Incomplete response cycle")

        print("Model selection test passed")
    finally:
        process.close()


def main() -> int:
    try:
        test_spice_chat_message()
        test_spice_chat_model_select()
        return 0
    except InteractionError as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())